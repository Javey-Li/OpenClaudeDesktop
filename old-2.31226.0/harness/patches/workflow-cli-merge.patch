+[
+  {
+    "name": "timer-members",
+    "script": "setTimeout.marker=\"root set\";clearTimeout.marker=\"root clear\";const child=await workflow(\"child\");return {child,set:setTimeout.marker,clear:clearTimeout.marker}",
+    "child": "const result={set:setTimeout.marker??null,clear:clearTimeout.marker??null};setTimeout.marker=\"child set\";clearTimeout.marker=\"child clear\";return result",
+    "value": {
+      "child": {
+        "set": "root set",
+        "clear": "root clear"
+      },
+      "set": "child set",
+      "clear": "child clear"
+    }
+  },
+  {
+    "name": "budget-function-members",
+    "script": "budget.spent.marker=\"root spent\";budget.remaining.marker=\"root remaining\";const child=await workflow(\"child\");return {child,spent:budget.spent.marker,remaining:budget.remaining.marker}",
+    "child": "const result={spent:budget.spent.marker??null,remaining:budget.remaining.marker??null,frozen:Object.isFrozen(budget),nullPrototype:Object.getPrototypeOf(budget)===null};budget.spent.marker=\"child spent\";budget.remaining.marker=\"child remaining\";return result",
+    "value": {
+      "child": {
+        "spent": "root spent",
+        "remaining": "root remaining",
+        "frozen": true,
+        "nullPrototype": true
+      },
+      "spent": "child spent",
+      "remaining": "child remaining"
+    }
+  },
+  {
+    "name": "helper-members",
+    "script": "const hooks={agent,parallel,pipeline,workflow,phase,log,consoleLog:console.log};for(const [name,hook] of Object.entries(hooks))hook.marker=\"root \"+name;const child=await workflow(\"child\");return {child,parent:Object.fromEntries(Object.entries(hooks).map(([name,hook])=>[name,hook.marker]))}",
+    "child": "const hooks={agent,parallel,pipeline,workflow,phase,log,consoleLog:console.log};const result=Object.fromEntries(Object.entries(hooks).map(([name,hook])=>[name,hook.marker??null]));for(const [name,hook] of Object.entries(hooks))hook.marker=\"child \"+name;return result",
+    "value": {
+      "child": {
+        "agent": null,
+        "parallel": null,
+        "pipeline": null,
+        "workflow": null,
+        "phase": null,
+        "log": null,
+        "consoleLog": null
+      },
+      "parent": {
+        "agent": "root agent",
+        "parallel": "root parallel",
+        "pipeline": "root pipeline",
+        "workflow": "root workflow",
+        "phase": "root phase",
+        "log": "root log",
+        "consoleLog": "root consoleLog"
+      }
+    }
+  },
+  {
+    "name": "captured-originals",
+    "script": "const original={budget,setTimeout,clearTimeout};original.budget.spent.marker=\"captured\";original.setTimeout.marker=\"captured\";original.clearTimeout.marker=\"captured\";budget={spent:()=>-1};setTimeout=()=>-2;clearTimeout=()=>-3;return await workflow(\"child\")",
+    "child": "return {budget:budget.spent.marker??null,set:setTimeout.marker??null,clear:clearTimeout.marker??null,total:budget.total,frozen:Object.isFrozen(budget)}",
+    "value": {
+      "budget": "captured",
+      "set": "captured",
+      "clear": "captured",
+      "total": null,
+      "frozen": true
+    }
+  },
+  {
+    "name": "sibling-members",
+    "script": "const first=await workflow(\"child\",{first:true});const second=await workflow(\"child\",{first:false});return {first,second,parent:[setTimeout.marker??null,budget.spent.marker??null]}",
+    "child": "const previous=[setTimeout.marker??null,budget.spent.marker??null];if(args.first){setTimeout.marker=\"first\";budget.spent.marker=\"first\";}return previous",
+    "value": {
