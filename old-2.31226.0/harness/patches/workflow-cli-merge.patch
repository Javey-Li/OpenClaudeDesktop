+++ b/packages/workflow/workflow-ptc/tests/mirror.spec.ts
@@ -0,0 +1,160 @@
+import { existsSync } from 'node:fs'
+import { basename, dirname, join } from 'node:path'
+import { mkdir, readFile, rm, symlink, writeFile } from 'node:fs/promises'
+import { describe, expect, it, vi } from 'vitest'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { WorkflowAttemptId } from '@deepseek-ai/dsh-workflow'
+import { Journal } from '../src/journal.ts'
+import { workflowMirrorDefinition } from '../src/mirror.ts'
+import { setupMerge } from './merge-setup.ts'
+
+const script = 'return await agent("cached work")'
+
+describe('Session-owned workflow recovery', () => {
+  it.each(['journal', 'script', 'directory'])('recovers a missing %s and reuses completed work through repeated resumes', async (kind) => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start(script)
+    expect((await first.result).value).toBe('reply-1')
+    await first.dispose()
+    const path = first.scriptPath!, directory = dirname(path)
+    const target = kind === 'journal' ? join(directory, `${first.attemptId}.jsonl`) : kind === 'script' ? path : directory
+    await rm(target, { recursive: true })
+    t.ctx.workflowEngine.prepareResume(t.parent, first.id, path)
+    expect(await readFile(path, 'utf8')).toContain(script)
+    const next = t.start(script, { resumeFromRunId: first.id, scriptPath: path })
+    expect((await next.result).value).toBe('reply-1')
+    await next.dispose()
+    await rm(directory, { recursive: true })
+    const again = t.start(script, { resumeFromRunId: first.id, scriptPath: path })
+    expect((await again.result).value).toBe('reply-1')
+    expect(t.requests).toHaveLength(1)
+    await again.dispose()
+    // Three confined process launches and two durable repairs share this timeout.
+  }, 30_000)
+
+  it('reconstructs recovery data from detached Session history and excludes inherited fork history', async () => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start(script)
+    await first.result
+    await first.dispose()
+    const seed = structuredClone(t.parent.session.snapshotEvents())
+    const restored = Session.create(t.parent.session.id, seed, t.parent.session.header)
+    const fork = Session.create(SessionId('different-owner'), seed)
+    const original = t.ctx.sessionProjections.stateOf(t.parent.session, 'workflowMirror')!
+    expect(t.ctx.sessionProjections.stateOf(restored, 'workflowMirror')).toEqual(original)
+    expect(t.ctx.sessionProjections.stateOf(fork, 'workflowMirror')!.runs).toEqual({})
+    expect(workflowMirrorDefinition.stateSchema.parse(JSON.parse(JSON.stringify(original)))).toEqual(original)
+    await rm(dirname(first.scriptPath!), { recursive: true })
+    t.ctx.workflowEngine.prepareResume({ ...t.parent, session: restored }, first.id, first.scriptPath)
+    expect(existsSync(first.scriptPath!)).toBe(true)
+  })
+
+  it('keeps user edits while repairing a missing journal', async () => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start('return 1')
+    await first.result
+    await first.dispose()
+    await writeFile(first.scriptPath!, '/* my formatting */ return 2')
+    await rm(join(dirname(first.scriptPath!), `${first.attemptId}.jsonl`))
+    t.ctx.workflowEngine.prepareResume(t.parent, first.id, first.scriptPath)
+    expect(await readFile(first.scriptPath!, 'utf8')).toBe('/* my formatting */ return 2')
+  })
+
+  it('does not recreate an external user source, including when the private journal is missing', async () => {
+    const t = await setupMerge({ mirror: true })
+    const external = join(t.root, 'user.js')
+    await writeFile(external, 'return 1')
+    const first = t.start('return 1', { scriptPath: external })
+    await first.result
+    await first.dispose()
+    const backup = t.ctx.sessionProjections.stateOf(t.parent.session, 'workflowMirror')!.runs[first.id]!
+    expect(backup.source).toBeUndefined()
+    await rm(external)
+    await rm(first.transcriptDir!, { recursive: true })
+    t.ctx.workflowEngine.prepareResume(t.parent, first.id, external)
+    expect(existsSync(external)).toBe(false)
+  })
+
+  it('refuses active recovery before writing any missing source', async () => {
+    const t = await setupMerge({ mirror: true, hold: true })
+    const first = t.start(script)
+    await rm(first.scriptPath!)
+    expect(() => { t.ctx.workflowEngine.prepareResume(t.parent, first.id, first.scriptPath) }).toThrow('still running')
+    expect(existsSync(first.scriptPath!)).toBe(false)
+    await first.dispose()
+  })
+
+  it('does not replace corrupt existing journals with backups', async () => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start('return 1')
+    await first.result
+    await first.dispose()
+    const journal = join(dirname(first.scriptPath!), `${first.attemptId}.jsonl`)
+    await writeFile(journal, 'corrupt\n')
+    expect(() => { t.ctx.workflowEngine.prepareResume(t.parent, first.id, first.scriptPath) }).toThrow('unavailable')
+    expect(await readFile(journal, 'utf8')).toBe('corrupt\n')
+  })
+
+  it('contains backup failures without losing the primary run and leaves mirroring opt-in', async () => {
+    const t = await setupMerge({ mirror: true })
+    const append = vi.spyOn(t.parent.session, 'append').mockImplementation(() => { throw new Error('backup unavailable') })
+    const first = t.start(script)
+    expect((await first.result).value).toBe('reply-1')
+    await first.dispose()
+    expect(append.mock.calls.every(args => args[0] === 'workflow-ptc/mirror')).toBe(true)
+    expect(t.ctx.sessionProjections.stateOf(t.parent.session, 'workflowMirror')!.runs).toEqual({})
+    const other = await setupMerge()
+    const plain = other.start('return 1')
+    await plain.result
+    await plain.dispose()
+    expect(other.ctx.sessionProjections.stateOf(other.parent.session, 'workflowMirror')!.runs).toEqual({})
+    await rm(dirname(plain.scriptPath!), { recursive: true })
+    expect(() => { other.ctx.workflowEngine.prepareResume(other.parent, plain.id, plain.scriptPath) }).toThrow('unavailable')
+  })
+
+  it('isolates late old-attempt records and rejects backups for another provider', async () => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start(script)
+    await first.result
+    await first.dispose()
+    const old = t.ctx.sessionProjections.stateOf(t.parent.session, 'workflowMirror')!.runs[first.id]!
+    const next = t.start('return 2', { resumeFromRunId: first.id })
+    await next.result
+    await next.dispose()
+    t.parent.session.append('workflow-ptc/mirror', { sessionId: t.parent.session.id, runId: first.id,
+      attemptId: first.attemptId!, record: { kind: 'entry', entry: old.entries[0]! } })
+    const backup = t.ctx.sessionProjections.stateOf(t.parent.session, 'workflowMirror')!.runs[first.id]!
+    expect(backup.entries).toEqual([])
+    await rm(dirname(next.scriptPath!), { recursive: true })
+    expect(() => { Journal.restore(join(t.root, 'workflows'), t.parent.session.id, first.id, 'other', backup,
+      basename(next.scriptPath!), () => {}) }).toThrow('Could not restore')
+    expect(existsSync(next.scriptPath!)).toBe(false)
+  })
+
+  it('rejects private directory links outside the owning Session', async () => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start('return 1')
+    await first.result
+    await first.dispose()
+    const directory = dirname(first.scriptPath!), outside = join(t.root, 'outside')
+    await mkdir(outside)
+    await rm(directory, { recursive: true })
+    await symlink(outside, directory)
+    expect(() => { t.ctx.workflowEngine.prepareResume(t.parent, first.id, first.scriptPath) }).toThrow('Could not restore')
+    expect(existsSync(join(outside, basename(first.scriptPath!)))).toBe(false)
+  })
+
+  it.each(['../escape.js', 'nul.js'])('ignores unsafe restored source %s while recovering its journal', async (fileName) => {
+    const t = await setupMerge({ mirror: true })
+    const first = t.start('return 1')
+    await first.result
+    await first.dispose()
+    t.parent.session.append('workflow-ptc/mirror', { sessionId: t.parent.session.id, runId: first.id,
+      attemptId: WorkflowAttemptId('11111111-1111-4111-8111-111111111111'),
+      record: { kind: 'start', provider: 'merge-test', source: { fileName, script: fileName === 'nul.js' ? 'return "\0"' : 'return 1' } } })
+    await rm(dirname(first.scriptPath!), { recursive: true })
+    t.ctx.workflowEngine.prepareResume(t.parent, first.id, first.scriptPath)
+    expect(existsSync(first.scriptPath!)).toBe(false)
+    expect(Journal.resume(join(t.root, 'workflows'), t.parent.session.id, first.id, 'merge-test')).toEqual([])
+  })
+})
