@@ -0,0 +1,31 @@
+/** Parse Claude agent effort and model-iteration limits from Markdown metadata. */
+
+/** Resolve named efforts, the med alias, and integer effort values.
+ * @param value - Raw frontmatter field.
+ * @returns Provider-facing effort identifier, or undefined for an invalid value.
+ */
+export function agentEffort(value: unknown): string | undefined {
+  if (value === undefined || value === null || value === '') return
+  // oxlint-disable-next-line typescript/no-base-to-string -- Claude metadata parsing intentionally uses JavaScript string coercion.
+  const text = String(value).toLowerCase()
+  if (text === 'med') return 'medium'
+  if (['low', 'medium', 'high', 'xhigh', 'max'].includes(text)) return text
+  const integer = typeof value === 'number' && Number.isInteger(value) ? value : Number.parseInt(text, 10)
+  return Number.isInteger(integer) ? String(integer) : undefined
+}
+
+/** Resolve Claude's positive integer maxTurns field, including numeric strings.
+ * @param value - Raw frontmatter field; numeric strings accept exponent/grouped notation and decimal integer prefixes.
+ * @returns Maximum model iterations, or undefined for an invalid value.
+ */
+export function agentMaxTurns(value: unknown): number | undefined {
+  if (value === undefined || value === null) return
+  // oxlint-disable-next-line typescript/no-base-to-string -- Claude metadata parsing intentionally uses JavaScript string coercion.
+  const text = String(value).trim()
+  let parsed: number
+  if (typeof value === 'number') parsed = value
+  else if (text.length <= 32 && /^[+-]?(\d+(\.\d*)?|\.\d+)[eE][+-]?\d+$/.test(text)) parsed = Number(text)
+  else if (text.length <= 32 && /^[+-]?\d{1,3}([_,\u00a0\u202f ])\d{3}(?:\1\d{3})*$/.test(text)) parsed = Number.parseInt(text.replace(/[_,\u00a0\u202f ]/g, ''), 10)
+  else parsed = Number.parseInt(text, 10)
+  return Number.isInteger(parsed) && parsed > 0 ? parsed : undefined
+}
