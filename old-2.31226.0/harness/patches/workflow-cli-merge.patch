+import * as vm from 'node:vm'
+import { describe, expect, it } from 'vitest'
+import { WORKFLOW_INTRINSICS_SOURCE } from '../src/intrinsics.ts'
+import { WORKFLOW_BOUNDARY_SOURCE, wrapWorkflowHostCall, wrapWorkflowHostAsync } from '../src/boundary.ts'
+import type { WorkflowBoundary } from '../src/boundary.ts'
+
+function fixture() {
+  const context = vm.createContext({ __proto__: null }, { codeGeneration: { strings: false, wasm: false } })
+  vm.runInContext(WORKFLOW_INTRINSICS_SOURCE, context)
+  const boundary = vm.runInContext(WORKFLOW_BOUNDARY_SOURCE, context) as WorkflowBoundary
+  return { context, boundary }
+}
+
+describe('workflow host and guest values', () => {
+  it('copies aliases and cycles into the guest without sharing host prototypes', () => {
+    const { context, boundary } = fixture()
+    const value: { n: number; self?: object } = { n: 1 }; value.self = value
+    context.result = boundary.clone([value, value])
+    expect(vm.runInContext('result instanceof Array && result[0] instanceof Object && result[0]===result[1] && result[0].self===result[0]', context)).toBe(true)
+    vm.runInContext('result[0].n=2', context)
+    expect(value.n).toBe(1)
+  })
+
+  it('copies enumerable data and dense indices without invoking toJSON or retaining methods', () => {
+    const { boundary } = fixture()
+    const bad = { get fail() { throw Error('unreadable') }, n: 2, toJSON() { throw Error('must not run') } }
+    expect(boundary.clone(bad)).toEqual({ n: 2 })
+    expect(boundary.clone([, () => 1, bad])).toEqual([undefined, undefined, { n: 2 }])
+    expect(boundary.clone(JSON.parse('{"__proto__":1,"constructor":2}'))).toEqual({ constructor: 2 })
+    expect(boundary.clone(new Date(0))).toEqual({})
+  })
+
+  it('propagates nested array limits but contains unrelated accessor and proxy failures', () => {
+    const { boundary } = fixture()
+    expect(() => boundary.clone({ nested: new Array(4097) })).toThrow('exceeds the maximum of 4096')
+    expect(() => boundary.clone(new Proxy([], { get: () => NaN }))).toThrow('not a safe integer')
+    expect(boundary.clone(new Proxy({}, { ownKeys() { throw Error('keys') } }))).toEqual({})
+    const revoked = Proxy.revocable({}, {}); revoked.revoke()
+    expect(boundary.clone([revoked.proxy])).toEqual([undefined])
+  })
+
+  it('does not mistake caller errors with identical messages for walker cap errors', () => {
+    const { boundary } = fixture()
+    expect(boundary.clone({ get x() { throw Error('array length 4097 exceeds the maximum of 4096 supported across the workflow VM boundary') } })).toEqual({})
+  })
+
+  it('boxes a settled value so host await cannot observe its later then getter', async () => {
+    const { context, boundary } = fixture()
+    const value: unknown = vm.runInContext('globalThis.reads=0; ({ get then(){reads++;return undefined}, n:1 })', context)
+    const settled = await boundary.settle(value)
+    expect(settled.value).toBe(value)
+    expect(vm.runInContext('reads', context)).toBe(1)
+    expect(Object.getPrototypeOf(settled)).toBeNull()
+  })
+
+  it('uses guest promises and fixed rejection fields for foreign host failures', async () => {
+    const { context, boundary } = fixture()
+    context.hook = boundary.asyncWrap(wrapWorkflowHostAsync(() => { throw Object.assign(new TypeError('failed'), { secret: 1 }) }))
+    const result: unknown = await vm.runInContext('(async()=>{const promise=hook();try{await promise}catch(e){return [promise instanceof Promise,Object.getPrototypeOf(e)===null,Object.isFrozen(e),Object.keys(e),String(e),Object.getPrototypeOf(e.toString)===null]}})()', context)
+    expect(result).toEqual([true, true, true, ['name', 'message', 'stack', 'toString'], 'TypeError: failed', true])
+  })
+
+  it('preserves guest errors when the async wrapper receives them directly', async () => {
+    const { context, boundary } = fixture()
+    const error = vm.runInContext('new Error("local")', context) as Error
+    const hook = boundary.asyncWrap(() => Promise.reject(error))
+    await expect(hook()).rejects.toBe(error)
+  })
+
+  it('does not let a throwing error name discard its message', () => {
+    const hook = wrapWorkflowHostCall(() => { throw { get name() { throw Error('name') }, message: 'retained' } })
+    expect(Object.getPrototypeOf(hook)).toBeNull()
+    try { hook(); expect.unreachable() }
+    catch (error) { expect(error).toMatchObject({ name: 'Error', message: 'retained' }); expect(Object.isFrozen(error)).toBe(true) }
+  })
+
+  it('invokes guest callbacks without exposing a host this value', () => {
+    const { context, boundary } = fixture()
+    const callback = vm.runInContext('(function(){"use strict";return this===undefined})', context) as () => unknown
+    expect(boundary.call(callback)).toBe(true)
+  })
+})
