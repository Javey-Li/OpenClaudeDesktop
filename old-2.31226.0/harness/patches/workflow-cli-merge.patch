+
+it('rejects user targets and repeated indexes already removed from the current projection', () => {
+  const { session, source } = fixture()
+  const user = session.append('user/message', createUserMessage({ content: [{ type: 'reasoning', text: 'untrusted' }], source: { kind: 'user' } }), { surfaceOp: 'append' })
+  expect(() => session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0] }, { messageId: user.data.id, blockIndexes: [0] }] })).toThrow(/assistant message/)
+  expect(session.deriveMessages()[0]?.content).toHaveLength(3)
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0] }] })
