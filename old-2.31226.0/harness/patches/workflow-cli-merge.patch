@@ -0,0 +1,21 @@
+/** Price reconstruction of one streamed assistant's advertised surface nodes. */
+
+import type { SessionEvent, SessionSeq } from '@deepseek-ai/dsh-session'
+import { ROLE_OVERHEAD } from './estimate.ts'
+
+/** One validated merge's selected nodes and role-framing correction.
+ * @param nodes - currently retained message estimates before applying the merge.
+ * @param event - validated decision identifying every segment of one response.
+ * @returns selected estimates, their sequence identities, merged tokens, and the framing adjustment.
+ */
+export function planStreamingTokens<Node extends { seq: SessionSeq; heuristicTokens: number }>(
+  nodes: readonly Node[],
+  event: SessionEvent<'assistant/stream-merge'>,
+): { selected: Node[]; sequences: ReadonlySet<SessionSeq>; tokens: number; delta: number } {
+  const sequences = new Set(event.data.messageSeqs)
+  const selected = nodes.filter(node => sequences.has(node.seq))
+  if (selected.length !== sequences.size) throw new Error('token meter: missing streamed assistant surface node')
+  const delta = -Math.max(0, selected.length - 1) * ROLE_OVERHEAD
+  const tokens = selected.reduce((sum, node) => sum + node.heuristicTokens, 0) + delta
+  return { selected, sequences, tokens, delta }
+}
