+  for (const { path: directory, namespace } of claude ? sources.toReversed() : sources) {
+    let entries
+    try {
+      const target = await fs.resolve(directory, options)
+      const stat = await fs.stat(target, signal)
+      if (!stat) continue
+      entries = stat.type === 'directory' ? await fs.listDir(target, signal) : [{ name: posix.basename(directory), type: stat.type, target }]
+    } catch (error) { skipUnreadable(error); continue }
+    let match: { script: string; meta?: WorkflowMeta } | undefined
+    for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
+      if (entry.type !== 'file' || !(claude ? /\.js$/u : /\.m?js$/u).test(entry.name)) continue
+      let bytes: Uint8Array
+      try { bytes = await fs.readBytes(entry.target, signal, config.maxScriptBytes) }
+      catch (error) { skipUnreadable(error); continue }
+      signal.throwIfAborted()
+      let source: string
+      let parsed: { script: string; meta?: WorkflowMeta }
+      try { source = decode(bytes); parsed = parse(source, !claude) }
+      catch { continue /* Non-workflow JavaScript is not a registry entry. */ }
+      if (!parsed.meta) continue
+      const name = namespace ? `${namespace}:${parsed.meta.name}` : parsed.meta.name
+      available.add(name)
+      if (name !== input.name) continue
+      if (claude) {
+        if (selected !== undefined) {
+          try { parse(source) }
+          catch { continue /* An invalid override cannot mask the earlier definition. */ }
+        }
+        selected = source
+        continue
+      }
+      if (match) throw new Error(`duplicate workflow name ${input.name} in ${directory}`)
+      match = parsed
+    }
+    if (match) {
+      return match
+    }
+  }
+  if (selected !== undefined) {
+    if (input.script !== undefined) parse(input.script)
+    return parse(selected)
+  }
+  throw new Error(claude ? `Workflow "${input.name}" not found. Available: ${[...available].join(', ')}` : `workflow name not found: ${input.name}`)
+}
