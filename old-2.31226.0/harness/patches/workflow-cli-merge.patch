+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import type { WorkflowAgentAdmissionInfo, WorkflowAgentInfo } from '@deepseek-ai/dsh-workflow'
+import { setupMerge } from './merge-setup.ts'
+
+interface AdmissionFixture { name: string; script: string; progress: Record<string, unknown>[] }
+const native = JSON.parse(await readFile(new URL('./fixtures/admissions-native.json', import.meta.url), 'utf8')) as AdmissionFixture[]
+const project = (rows: Record<string, unknown>[]) => rows.map(row => Object.fromEntries(
+  ['type', 'index', 'title', 'kind', 'label', 'phaseIndex', 'phaseTitle'].filter(key => row[key] !== undefined).map(key => [key, row[key]]),
+))
+
+it.each(native)('matches native $name admission order and labels through real PTC', async (fixture) => {
+  const t = await setupMerge({ structured: { items: [1, 2] }, concurrency: 1 })
+  const events: Record<string, unknown>[] = []
+  t.ctx.on('workflow/phase', (_run, title, phase) => { events.push({ type: 'workflow_phase', title, ...phase }) })
+  t.ctx.on('workflow/agent-admission', (_run, agent) => {
+    if (agent.state === 'queued') events.push({ type: 'workflow_agent', index: agent.seq, label: agent.label, phaseIndex: agent.phaseIndex, phaseTitle: agent.phase })
+  })
+  const run = t.start(fixture.script)
+  expect((await run.result).stopReason).toBe('completed')
+  const output = JSON.parse(await readFile(run.outputFile!, 'utf8')) as { workflowProgress: Record<string, unknown>[] }
+  expect(project(events)).toEqual(fixture.progress)
+  expect(project(output.workflowProgress)).toEqual(fixture.progress)
+  await run.dispose()
+})
+
+it('publishes every queued call before the first child completes and retains counts on cancellation', async () => {
+  const t = await setupMerge({ hold: true, concurrency: 1 })
+  const admissions: WorkflowAgentAdmissionInfo[] = [], starts: WorkflowAgentInfo[] = []
+  const queued = Promise.withResolvers<undefined>(), published = Promise.withResolvers<undefined>()
+  t.ctx.on('workflow/agent-admission', (_run, agent) => { admissions.push(agent); if (admissions.length === 8) queued.resolve(undefined) })
+  t.ctx.on('workflow/agent-start', (_run, agent) => { starts.push(agent); published.resolve(undefined) })
+  const run = t.start('phase("Queue");return await Promise.all(Array.from({length:8},(_,i)=>agent("work",{label:String(i)})))')
+  await queued.promise
+  await published.promise
+  expect(admissions).toHaveLength(8)
+  expect(starts).toHaveLength(1)
+  expect(t.requests).toHaveLength(1)
+  expect(admissions.every(agent => agent.state === 'queued' && !('childId' in agent))).toBe(true)
+  expect(starts[0]?.seq).toBe(1)
+  run.cancel('queue test')
+  expect(await run.result).toMatchObject({ stopReason: 'cancelled', agentsStarted: 8 })
+  expect(await readFile(run.outputFile!, 'utf8')).toBe('')
+  await run.dispose()
+})
+
+it('keeps a failed admission without inventing a child lifecycle when provider startup rejects', async () => {
+  const t = await setupMerge({ startFailedCalls: [1] })
+  const admissions: WorkflowAgentAdmissionInfo[] = [], starts: WorkflowAgentInfo[] = []
+  t.ctx.on('workflow/agent-admission', (_run, agent) => { admissions.push(agent) })
+  t.ctx.on('workflow/agent-start', (_run, agent) => { starts.push(agent) })
+  const run = t.start('try{await agent("work")}catch(e){return e.message}')
+  expect(await run.result).toMatchObject({ stopReason: 'completed', agentsStarted: 1 })
+  expect(admissions.map(agent => agent.state)).toEqual(['queued', 'failed'])
+  expect(admissions[1]).toMatchObject({ seq: 1, queuedAt: admissions[0]?.queuedAt, error: expect.stringContaining('provider startup rejected') as string })
+  expect(starts).toEqual([])
+  const output = JSON.parse(await readFile(run.outputFile!, 'utf8')) as { workflowProgress: Record<string, unknown>[] }
+  expect(output.workflowProgress).toHaveLength(1)
+  expect(output.workflowProgress[0]).toMatchObject({ state: 'error', label: 'work' })
+  expect(output.workflowProgress[0]).not.toHaveProperty('agentId')
+  await run.dispose()
+})
