@@ -0,0 +1,148 @@
+import { homedir } from 'node:os'
+import { describe, expect, it } from 'vitest'
+import { prepareBashClamp } from '../src/bash-clamp.ts'
+
+const signal = new AbortController().signal
+// Double-star is an explicit wildcard pattern; Bash(*) parses as no rule content and is refused.
+const cases: [string, string[], boolean][] = [
+  ['git status && git diff', ['git status', 'git diff'], true],
+  ['git status && git reset --hard', ['git status', 'git diff'], false],
+  ['git status || git diff', ['git:*'], true],
+  ['git status; git diff\ngit log', ['git:*'], true],
+  ['git status | head -10', ['git:*', 'head:*'], true],
+  ['git status | head -10', ['git:*'], false],
+  ['git status |& head -10', ['git:*', 'head:*'], true],
+  ['! git status', ['git status'], true],
+  ['echo good &', ['echo good'], true],
+  ['echo good # ; dangerous\necho good', ['echo good'], true],
+  ['# no command', ['**'], false],
+  ['echo "hello; world"', ['echo:*'], true],
+  ["echo '$(touch x)'", ['echo:*'], true],
+  ['echo "$(touch x)"', ['**'], false],
+  ['echo `touch x`', ['**'], false],
+  ['echo <(cat x)', ['**'], false],
+  ['(git status)', ['**'], false],
+  ['{ git status; }', ['**'], false],
+  ['if true; then git status; fi', ['**'], false],
+  ['for x in a b; do echo "$x"; done', ['**'], false],
+  ['echo "unfinished', ['**'], false],
+  ['echo foo\\ bar', ['**'], false],
+  ['echo hi\r', ['**'], false],
+  ['echo \u00a0hi', ['**'], false],
+  ['echo \ud800', ['**'], false],
+  ['echo ~[dynamic]', ['**'], false],
+  ['echo =command', ['**'], false],
+  ['echo <1-5>', ['**'], false],
+  ['echo a{b,c}', ['**'], false],
+  ['echo "a{b,c}"', ['echo:*'], true],
+  ["echo 'a{b,c}'", ['echo:*'], true],
+  ['echo {a,"b"}', ['**'], false],
+  ['echo hi > out', ['echo hi'], true],
+  ['echo hi 2>/dev/null', ['echo hi'], true],
+  ['echo hi 2>&1', ['echo hi'], true],
+  ['echo > out hi', ['**'], false],
+  ['echo hi > $HOME/out', ['**'], false],
+  ['echo hi > "$HOME/out"', ['echo hi'], true],
+  ['echo hi > "prefix-$USER"', ['**'], false],
+  ['echo hi > !out', ['**'], false],
+  ['echo hi >&-out', ['**'], false],
+  ['echo hi <<< literal', ['echo hi'], false],
+  ['echo hi <<< literal', ['echo:*'], true],
+  ['echo hi <<< literal', ['echo hi <<< literal'], true],
+  ["cat << 'EOF'\nhello\nEOF", ['cat'], true],
+  ['cat << EOF\nhello\nEOF', ['**'], false],
+  ['echo  hi', ['echo  hi'], true],
+  ['echo  hi', ['echo hi'], false],
+  ['echo\thi', ['echo:*'], true],
+  ['echo', ['echo *'], true],
+  ['echo hello', ['echo *'], true],
+  ['echo hello', ['echo h?llo'], false],
+  ['cat a/b/c.txt', ['cat a/**/c.txt'], true],
+  ['cat a/c.txt', ['cat a/**/c.txt'], true],
+  ['echo good', ['certified: echo good'], false],
+  ['xargs git status', ['git:*'], true],
+  ['xargs git status', ['git *'], true],
+  ['xargs git status', ['git *status'], false],
+  ['git status-other', ['git status:*'], false],
+  ['g"it" status', ['git status'], true],
+  ['g\\it status', ['git status'], true],
+  ["'git' status", ['git status'], true],
+  ['command -p git status', ['git status'], true],
+  ['command -v git', ['git:*'], false],
+  ['nohup timeout -s TERM 10 nice -n 2 git status', ['git status'], true],
+  ['NODE_ENV=test git status', ['git status'], true],
+  ['PATH=/tmp git status', ['git status'], false],
+  ['PATH=/tmp; echo hi', ['**'], false],
+  ['A=hello; echo $A', ['A=hello', 'echo $A', 'echo hello'], true],
+  ['A=hello; echo $A', ['A=hello', 'echo $A'], false],
+  ['A=hello; A=hello; echo $A', ['**'], true],
+  ['A=hello; A=world; echo $A', ['**'], false],
+  ['A=hello echo $A', ['**'], false],
+  ['echo first; A=hello; echo $A', ['**'], false],
+  ['A=hello; echo ok; echo $A', ['**'], true],
+  ['A=hello | echo $A', ['**'], false],
+  ['A=hello || echo $A', ['**'], false],
+  ['echo $HOME', ['echo $HOME', `echo ${homedir()}`], true],
+  ['echo $MISSING', ['**'], false],
+  ['echo ${HOME}', ['**'], false],
+  ['echo "prefix-$USER"', ['echo:*'], true],
+  ['echo "$USER"', ['**'], false],
+  ['echo $((a+2))', ['**'], false],
+  ['echo $((1+2))', ['echo:*'], true],
+  ['echo $((0xaf+2))', ['echo:*'], true],
+  ['echo $((64#abc+1))', ['echo:*'], true],
+  ['A=hello; read A; echo $A', ['**'], false],
+  ['A=hello; printf -v A world; echo $A', ['**'], false],
+  ['A=hello; command read A; echo $A', ['**'], false],
+  ['read PATH; echo hi', ['**'], false],
+  ['A=hello; A+=world; echo $A', ['**'], true],
+  ['A=hello; echo "prefix-$A"', ['**'], true],
+  ['RANDOM=10; echo $RANDOM', ['**'], false],
+  ['RANDOM=10; echo "prefix-$RANDOM"', ['**'], true],
+  ['echo "prefix-$?"', ['**'], true],
+  ['echo "prefix-$1"', ['**'], false],
+  ['A=hello; true || false; echo $A', ['**'], false],
+  ['A=hello; echo ok | cat; echo $A', ['**'], true],
+
+  ['cat a/b/c.txt', ['cat a/**/**/c.txt'], true],
+  ['cat a/c.txt', ['cat a/**/**/c.txt'], true],
+  ['echo hi <<< $HOME', ['echo hi <<< $HOME'], false],
+  ['echo hi <<< $HOME', ['echo hi <<< $HOME', 'echo hi'], true],
+  ['echo hi <<< "prefix-$USER"', ['echo:*'], true],
+  ['echo hi <<< "!literal"', ['echo:*'], true],
+  ['A=$((1+2)); echo $A', ['**'], false],
+  ['A=hello; echo $((1+2)) $A', ['**'], true],
+
+  ['A=hello B=$A echo ok', ['**'], false],
+  ['A=hello; A=hello B=$A echo ok', ['**'], false],
+  ['A=hello; A=world :; echo $A', ['**'], false],
+
+]
+
+describe('workflow Bash command admission', () => {
+  it.each(cases)('%s with %j admits=%s', async (command, rules, allowed) => {
+    const clamp = await prepareBashClamp(rules.map(rule => `Bash(${rule})`), signal)
+    expect(clamp!(command) === undefined).toBe(allowed)
+  })
+
+  it('does not share tracked shell variables between tool calls', async () => {
+    const clamp = (await prepareBashClamp(['Bash(**)'], signal))!
+    expect(clamp('A=hello; echo $A')).toBeUndefined()
+    expect(clamp('echo $A')).toMatch(/outside/)
+  })
+
+  it('rejects oversized commands before allocating a parse tree', async () => {
+    const clamp = (await prepareBashClamp(['Bash(echo:*)'], signal))!
+    expect(clamp('echo ' + 'a'.repeat(9_995))).toBeUndefined()
+    expect(clamp('echo ' + 'a'.repeat(9_996))).toMatch(/outside/)
+  })
+
+  it('prepares no parser for absent rules, and rejects invalid rules or cancellation', async () => {
+    expect(await prepareBashClamp(undefined, signal)).toBeUndefined()
+    expect(await prepareBashClamp([], signal)).toBeUndefined()
+    await expect(prepareBashClamp(['Read(*)'], signal)).rejects.toThrow(/invalid/)
+    await expect(prepareBashClamp(['Bash()'], signal)).rejects.toThrow(/invalid/)
+    await expect(prepareBashClamp(['Bash(*)'], signal)).rejects.toThrow(/invalid/)
+    await expect(prepareBashClamp(['Bash(**)'], AbortSignal.abort())).rejects.toThrow()
+  })
+})
