@@ -0,0 +1,110 @@
+/** Read declarative Claude configuration through the active filesystem; never execute plugin modules. */
+import { homedir } from 'node:os'
+import { join, posix } from 'node:path'
+import type FileSystem from '@deepseek-ai/dsh-fs'
+import { load, JSON_SCHEMA } from 'js-yaml'
+
+/** Resolve enabled plugin component paths through the execution-world filesystem.
+ * @param fs - Filesystem of the caller's execution world.
+ * @param component - Manifest component whose default and additional paths are returned.
+ * @param cwd - Project directory for scoped installs and settings overrides.
+ * @param signal - Cancels configuration reads.
+ * @returns Enabled component paths with their plugin namespace and root; no executable module is loaded.
+ */
+export async function claudePluginSources(fs: FileSystem, component: 'workflows' | 'agents' | 'skills', cwd: string | undefined, signal: AbortSignal): Promise<{ path: string; namespace: string; root: string }[]> {
+  const user = fs.processPathFromHostPath(join(homedir(), '.claude'))
+  if (!user) return []
+  const read = async (path: string): Promise<Record<string, unknown>> => {
+    const target = await fs.resolve(path, { ...cwd === undefined ? {} : { cwd }, signal })
+    if ((await fs.stat(target, signal))?.type !== 'file') return {}
+    const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 1_048_576)))
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`invalid plugin registry: ${path}`)
+    return value as Record<string, unknown>
+  }
+  const enabled = new Map<string, boolean>()
+  for (const path of [posix.join(user, 'settings.json'), '.claude/settings.json', '.claude/settings.local.json']) {
+    const settings = await read(path)
+    if (settings.enabledPlugins && typeof settings.enabledPlugins === 'object') {
+      for (const [name, value] of Object.entries(settings.enabledPlugins)) if (typeof value === 'boolean') enabled.set(name, value)
+    }
+  }
+  const registry = await read(posix.join(user, 'plugins', 'installed_plugins.json'))
+  if (!registry.plugins || typeof registry.plugins !== 'object') return []
+  const sources: { path: string; namespace: string; root: string }[] = []
+  for (const [id, records] of Object.entries(registry.plugins)) {
+    if (!enabled.get(id) || !Array.isArray(records)) continue
+    const candidates = records.filter((record: unknown): record is Record<string, unknown> => {
+      if (record === null || typeof record !== 'object') return false
+      const fields = record as Record<string, unknown>
+      return typeof fields.installPath === 'string' && (fields.scope !== 'project' && fields.scope !== 'local' || fields.projectPath === cwd)
+    })
+    candidates.sort((a, b) => Number(b.scope === 'local') - Number(a.scope === 'local') || Number(b.scope === 'project') - Number(a.scope === 'project'))
+    const entry = candidates[0]
+    if (!entry) continue
+    const root = await fs.resolve(String(entry.installPath), { signal })
+    const rootPath = fs.processPath(root)
+    const manifest = await read(posix.join(rootPath, '.claude-plugin', 'plugin.json'))
+    const namespace = typeof manifest.name === 'string' ? manifest.name : id.slice(0, id.includes('@') ? id.indexOf('@') : id.length)
+    const configured: unknown = manifest[component]
+    const custom: unknown[] = configured === undefined ? [] : Array.isArray(configured) ? configured : [configured]
+    for (const relative of [component, ...custom]) {
+      if (typeof relative !== 'string') throw new Error(`invalid plugin component path: ${id}`)
+      const target = await fs.resolve(posix.join(rootPath, relative), { signal })
+      if (!fs.contains(root, target)) throw new Error(`plugin component path leaves plugin root: ${id}`)
+      sources.push({ path: fs.processPath(target), namespace, root: rootPath })
+    }
+  }
+  return sources
+}
+
+/** Find project-ancestor and user component roots, in lookup order.
+ * @param fs - Execution-world filesystem and host-path mapper.
+ * @param component - Claude configuration directory name.
+ * @param cwd - Project directory from which ancestor lookup begins.
+ * @returns Unique component paths; the user path is omitted when not mapped into this world.
+ */
+export function claudeDirectories(fs: FileSystem, component: 'agents' | 'skills' | 'workflows', cwd?: string): string[] {
+  const directories: string[] = []
+  for (let directory = cwd; directory; directory = posix.dirname(directory)) {
+    directories.push(posix.join(directory, '.claude', component))
+    if (posix.dirname(directory) === directory) break
+  }
+  if (cwd === undefined) directories.push(`.claude/${component}`)
+  const user = fs.processPathFromHostPath(join(homedir(), '.claude', component))
+  if (user !== undefined) directories.push(user)
+  return [...new Set(directories)]
+}
+
+/** Parse bounded Markdown configuration without evaluating YAML tags or body content.
+ * @param source - UTF-8 Markdown text already bounded by the caller's read limit.
+ * @returns Frontmatter metadata and the trimmed instruction body.
+ */
+export function parseClaudeMarkdown(source: string): { metadata: Record<string, unknown>; content: string } {
+  const header = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/.exec(source.replace(/^\uFEFF/, ''))
+  const text = source.replace(/^\uFEFF/, '')
+  const frontmatter = header?.[1]
+  const parsed: unknown = frontmatter === undefined ? {} : load(frontmatter, { schema: JSON_SCHEMA })
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('Claude frontmatter must be an object')
+  return { metadata: parsed as Record<string, unknown>, content: text.slice(header?.[0].length ?? 0).trim() }
+}
+
+const toolAliases: Readonly<Record<string, string>> = Object.freeze({ Workflow: 'workflow', RunWorkflow: 'workflow', Read: 'read', Write: 'write', Edit: 'edit', Glob: 'glob', Grep: 'grep', Bash: 'bash', Skill: 'skill', Agent: 'subagent', Task: 'subagent', WebFetch: 'web_fetch', WebSearch: 'web_search', ListMcpResourcesTool: 'list_mcp_resources', ListMcpResources: 'list_mcp_resources', ReadMcpResourceTool: 'read_mcp_resource', ReadMcpResource: 'read_mcp_resource' })
+
+/** Translate a Claude tool selector into its Harness global name.
+ * @param name - Claude alias or a provider's existing tool name.
+ * @returns Harness name; unknown names pass through unchanged.
+ */
+export function harnessToolName(name: string): string {
+  return Object.hasOwn(toolAliases, name) ? toolAliases[name] ?? name : name
+}
+
+/** Translate a Harness tool name for Claude hook matching and payloads.
+ * @param name - Harness or external tool name.
+ * @returns Canonical Claude alias when known, otherwise the original name.
+ */
+export function claudeToolName(name: string): string {
+  return Object.entries(toolAliases).find(([, value]) => value === harnessToolName(name))?.[0] ?? name
+}
+
+export { parseClaudeToolSelector } from './tool-selector.ts'
+export { claudeReadAllowed } from './read-permission.ts'
