+/** Durable, session-scoped invocation journals; writes complete before the guest receives a result. */
+import { closeSync, existsSync, fsyncSync, mkdirSync, openSync, readFileSync, realpathSync, renameSync, writeFileSync, writeSync } from 'node:fs'
+import { basename, join } from 'node:path'
+import { randomUUID } from 'node:crypto'
+import { WorkflowError, WorkflowAttemptId } from '@deepseek-ai/dsh-workflow'
+import type { WorkflowMeta } from '@deepseek-ai/dsh-workflow'
+import type { JournalEntry } from './types.ts'
+import { digest } from './call-key.ts'
+import type { WorkflowMirrorData, WorkflowMirrorSnapshot } from './mirror.ts'
+
+const attemptPattern = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/
+
+function assertRunId(runId: string): void {
+  if (!/^(?:wf_[a-z0-9-]{6,}|[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})$/.test(runId)) throw new WorkflowError('invalid workflow resume run id', 'RESUME_UNAVAILABLE')
+}
+
+function missing(error: unknown): boolean {
+  return error instanceof Error && 'code' in error && error.code === 'ENOENT'
+}
+
+function contents(directory: string): string | undefined {
+  let current: string | undefined
+  try { current = readFileSync(join(directory, 'current.json'), 'utf8') }
+  catch (error) { if (!missing(error)) throw error }
+  let filename = 'journal.jsonl'
+  if (current !== undefined) {
+    const pointer: unknown = JSON.parse(current)
+    if (pointer === null || typeof pointer !== 'object' || !('attemptId' in pointer) || typeof pointer.attemptId !== 'string' || !attemptPattern.test(pointer.attemptId)) throw new Error('invalid journal attempt pointer')
+    filename = `${pointer.attemptId}.jsonl`
+  }
+  try { return readFileSync(join(directory, filename), 'utf8') }
+  catch (error) { if (!missing(error)) throw error; return undefined }
+}
+
+/** A new run's private script and append-only call results. */
+export class Journal {
+  /** Absolute path of the reusable script, including its literal meta header. */
+  readonly scriptPath: string
