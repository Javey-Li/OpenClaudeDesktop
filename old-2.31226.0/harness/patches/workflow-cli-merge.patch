+  expect(() => session.append('tool-workflow/agent-start', { ...started, seq: 2 })).toThrow()
+  session.append('tool-workflow/agent-admission', { ...queued, seq: 3 })
+  session.append('tool-workflow/run-end', { runId, stopReason: 'cancelled' })
+})
diff --git a/packages/workflow/tool-workflow/tests/read-policy.spec.ts b/packages/workflow/tool-workflow/tests/read-policy.spec.ts
new file mode 100644
index 0000000000..3bc7091e65
--- /dev/null
+++ b/packages/workflow/tool-workflow/tests/read-policy.spec.ts
@@ -0,0 +1,132 @@
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { mkdir, symlink, writeFile } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { claudeReadAllowed } from '@deepseek-ai/dsh-claude-code-config'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import WorkflowEngine from '@deepseek-ai/dsh-workflow'
+import { mountPtcRuntime, fakeParent } from '../../workflow-ptc/tests/setup.ts'
+import { resolveWorkflowSource } from '../src/source.ts'
+import { workflowScriptPath } from '../src/script-path.ts'
+import { workflowReadAdmission } from '../src/read-policy.ts'
+
+const signal = new AbortController().signal
+const source = 'export const meta={name:"saved",description:"Saved"}; return 1'
+
+async function setup() {
+  const ctx = new Context()
+  const { root, cwd } = await mountPtcRuntime(ctx)
+  const user = join(root, 'user')
+  await mkdir(user)
+  await mkdir(join(cwd, '.claude'))
+  const original = ctx.fs.processPathFromHostPath.bind(ctx.fs)
+  vi.spyOn(ctx.fs, 'processPathFromHostPath').mockImplementation(path => path === homedir() ? root : path === (process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude')) ? user : original(path))
+  const options = { cwd, signal, additionalDirectories: [], privateDirectories: [], bypassPermissions: false }
+  const settings = (permissions: object, scope = user) => writeFile(join(scope, 'settings.json'), JSON.stringify({ permissions }))
+  const allowed = (paths: string[], overrides = {}) => claudeReadAllowed(ctx.fs, paths, { ...options, ...overrides })
+  return { ctx, cwd, root, user, settings, allowed }
+}
+
+describe('Workflow Read admission', () => {
+  it('admits cwd, added, private and bypass directories without treating a sibling prefix as contained', async () => {
+    const { cwd, root, allowed } = await setup()
+    expect(await allowed([join(cwd, 'saved.js')])).toBe(true)
+    expect(await allowed([join(root, 'outside.js')])).toBe(false)
+    expect(await allowed([`${cwd}-other/saved.js`])).toBe(false)
+    expect(await allowed([join(root, 'outside.js')], { additionalDirectories: [root] })).toBe(true)
+    expect(await allowed([join(root, 'private/saved.js')], { privateDirectories: [join(root, 'private')] })).toBe(true)
+    expect(await allowed([join(root, 'outside.js')], { bypassPermissions: true })).toBe(true)
+  })
+  it.each(['ask', 'deny'])('applies %s to both symlink spellings before every grant', async (behavior) => {
+    const { cwd, root, settings, allowed } = await setup()
+    for (const rule of ['Read', 'Read(./alias.js)', 'Read(./saved.js)']) {
+      await settings({ [behavior]: [rule] })
+      expect(await allowed([join(cwd, 'alias.js'), join(cwd, 'saved.js')], {
+        bypassPermissions: true, privateDirectories: [root], additionalDirectories: [root],
+      })).toBe(false)
+    }
+  })
+  it('matches absolute and home rules, while bare and parent-relative allows do not grant outside reads', async () => {
+    const { root, allowed, settings } = await setup()
+    const file = join(root, 'saved.js')
+    for (const rule of ['Read', 'Read(../saved.js)']) {
+      await settings({ allow: [rule] })
+      expect(await allowed([file])).toBe(false)
+    }
+    for (const rule of [`Read(/${file})`, 'Read(~/saved.js)', `Edit(/${file})`]) {
+      await settings({ allow: [rule] })
+      expect(await allowed([file])).toBe(true)
+    }
+    await settings({ allow: [`Edit(/${file})`], deny: [`Edit(/${file})`] })
+    expect(await allowed([file])).toBe(false)
+  })
+  it('uses source-relative slash patterns and keeps negations inside their own settings source', async () => {
+    const { cwd, user, settings, allowed } = await setup()
+    await settings({ deny: ['Read(/secret/*)', 'Read(!/secret/public.js)'] }, join(cwd, '.claude'))
+    expect(await allowed([join(cwd, 'secret/private.js')])).toBe(false)
+    expect(await allowed([join(cwd, 'secret/public.js')])).toBe(true)
+    await settings({ deny: ['Read(/secret/public.js)'] }, join(cwd, '.claude'))
+    await settings({ deny: ['Read(!secret/public.js)'] }, user)
+    expect(await allowed([join(cwd, 'secret/public.js')])).toBe(false)
+  })
+  it('honors settings added directories and applies the outside-read fence before bypass and private grants', async () => {
+    const { root, allowed, settings } = await setup()
+    const file = join(root, 'saved.js')
+    await settings({ additionalDirectories: [root] })
+    expect(await allowed([file])).toBe(true)
+    await settings({ blockReadsOutsideWorkingDirectories: true })
+    expect(await allowed([file], { bypassPermissions: true, privateDirectories: [root] })).toBe(false)
+  })
+  it('does not treat Edit deny as Read deny, and requires an allow for every outside alias', async () => {
+    const { cwd, root, allowed, settings } = await setup()
+    await settings({ deny: ['Edit(./saved.js)'] })
+    expect(await allowed([join(cwd, 'saved.js')])).toBe(true)
+    const file = join(root, 'saved.js')
+    await settings({ allow: [`Read(/${file})`] })
+    expect(await allowed([join(root, 'alias.js'), file])).toBe(false)
+  })
+  it('checks resolved symlink targets before reading script bytes', async () => {
+    const { ctx, root, cwd, allowed } = await setup()
+    const outside = join(root, 'saved.js')
+    await writeFile(outside, source)
+    await symlink(outside, join(cwd, 'alias.js'))
+    const read = vi.spyOn(ctx.fs, 'readBytes')
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath: 'alias.js' }, { inputMode: 'claude-code', maxScriptBytes: 1024, workflowDirectories: [] }, signal, cwd,
+      async (paths) => { if (!await allowed([...paths])) throw new Error('not readable') })).rejects.toThrow('not readable')
+    expect(read.mock.calls.some(([target]) => ctx.fs.processPath(target) === outside)).toBe(false)
+  })
+  it('requires the owning Agent to see Read even when application policy grants bypass or private access', async () => {
+    const { ctx, root, cwd } = await setup()
+    class Engine extends WorkflowEngine {
+      start(): never { throw new Error('unused') }
+      override sourceDirectories(): readonly string[] { return [root] }
+    }
+    await ctx.plugin(Engine)
+    await ctx.plugin(SystemPrompt)
+    await ctx.plugin(ToolRuntime)
+    const parent = fakeParent(ctx)
+    const schemas = vi.spyOn(ctx.tools, 'schemas').mockReturnValue([])
+    ctx.on('tool-workflow/read-policy', async (_agent, next) => ({ ...await next(), bypassPermissions: true }))
+    const admit = workflowReadAdmission(ctx, parent, 'saved.js', signal)
+    await expect(admit([join(cwd, 'saved.js')])).rejects.toThrow('file you can already read')
+    schemas.mockReturnValue([{ name: 'Read', description: 'read', parameters: { type: 'object', properties: {} } }])
+    await expect(admit([join(root, 'saved.js')])).resolves.toBeUndefined()
+    expect(schemas).toHaveBeenCalledWith(parent)
+    ctx.on('tool-workflow/read-policy', async (_agent, next) => ({ ...await next(), readAvailable: false }))
+    await expect(admit([join(cwd, 'saved.js')])).rejects.toThrow('file you can already read')
+  })
+})
+
+describe('Workflow network paths', () => {
+  it.each(['//host/share/a.js', '\\\\host\\share\\a.js', '/??/C:/a.js', '\\??\\C:\\a.js', '/net/host/a.js', '/net/host/../../tmp/a.js', '/net', '/Network/Servers/host/a.js', '/NETWORK/../tmp/a.js', '/.vol/../tmp/a.js', '/.file/id', '/.nofollow/a', '/.resolve/a', '/n\u200det/host/a.js'])('refuses %s without invoking the filesystem', async (scriptPath) => {
+    const { ctx, cwd } = await setup()
+    const resolve = vi.spyOn(ctx.fs, 'resolve')
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath }, { inputMode: 'claude-code', maxScriptBytes: 1024, workflowDirectories: [] }, signal, cwd)).rejects.toThrow('Network (UNC, NT-namespace, or automount)')
+    expect(resolve).not.toHaveBeenCalled()
+  })
+  it.each(['/home/person/a.js', '/tmp/network/a.js', '/tmp/.vol/a.js', '/nettle/a.js', 'saved.js'])('retains ordinary path %s', (path) => {
+    expect(workflowScriptPath(path, '/work')).toBe(path.startsWith('/') ? path : '/work/saved.js')
+  })
+})
diff --git a/packages/workflow/tool-workflow/tests/source.spec.ts b/packages/workflow/tool-workflow/tests/source.spec.ts
new file mode 100644
index 0000000000..90dd544990
--- /dev/null
+++ b/packages/workflow/tool-workflow/tests/source.spec.ts
@@ -0,0 +1,147 @@
+import { chmod, link, mkdir, symlink, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { homedir } from 'node:os'
+import { Context } from '@deepseek-ai/cordis'
+import { FsError } from '@deepseek-ai/dsh-fs'
+import { describe, expect, it, vi } from 'vitest'
+import { mountPtcRuntime } from '../../workflow-ptc/tests/setup.ts'
+import { resolveWorkflowSource } from '../src/source.ts'
+
+const config = { maxScriptBytes: 1024, workflowDirectories: [] }
+const signal = new AbortController().signal
+const source = (name: string) => `export const meta = {name:'${name}',description:'Reusable workflow'}; return args`
+
+describe('workflow source resolution over the real filesystem', () => {
+  it('discovers enabled plugin workflows by their namespaced metadata and honors project disablement', async () => {
+    const ctx = new Context()
+    const { cwd, root } = await mountPtcRuntime(ctx)
+    const user = join(root, 'user-config'), plugin = join(root, 'plugin')
+    await mkdir(join(user, 'plugins'), { recursive: true })
+    await mkdir(join(plugin, '.claude-plugin'), { recursive: true })
+    await mkdir(join(plugin, 'flows'), { recursive: true })
+    await mkdir(join(cwd, '.claude'), { recursive: true })
+    await writeFile(join(user, 'settings.json'), JSON.stringify({ enabledPlugins: { 'review-kit@fixtures': true } }))
+    await writeFile(join(user, 'plugins/installed_plugins.json'), JSON.stringify({ version: 2, plugins: { 'review-kit@fixtures': [{ scope: 'user', installPath: plugin }] } }))
+    await writeFile(join(plugin, '.claude-plugin/plugin.json'), JSON.stringify({ name: 'review-kit', workflows: './flows/custom.js' }))
+    await writeFile(join(plugin, 'flows/custom.js'), source('audit'))
+    const home = join(homedir(), '.claude')
+    const mapping = vi.spyOn(ctx.fs, 'processPathFromHostPath').mockImplementation(path => path.startsWith(home) ? user + path.slice(home.length) : undefined)
+    try {
+      expect((await resolveWorkflowSource(ctx.fs, { name: 'review-kit:audit' }, config, signal, cwd)).meta?.name).toBe('audit')
+      await writeFile(join(cwd, '.claude/settings.json'), JSON.stringify({ enabledPlugins: { 'review-kit@fixtures': false } }))
+      await expect(resolveWorkflowSource(ctx.fs, { name: 'review-kit:audit' }, config, signal, cwd)).rejects.toThrow('not found')
+    } finally { mapping.mockRestore() }
+  })
+  it('uses explicit paths before inline source and resolves registry meta.name independently of filename', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/workflows'), { recursive: true })
+    await writeFile(join(cwd, '.claude/workflows/not-the-name.js'), source('registered-review'))
+    await writeFile(join(cwd, 'saved.js'), source('saved-review'))
+    const file = await resolveWorkflowSource(ctx.fs, { scriptPath: 'saved.js', script: 'invalid inline (', name: 'missing' }, config, signal, cwd)
+    expect(file.meta?.name).toBe('saved-review')
+    expect(file.scriptPath).toBe(join(cwd, 'saved.js'))
+    expect(file.script).toContain('return args')
+    expect((await resolveWorkflowSource(ctx.fs, { name: 'registered-review' }, config, signal, cwd)).meta?.name).toBe('registered-review')
+    await writeFile(join(cwd, '.claude/workflows/duplicate.js'), source('registered-review'))
+    await expect(resolveWorkflowSource(ctx.fs, { name: 'registered-review' }, config, signal, cwd)).rejects.toThrow('duplicate workflow name')
+  })
+  it('uses CLI source precedence, validates explicit code before launch and ignores empty selectors', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    const cli = { ...config, inputMode: 'claude-code' as const }
+    await mkdir(join(cwd, '.claude/workflows'), { recursive: true })
+    await writeFile(join(cwd, '.claude/workflows/registered.js'), source('registered'))
+    await writeFile(join(cwd, 'saved.js'), source('saved'))
+    const resolve = (input: Parameters<typeof resolveWorkflowSource>[1]) => resolveWorkflowSource(ctx.fs, input, cli, signal, cwd)
+    expect((await resolve({ scriptPath: 'saved.js', name: 'missing', script: source('inline') })).meta?.name).toBe('saved')
+    expect((await resolve({ name: 'registered', script: source('inline') })).meta?.name).toBe('registered')
+    expect((await resolve({ scriptPath: '', name: '', script: source('inline') })).meta?.name).toBe('inline')
+    await expect(resolve({ name: 'missing', script: source('inline') })).rejects.toThrow('not found')
+    await expect(resolve({ scriptPath: 'missing.js', script: source('inline') })).rejects.toThrow()
+    await expect(resolve({ scriptPath: 'saved.js', script: 'invalid (' })).rejects.toThrow()
+    await expect(resolve({ name: 'registered', script: '' })).rejects.toThrow('FIRST statement')
+    await expect(resolve({ name: 'registered', script: 'invalid (' })).rejects.toThrow()
+    await writeFile(join(cwd, '.claude/workflows/ignored.mjs'), source('ignored'))
+    await expect(resolve({ name: 'ignored' })).rejects.toThrow('not found')
+    await writeFile(join(cwd, '.claude/workflows/z-override.js'), source('registered').replace('return args', 'return "override"'))
+    expect((await resolve({ name: 'registered' })).script).toContain('return "override"')
+  })
+  it('requires a single-link descriptor for CLI scriptPath while allowing resolved symbolic links', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    await writeFile(join(cwd, 'source.js'), source('verified'))
+    await symlink(join(cwd, 'source.js'), join(cwd, 'symbolic.js'))
+    const cli = { ...config, inputMode: 'claude-code' as const }
+    expect((await resolveWorkflowSource(ctx.fs, { scriptPath: 'symbolic.js' }, cli, signal, cwd)).meta?.name).toBe('verified')
+    await link(join(cwd, 'source.js'), join(cwd, 'hard.js'))
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath: 'hard.js' }, cli, signal, cwd)).rejects.toMatchObject({ code: 'FS_PERMISSION_DENIED' })
+    expect((await resolveWorkflowSource(ctx.fs, { scriptPath: 'hard.js' }, config, signal, cwd)).meta?.name).toBe('verified')
+  })
+
+  it('rejects missing, oversized and aborted sources before execution', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    await expect(resolveWorkflowSource(ctx.fs, {}, config, signal, cwd)).rejects.toThrow('requires script')
+    await expect(resolveWorkflowSource(ctx.fs, { script: ' '.repeat(1025) }, config, signal, cwd)).rejects.toThrow('maxScriptBytes')
+    await writeFile(join(cwd, 'large.js'), ' '.repeat(1025))
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath: 'large.js' }, config, signal, cwd)).rejects.toThrow()
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath: 'missing.js' }, config, signal, cwd)).rejects.toThrow()
+    await expect(resolveWorkflowSource(ctx.fs, { script: 'return 1' }, config, AbortSignal.abort(new Error('cancelled')), cwd)).rejects.toThrow('cancelled')
+  })
+  it('decodes CLI disk bytes nonfatally without applying the byte limit again after replacement', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    const prefix = Buffer.from('export const meta={name:"bytes",description:"Bytes"}; return "')
+    const bytes = Buffer.concat([prefix, Buffer.alloc(900, 255), Buffer.from('"')])
+    await writeFile(join(cwd, 'bytes.js'), bytes)
+    const parsed = await resolveWorkflowSource(ctx.fs, { scriptPath: 'bytes.js' }, { ...config, inputMode: 'claude-code' }, signal, cwd)
+    expect(parsed.script).toContain('\ufffd'.repeat(900))
+    expect(Buffer.byteLength(parsed.script)).toBeGreaterThan(config.maxScriptBytes)
+    await expect(resolveWorkflowSource(ctx.fs, { scriptPath: 'bytes.js' }, config, signal, cwd)).rejects.toThrow()
+  })
+  it('skips oversized and unreadable CLI registry entries while following readable symlinks', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    const directory = join(cwd, '.claude/workflows')
+    await mkdir(directory, { recursive: true })
+    await writeFile(join(directory, 'a-large.js'), ' '.repeat(1025))
+    const unreadable = join(directory, 'b-unreadable.js')
+    await writeFile(unreadable, source('unreadable'))
+    await chmod(unreadable, 0)
+    await writeFile(join(cwd, 'target.js'), source('linked-registry'))
+    await symlink(join(cwd, 'target.js'), join(directory, 'c-linked.js'))
+    try {
+      expect((await resolveWorkflowSource(ctx.fs, { name: 'linked-registry' }, { ...config, inputMode: 'claude-code' }, signal, cwd)).meta?.name).toBe('linked-registry')
+      await expect(resolveWorkflowSource(ctx.fs, { name: 'linked-registry' }, config, signal, cwd)).rejects.toMatchObject({ code: 'FS_TOO_LARGE' })
+    } finally { await chmod(unreadable, 0o600) }
+  })
+  it('keeps earlier valid definitions when a higher-priority body is invalid and diagnoses a sole broken body', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    const low = join(cwd, 'low'), high = join(cwd, 'high')
+    await mkdir(low); await mkdir(high)
+    await writeFile(join(low, 'valid.js'), source('fallback').replace('return args', 'return "earlier"'))
+    await writeFile(join(high, 'invalid.js'), source('fallback').replace('return args', 'const = ;'))
+    await writeFile(join(high, 'sole.js'), source('sole-broken').replace('return args', 'const = ;'))
+    const cli = { ...config, workflowDirectories: [high, low], inputMode: 'claude-code' as const }
+    expect((await resolveWorkflowSource(ctx.fs, { name: 'fallback' }, cli, signal, cwd)).script).toContain('return "earlier"')
+    await expect(resolveWorkflowSource(ctx.fs, { name: 'sole-broken' }, cli, signal, cwd)).rejects.toThrow(SyntaxError)
+  })
+  it('does not swallow cancellation as an unreadable directory or registry entry', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    const directory = join(cwd, '.claude/workflows')
+    await mkdir(directory, { recursive: true })
+    await writeFile(join(directory, 'valid.js'), source('cancelled-registry'))
+    const cli = { ...config, inputMode: 'claude-code' as const }
+    const reader = vi.spyOn(ctx.fs, 'readBytes').mockRejectedValue(new FsError('read cancelled', 'FS_ABORTED'))
+    await expect(resolveWorkflowSource(ctx.fs, { name: 'cancelled-registry' }, cli, signal, cwd)).rejects.toMatchObject({ code: 'FS_ABORTED' })
+    reader.mockRestore()
+    const controller = new AbortController()
+    const listing = vi.spyOn(ctx.fs, 'listDir').mockImplementation(async () => { controller.abort(new Error('directory cancelled')); throw new Error('I/O failed') })
+    try {
+      await expect(resolveWorkflowSource(ctx.fs, { name: 'cancelled-registry' }, cli, controller.signal, cwd)).rejects.toThrow('directory cancelled')
+    } finally { listing.mockRestore() }
+  })
+})
