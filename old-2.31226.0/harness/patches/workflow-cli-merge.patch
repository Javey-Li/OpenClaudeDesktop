+/** Mount Claude agent MCP declarations in the unpublished child's effect scope. */
+import type { Context } from '@deepseek-ai/cordis'
+import { activateMcpClient, Config as McpConfig, getMcpServerContext, inheritMcpServer } from '@deepseek-ai/dsh-mcp-client'
+import type { Config } from '@deepseek-ai/dsh-mcp-client'
+import type { McpResourceToolName } from '@deepseek-ai/dsh-mcp-resources'
+import type {} from '@deepseek-ai/dsh-fs'
+import { expandAgentMcpConfig, readAgentMcpConfigs } from './agent-mcp-config.ts'
+
+/** A borrowed server namespace or a validated connection owned by this child. */
+export interface AgentMcpServer {
+  name: string
+  config?: Config
+  source?: Context
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+/** Resolve mounted names or disk declarations and validate inline transports without starting a process.
+ * @param ctx - Parent context with the inherited tool and filesystem services.
+ * @param entries - Trust-filtered local-agent frontmatter entries.
+ * @param cwd - Original project directory for disk discovery and approval.
+ * @param signal - Cancels discovery before child publication.
+ * @param executionCwd - Child directory used by new stdio connections, including an isolated worktree.
+ * @returns Valid declarations in input order; invalid, unavailable and unsupported entries warn and skip.
+ */
+export async function resolveAgentMcpServers(
+  ctx: Context,
+  entries: readonly unknown[],
+  cwd: string,
+  signal: AbortSignal,
+  executionCwd = cwd,
+): Promise<AgentMcpServer[]> {
+  signal.throwIfAborted()
+  const result: AgentMcpServer[] = []
+  const seen = new Set<string>()
+  let lookup: Awaited<ReturnType<typeof readAgentMcpConfigs>> | undefined
+  const connection = (name: string, value: unknown, fromDisk: boolean): Config | undefined => {
+    if (ctx.get('fs')?.processPathFromHostPath(executionCwd) !== executionCwd) {
+      ctx.logger.warn(`Agent MCP server '${name}' requires a local execution world`)
+      return
+    }
+    if (!record(value)) { ctx.logger.warn(`Agent MCP server '${name}' must contain a connection object`); return }
+    if (value.headersHelper !== undefined || value.oauth !== undefined) {
+      ctx.logger.warn(`Agent MCP server '${name}' requires authentication options that this client does not support`)
+      return
+    }
+    const raw = fromDisk ? expandAgentMcpConfig(ctx, name, value) : value
+    try {
+      const common = {
+        serverName: name, failOnStartupError: true, reconnect: { enabled: false },
+        ...raw.timeout === undefined ? {} : { toolCallTimeoutMs: raw.timeout },
+      }
+      let config: Config
+      if (raw.type === undefined || raw.type === 'stdio') {
+        config = McpConfig({ ...common, transport: 'stdio', command: raw.command, args: raw.args, env: raw.env, cwd: executionCwd } as Parameters<typeof McpConfig>[0])
+      } else if (raw.type === 'http' || raw.type === 'streamable-http') {
+        if (typeof raw.url !== 'string' || !['http:', 'https:'].includes(new URL(raw.url).protocol)) throw new Error('invalid HTTP endpoint')
+        config = McpConfig({ ...common, transport: 'streamable-http', url: raw.url, headers: raw.headers } as Parameters<typeof McpConfig>[0])
+      } else throw new Error('unsupported transport')
+      if (!Number.isFinite(config.toolCallTimeoutMs) || config.toolCallTimeoutMs <= 0) throw new Error('invalid timeout')
+      return config
+    } catch (_error: unknown) {
+      // Config errors may quote credentials; only the server identity enters diagnostics.
+      ctx.logger.warn(`Agent MCP server '${name}' has an invalid or unsupported connection configuration`)
+      return
+    }
+  }
+  for (const entry of entries) {
+    signal.throwIfAborted()
+    const pair = typeof entry === 'string' ? [entry, undefined] as const : record(entry) && Object.keys(entry).length === 1 ? Object.entries(entry)[0] : undefined
+    if (!pair) { ctx.logger.warn('Agent MCP declaration must be a server name or a one-key server configuration'); continue }
+    const [name, raw] = pair
+    if (seen.has(name)) continue
+    if (!/^[A-Za-z0-9_-]{1,32}$/.test(name) || ['webagent', 'claude-code-remote', 'hearthbot'].includes(name)) {
+      ctx.logger.warn(`Agent MCP server '${name}' has an unsupported or reserved namespace`)
+      continue
+    }
+    if (typeof entry === 'string' && getMcpServerContext(ctx, name)) {
+      result.push({ name, source: ctx })
+      seen.add(name)
+      continue
+    }
+    let config: Config | undefined
+    if (typeof entry === 'string') {
+      lookup ??= await readAgentMcpConfigs(ctx, cwd, signal)
+      for (const candidate of lookup(name)) {
+        config = connection(name, candidate, true)
+        if (config) break
+      }
+      if (!config) ctx.logger.warn(`Agent MCP server '${name}' has no available mounted or approved disk configuration`)
+    } else config = connection(name, raw, false)
+    if (config) { result.push({ name, config }); seen.add(name) }
+  }
+  signal.throwIfAborted()
+  return result
+}
+
+/** Await child-owned clients before the first request; borrowed namespaces retain their existing owner.
+ * @param ctx - Unpublished child's effect scope.
+ * @param servers - Resolved declarations, including borrowed namespaces without config.
+ * @param acceptTool - Monotonic caller/definition admission applied on every discovery.
+ * @param signal - Cancels startup; every newly created transport is drained before rejection.
+ * @param resourceTools - Ordinary tool selection for shared MCP resource operations.
+ * @returns Readiness after all initial connections settle; individual connection failures warn and skip.
+ */
+export async function installAgentMcpServers(
+  ctx: Context,
+  servers: readonly AgentMcpServer[],
+  acceptTool: (name: string) => boolean,
+  signal: AbortSignal,
+  resourceTools: readonly McpResourceToolName[],
+): Promise<void> {
+  const outcomes = await Promise.allSettled(servers.map(async (server) => {
+    const config = server.config
+    if (!config) {
+      if (server.source) inheritMcpServer(ctx, server.source, server.name, acceptTool, resourceTools)
+      return
+    }
+    signal.throwIfAborted()
+    const startup = AbortSignal.any([signal, AbortSignal.timeout(10_000)])
+    const fiber = ctx.plugin({ name: `agent-mcp-${server.name}`, apply: async (inner: Context) => {
+      await activateMcpClient(inner, config, { signal: startup, acceptTool, resourceTools })
+    } })
+    try { await fiber }
+    catch (_error: unknown) {
+      await fiber.dispose()
+      signal.throwIfAborted()
+      ctx.logger.warn(`Agent MCP server '${server.name}' failed to connect; continuing without its tools`)
+    }
+  }))
+  const failure = outcomes.find(outcome => outcome.status === 'rejected')
+  if (failure?.status === 'rejected') throw failure.reason
+  signal.throwIfAborted()
+}
diff --git a/packages/subagent/subagent-spawn-in-process/src/agent-metadata.ts b/packages/subagent/subagent-spawn-in-process/src/agent-metadata.ts
