+/** Schema checks for command-hook replacement input. */
+import { describe, expect, it } from 'vitest'
+import { rewrittenInputError } from '../src/input.ts'
+
+describe('hook replacement input', () => {
+  const schema = { type: 'object', properties: { command: { type: 'string', minLength: 1 } }, required: ['command'], additionalProperties: false }
+  it('accepts extra keys without mutating them or coercing values', () => {
+    const value = { command: 'echo x', extra: 1 }
+    expect(rewrittenInputError(schema, value)).toBeUndefined()
+    expect(value).toEqual({ command: 'echo x', extra: 1 })
+    expect(rewrittenInputError(schema, { command: 1 })).toContain('string')
+    expect(rewrittenInputError(schema, {})).toContain('required')
+    expect(rewrittenInputError(schema, { command: '' })).toContain('fewer')
+  })
+  it.each(['https://json-schema.org/draft/2020-12/schema', 'https://json-schema.org/draft/2019-09/schema'])('validates local references under %s', (dialect) => {
+    const ref = { $schema: dialect, $defs: { arg: { type: 'integer', minimum: 2 } }, $ref: '#/$defs/arg' }
+    expect(rewrittenInputError(ref, 2)).toBeUndefined()
+    expect(rewrittenInputError(ref, 1)).toContain('>= 2')
+  })
+  it('rejects unavailable remote schemas and isolates reused schema identifiers', () => {
+    expect(rewrittenInputError({ $ref: 'https://invalid.example/schema' }, {})).toContain('cannot validate')
+    expect(rewrittenInputError({ $id: 'same', type: 'string' }, 'x')).toBeUndefined()
+    expect(rewrittenInputError({ $id: 'same', type: 'integer' }, 'x')).toContain('integer')
+  })
+})
