+/** Read only the descriptor whose single-link identity was checked against the canonical target. */
+async function readVerifiedBytes(
+  target: LocalTarget, signal: AbortSignal | undefined, maxBytes: number, internals: FsIoInternals,
+): Promise<Uint8Array> {
+  throwIfAborted(signal, 'read')
+  const flags = constants.O_RDONLY | (process.platform === 'win32' ? 0 : constants.O_NONBLOCK)
+  const denied = () => new FsError(`cannot read "${target.displayPath}": file must have a nonzero identity and exactly one hard link`, 'FS_PERMISSION_DENIED')
+  const changed = () => new FsError(`cannot read "${target.displayPath}": canonical file identity changed`, 'FS_STALE_VERSION')
+  try {
+    const handle = await open(target.targetKey, flags)
+    try {
+      const info = await handle.stat({ bigint: true })
+      if (info.ino === 0n || info.nlink !== 1n) throw denied()
+      if (!info.isFile()) throw new FsError(`cannot read "${target.displayPath}": not a regular file`, 'FS_NOT_REGULAR_FILE')
+      if (info.size > BigInt(maxBytes)) throw new FsError(`cannot read "${target.displayPath}": ${info.size} bytes exceeds the ${maxBytes}-byte limit`, 'FS_TOO_LARGE')
+      await internals.inspectReadBytesAfterStat?.(target)
+      throwIfAborted(signal, 'read')
+      if (await realpath(target.targetKey) !== target.targetKey) throw changed()
+      const check = await open(target.targetKey, flags | (process.platform === 'win32' ? 0 : constants.O_NOFOLLOW))
+      try {
+        const current = await check.stat({ bigint: true })
+        if (current.dev !== info.dev || current.ino !== info.ino) throw changed()
+        if (current.nlink !== 1n) throw denied()
+      } finally { await check.close() }
+      if (await realpath(target.targetKey) !== target.targetKey) throw changed()
+      if ((await handle.stat({ bigint: true })).nlink !== 1n) throw denied()
+      await internals.inspectReadBytesBeforeContent?.(target)
+      const chunks: Buffer[] = []
+      let total = 0
+      while (total <= maxBytes) {
+        throwIfAborted(signal, 'read')
+        const buffer = Buffer.allocUnsafe(Math.min(maxBytes + 1 - total, DIFF_BASIS_READ_CHUNK_BYTES))
+        const { bytesRead } = await handle.read(buffer, 0, buffer.length, total)
+        if (bytesRead === 0) break
+        total += bytesRead
+        if (total > maxBytes) throw new FsError(`cannot read "${target.displayPath}": content exceeds the ${maxBytes}-byte limit`, 'FS_TOO_LARGE')
+        chunks.push(buffer.subarray(0, bytesRead))
