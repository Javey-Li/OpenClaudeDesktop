@@ -0,0 +1,82 @@
+/** Load agent-declared skills as logged child-only instructions before the first request. */
+import { posix } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { renderSkillContent, type SkillDefinition } from '@deepseek-ai/dsh-skill'
+import { claudeDirectories, claudePluginSources, parseClaudeMarkdown } from '@deepseek-ai/dsh-claude-code-config'
+
+declare module '@deepseek-ai/dsh-llm' {
+  interface MessageSourceMap {
+    /** Attribution only; replay preserves the recorded body without the producer.
+     * @persistenceAttribution
+     */
+    'subagent-skill-preload': { kind: 'subagent-skill-preload'; form: 'instructions'; name: string }
+  }
+}
+
+/** Resolve registry, Claude project/user, and enabled plugin skills for one child.
+ * @param ctx - Unpublished child's registration context.
+ * @param child - Agent receiving durable instruction messages.
+ * @param names - Skills declared by the selected agent definition.
+ * @param agentType - Selected agent name, including its optional plugin namespace.
+ * @param cwd - Definition lookup directory, retained when the child uses a worktree.
+ * @param signal - Cancels loading before child publication.
+ */
+export async function preloadAgentSkills(
+  ctx: Context,
+  child: Agent,
+  names: readonly string[],
+  agentType: string,
+  cwd: string,
+  signal: AbortSignal,
+): Promise<void> {
+  const fs = ctx.get('fs')
+  if (!fs) throw new Error('agent skill preloading requires the fs service')
+  const registry = ctx.get('skills')
+  const plugins = await claudePluginSources(fs, 'skills', cwd, signal)
+  const sources = [...claudeDirectories(fs, 'skills', cwd).map(path => ({ path, namespace: '', root: '' })), ...plugins]
+  const loaded = new Set<string>()
+  for (const name of names) {
+    signal.throwIfAborted()
+    let skill = await registry?.get(name, { cwd, signal, scope: child })
+    if (!skill) {
+      const candidates: SkillDefinition[] = []
+      for (const source of sources) {
+        const root = await fs.resolve(source.path, { cwd, signal })
+        const stat = await fs.stat(root, signal)
+        if (!stat) continue
+        const entries = stat.type === 'directory' ? await fs.listDir(root, signal) : [{ name: posix.basename(source.path), type: stat.type, target: root }]
+        for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
+          const path = entry.type === 'directory' ? posix.join(source.path, entry.name, 'SKILL.md') : fs.processPath(entry.target)
+          if (!path.endsWith('.md')) continue
+          const target = await fs.resolve(path, { cwd, signal })
+          if ((await fs.stat(target, signal))?.type !== 'file') continue
+          try {
+            const { metadata, content } = parseClaudeMarkdown(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 1_048_576)))
+            const fallback = posix.basename(path) === 'SKILL.md' ? posix.basename(posix.dirname(path)) : posix.basename(path, '.md')
+            const localName = typeof metadata.name === 'string' && metadata.name ? metadata.name : fallback
+            const fullName = source.namespace ? `${source.namespace}:${localName}` : localName
+            if (fullName !== name && !fullName.endsWith(`:${name}`)) continue
+            candidates.push({ name: fullName, description: typeof metadata.description === 'string' ? metadata.description : '', content: source.root ? content.replaceAll('${CLAUDE_PLUGIN_ROOT}', source.root) : content, metadata, provider: 'claude-code', source: source.namespace ? 'plugin' : 'claude', invocation: { modelInvocable: metadata['disable-model-invocation'] !== true, userInvocable: metadata['user-invocable'] !== false }, resourceBase: { kind: 'directory', path: posix.dirname(fs.processPath(target)) } })
+          } catch (error: unknown) {
+            signal.throwIfAborted()
+            ctx.logger.warn(`Could not load agent skill ${path}: ${String(error)}`)
+          }
+        }
+      }
+      const namespace = agentType.includes(':') ? agentType.split(':')[0] : undefined
+      skill = candidates.find(candidate => candidate.name === name)
+        ?? (namespace ? candidates.find(candidate => candidate.name === `${namespace}:${name}`) : undefined)
+        ?? candidates[0]
+    }
+    signal.throwIfAborted()
+    if (!skill || !skill.invocation.modelInvocable) {
+      ctx.logger.warn(`Agent ${agentType}: skill '${name}' was not found or is disabled`)
+      continue
+    }
+    if (loaded.has(skill.name)) continue
+    loaded.add(skill.name)
+    child.inject(createUserMessage({ content: [{ type: 'text', text: renderSkillContent(skill) }], source: { kind: 'subagent-skill-preload', form: 'instructions', name: skill.name } }))
+  }
+}
