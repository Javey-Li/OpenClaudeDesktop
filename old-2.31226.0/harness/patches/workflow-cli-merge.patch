+import { afterEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import LlmRuntime, { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { StreamChunk } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { adapter, chunks, MODEL, options, server, sse } from './helpers.ts'
+import { translateComplete } from '../src/translate.ts'
+
+const cleanups: (() => Promise<void>)[] = []
+afterEach(async () => { for (const close of cleanups.splice(0).reverse()) await close() })
+const content = [
+  { type: 'thinking', thinking: 'reasoning', signature: 'opaque-signature' },
+  { type: 'tool_use', id: 'final-call', name: 'capture', input: { answer: 'fresh' } },
+]
+const complete = () => ({
+  type: 'message', role: 'assistant', content, stop_reason: 'tool_use',
+  usage: { input_tokens: 12, output_tokens: 4, cache_read_input_tokens: 8 },
+})
+const partial = [
+  { type: 'message_start', message: { usage: { input_tokens: 12, output_tokens: 0 } } },
+  { type: 'content_block_start', index: 0, content_block: { type: 'tool_use', id: 'partial-call', name: 'capture', input: {} } },
+  { type: 'content_block_delta', index: 0, delta: { type: 'input_json_delta', partial_json: '{"answer":"discarded' } },
+]
+const fullStream = () => [
+  { type: 'message_start', message: { usage: complete().usage } },
+  ...content.flatMap((block, index) => [
+    { type: 'content_block_start', index, content_block: block }, { type: 'content_block_stop', index },
+  ]),
+  { type: 'message_delta', delta: { stop_reason: 'tool_use' } }, { type: 'message_stop' },
+]
+
+async function harness(reply: Parameters<typeof server>[0]) {
+  const http = await server(reply)
+  cleanups.push(() => http.close())
+  const ctx = new Context()
+  cleanups.push(async () => { await ctx.fiber.dispose() })
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['deepseek-official'], adapter({ baseURL: http.url }))
+  const agent = await ctx.agentLoop.create(SessionId('fallback'), { provider: 'deepseek-official', model: MODEL, streamToolCalls: true })
+  const captured: unknown[] = []
+  ctx.tools.register(defineContentToolFixture({
+    name: 'capture', description: 'capture', parameters: { answer: { type: 'string' } },
+    async execute(args, exec) { captured.push(args); exec.concludeTurn(); return [] },
+  }))
+  const run = async () => {
+    agent.followup(createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'capture a value' }] }))
+    await agent.whenIdle()
+  }
+  return { http, ctx, agent, captured, run }
+}
+
+it.each([1, 2, 5])('uses complete JSON after the provider stream retry budget (partial limit %s)', async (limit) => {
+  const { http, agent, captured, run } = await harness((response, count) => {
+    if (count === 3) { response.setHeader('content-type', 'application/json'); response.end(JSON.stringify(complete())) }
+    else response.end(sse(count <= limit ? partial : fullStream()))
+  })
+  await run()
+  expect(http.requests.map(request => request.body.stream)).toEqual(limit === 1 ? [true, true] : [true, true, false])
+  expect(captured).toEqual([{ answer: 'fresh' }])
+  const events = agent.session.snapshotEvents()
+  const starts = events.filter(event => event.type === 'assistant/stream-start')
+  expect(starts.map(event => event.data.transport ?? 'streaming')).toEqual(limit === 1
+    ? ['streaming', 'streaming'] : ['streaming', 'streaming', 'non-streaming'])
+  expect(events.filter(event => event.type === 'tool/call')).toHaveLength(1)
+  expect(events.findLast(event => event.type === 'turn/end')?.data.reason).toEqual({ kind: 'completed' })
+  expect(agent.session.deriveMessages().find(message => message.role === 'assistant')?.source).toMatchObject({
+    replayState: { blocks: [{ type: 'reasoning', signature: 'opaque-signature' }, { type: 'tool-call' }] },
+  })
+  if (limit > 1) expect(http.requests[2]?.headers.accept).toBe('application/json')
+})
+
+it('does not retry or execute earlier valid blocks when the complete fallback is malformed', async () => {
+  const { http, ctx, agent, captured, run } = await harness((response, count) => {
+    response.end(count < 3 ? sse(partial) : JSON.stringify({ ...complete(), content: [...content, { type: 'unknown' }] }))
+  })
+  let retries = 0
+  ctx.on('agent/request-error', async () => { retries++; return { kind: 'retry' } })
+  await run()
+  expect(http.requests.map(request => request.body.stream)).toEqual([true, true, false])
+  expect(captured).toEqual([])
+  expect(retries).toBe(0)
+  expect(agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data.reason).toMatchObject({
+    kind: 'error', error: { code: 'UNSUPPORTED_CONTENT' },
+  })
+})
+
+it('a completed capture followed by EOF remains terminal even when the provider supports fallback', async () => {
+  const { http, ctx, agent, captured, run } = await harness(response => response.end(sse(fullStream().slice(0, -2))))
+  let retries = 0
+  ctx.on('agent/request-error', async () => { retries++; return { kind: 'retry' } })
+  await run()
+  expect(http.requests).toHaveLength(1)
+  expect(captured).toEqual([{ answer: 'fresh' }])
+  expect(retries).toBe(0)
+  expect(agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data.reason).toMatchObject({
+    kind: 'error', error: { code: 'STREAM_CLOSED' },
+  })
+})
+
+it('the prepared ordinary and fallback transports share one dispatch slot and middleware', async () => {
+  const { ctx, http } = await harness(response => response.end(JSON.stringify(complete())))
+  let middleware = 0
+  ctx.on('llm/stream', async function* (_request, next) { middleware++; yield* next() })
+  const prepared = await ctx.llm.prepareCall({ provider: 'deepseek-official', model: MODEL })
+  const request = options(prepared.config)
+  const fallback = prepared.nonStreamingFallback
+  expect(fallback?.streamRetries).toBe(1)
+  if (!fallback) throw new Error('missing fallback')
+  const result = await chunks(fallback.stream(request))
+  expect(result.at(-1)?.type).toBe('finish')
+  expect(() => prepared.stream(request)).toThrow('only be dispatched once')
+  expect(() => fallback.stream(request)).toThrow('only be dispatched once')
+  expect(http.requests).toHaveLength(1)
+  expect(middleware).toBe(1)
+})
+
+it('validates the whole JSON envelope and usage before yielding a complete response', async () => {
+  const output: StreamChunk[] = []
+  await expect((async () => {
+    for await (const chunk of translateComplete({ ...complete(), usage: { input_tokens: -1 } }, MODEL)) output.push(chunk)
+  })()).rejects.toMatchObject({ code: 'MALFORMED_RESPONSE' })
+  expect(output).toEqual([])
+  const valid = await chunks(translateComplete(complete(), MODEL))
+  expect(valid.at(-2)).toEqual({ type: 'usage', usage: { inputTokens: 12, outputTokens: 4, cacheReadTokens: 8, totalTokens: 24 } })
+})
