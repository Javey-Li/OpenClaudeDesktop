+ * @module @deepseek-ai/dsh-hooks-claude-code/http
+ */
+import Ajv from 'ajv'
+import type { Context } from '@deepseek-ai/cordis'
+import { deadline } from '@deepseek-ai/dsh-timeout'
+import { parseHookOutput } from '@deepseek-ai/dsh-hook-protocol'
+import type { HookOutput, RunHookResult } from '@deepseek-ai/dsh-hook-protocol'
+import { expandHttpHookHeader } from './http-env.ts'
+import { matchesHttpHookUrl } from './http-url.ts'
+import { postHttpHook } from './http-network.ts'
+import type { HttpHook, HttpHookPolicy } from './http-types.ts'
+
+const hostPolicies = new WeakMap<Context, Set<HttpHookPolicy>>()
+
+/** Mount host restrictions for every HTTP handler under the same runtime root.
+ * @param ctx - Owning plugin scope; disposal removes its restriction.
+ * @param policy - Optional host URL and environment allowlists.
+ */
