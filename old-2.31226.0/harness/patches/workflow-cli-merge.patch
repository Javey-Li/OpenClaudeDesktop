@@ -0,0 +1,169 @@
+/** Complete Claude Workflow output files, independent of transcript rendering limits. */
+
+/** Native phase record; reserved child groups retain their index before announcement. */
+export interface OutputPhase {
+  type: 'workflow_phase'
+  index: number
+  title: string
+  kind?: 'child'
+}
+
+/** One execution's phase identity, shared by root and child scripts. */
+export class WorkflowPhases {
+  private readonly phases = new Map<string, OutputPhase>()
+  private readonly announced = new Set<number>()
+
+  /** Reserve an index without displaying the phase.
+   * @param title - Normalized phase title, including an empty title.
+   * @param kind - Kind on the first reservation; later calls preserve it.
+   * @returns Stable one-based phase record.
+   */
+  reserve(title: string, kind?: 'child'): OutputPhase {
+    let phase = this.phases.get(title)
+    if (!phase) {
+      phase = { type: 'workflow_phase', index: this.phases.size + 1, title, ...kind ? { kind } : {} }
+      this.phases.set(title, phase)
+    }
+    return phase
+  }
+
+  /** Announce a reserved phase once, before its first agent enters the queue.
+   * @param title - Normalized phase title.
+   * @param emit - Receives the first announcement only.
+   * @returns Stable one-based index.
+   */
+  announce(title: string, emit: (phase: OutputPhase) => void): number {
+    const phase = this.reserve(title)
+    if (!this.announced.has(phase.index)) {
+      this.announced.add(phase.index)
+      emit(phase)
+    }
+    return phase.index
+  }
+}
+
+/** Observed agent fields; providers leave unavailable measurements absent. */
+export interface OutputAgent {
+  label?: string
+  phaseIndex?: number
+  phaseTitle?: string
+  agentId?: string
+  agentType?: string
+  isolation?: string
+  model?: string | undefined
+  state?: 'start' | 'done' | 'error' | 'skipped'
+  startedAt?: number
+  queuedAt?: number
+  attempt?: number
+  cached?: boolean
+  lastToolName?: string
+  lastToolSummary?: string
+  promptPreview?: string | undefined
+  promptFramed?: boolean
+  lastProgressAt?: number
+  tokens?: number
+  toolCalls?: number
+  durationMs?: number
+  resultPreview?: string | undefined
+  error?: string
+}
+
+/** Normalize explicit labels, or truncate the prompt to 60 UTF-16 units before collapsing whitespace.
+ * @param prompt - Agent prompt before task framing.
+ * @param label - Explicit display label; nullish values use the prompt.
+ * @returns Display label without an ellipsis or split surrogate pair.
+ */
+export function workflowLabel(prompt: string, label?: unknown): string {
+  const end = prompt.charCodeAt(59) >= 0xD800 && prompt.charCodeAt(59) <= 0xDBFF ? 59 : 60
+  // oxlint-disable-next-line typescript/no-base-to-string -- Native explicit labels use String, including plain objects.
+  return (label == null ? prompt.slice(0, end) : String(label)).replace(/\s+/g, ' ').trim()
+}
+
+/** Trim diagnostic previews to 400 UTF-16 units without splitting a surrogate pair.
+ * @param value - A JSON-compatible result or prompt.
+ * @returns Nonempty preview, absent for nullish or blank values.
+ */
+export function workflowPreview(value: unknown): string | undefined {
+  if (value == null) return undefined
+  const text = (typeof value === 'string' ? value : JSON.stringify(value)).trim()
+  if (!text) return undefined
+  if (text.length <= 400) return text
+  const end = text.charCodeAt(399) >= 0xD800 && text.charCodeAt(399) <= 0xDBFF ? 399 : 400
+  return text.slice(0, end) + '…'
+}
+
+/** Accumulates ordered native diagnostic records for one execution attempt. */
+export class WorkflowOutput {
+  private readonly logs: string[] = []
+  private readonly phases = new WorkflowPhases()
+  private readonly agents = new Map<number, OutputAgent & { type: 'workflow_agent'; index: number }>()
+  private readonly progress: (OutputPhase | (OutputAgent & { type: 'workflow_agent'; index: number }))[] = []
+  private readonly announced = new Set<string>()
+
+  constructor(private readonly summary: string) {}
+
+  /** Reserve a group without displaying it until it contains work.
+   * @param title - Normalized phase title.
+   * @param kind - Child Workflow marker, when applicable.
+   * @returns Stable one-based index.
+   */
+  reservePhase(title: string, kind?: 'child'): number { return this.phases.reserve(title, kind).index }
+
+  /** Announce a phase once, preserving first-appearance order.
+   * @param title - Normalized phase title.
+   * @param kind - Child Workflow marker, when applicable.
+   * @param details - Execution-assigned identity when supplied by a runtime.
+   * @returns Stable one-based index.
+   */
+  phase(title: string, kind?: 'child', details?: { index: number; kind?: 'child' }): number {
+    const phase = details ? { type: 'workflow_phase' as const, index: details.index, title, ...details.kind ? { kind: details.kind } : {} } : this.phases.reserve(title, kind)
+    if (!this.announced.has(title)) {
+      this.announced.add(title)
+      this.progress.push(phase)
+    }
+    return phase.index
+  }
+
+  /** Retain the script's already formatted log line.
+   * @param message - Complete Workflow log message.
+   */
+  log(message: string): void { this.logs.push(message) }
+
+  /** Merge observations for one admitted call without reordering its row.
+   * @param index - One-based invocation sequence.
+   * @param fields - Available agent observations; undefined fields are omitted from JSON.
+   */
+  agent(index: number, fields: OutputAgent): void {
+    const current = this.agents.get(index)
+    if (current) Object.assign(current, fields)
+    else {
+      const row = { type: 'workflow_agent' as const, index, ...fields }
+      this.agents.set(index, row)
+      this.progress.push(row)
+    }
+  }
+
+  /** Render full successful output; failures and cancellation leave an empty file.
+   * @param result - Settled script outcome after child cleanup.
+   * @returns Pretty JSON without a trailing newline, or an empty string.
+   */
+  render(result: { stopReason: string; value?: unknown; agentsStarted: number }): string {
+    if (result.stopReason !== 'completed') return ''
+    const agents = [...this.agents.values()].filter(agent => !agent.cached)
+    const total = (field: 'tokens' | 'toolCalls'): number | undefined => {
+      let sum = 0
+      for (const agent of agents) {
+        const value = agent[field]
+        if (value === undefined) return undefined
+        sum += value
+      }
+      return sum
+    }
+    return JSON.stringify({
+      summary: this.summary, agentCount: result.agentsStarted, logs: this.logs,
+      result: result.value, workflowProgress: this.progress,
+      totalTokens: total('tokens'),
+      totalToolCalls: total('toolCalls'),
+    }, null, 2)
+  }
+}
