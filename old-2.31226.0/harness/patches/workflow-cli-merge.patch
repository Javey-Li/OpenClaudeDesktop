+/** Rejected reasoning changes future context without rewriting the original response. */
+import { expect, it } from 'vitest'
+import { createAssistantMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '../src/types.ts'
+import { Session, SessionId, foldSurface, deriveEventMessage } from '../src/index.ts'
+
+function fixture(replayState: unknown = { response: { model: 'fixture' }, blocks: [{ signature: 'a' }, { text: true }, { redactedData: 'opaque' }] }) {
+  const session = Session.create(SessionId('reasoning-strip'))
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  const content = [{ type: 'reasoning', text: 'first' }, { type: 'text', text: 'answer' }, { type: 'reasoning', text: '' }] as const
+  const message = createAssistantMessage({ content: [...content], source: { provider: 'mock', model: 'mock', replayState } })
+  const source = session.append('assistant/message', { turn: 1, step: 1, stream: [], message }, { surfaceOp: 'append' })
+  return { session, source, message }
+}
+
+it('replays sequential omissions with aligned private metadata, stable identity and unmodified raw events', () => {
+  const { session, source, message } = fixture()
+  const saved = JSON.stringify(source)
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [2] }] })
+  expect(session.deriveMessages()[0]).toMatchObject({ id: message.id, content: message.content.slice(0, 2), source: { replayState: { blocks: [{ signature: 'a' }, { text: true }] } } })
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0] }] })
+  const projected = session.deriveMessages()[0]
+  expect(projected).toMatchObject({ id: message.id, content: [message.content[1]], source: { replayState: { blocks: [{ text: true }] } } })
+  expect(JSON.stringify(source)).toBe(saved)
+  const restored = Session.create(SessionId('restored'), JSON.parse(JSON.stringify(session.snapshotEvents())) as SessionEvent[])
+  expect(restored.deriveMessages()).toEqual([projected])
+  const surface = foldSurface(session.snapshotEvents())
+  expect(deriveEventMessage(source, surface.projectedMessages)).toEqual(projected)
+  expect(session.surface.contentGeneration).toBe(2)
+})
+
+it.each([null, {}, { response: {}, blocks: [] }, { response: {}, blocks: null }])('drops metadata that cannot be safely aligned: %j', (state) => {
+  const { session, source } = fixture(state)
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0] }] })
+  expect(session.deriveMessages()[0]?.source).not.toHaveProperty('replayState')
+})
+
+it('preserves response-only replay and removes fully omitted messages from the derived history', () => {
+  const { session, source } = fixture({ response: { native: 'response-only' } })
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0, 2] }] })
+  expect(session.deriveMessages()[0]?.source).toHaveProperty('replayState', { response: { native: 'response-only' } })
+  const only = session.append('assistant/message', { turn: 1, step: 1, stream: [], message: createAssistantMessage({ content: [{ type: 'reasoning', text: 'only' }], source: { provider: 'mock', model: 'mock' } }) }, { surfaceOp: 'append' })
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: only.data.message.id, blockIndexes: [0] }] })
+  expect(session.deriveMessages()).toHaveLength(1)
+})
+
+it('reconstructs original reasoning positions from legacy records without provider ordering metadata', () => {
+  const { session, source } = fixture()
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [0] }] })
+  expect(session.deriveMessages()[0]?.source).toHaveProperty('reasoningPrefix', [1, 1])
+  session.append('assistant/reasoning-strip', { targets: [{ messageId: source.data.message.id, blockIndexes: [1] }] })
+  expect(session.deriveMessages()[0]?.source).toHaveProperty('reasoningPrefix', [1])
+  const restored = Session.create(SessionId('legacy-restore'), JSON.parse(JSON.stringify(session.snapshotEvents())) as SessionEvent[])
+  expect(restored.deriveMessages()).toEqual(session.deriveMessages())
+  expect(source.data.message.source).not.toHaveProperty('reasoningPrefix')
+})
+
+it.each([
+  null, {}, { targets: [] }, { targets: [{ messageId: 'current', blockIndexes: [] }] },
+  { targets: [{ messageId: 'current', blockIndexes: [1] }] }, { targets: [{ messageId: 'current', blockIndexes: [3] }] },
+  { targets: [{ messageId: 'current', blockIndexes: [0, 0] }] }, { targets: [{ messageId: 'current', blockIndexes: [2, 0] }] },
+  { targets: [{ messageId: 'current', blockIndexes: [-1] }] }, { targets: [{ messageId: 'current', blockIndexes: [-0] }] },
+  { targets: [{ messageId: 'missing', blockIndexes: [0] }] }, { targets: [{ messageId: 'not-assistant', blockIndexes: [0] }] },
+  { targets: [{ messageId: 'current', blockIndexes: [0] }, { messageId: 'current', blockIndexes: [2] }] },
+  { targets: [{ messageId: 'current', blockIndexes: [0] }], extra: true },
+  { targets: [{ messageId: 'current', blockIndexes: [0], extra: true }] },
+])('rejects invalid decisions atomically %#', (data) => {
+  const { session, message } = fixture()
+  const supplied = data && 'targets' in data && Array.isArray(data.targets)
+    ? { ...data, targets: data.targets.map(target => ({
+      ...target, messageId: target.messageId === 'current' ? message.id : target.messageId,
