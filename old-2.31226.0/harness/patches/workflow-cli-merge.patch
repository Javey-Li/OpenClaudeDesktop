@@ -0,0 +1,36 @@
+/** Lexical Workflow path checks run before the filesystem can contact a network mount. */
+import { posix, win32 } from 'node:path'
+
+/** Detect native namespace and macOS automount spellings, including prefixes later erased by `..`. */
+function networkPath(path: string): boolean {
+  if (/^[\\/]{2}/u.test(path) || /^[\\/]\?\?[\\/]/u.test(path)
+    || path.includes('??') && /^[\\/]\?\?[\\/]/u.test(win32.normalize(path))) return true
+  if (!path.startsWith('/')) return false
+  const parts: string[] = []
+  for (const part of path.split('/')) {
+    if (!part || part === '.') continue
+    if (part === '..') { parts.pop(); continue }
+    parts.push(part)
+    const head = parts[0] ?? part
+    const first = head.toLowerCase()
+    if (first === 'network' || /^\.(?:vol|file|nofollow|resolve)$/iu.test(first)) return true
+    const fold = (value: string) => value.replace(/[\u200c-\u200f\u202a-\u202e\u206a-\u206f\ufeff]/gu, '').toUpperCase().toLowerCase()
+    if (fold(head) === 'net' && parts.length >= 2) return true
+    if (fold(head) === 'network' && parts[1] && fold(parts[1]) === 'servers' && parts.length >= 3) return true
+  }
+  return parts.length === 1 && parts[0]?.toLowerCase() === 'net'
+}
+
+/** Refuse Workflow network paths before resolution and return the absolute lexical spelling.
+ * @param path - Model-supplied scriptPath.
+ * @param cwd - Calling execution world's absolute working directory, when known.
+ * @returns The lexical absolute path, or the original relative path when cwd is absent.
+ */
+export function workflowScriptPath(path: string, cwd?: string): string {
+  const paths = cwd && /^[a-z]:[\\/]/iu.test(cwd) ? win32 : posix
+  const absolute = cwd === undefined ? path : paths.resolve(cwd, path)
+  if (networkPath(path) || networkPath(absolute)) {
+    throw new Error(`Network (UNC, NT-namespace, or automount) paths are not allowed for workflow scriptPath: ${path}`)
+  }
+  return absolute
+}
