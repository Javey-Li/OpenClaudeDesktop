@@ -0,0 +1,78 @@
+/** Session-owned backup records and their host-only incremental projection. */
+import { z } from 'zod'
+import type { ZodType } from 'zod'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+import { WorkflowAttemptId, WorkflowRunId } from '@deepseek-ai/dsh-workflow'
+import type { JournalEntry } from './types.ts'
+
+/** Private reusable source; external user files have no backup source entry. */
+export interface WorkflowMirrorSource {
+  fileName: string
+  script: string
+}
+
+/** Latest execution data retained independently of the private journal directory. */
+export interface WorkflowMirrorSnapshot {
+  attemptId: WorkflowAttemptId
+  provider: string
+  source?: WorkflowMirrorSource
+  entries: JournalEntry[]
+}
+
+/** A committed backup update attributed to its original owning Session. */
+export interface WorkflowMirrorData {
+  sessionId: SessionId
+  runId: WorkflowRunId
+  attemptId: WorkflowAttemptId
+  record: { kind: 'start'; provider: string; source?: WorkflowMirrorSource } | { kind: 'entry'; entry: JournalEntry }
+}
+
+/** Host-only projection; inherited events never grant a child Session recovery rights. */
+export interface WorkflowMirrorState {
+  owner: SessionId
+  runs: Record<string, WorkflowMirrorSnapshot>
+}
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Private workflow recovery data; not model-visible or a user instruction. */
+    'workflow-ptc/mirror': WorkflowMirrorData
+  }
+}
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap {
+    /** Latest same-Session workflow source and invocation backups. */
+    workflowMirror: WorkflowMirrorState
+  }
+}
+
+const sourceSchema = z.object({ fileName: z.string(), script: z.string() })
+const entrySchema: ZodType<JournalEntry> = z.object({
+  seq: z.number().int().positive(), promptHash: z.string(), optsHash: z.string(),
+  childId: z.string(), outcome: z.enum(['started', 'completed', 'failed']), value: z.unknown(),
+})
+const stateSchema: ZodType<WorkflowMirrorState> = z.object({
+  owner: z.string().transform(SessionId),
+  runs: z.record(z.string(), z.object({
+    attemptId: z.uuid().transform(WorkflowAttemptId), provider: z.string(),
+    source: sourceSchema.optional(), entries: z.array(entrySchema),
+  }).transform(({ source, ...fields }) => ({ ...fields, ...source === undefined ? {} : { source } }))),
+})
+
+/** Reconstruct only the latest attempt; late entries from earlier attempts stay isolated. */
+export const workflowMirrorDefinition = {
+  key: 'workflowMirror', stateVersion: 1, stateSchema,
+  init: header => ({ owner: header.id, runs: {} }),
+  apply: (state, event) => {
+    if (event.type !== 'workflow-ptc/mirror' || event.data.sessionId !== state.owner) return state
+    const { runId, attemptId, record } = event.data
+    if (record.kind === 'start') return { ...state, runs: { ...state.runs, [runId]: {
+      attemptId, provider: record.provider, ...record.source === undefined ? {} : { source: record.source }, entries: [],
+    } } }
+    const run = state.runs[runId]
+    if (!run || run.attemptId !== attemptId) return state
+    return { ...state, runs: { ...state.runs, [runId]: { ...run, entries: [...run.entries, record.entry] } } }
+  },
+} satisfies Omit<ProjectionDefinition<'workflowMirror', WorkflowMirrorState>, 'wire'>
