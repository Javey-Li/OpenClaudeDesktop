+  readonly directory: string
+  /** Complete settled output; absent until its flushed file has been published. */
+  outputFile?: string
+  /** Isolates this execution from earlier holders of the same run. */
+  readonly attemptId = WorkflowAttemptId(randomUUID())
+  private readonly file: string
