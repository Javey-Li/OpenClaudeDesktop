index 0000000000..2c95a119a4
--- /dev/null
+++ b/packages/jobs/tool-jobs/src/claude-task-stop.ts
@@ -0,0 +1,76 @@
+/** Claude Code task cancellation over the owner-scoped job registry. */
+import type { Context } from '@deepseek-ai/cordis'
+import { JobId } from '@deepseek-ai/dsh-jobs'
+import { defineTool, ToolArgsError } from '@deepseek-ai/dsh-tools'
+import type { ToolDefinition } from '@deepseek-ai/dsh-tools'
+
+/**
+ * Construct TaskStop while sharing notice suppression with the generic controller.
+ * @param ctx - Controller context with its job registry.
+ * @param stopped - Jobs whose cancellation was already delivered through a tool result.
+ * @param waitCap - Maximum cooperative cleanup wait in milliseconds.
+ * @returns Strict TaskStop with task_id and deprecated shell_id inputs.
+ */
+export function claudeTaskStop(ctx: Context, stopped: Set<JobId>, waitCap: number): ToolDefinition {
+  const tool = defineTool({
+    name: 'TaskStop',
+    description: 'Stop a running background task by its task_id. Returns its task identity and status after cleanup.',
+    parameters: {
+      task_id: { type: 'string', description: 'ID returned by the tool that launched the background task.' },
+      shell_id: { type: 'string', description: 'Deprecated: use task_id instead.' },
+    },
+    output: {
+      schema: {
+        type: 'object', additionalProperties: false,
+        properties: {
+          message: { type: 'string', required: true },
+          task_id: { type: 'string', required: true },
+          task_type: { type: 'string', required: true },
+          command: { type: 'string', required: true },
+        },
+      },
+      render: (_args, value) => [{ type: 'text', text: JSON.stringify(value) }],
+    },
+    async execute(args, exec) {
+      const target = args.task_id || args.shell_id
+      if (!target) throw new Error('Missing required parameter: task_id')
+      const id = JobId(target)
+      // Listing is owner-filtered and does not reveal another session's tasks.
+      const job = ctx.jobs.list(exec.agent?.id).find(entry => entry.id === id)
+      if (!job) throw new Error(`No task found with ID: ${id}`)
+      if (job.status !== 'running') throw new Error(`Task ${id} is not running (status: ${job.status})`)
+      const outcome = ctx.jobs.kill(id, exec.agent?.id)
+      if (outcome === 'already-finished') throw new Error(`Task ${id} is not running`)
+      stopped.add(id)
+      try {
+        await ctx.jobs.wait(id, waitCap, exec.agent?.id, exec.signal)
+      } catch (error) {
+        stopped.delete(id)
+        throw error
+      }
+      const current = ctx.jobs.get(id, exec.agent?.id)
+      if (current.status === 'running' || current.status === 'stopping') {
+        stopped.delete(id)
+        throw new Error(`Task ${id} is still stopping; cleanup has not finished`)
+      }
+      return {
+        message: `Successfully stopped task: ${id} (${job.label})`,
+        task_id: id,
+        task_type: job.kind === 'subagent' ? 'local_agent' : `local_${job.kind}`,
+        command: job.label,
+      }
+    },
+    presentCall: args => ({ card: 'generic', title: 'Stop background task', kind: 'execute', rawInput: args.task_id ?? args.shell_id ?? '' }),
+  })
+  return {
+    ...tool,
+    parameters: { ...tool.parameters, additionalProperties: false },
+    execute(input, exec) {
+      if (input && typeof input === 'object') {
+        const extra = Object.keys(input).find(key => key !== 'task_id' && key !== 'shell_id')
+        if (extra !== undefined) throw new ToolArgsError([`unexpected parameter ${extra}`])
+      }
+      return tool.execute(input, exec)
+    },
+  }
+}
