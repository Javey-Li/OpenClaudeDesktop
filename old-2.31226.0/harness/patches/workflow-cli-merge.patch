+import TokenMeter from '../src/index.ts'
+import { estimateMessage } from '../src/estimate.ts'
+import { deriveTurnTokenUsage } from '../src/turn-usage.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose())) })
+
+async function harness() {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(TokenMeter)
+  const session = ctx.sessions.create()
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  session.append('request/header', { reason: 'initial', header: { config: { provider: 'mock', model: 'mock' } } })
+  session.append('user/message', createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'request' }] }), { surfaceOp: 'append' })
+  return { ctx, session }
+}
+
+function response(session: Session, suffix: string) {
+  const start = session.append('assistant/stream-start', { turn: 1, step: 1, provider: 'mock', model: 'mock' })
+  const fragments = ['first', 'second'].map((text, index) => {
+    const block = { type: 'text' as const, text: text + suffix }
+    const stream: AssistantStreamRecord[] = [{ type: 'chunk', time: index + 1, chunk: { type: 'block-end', index, block } }]
+    return session.append('assistant/message', {
+      turn: 1, step: 1, stream, message: createAssistantMessage({ source: { provider: 'mock', model: 'mock' }, content: [block] }),
+    }, { surfaceOp: 'append' })
+  })
+  const attempt = session.append('assistant/attempt', {
+    turn: 1, step: 1, stream: [...fragments.flatMap(item => item.data.stream),
+      { type: 'chunk', time: 3, chunk: { type: 'usage', usage: { inputTokens: 1000, outputTokens: 10, totalTokens: 1010 } } },
+      { type: 'chunk', time: 4, chunk: { type: 'finish', reason: { kind: 'stop' } } },
+    ],
+  })
+  session.append('assistant/stream-merge', {
+    turn: 1, step: 1, startSeq: start.seq, attemptSeq: attempt.seq, messageSeqs: fragments.map(item => item.seq),
+  })
+}
+
+describe('streaming response metering', () => {
+  it('prices the merged message once and anchors provider usage before response checkpoints', async () => {
+    const { ctx, session } = await harness()
+    const promptPrice = ctx.tokenMeter.measure(session).surfaceTokens
+    response(session, '')
+    const measurement = ctx.tokenMeter.measure(session)
+    const expected = session.deriveMessages().reduce((sum, message) => sum + estimateMessage(message), 0)
+    expect(measurement.surfaceTokens).toBe(expected)
+    expect(measurement.surfaceDeltaTokens).toBe(0)
+    expect(measurement.baseline).toMatchObject({ kind: 'usage', tokens: 1010 })
+    expect(ctx.sessionProjections.stateOf(session, 'contextBreakdown')?.breakdown.messageTokens).toBe(expected)
+    const pressure = ctx.sessionProjections.stateOf(session, 'contextPressure')
+    expect(pressure?.sampledSurfaceTokens).toBe(promptPrice)
+    expect(pressure?.surfaceTokens).toBe(expected)
+    expect(pressure?.streamingSurfaceTokens).toBeUndefined()
+    expect(ctx.sessionProjections.stateOf(session, 'tokenUsage')?.totals).toMatchObject({ uncachedInputTokens: 1000, outputTokens: 10 })
+    const replay = Session.create(SessionId('meter-replay'), session.snapshotEvents())
+    expect(ctx.tokenMeter.measure(replay).surfaceTokens).toBe(expected)
+  })
+
+  it('bills two streaming attempts within one step separately without double-counting their fragments', async () => {
+    const { ctx, session } = await harness()
+    response(session, '-1')
+    response(session, '-2')
+    session.append('step/end', { turn: 1, step: 1 })
+    session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+    expect(ctx.sessionProjections.stateOf(session, 'tokenUsage')?.totals).toMatchObject({ uncachedInputTokens: 2000, outputTokens: 20 })
+    expect(deriveTurnTokenUsage(session.snapshotEvents())).toMatchObject({ uncachedInputTokens: 2000, outputTokens: 20, totalTokens: 2020 })
+    const expected = session.deriveMessages().reduce((sum, message) => sum + estimateMessage(message), 0)
+    expect(ctx.tokenMeter.measure(session).surfaceTokens).toBe(expected)
+    expect(ctx.sessionProjections.stateOf(session, 'contextBreakdown')?.breakdown.messageTokens).toBe(expected)
+  })
+})
