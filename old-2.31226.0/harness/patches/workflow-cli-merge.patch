+++ b/packages/mcp/mcp-client/tests/ordering-fixture.ts
@@ -0,0 +1,53 @@
+/** Controlled MCP completion timing for recorded Workflow integration. */
+import { createServer } from 'node:http'
+import { createMcpHandler, McpServer } from '@modelcontextprotocol/server'
+import { toNodeHandler, type NodeIncomingMessageLike } from '@modelcontextprotocol/node'
+import { z } from 'zod'
+
+/**
+ * Start parallel read-only calls and an exclusive barrier with observable completion order.
+ * @returns The endpoint, execution observations, and server teardown.
+ */
+export async function startOrderingMcpFixture() {
+  const starts: string[] = []
+  const finishes: string[] = []
+  let active = 0
+  let maxActive = 0
+  const handler = createMcpHandler(() => {
+    const mcp = new McpServer({ name: 'ordering-fixture', version: '1.0.0' }, { capabilities: { tools: {} } })
+    for (const name of ['delay', 'exclusive']) {
+      mcp.registerTool(name, {
+        description: 'Return a label after a bounded fixture delay.',
+        inputSchema: z.object({ label: z.string(), delayMs: z.number().int().min(0).max(1000) }),
+        annotations: { readOnlyHint: name === 'delay' },
+      }, async ({ label, delayMs }) => {
+        starts.push(label)
+        active++
+        maxActive = Math.max(maxActive, active)
+        await new Promise(resolve => setTimeout(resolve, delayMs))
+        active--
+        finishes.push(label)
+        return { content: [{ type: 'text', text: label }] }
+      })
+    }
+    return mcp
+  })
+  const handle = toNodeHandler(handler)
+  const server = createServer((request, response) => {
+    handle(request as NodeIncomingMessageLike, response).catch((error: unknown) => {
+      response.writeHead(500).end(String(error))
+    })
+  })
+  await new Promise<void>((resolve) => { server.listen(0, '127.0.0.1', resolve) })
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('ordering fixture missing address')
+  return {
+    url: `http://127.0.0.1:${address.port}/mcp`, starts, finishes,
+    get maxActive() { return maxActive },
+    async close() {
+      await handler.close()
+      server.closeAllConnections()
+      await new Promise<void>((resolve, reject) => { server.close((error) => { if (error) reject(error); else resolve() }) })
+    },
+  }
+}
