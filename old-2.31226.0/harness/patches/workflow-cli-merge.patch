@@ -0,0 +1,38 @@
+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+
+interface CacheFixture { name: string; script: string; modelCalls: number; progress: Record<string, unknown>[] }
+interface Output { workflowProgress: Record<string, unknown>[] }
+const native = JSON.parse(await readFile(new URL('./fixtures/cache-progress-native.json', import.meta.url), 'utf8')) as CacheFixture[]
+const project = (rows: Record<string, unknown>[]) => rows.map(row => Object.fromEntries(
+  ['type', 'index', 'title', 'kind', 'label', 'phaseIndex', 'phaseTitle', 'state', 'cached'].filter(key => row[key] !== undefined).map(key => [key, row[key]]),
+))
+
+it.each(native)('matches native $name cache progress through real PTC and journal recovery', async (fixture) => {
+  const t = await setupMerge()
+  const first = t.start(fixture.script, { args: { resumed: false } })
+  expect((await first.result).stopReason).toBe('completed')
+  const original = JSON.parse(await readFile(first.outputFile!, 'utf8')) as Output
+  await first.dispose()
+  const events: string[] = [], admissions: number[] = []
+  t.ctx.on('workflow/phase', (_run, title) => { events.push(title) })
+  t.ctx.on('workflow/agent-admission', (_run, info) => { admissions.push(info.seq); events.push(`agent ${info.seq}`) })
+  t.ctx.on('workflow/agent-start', (_run, info) => { if (info.cached) events.push(`agent ${info.seq}`) })
+  const resumed = t.start(fixture.script, { args: { resumed: true }, resumeFromRunId: first.id })
+  expect((await resumed.result).stopReason).toBe('completed')
+  const output = JSON.parse(await readFile(resumed.outputFile!, 'utf8')) as Output
+  expect(project(output.workflowProgress)).toEqual(fixture.progress)
+  expect(events).toEqual(fixture.progress.map(row => row.type === 'workflow_phase' ? row.title : `agent ${String(row.index)}`))
+  expect(t.requests).toHaveLength(fixture.modelCalls)
+  if (fixture.name !== 'changed-prefix') {
+    expect(admissions).toEqual([])
+    const before = original.workflowProgress.filter(row => row.type === 'workflow_agent')
+    const after = output.workflowProgress.filter(row => row.type === 'workflow_agent')
+    expect(after.map(row => row.agentId)).toEqual(before.map(row => row.agentId))
+    for (const row of after) {
+      for (const field of ['queuedAt', 'attempt', 'durationMs', 'tokens', 'toolCalls']) expect(row).not.toHaveProperty(field)
+    }
+  }
+  await resumed.dispose()
+})
