+import { describe, expect, it } from 'vitest'
+import { runInNewContext } from 'node:vm'
+import { compileStructuredOutputSchema } from '../src/output-schema.ts'
+
+describe('delegated output JSON Schema', () => {
+  it('enforces local references, combinators, nullable values and collection constraints', () => {
+    const validate = compileStructuredOutputSchema({
+      type: 'object',
+      $defs: { slug: { type: 'string', pattern: '^[a-z]+$', minLength: 2, maxLength: 8 } },
+      properties: {
+        name: { $ref: '#/$defs/slug' },
+        score: { anyOf: [{ type: 'null' }, { type: 'number', minimum: 0, maximum: 10, multipleOf: 0.5 }] },
+        tags: { type: 'array', items: { $ref: '#/$defs/slug' }, minItems: 1, maxItems: 2, uniqueItems: true },
+        extra: { type: 'object', additionalProperties: { type: 'integer', minimum: 0 } },
+      },
+      required: ['name', 'score', 'tags'], additionalProperties: false,
+      allOf: [{ not: { properties: { name: { const: 'forbidden' } }, required: ['name'] } }],
+    })
+    const good = { name: 'alice', score: 2.5, tags: ['hello'], extra: { count: 2 } }
+    expect(validate(good)).toBe(true)
+    expect(validate({ ...good, score: null })).toBe(true)
+    for (const patch of [{ name: 'A' }, { score: 11 }, { score: 2.3 }, { tags: ['same', 'same'] }, { extra: { count: -1 } }]) {
+      expect(validate({ ...good, ...patch })).toBe(false)
+    }
+    expect(validate({ ...good, unknown: true })).toBe(false)
+  })
+
+  it('matches the CLI format policy and never coerces or inserts defaults', () => {
+    const validate = compileStructuredOutputSchema({ type: 'object', properties: {
+      email: { type: 'string', format: 'email' }, count: { type: 'integer', default: 3 },
+    } })
+    const value = { email: 'not-an-email' }
+    expect(validate(value)).toBe(true)
+    expect(value).toEqual({ email: 'not-an-email' })
+    expect(validate({ count: '3' })).toBe(false)
+  })
+
+  it('accepts a lossless schema from the workflow VM and snapshots mutable input', () => {
+    const schema = runInNewContext('({type:"object", properties:{n:{type:"number",minimum:1}},required:["n"]})') as {
+      properties: { n: { minimum: number } }
+    }
+    const validate = compileStructuredOutputSchema(schema)
+    schema.properties.n.minimum = 0
+    expect(validate({ n: 0 })).toBe(false)
+  })
+
+  it.each([
+    { type: 'object', required: ['missing'], additionalProperties: false },
+    { type: 'object', properties: { optional: { type: 'string', minLength: 5, maxLength: 2 } } },
+    { type: 'object', properties: { n: { type: 'number', minimum: 5, exclusiveMaximum: 5 } } },
+    { type: 'object', properties: { n: { type: 'integer', enum: ['wrong'] } } },
+    { type: 'object', properties: { n: { type: 'string', const: 4 } } },
+    { type: 'object', properties: { n: { type: 'number', enum: [1, 2], const: 3 } } },
+    { type: 'object', properties: { a: {}, b: {} }, required: ['a', 'b'], maxProperties: 1 },
+    { type: 'object', properties: { list: { type: 'array', items: { type: 'string', minLength: 3, maxLength: 1 } } } },
+  ])('rejects the CLI local contradiction checks before spending a model call: %j', (schema) => {
+    expect(() => compileStructuredOutputSchema(schema)).toThrow(/unusable schema/)
+  })
+
+  it('does not reject nullable or alternative branches using an overbroad bound check', () => {
+    const validate = compileStructuredOutputSchema({ type: 'object', properties: {
+      n: { type: ['number', 'null'], minimum: 10, maximum: 1 },
+      s: { anyOf: [{ type: 'string', minLength: 3, maxLength: 1 }, { type: 'null' }] },
+    } })
+    expect(validate({ n: null, s: null })).toBe(true)
+  })
+
+  it.each([
+    { type: 'object', $async: true },
+    { type: 'object', properties: { value: { $ref: 'https://example.invalid/schema.json' } } },
+    { type: 'object', madeUpConstraint: true },
+    { type: 'object', properties: { value: { type: 'string', pattern: '[' } } },
+    { type: 'object', default: () => {} },
+    { type: 'array' },
+  ])('rejects invalid or asynchronous schemas before child creation: %j', (schema) => {
+    expect(() => compileStructuredOutputSchema(schema)).toThrow(/unsupported JSON schema/)
+  })
+})
