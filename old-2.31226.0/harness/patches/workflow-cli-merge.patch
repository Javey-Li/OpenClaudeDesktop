+/**
+ * Model-facing discovery projects resource records with server attribution and excludes MCP Apps UI documents.
+ *
+ * @module @deepseek-ai/dsh-mcp-resources
+ */
+
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+
+/**
+ * Resolve the CLI's tool-safe server spelling without changing exact-name precedence.
+ * @param name - configured or requested server name.
+ * @returns case-preserving normalized spelling.
+ */
+export function normalizedServerName(name: string): string {
+  const normalized = name.replace(/[^A-Za-z0-9_-]/g, '_')
+  return name.startsWith('claude.ai ') ? normalized.replace(/_+/g, '_').replace(/^_|_$/g, '') : normalized
+}
+
+const token = "[!#$%&'*+.^_`|~0-9A-Za-z-]+"
+const mediaType = new RegExp(`^[ \\t]*(${token})/(${token})`)
+const parameter = new RegExp(`[ \\t\\r\\n]*;[ \\t\\r\\n]*(?:(${token})=(?:(${token})|"((?:[^"\\\\]|\\\\.)*)")(?=[ \\t\\r\\n]*(?:;|$)))?`, 'y')
+
+function appResource(uri: string, mimeType: JsonValue | undefined): boolean {
+  if (uri.slice(0, 5).toLowerCase() === 'ui://') return true
+  if (typeof mimeType !== 'string' || mimeType.length > 1024) return false
+  const type = mediaType.exec(mimeType)
+  if (type?.[1]?.toLowerCase() !== 'text' || type[2]?.toLowerCase() !== 'html') return false
+  parameter.lastIndex = type[0].length
+  for (let match = parameter.exec(mimeType); match; match = parameter.exec(mimeType)) {
+    const value = match[2] ?? match[3]?.replace(/\\(.)/g, '$1')
+    if (match[1]?.toLowerCase() === 'profile' && value?.toLowerCase() === 'mcp-app') return true
+  }
+  return false
+}
+
+/**
+ * Project a provider's resource listing for model discovery; direct reads remain available.
+ * @param value - protocol JSON returned by the provider.
+ * @param server - authoritative configured server name.
+ * @returns visible resource records with server attribution.
+ * @throws when a provider returns a malformed listing or resource record.
+ */
+export function discoverableResources(value: JsonValue, server: string): JsonValue[] {
+  if (!value || typeof value !== 'object' || Array.isArray(value) || !Array.isArray(value.resources)) {
+    throw new Error('MCP resources/list result must contain a resources array')
+  }
+  return value.resources.flatMap((resource) => {
+    if (!resource || typeof resource !== 'object' || Array.isArray(resource) || typeof resource.uri !== 'string' || typeof resource.name !== 'string') {
+      throw new Error('MCP resource records must contain uri and name strings')
+    }
+    return appResource(resource.uri, resource.mimeType) ? [] : [{ ...resource, server }]
+  })
+}
