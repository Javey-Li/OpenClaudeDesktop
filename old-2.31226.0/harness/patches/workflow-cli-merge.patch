+/** Claude-compatible classification of completed Bash commands; never executes shell text. */
+import { fileURLToPath } from 'node:url'
+import { Language, Parser, type Node } from 'web-tree-sitter'
+
+const containers = new Set(['program', 'list', 'pipeline'])
+const separators = new Set(['&&', '||', '|', ';', '&', '|&', '\n'])
+const conditionalCommands = new Set(['grep', 'rg', 'egrep', 'fgrep', 'find', 'diff', 'test', '['])
+let language: Promise<Language> | undefined
+
+function finalCommand(node: Node): string | undefined {
+  if (separators.has(node.type) || node.type === 'comment') return undefined
+  if (containers.has(node.type) || node.type === 'redirected_statement') {
+    for (const child of node.children.toReversed()) {
+      if (node.type === 'redirected_statement' && child.type.endsWith('_redirect')) continue
+      const command = finalCommand(child)
+      if (command !== undefined) return command
+    }
+    return undefined
+  }
+  return node.text
+}
+
+function acceptsOne(command: string): boolean {
+  const words = command.trim().split(/\s+/)
+  const first = words.shift() ?? ''
+  if (conditionalCommands.has(first)) return true
+  if (first !== 'git') return false
+  let skipArgument = false
+  for (const word of words) {
+    if (skipArgument) { skipArgument = false; continue }
+    if (word.startsWith('-')) {
+      skipArgument = word === '-C' || word === '-c'
+      continue
+    }
+    return word === 'diff' || word === 'grep'
+  }
+  return false
+}
+
+/** Load the grammar before tool publication and return a synchronous exit classifier.
+ * @returns a classifier whose true result marks a completed command as a tool failure.
+ */
+export async function prepareExitCodeClassifier(): Promise<(command: string, exitCode: number) => boolean> {
+  language ??= (async () => {
+    await Parser.init()
+    return Language.load(fileURLToPath(import.meta.resolve('tree-sitter-bash/tree-sitter-bash.wasm')))
+  })()
+  const grammar = await language
+  return (command, exitCode) => {
+    if (exitCode === 0) return false
+    let selected = command
+    // The reference splitter leaves inputs above this fixed parser limit intact.
+    if (command.length > 0 && command.length <= 10_000) {
+      const parser = new Parser()
+      try {
+        parser.setLanguage(grammar)
+        const tree = parser.parse(command)
+        if (tree) {
+          try { selected = finalCommand(tree.rootNode) ?? command }
+          finally { tree.delete() }
+        }
+      } finally { parser.delete() }
+    }
+    return acceptsOne(selected) ? exitCode >= 2 : true
+  }
+}
