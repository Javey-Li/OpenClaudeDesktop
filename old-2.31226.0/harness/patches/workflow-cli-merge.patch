diff --git a/packages/hooks/hooks-claude-code/tests/http.spec.ts b/packages/hooks/hooks-claude-code/tests/http.spec.ts
new file mode 100644
index 0000000000..e3b41056cc
--- /dev/null
+++ b/packages/hooks/hooks-claude-code/tests/http.spec.ts
@@ -0,0 +1,186 @@
+import { createServer } from 'node:http'
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import { once } from 'node:events'
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { Config } from '../src/index.ts'
+import { installProxyFromEnvironment } from '@deepseek-ai/dsh-http-proxy'
+import { decodeHttpHookOutput, installHttpHookPolicy, runHttpHook } from '../src/http.ts'
+import { blockedHttpHookAddress } from '../src/http-network.ts'
+import { expandHttpHookHeader } from '../src/http-env.ts'
+import { matchesHttpHookUrl } from '../src/http-url.ts'
+import { parseClaudeCodeConfig, validateClaudeAgentHooks } from '../src/config.ts'
+
+const cleanups: (() => Promise<unknown>)[] = []
+afterEach(async () => { for (const cleanup of cleanups.splice(0).reverse()) await cleanup() })
+async function endpoint(handler: (request: IncomingMessage, response: ServerResponse) => void): Promise<string> {
+  const server = createServer(handler)
+  server.listen(0, '127.0.0.1')
+  await once(server, 'listening')
+  cleanups.push(async () => { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() =>{  resolve() })) })
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('missing bound TCP port')
+  return `http://127.0.0.1:${address.port}`
+}
+function context(): Context {
+  const ctx = new Context()
+  cleanups.push(() => ctx.fiber.dispose())
+  return ctx
+}
+function options(signal = new AbortController().signal) {
+  return { payload: { hook_event_name: 'PreToolUse', tool_name: 'Bash', tool_input: { command: 'true' } }, signal, point: 'PreToolUse', defaultTimeoutMs: 3000 }
+}
+
+describe('Claude HTTP hooks', () => {
+  it('keeps omitted host policy unrestricted and explicit empty lists restrictive after config validation', () => {
+    const omitted = Config({ configPath: 'hooks.json' })
+    expect(omitted.allowedHttpHookUrls).toBeUndefined()
+    expect(omitted.httpHookAllowedEnvVars).toBeUndefined()
+    expect(Config({ configPath: 'hooks.json', allowedHttpHookUrls: [], httpHookAllowedEnvVars: [] })).toMatchObject({
+      allowedHttpHookUrls: [], httpHookAllowedEnvVars: [],
+    })
+  })
+
+  it('posts JSON with allowed headers and consumes 2xx decisions', async () => {
+    const received: { method: string | undefined; headers: IncomingMessage['headers']; body: string }[] = []
+    const url = await endpoint((request, response) => {
+      let body = ''
+      request.on('data', (chunk) => { body += String(chunk) })
+      request.on('end', () => {
+        received.push({ method: request.method, headers: request.headers, body })
+        response.writeHead(201).end(JSON.stringify({ hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny', permissionDecisionReason: 'HTTP gate' } }))
+      })
+    })
+    const { output } = await runHttpHook(context(), { type: 'http', url, headers: { 'x-hook': 'literal\r\nvalue', 'x-absent': '$NOT_ALLOWED' } }, options())
+    expect(output).toMatchObject({ exitCode: 201, decision: 'deny', reason: 'HTTP gate' })
+    expect(received).toHaveLength(1)
+    expect(received[0]?.method).toBe('POST')
+    expect(received[0]?.headers).toMatchObject({ 'content-type': 'application/json', 'x-hook': 'literalvalue', 'x-absent': '' })
+    expect(received[0]?.body).toBe(JSON.stringify(options().payload))
+  })
+
+  it('uses the installed HTTP proxy and leaves its dispatcher usable for the next handler', async () => {
+    const targets: string[] = []
+    const proxy = createServer((request, response) => {
+      targets.push(request.url ?? '')
+      response.end('{}')
+    })
+    proxy.listen(0, '127.0.0.1')
+    await once(proxy, 'listening')
+    cleanups.push(async () => { proxy.closeAllConnections(); await new Promise<void>(resolve => proxy.close(() => { resolve() })) })
+    const address = proxy.address()
+    if (!address || typeof address === 'string') throw new Error('missing proxy TCP port')
+    const dispose = await installProxyFromEnvironment({ get: name => name === 'HTTP_PROXY' ? { value: `http://127.0.0.1:${address.port}` } : undefined }, () => {})
+    cleanups.push(dispose)
+    const ctx = context()
+    for (let i = 0; i < 2; i++) {
+      expect((await runHttpHook(ctx, { type: 'http', url: 'http://10.0.0.1/hook' }, options())).output.exitCode).toBe(200)
+    }
+    expect(targets).toEqual(['http://10.0.0.1/hook', 'http://10.0.0.1/hook'])
+  })
+
+  it('does not follow redirects or apply a non-2xx JSON denial', async () => {
+    let reached = false
+    const target = await endpoint((_request, response) => { reached = true; response.end('{}') })
+    const url = await endpoint((_request, response) => response.writeHead(307, { location: target }).end('{"continue":false,"decision":"block"}'))
+    const { output } = await runHttpHook(context(), { type: 'http', url }, options())
+    expect(output).toMatchObject({ exitCode: 307, stderr: 'HTTP 307' })
+    expect(output.continue).toBeUndefined()
+    expect(output.decision).toBeUndefined()
+    expect(reached).toBe(false)
+  })
+
+  it('times out while reading the body and closes the connection', async () => {
+    let closed!: () => void
+    const disconnected = new Promise<void>((resolve) => { closed = resolve })
+    const url = await endpoint((_request, response) => {
+      response.writeHead(200).write('{"continue":')
+      response.on('close', closed)
+    })
+    const { output } = await runHttpHook(context(), { type: 'http', url, timeoutSec: 0.1 }, options())
+    expect(output.exitCode).toBeUndefined()
+    expect(output.continue).toBeUndefined()
+    expect(output.stderr).toContain('HTTP_HOOK_TIMEOUT')
+    await disconnected
+  })
+
+  it('cancels an in-flight response without a late decision', async () => {
+    const controller = new AbortController()
+    const url = await endpoint((_request, response) => {
+      response.writeHead(200).write('{"decision":')
+      controller.abort(new Error('owner cancelled'))
+    })
+    const { output } = await runHttpHook(context(), { type: 'http', url }, options(controller.signal))
+    expect(output).toEqual({ exitCode: undefined, stdout: '', stderr: 'owner cancelled' })
+  })
+
+  it('inherits host URL restrictions and releases them with their owning plugin', async () => {
+    let calls = 0
+    const url = await endpoint((_request, response) => { calls++; response.end('{}') })
+    const ctx = context()
+    const fork = ctx.plugin((scope) => { installHttpHookPolicy(scope, { allowedHttpHookUrls: [] }) })
+    await fork
+    const child = ctx.extend({})
+    expect((await runHttpHook(child, { type: 'http', url }, options())).output.stderr).toContain('allowedHttpHookUrls')
+    expect(calls).toBe(0)
+    await fork.dispose()
+    expect((await runHttpHook(child, { type: 'http', url }, options())).output.exitCode).toBe(200)
+    expect(calls).toBe(1)
+  })
+
+  it.each(['http://10.0.0.1', 'http://192.168.0.1', 'http://169.254.169.254', 'http://[fd00::1]', 'http://[::ffff:10.1.1.1]'])(
+    'refuses a direct private destination %s before connecting', async (url) => {
+      expect((await runHttpHook(context(), { type: 'http', url }, options())).output.stderr).toContain('HTTP hook blocked:')
+    },
+  )
+
+  it.each([
+    ['', undefined], ['{}', undefined], ['plain prose', undefined], ['{"continue":"false"}', undefined],
+    ['{"continue":false,"reason":4}', undefined], ['{"continue":false}', false],
+    ['{"async":true,"continue":false}', undefined], ['{"hookSpecificOutput":{"hookEventName":"Missing"},"continue":false}', undefined],
+  ])('validates HTTP output %s before applying control fields', (body, expected) => {
+    expect(decodeHttpHookOutput(200, body, 'PreToolUse').continue).toBe(expected)
+  })
+
+  it('strips irrelevant event fields and discards mismatched context', () => {
+    const body = JSON.stringify({ hookSpecificOutput: { hookEventName: 'UserPromptSubmit', permissionDecision: 'deny', additionalContext: 'notes' } })
+    expect(decodeHttpHookOutput(200, body, 'UserPromptSubmit').decision).toBeUndefined()
+    expect(decodeHttpHookOutput(200, body, 'PreToolUse').additionalContext).toBeUndefined()
+  })
+
+  it('parses HTTP handlers in file config and local agent definitions', () => {
+    const hooks = { PreToolUse: [{ hooks: [{ type: 'http', url: 'https://hooks.example/gate', timeout: 4, headers: { Authorization: 'Bearer $HOOK_TOKEN' }, allowedEnvVars: ['HOOK_TOKEN'] }] }] }
+    expect(() => { validateClaudeAgentHooks(hooks) }).not.toThrow()
+    expect(parseClaudeCodeConfig(hooks).config.PreToolUse?.[0]?.hooks[0]).toEqual({ type: 'http', url: 'https://hooks.example/gate', timeoutSec: 4, headers: { Authorization: 'Bearer $HOOK_TOKEN' }, allowedEnvVars: ['HOOK_TOKEN'] })
+  })
+
+  it.each([{ url: '' }, { url: 'https://example.com', headers: { a: 1 } }, { url: 'https://example.com', allowedEnvVars: [1] }, { url: 'https://example.com', timeout: -1 }])('rejects malformed local HTTP config %j', (fields) => {
+    expect(() => { validateClaudeAgentHooks({ Stop: [{ hooks: [{ type: 'http', ...fields }] }] }) }).toThrow('invalid agent HTTP hook')
+  })
+})
+
+describe('HTTP policy pure functions', () => {
+  it('expands explicitly allowed ordinary variables and withholds protected credentials', () => {
+    const env = { HOOK_TOKEN: 'custom\r\nvalue', ANTHROPIC_API_KEY: 'provider', CLAUDE_CODE_OAUTH_TOKEN: 'internal', HF_TOKEN: 'hf' }
+    const allowed = new Set(Object.keys(env))
+    expect(expandHttpHookHeader('$HOOK_TOKEN/${ANTHROPIC_API_KEY}/$CLAUDE_CODE_OAUTH_TOKEN/$HF_TOKEN', allowed, new Set(), env)).toBe('customvalue///hf')
+    expect(expandHttpHookHeader('$ANTHROPIC_API_KEY/$CLAUDE_CODE_OAUTH_TOKEN', allowed, allowed, env)).toBe('provider/')
+  })
+
+  it.each(['127.0.0.1', '::1', '8.8.8.8', '2001:4860:4860::8888', '::ffff:127.0.0.1'])('allows loopback or public address %s', (address) => {
+    expect(blockedHttpHookAddress(address)).toBe(false)
+  })
+  it.each(['0.0.0.0', '10.1.2.3', '172.16.0.1', '100.64.0.1', '192.168.1.1', '169.254.1.1', '::', 'fd00::1', 'fe80::1', '::ffff:192.168.1.1'])('blocks private address %s', (address) => {
+    expect(blockedHttpHookAddress(address)).toBe(true)
+  })
+  it.each([
+    ['https://hooks.example/a/b', 'https://hooks.example', true],
+    ['https://hooks.example/a', 'https://hooks.example/', false],
+    ['https://sub.example:8443/a', 'https://*.example', true],
+    ['https://hooks.example:8443/a', 'https://hooks.example:*', true],
+    ['http://hooks.example/a', 'https://hooks.example/*', false],
+    ['https://hooks.example/a?q=1#ignored', 'https://hooks.example/*?q=*', true],
+  ])('matches %s against %s', (url, pattern, expected) => {
+    expect(matchesHttpHookUrl(url, pattern)).toBe(expected)
+  })
+})
