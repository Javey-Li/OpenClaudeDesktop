index 0000000000..24bedb76e8
--- /dev/null
+++ b/packages/workflow/tool-workflow/src/claude-script.ts
@@ -0,0 +1,45 @@
+/** Claude script headers are parsed as data at the tool edge; the engine accepts body-only JavaScript. */
+import { parse, tokenizer } from 'acorn'
+import JSON5 from 'json5'
+import type { WorkflowMeta } from '@deepseek-ai/dsh-workflow'
+
+/** Locate the end of the leading metadata object without parsing the body.
+ * @param source - Complete workflow script.
+ * @returns UTF-16 offset immediately after the metadata object's closing brace.
+ */
+export function metadataEnd(source: string): number {
+  const tokens = tokenizer(source, { ecmaVersion: 'latest' })
+  for (const expected of ['export', 'const', 'meta', '=', '{']) {
+    const token = tokens.getToken()
+    if ((token.type.label === 'name' && 'value' in token ? token.value : token.type.label) !== expected) {
+      throw new Error('expected export const meta = { ... }')
+    }
+  }
+  let depth = 1
+  while (depth > 0) {
+    const token = tokens.getToken()
+    if (token.type.label === 'eof') throw new Error('unterminated workflow meta object')
+    if (token.type.label === '{' || token.type.label === '${') depth++
+    if (token.type.label === '}') depth--
+    if (depth === 0) return token.end
+  }
+  throw new Error('unterminated workflow meta object')
+}
+
+/** Strip a leading literal meta declaration without evaluating any JavaScript.
+ * @param source - Complete workflow script with an optional literal metadata export.
+ * @param validateBody - False reads only the leading metadata for registry discovery.
+ * @returns Body preserving original line positions, plus the parsed metadata when present.
+ */
+export function parseClaudeCodeScript(source: string, validateBody = true): { script: string; meta?: WorkflowMeta } {
+  const prefix = validateBody ? source : source.slice(0, metadataEnd(source))
+  const program = parse(prefix, { ecmaVersion: 'latest', sourceType: 'script', allowImportExportEverywhere: true, allowAwaitOutsideFunction: true, allowReturnOutsideFunction: true })
+  const first = program.body[0]
+  if (first?.type !== 'ExportNamedDeclaration') return { script: source }
+  if (first.declaration?.type !== 'VariableDeclaration' || first.declaration.kind !== 'const' || first.declaration.declarations.length !== 1) throw new Error('expected export const meta = { ... }')
+  const declaration = first.declaration.declarations[0]
+  if (!declaration || declaration.id.type !== 'Identifier' || declaration.id.name !== 'meta' || declaration.init?.type !== 'ObjectExpression') throw new Error('expected one literal workflow meta object')
+  // JSON5 accepts JavaScript object spelling and comments, but never evaluates expressions.
+  const meta: WorkflowMeta = JSON5.parse(source.slice(declaration.init.start, declaration.init.end))
+  return { meta, script: source.slice(0, first.start) + source.slice(first.start, first.end).replace(/[^\r\n]/g, ' ') + source.slice(first.end) }
+}
