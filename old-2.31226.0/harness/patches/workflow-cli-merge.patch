diff --git a/packages/workflow/workflow-ptc/src/warmup.ts b/packages/workflow/workflow-ptc/src/warmup.ts
new file mode 100644
index 0000000000..f3e83df6dd
--- /dev/null
+++ b/packages/workflow/workflow-ptc/src/warmup.ts
@@ -0,0 +1,36 @@
+/** Coordinate cold requests with the same prompt prefix within one workflow. */
+import { setTimeout as delay } from 'node:timers/promises'
+
+/** Per-workflow cache of leaders whose first response warms a shared prompt prefix. */
+export class PrefixWarmup {
+  private readonly entries = new Map<string, { ready: Promise<void>; expires: number }>()
+
+  constructor(private readonly waitMs: number, private readonly ttlMs: number) {}
+
+  /** Followers wait for the leader's first response, bounded by the configured window.
+   * @param key - Stable prompt-prefix identity shared by matching child requests.
+   * @param signal - Cancels a follower's wait.
+   * @returns Idempotent completion callback; false evicts a leader that received no response.
+   */
+  async enter(key: string, signal: AbortSignal): Promise<(responded: boolean) => void> {
+    const existing = this.entries.get(key)
+    if (existing && existing.expires > Date.now()) {
+      const timer = new AbortController()
+      try { await Promise.race([existing.ready, delay(this.waitMs, undefined, { signal: AbortSignal.any([signal, timer.signal]) })]) }
+      finally { timer.abort() }
+      signal.throwIfAborted()
+      return () => {}
+    }
+    const { promise, resolve } = Promise.withResolvers<void>()
+    const entry = { ready: promise, expires: Date.now() + this.ttlMs }
+    this.entries.set(key, entry)
+    let released = false
+    return (responded) => {
+      if (released) return
+      released = true
+      if (!responded) this.entries.delete(key)
+      else entry.expires = Date.now() + this.ttlMs
+      resolve()
+    }
+  }
+}
