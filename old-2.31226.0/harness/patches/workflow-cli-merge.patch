@@ -0,0 +1,32 @@
+/** Validate hook-authored arguments without coercion, defaults, or remote schema loading. */
+
+import { Ajv, type ValidateFunction } from 'ajv'
+import { Ajv2019 } from 'ajv/dist/2019.js'
+import { Ajv2020 } from 'ajv/dist/2020.js'
+
+const validators = new WeakMap<object, ValidateFunction>()
+
+/**
+ * Explain invalid rewritten input, excluding extra-key errors as Claude's hook validator does.
+ * @param schema - the visible tool's JSON parameter schema.
+ * @param value - arguments parsed from a command hook's JSON output.
+ * @returns a validation reason, or undefined when the input is accepted.
+ */
+export function rewrittenInputError(schema: Record<string, unknown>, value: unknown): string | undefined {
+  try {
+    let validate = validators.get(schema)
+    if (validate === undefined) {
+      const dialect = schema['$schema']
+      const options = { strict: false, allErrors: true, validateFormats: false }
+      const ajv = typeof dialect === 'string' && dialect.includes('2020-12') ? new Ajv2020(options)
+        : typeof dialect === 'string' && dialect.includes('2019-09') ? new Ajv2019(options) : new Ajv(options)
+      validate = ajv.compile(schema)
+      validators.set(schema, validate)
+    }
+    validate(value)
+    const errors = (validate.errors ?? []).filter(error => error.keyword !== 'additionalProperties')
+    return errors.length === 0 ? undefined : errors.map(error => `${error.instancePath || '/'} ${error.message ?? error.keyword}`).join('; ')
+  } catch (error: unknown) {
+    return `cannot validate rewritten arguments: ${error instanceof Error ? error.message : String(error)}`
+  }
+}
