@@ -0,0 +1,66 @@
+/** Provider error classification and exact request-to-history reasoning coordinates. */
+import type { LlmFailure, RequestMessage } from '@deepseek-ai/dsh-llm'
+import { readReplay } from './replay.ts'
+import type { WireBlock, WireRequest } from './wire-types.ts'
+
+function identity(block: WireBlock | undefined): string | undefined {
+  const value = block?.type === 'thinking' ? block.signature : block?.type === 'redacted_thinking' ? block.data : undefined
+  return typeof value === 'string' && value.length > 0 ? `${block?.type}:${value}` : undefined
+}
+
+function signatureError(message: string): boolean {
+  const normalized = message.toLowerCase().replaceAll('`', '')
+  return normalized.includes('signature in thinking block')
+    || normalized.includes('invalid data in redacted_thinking block')
+    || (normalized.includes('thinking.signature') && normalized.includes('field required'))
+    || ((normalized.includes('thinking block') || normalized.includes('redacted_thinking'))
+      && (normalized.includes('cannot be modified') || normalized.includes('invalid signature')))
+    || /capability_rejected: thinking_signature(?![A-Za-z0-9_:.-])/.test(message)
+}
+
+/**
+ * Select a reasoning-recovery decision for a rejected request, without changing history.
+ * @param failure - normalized HTTP failure.
+ * @param headers - provider coordinates for a prefix mismatch.
+ * @param body - exact serialized request that was rejected.
+ * @param history - immutable history used to build that request.
+ * @returns a whole-history or unique suffix decision; absent when no repair is possible.
+ */
+export function reasoningRecovery(
+  failure: LlmFailure, headers: Headers, body: WireRequest, history: readonly RequestMessage[],
+): LlmFailure['reasoningRecovery'] {
+  if (failure.status !== 400) return undefined
+  const message = failure.message.toLowerCase()
+  const prefix = message.includes('not created in this conversation') || message.includes('bound to a different conversation')
+  if (!prefix && !signatureError(failure.message)) return undefined
+  if (!body.messages.some(message => message.role === 'assistant'
+    && message.content.some(block => block.type === 'thinking' || block.type === 'redacted_thinking'))) return undefined
+  if (!prefix) return {}
+  const header = headers.get('anthropic-thinking-prefix-mismatch')
+  if (!header || header.length > 2048) return {}
+  const fields = new Map<string, string>()
+  for (const field of header.split(';')) {
+    const separator = field.indexOf('=')
+    if (separator <= 0) continue
+    const key = field.slice(0, separator).trim()
+    if (!fields.has(key)) fields.set(key, field.slice(separator + 1).trim())
+  }
+  const position = /^messages\.(\d{1,6})\.content\.(\d{1,6})$/.exec(fields.get('block') ?? '')
+  if (!position) return {}
+  const wire = body.messages[Number(position[1])]
+  const key = wire?.role === 'assistant' ? identity(wire.content[Number(position[2])]) : undefined
+  if (key === undefined) return {}
+  let from: NonNullable<LlmFailure['reasoningRecovery']>['from']
+  for (const message of history) {
+    if (message.role !== 'assistant') continue
+    const replay = readReplay(message, message.source.model)
+    for (const [blockIndex, metadata] of (replay ?? []).entries()) {
+      const candidate = metadata.redactedData !== undefined ? `redacted_thinking:${metadata.redactedData}`
+        : metadata.signature !== undefined ? `thinking:${metadata.signature}` : undefined
+      if (candidate !== key) continue
+      if (from !== undefined) return {}
+      from = { messageId: message.id, blockIndex }
+    }
+  }
+  return from === undefined ? {} : { from }
+}
