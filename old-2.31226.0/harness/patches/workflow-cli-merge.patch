@@ -0,0 +1,27 @@
+/** Stable identities shared by host journaling and guest prefix comparison. */
+import { createHash } from 'node:crypto'
+import type { ChildStartRequest, JournalEntry } from './types.ts'
+
+/** Stable JSON key order for semantically identical option objects. */
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical)
+  if (value !== null && typeof value === 'object') return Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b, 'en')).map(([key, item]) => [key, canonical(item)]))
+  return value
+}
+
+/** Hash a JSON input without copying prompts into guest initialization.
+ * @param value - JSON value to hash with stable object key ordering.
+ * @returns Hexadecimal SHA-256 digest.
+ */
+export function digest(value: unknown): string {
+  return createHash('sha256').update(JSON.stringify(canonical(value))).digest('hex')
+}
+
+/** Derive a call's journal key from its raw computed prompt and normalized options.
+ * @param request - Computed prompt, options and nested execution scope.
+ * @returns Digests used to compare one settled journal entry.
+ */
+export function callKey(request: ChildStartRequest): Pick<JournalEntry, 'promptHash' | 'optsHash'> {
+  const { label: _label, phase: _phase, stallMs: _stallMs, ...options } = request.options ?? {}
+  return { promptHash: digest(request.prompt), optsHash: digest({ options, scope: request.scope ?? '', previousKey: request.previousKey ?? '' }) }
+}
diff --git a/packages/workflow/workflow-ptc/src/compiler.ts b/packages/workflow/workflow-ptc/src/compiler.ts
