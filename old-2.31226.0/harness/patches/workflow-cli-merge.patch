@@ -0,0 +1,121 @@
+import recoveryFixture from '../../../sdk/client/tests/fixtures/streaming-text-recovery.json'
+/** Required stream markers remain readable through strict V4 physical restoration. */
+import { describe, expect, it } from 'vitest'
+import { createAssistantMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import { KNOWN_SESSION_EVENT_TYPES, Session, SessionId, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+import { restoreReleasedV4Artifact } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+import type { SessionFormatArtifact, SessionFormatEvent } from '@deepseek-ai/dsh-session-format'
+import { sessionFormatCatalog } from '../src/index.ts'
+
+function fixture(transport?: 'non-streaming') {
+  const session = Session.create(SessionId('strict-stream'))
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  const start = session.append('assistant/stream-start', {
+    turn: 1, step: 1, provider: 'mock', model: 'mock', ...transport === undefined ? {} : { transport },
+  })
+  const block = { type: 'tool-call' as const, id: ToolCallId('write'), name: 'write', arguments: '{}' }
+  const stream = [{ type: 'chunk' as const, time: 1, chunk: { type: 'block-end' as const, index: 0, block } }]
+  const checkpoint = session.append('assistant/message', {
+    turn: 1, step: 1, stream,
+    message: createAssistantMessage({ content: [block], source: { provider: 'mock', model: 'mock' } }),
+  }, { surfaceOp: 'append' })
+  session.append('tool/call', { turn: 1, step: 1, callId: block.id, name: block.name, arguments: block.arguments })
+  session.append('tool/result', {
+    turn: 1, step: 1,
+    message: createToolResultMessage({ callId: block.id, isError: false, content: [{ type: 'text', text: 'written' }] }),
+  }, { surfaceOp: 'append' })
+  const attempt = session.append('assistant/attempt', { turn: 1, step: 1, stream: [...stream, {
+    type: 'chunk', time: 2, chunk: { type: 'finish', reason: { kind: 'tool-calls' }, replayState: { response: { id: 'opaque' }, blocks: [{ id: 'signed' }] } },
+  }] })
+  session.append('assistant/stream-merge', { turn: 1, step: 1, startSeq: start.seq, attemptSeq: attempt.seq, messageSeqs: [checkpoint.seq] })
+  session.append('step/end', { turn: 1, step: 1 })
+  session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  return session
+}
+
+function artifact(session: Session): SessionFormatArtifact {
+  return JSON.parse(JSON.stringify({
+    header: { ...session.header, delegationDepth: 0 }, events: session.snapshotEvents(), inheritedEventCount: 0,
+  })) as SessionFormatArtifact
+}
+
+describe('strict streaming response persistence', () => {
+  it.each(['valid', 'unknown', 'mismatch'] as const)('physically restores the %s unclosed-block policy without promoting partial text', (variant) => {
+    const session = fixture()
+    const current = artifact(session)
+    const reader = sessionFormatCatalog.createRestore(
+      sessionFormatCatalog.encodeCurrentHeader(current.header, 0), { recovery: 'strict', validation: 'current' },
+    )
+    const rows = recoveryFixture.map(event => event.type === 'assistant/stream-start' && variant === 'unknown'
+      ? { ...event, data: { ...event.data, incompleteBlocks: 'unknown' } }
+      : event.type === 'assistant/stream-merge' && variant === 'mismatch'
+        ? { ...event, data: { ...event.data, incompleteBlocks: undefined } } : event)
+    const restore = () => {
+      for (const event of rows) {
+        reader.decodeRow(sessionFormatCatalog.encodeCurrentEvent(JSON.parse(JSON.stringify(event)) as SessionFormatEvent))
+      }
+      return reader.finish()
+    }
+    if (variant !== 'valid') {
+      expect(restore).toThrow(/incompleteBlocks|assistant\/stream/)
+      return
+    }
+    const restored = restore()
+    const header = JSON.parse(JSON.stringify(restored.header)) as SessionHeader
+    const fresh = Session.fromRestore(session.id, restored.events as SessionEvent[], header, SessionLogOffset(0), 'detached')
+    expect(fresh.deriveMessages().flatMap(message => message.content)).toEqual([{ type: 'text', text: 'kept text' }])
+    expect(restored.events).toEqual(recoveryFixture)
+  })
+
+  it.each([undefined, 'non-streaming'] as const)('round trips %s transport, opaque replay state, and tool pairing', (transport) => {
+    const session = fixture(transport)
+    const original = artifact(session)
+    const reader = sessionFormatCatalog.createRestore(
+      sessionFormatCatalog.encodeCurrentHeader(original.header, 0), { recovery: 'strict', validation: 'current' },
+    )
+    for (const event of original.events) reader.decodeRow(sessionFormatCatalog.encodeCurrentEvent(event))
+    const restored = reader.finish()
+    expect(restored.events).toEqual(original.events)
+    const header = JSON.parse(JSON.stringify(restored.header)) as SessionHeader
+    const events = JSON.parse(JSON.stringify(restored.events)) as SessionEvent[]
+    const fresh = Session.fromRestore(session.id, events, header, SessionLogOffset(0), 'detached')
+    expect(fresh.deriveMessages()).toEqual(session.deriveMessages())
+  })
+
+  it.each([false, true])('makes an older vocabulary refuse the %s completed stream instead of misreading intermediate messages', (completed) => {
+    const current = artifact(fixture())
+    const oldVocabulary = new Set([...KNOWN_SESSION_EVENT_TYPES].filter(type => type !== 'assistant/stream-start' && type !== 'assistant/stream-merge'))
+    const events = completed ? current.events : current.events.slice(0, 4)
+    expect(() => restoreReleasedV4Artifact({ ...current, events }, oldVocabulary)).toThrow(/unknown event type.*assistant\/stream-start/)
+  })
+
+  it('rejects a forged merge through strict physical restoration', () => {
+    const session = fixture()
+    const current = artifact(session)
+    const reader = sessionFormatCatalog.createRestore(
+      sessionFormatCatalog.encodeCurrentHeader(current.header, 0), { recovery: 'strict', validation: 'current' },
+    )
+    const rows: SessionFormatEvent[] = current.events.map(event => event.type === 'assistant/stream-merge'
+      ? { ...event, data: { ...event.data as object, attemptSeq: 0 } } : event)
+    expect(() => {
+      for (const event of rows) reader.decodeRow(sessionFormatCatalog.encodeCurrentEvent(event))
+      reader.finish()
+    }).toThrow(/assistant\/stream-merge/)
+  })
+
+  it('rejects an unknown transport through strict physical restoration', () => {
+    const session = fixture()
+    const current = artifact(session)
+    const reader = sessionFormatCatalog.createRestore(
+      sessionFormatCatalog.encodeCurrentHeader(current.header, 0), { recovery: 'strict', validation: 'current' },
+    )
+    const rows = current.events.map(event => event.type === 'assistant/stream-start'
+      ? { ...event, data: { ...event.data as object, transport: 'unknown' } } : event)
+    expect(() => {
+      for (const event of rows) reader.decodeRow(sessionFormatCatalog.encodeCurrentEvent(event))
+      reader.finish()
+    }).toThrow(/transport|assistant\/stream-start/)
+  })
+})
