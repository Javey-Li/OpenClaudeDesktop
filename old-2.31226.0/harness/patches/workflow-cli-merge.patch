+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { setupMerge } from './merge-setup.ts'
+
+it('executes the Claude CLI 2.1.280 review-changes pipeline with concrete schemas', async () => {
+  const t = await setupMerge()
+  let calls = 0
+  t.ctx.subagents.registerProvider({
+    name: 'review-example', inheritsParentContext: false,
+    capabilities: { agentOptions: true, outputSchema: true, depthLimit: false, persona: false, toolFilter: true },
+    async start(request) {
+      const id = ++calls
+      const structured = Object.hasOwn(request.outputSchema?.properties ?? {}, 'findings')
+        ? { findings: [{ title: `Issue ${id}`, file: `src/${id}.ts` }] }
+        : { isReal: true }
+      return { id: SessionId(`example-${id}`), localAgent: undefined, result: Promise.resolve({ output: [], structured, outputTokens: 3, stopReason: 'completed' as const }), dispose: async () => {} }
+    },
+  })
+  const body = await readFile(new URL('./fixtures/review-changes.js', import.meta.url), 'utf8')
+  const schemas = `
+const FINDINGS_SCHEMA = { type: 'object', properties: { findings: { type: 'array', items: { type: 'object', properties: { title: { type: 'string' }, file: { type: 'string' } }, required: ['title', 'file'], additionalProperties: false } } }, required: ['findings'], additionalProperties: false };
+const VERDICT_SCHEMA = { type: 'object', properties: { isReal: { type: 'boolean' } }, required: ['isReal'], additionalProperties: false };
+`
+  const run = t.start(schemas + body, { subagentProvider: 'review-example', budgetTotal: 100 })
+  expect(await run.result).toMatchObject({ stopReason: 'completed', agentsStarted: 4, value: { confirmed: [{ title: 'Issue 1', file: 'src/1.ts', verdict: { isReal: true } }, { title: 'Issue 2', file: 'src/2.ts', verdict: { isReal: true } }] } })
+  expect(calls).toBe(4)
+  await run.dispose()
+})
diff --git a/packages/workflow/workflow-ptc/tests/compiler.spec.ts b/packages/workflow/workflow-ptc/tests/compiler.spec.ts
new file mode 100644
index 0000000000..4d1d02d843
--- /dev/null
+++ b/packages/workflow/workflow-ptc/tests/compiler.spec.ts
@@ -0,0 +1,90 @@
+import * as vm from 'node:vm'
+import { describe, expect, it } from 'vitest'
+import { compileWorkflowBody, WORKFLOW_ASYNC_INIT_SOURCE } from '../src/compiler.ts'
+import { WORKFLOW_INTRINSICS_SOURCE } from '../src/intrinsics.ts'
+
+async function evaluate(body: string): Promise<unknown> {
+  const context = vm.createContext({}, { codeGeneration: { strings: false, wasm: false } })
+  vm.runInContext(WORKFLOW_INTRINSICS_SOURCE, context)
+  vm.runInContext(WORKFLOW_ASYNC_INIT_SOURCE, context)
+  const script = new vm.Script(compileWorkflowBody(body))
+  const value: unknown = await script.runInContext(context, { timeout: 1000 })
+  return value === undefined ? null : JSON.parse(JSON.stringify(value))
+}
+
+describe('workflow compiler', () => {
+  it.each([
+    ['const __wRg$secret=1;return 1', "Identifier '__wRg$secret' is reserved."],
+    ['if(false)__wRg$secret;return 1', "Identifier '__wRg$secret' is reserved."],
+    ['const f=(__wRg$secret)=>1;return 1', "Identifier '__wRg$secret' is reserved."],
+    ['return {__wRg$secret}', "Identifier '__wRg$secret' is reserved."],
+    ['if(false)import("node:fs");return 1', 'import() is not available in workflow scripts.'],
+    ['await using resource=null;return 1', "'await using' declarations are not supported in workflow scripts."],
+  ])('rejects unsupported source before evaluation: %s', (body, message) => {
+    expect(() => compileWorkflowBody(body)).toThrow(message)
+  })
+
+  it.each([
+    ['return ({__wRg$secret:1}).__wRg$secret', 1],
+    ['__wRg$label: for(let i=0;i<1;i++)break __wRg$label;return 1', 1],
+    ['return "__wRg$secret"', '__wRg$secret'],
+  ])('permits property, label and string names outside bindings: %s', async (body, expected) => {
+    await expect(evaluate(body)).resolves.toEqual(expected)
+  })
+
+  it('resolves async iterator values and completion values in the guest', async () => {
+    await expect(evaluate(`
+      let index=0, completed=0;
+      const source={ [Symbol.asyncIterator]() { return { next() {
+        return { done: index===2, value: index++<2 ? Promise.resolve(index) : {then(resolve){completed++;resolve(0)}} };
+      } } } };
+      const values=[]; for await(const value of source)values.push([value,typeof value]);
+      return {values,completed};
+    `)).resolves.toEqual({ values: [[1, 'number'], [2, 'number']], completed: 1 })
+  })
+
+  it('captures iterator methods once and resolves early-return values', async () => {
+    await expect(evaluate(`
+      const calls=[];
+      const source={ [Symbol.asyncIterator]() { return {
+        get next(){calls.push('next');return ()=>({done:false,value:1})},
+        get return(){calls.push('return');return ()=>({done:true,value:{then(resolve){calls.push('settled');resolve(2)}}})},
+        get throw(){calls.push('throw')},
+      } } };
+      for await(const value of source)break;
+      return calls;
+    `)).resolves.toEqual(['next', 'return', 'throw', 'settled'])
+  })
+
+  it.each([
+    ['{[Symbol.asyncIterator]:1}', '@@asyncIterator is not a function'],
+    ['{[Symbol.asyncIterator](){return 1}}', 'Iterator is not an object'],
+    ['{[Symbol.asyncIterator](){return {next:1}}}', 'Iterator.next is not a function'],
+    ['{[Symbol.asyncIterator](){return {next(){return 1}}}}', 'Iterator result is not an object'],
+  ])('validates asynchronous iterator protocol: %s', async (source, message) => {
+    await expect(evaluate(`for await(const value of ${source}){}`)).rejects.toMatchObject({ name: 'TypeError', message })
+  })
+
+  it('preserves async generators, delegation and nested synchronous functions', async () => {
+    await expect(evaluate(`
+      async function* values(){function inner(){return {then:3}};yield inner().then;yield* [Promise.resolve(4)];return await Promise.resolve(5)}
+      const it=values();return [await it.next(),await it.next(),await it.next()];
+    `)).resolves.toEqual([{ value: 3, done: false }, { value: 4, done: false }, { value: 5, done: true }])
+  })
+
+  it('closes a delegated iterator before rejecting its missing throw method', async () => {
+    await expect(evaluate(`
+      let closed=0;
+      const source={ [Symbol.asyncIterator](){return {next(){return {value:1,done:false}},return(){closed++;return Promise.resolve({done:true})}}} };
+      async function* values(){yield* source} const it=values();await it.next();
+      try{await it.throw(Error('stop'))}catch(error){return [closed,error.message]}
+    `)).resolves.toEqual([1, 'The iterator does not provide a throw method'])
+  })
+
+  it('retains the captured guest resolver after replacing the Promise global', async () => {
+    await expect(evaluate(`
+      Promise={resolve(){throw Error('replacement')}};
+      const f=async()=>await ({then(resolve){resolve(7)}});return await f();
+    `)).resolves.toBe(7)
+  })
+})
