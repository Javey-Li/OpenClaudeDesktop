index 0000000000..c20124832e
--- /dev/null
+++ b/packages/workflow/workflow-ptc/src/boundary.ts
@@ -0,0 +1,270 @@
+/**
+ * Guest-local callbacks, value copies and host-call error records.
+ * Process confinement remains the responsibility of the PTC provider.
+ * @module @deepseek-ai/dsh-workflow-ptc/boundary
+ */
+
+/** String-only failure fields read in the script VM. */
+export interface WorkflowErrorInfo {
+  name: string
+  message: string
+  stack: string
+}
+
+/** Helpers created in one workflow's VM; values never share copies across calls. */
+export interface WorkflowBoundary {
+  /**
+   * Read an object-valued schema in this VM, containing failed getters.
+   * @param options - A child agent options bag.
+   * @returns The original schema reference, or undefined.
+   */
+  readSchema(options: unknown): object | undefined
+  /**
+   * Copy enumerable data into this VM, preserving aliases and cycles.
+   * @param value - Data to copy.
+   * @returns Guest data; functions become undefined.
+   */
+  clone(value: unknown): unknown
+  /**
+   * Convert a value inside the VM, containing failed conversion hooks.
+   * @param value - Value to stringify.
+   * @returns Its string or a fixed unprintable label.
+   */
+  toString(value: unknown): string
+  /**
+   * Read failure fields independently without invoking toString.
+   * @param error - Thrown value.
+   * @returns Name, message and stack strings.
+   */
+  errorInfo(error: unknown): WorkflowErrorInfo
+  /**
+   * Invoke a callback from this VM's stack with VM-owned arguments.
+   * @param callback - Guest callback.
+   * @param args - Arguments passed without cloning.
+   * @returns The unassimilated callback result.
+   */
+  call(callback: (...args: unknown[]) => unknown, ...args: unknown[]): unknown
+  /**
+   * Resolve in this VM and box the value to prevent host re-assimilation.
+   * @param value - Value or thenable.
+   * @returns A null-prototype record containing the settled value.
+   */
+  settle(value: unknown): Promise<{ value: unknown }>
+  /**
+   * Wrap a host hook in a guest Promise and consume dropped rejections.
+   * @param callback - Host hook with normalized errors.
+   * @returns A guest callable with a rejection observer.
+   */
+  asyncWrap(callback: (...args: unknown[]) => unknown): (...args: unknown[]) => Promise<unknown>
+  /**
+   * Read dense slots without consulting custom iteration methods.
+   * @param value - Array-like input.
+   * @param maximum - Maximum supported length.
+   * @returns One slot per index; failed reads become undefined.
+   */
+  snapshot(value: unknown, maximum: number): unknown[]
+}
+
+/** Install after intrinsic hardening; evaluate once for each script VM. */
+export const WORKFLOW_BOUNDARY_SOURCE = String.raw`(() => {
+  'use strict';
+  const freeze = Object.freeze, proto = Object.getPrototypeOf, setProto = Object.setPrototypeOf;
+  const objectProto = Object.prototype, keys = Object.keys, define = Object.defineProperty;
+  const isArray = Array.isArray, safeInteger = Number.isSafeInteger;
+  const Map = WeakMap, Set = WeakSet, Failure = Error;
+  const apply = Reflect.apply, then = Promise.prototype.then;
+  const string = String;
+  const caps = new Set();
+  const capError = message => { const error = new Failure(message); caps.add(error); return error; };
+  const lengthOf = (value, maximum) => {
+    let length;
+    try { length = value.length; }
+    catch { throw new Failure('unable to read array length across the workflow VM boundary'); }
+    if (!safeInteger(length)) throw capError('array length is not a safe integer across the workflow VM boundary');
+    if (length > maximum) throw capError('array length ' + length + ' exceeds the maximum of ' + maximum + ' supported across the workflow VM boundary');
+    return length;
+  };
+  const clone = value => {
+    const copies = new Map();
+    const copy = input => {
+      if (typeof input === 'function') return undefined;
+      if (input === null || typeof input !== 'object') return input;
+      if (copies.has(input)) return copies.get(input);
+      const array = isArray(input), output = array ? [] : {};
+      copies.set(input, output);
+      if (array) {
+        const length = lengthOf(input, 4096);
+        for (let i = 0; i < length; i++) {
+          try { output[i] = copy(input[i]); }
+          catch (error) { if (caps.has(error)) throw error; output[i] = undefined; }
+        }
+      } else {
+        let names;
+        try { names = keys(input); } catch { return output; }
+        for (const name of names) {
+          if (name === '__proto__') continue;
+          try {
+            const item = input[name];
+            if (typeof item !== 'function') define(output, name, { value: copy(item), writable: true, enumerable: true, configurable: true });
+          } catch (error) { if (caps.has(error)) throw error; }
+        }
+      }
+      return output;
+    };
+    return copy(value);
+  };
+  const seal = error => {
+    let name = 'Error', message = '<non-string error>', stack;
+    try { const value = error?.name; if (typeof value === 'string') name = value; } catch {}
+    try { const value = error?.message; message = typeof value === 'string' ? value : typeof error === 'string' ? error : '<non-string error>'; }
+    catch { message = '<unprintable thrown value>'; }
+    try { const value = error?.stack; if (typeof value === 'string') stack = value; } catch {}
+    const toString = setProto(() => name + ': ' + message, null);
+    return freeze({ __proto__: null, name, message, stack: stack ?? name + ': ' + message, toString: freeze(toString) });
+  };
+  const fallback = seal({ message: 'host call failed at the VM boundary (details unavailable)' });
+  const own = error => {
+    for (let i = 0; i < 64; i++) {
+      error = proto(error);
+      if (error === objectProto) return true;
+      if (error === null) return false;
+    }
+    return false;
+  };
+  return {
+    clone,
+    readSchema: options => {
+      try { const value = options && typeof options === 'object' ? options.schema : undefined; return value && typeof value === 'object' ? value : undefined; }
+      catch { return undefined; }
+    },
+    toString: value => { try { return string(value); } catch { return '<unprintable>'; } },
+    errorInfo: error => {
+      let name = 'Error', message = '', stack = '';
+      try { const value = error?.name; if (typeof value === 'string') name = value; } catch {}
+      try {
+        const value = error?.message;
+        if (typeof value === 'string') message = value;
+        else if (typeof error === 'string') message = error;
+        else if (typeof error === 'number' || typeof error === 'boolean' || typeof error === 'bigint') message = string(error);
+      } catch {}
+      try { const value = error?.stack; if (typeof value === 'string') stack = value; } catch {}
+      return { __proto__: null, name, message, stack };
+    },
+    call: (callback, ...args) => callback(...args),
+    settle: async value => ({ __proto__: null, value: await value }),
+    snapshot: (value, maximum) => {
+      if (value === null || typeof value !== 'object') return [];
+      const length = lengthOf(value, maximum), output = [];
+      for (let i = 0; i < length; i++) { try { output[i] = value[i]; } catch { output[i] = undefined; } }
+      return output;
+    },
+    asyncWrap: host => {
+      const invoke = async (...args) => {
+        try { return await host(...args); }
+        catch (error) {
+          if (error === null || typeof error !== 'object' && typeof error !== 'function') throw error;
+          let local = false;
+          try { local = own(error); } catch {}
+          if (local) throw error;
+          let reason = fallback;
+          try { reason = seal(error); } catch {}
+          throw reason;
+        }
+      };
+      return (...args) => {
+        const promise = apply(invoke, undefined, args);
+        apply(then, promise, [undefined, () => {}]);
+        return promise;
+      };
+    },
+  };
+})()`
+
+/** First schema copies are retained by reference within one script's agent hook. */
+export class WorkflowSchemaMemo {
+  private readonly values = new WeakMap<object, unknown>()
+
+  /**
+   * Copy root options and retain own data-property schema references.
+   * @param options - Original script options.
+   * @param copy - The root options copier.
+   * @param isProxy - The runtime's proxy detector; proxy bags do not memoize.
+   * @returns Copied options with the first schema copy for this reference.
+   */
+  root(options: unknown, copy: (value: unknown) => unknown, isProxy: (value: object) => boolean): unknown {
+    let source: object | undefined
+    if (options !== null && typeof options === 'object' && !isProxy(options)) {
+      const descriptor = Object.getOwnPropertyDescriptor(options, 'schema')
+      const value: unknown = descriptor && 'value' in descriptor ? descriptor.value : undefined
+      if (value !== null && typeof value === 'object') source = value
+    }
+    const result = copy(options)
+    if (source && result !== null && typeof result === 'object') {
+      let schema = this.values.get(source)
+      if (schema === undefined) { schema = copy(source); this.values.set(source, schema) }
+      Object.assign(result, { schema })
+    }
+    return result
+  }
+
+  /**
+   * Retain a child's first schema copy before forwarding to the root hook.
+   * @param options - Original child options, including accessor/proxy bags.
+   * @param boundary - The child's copier and schema reader.
+   * @returns Copied options with the schema reference retained for this child.
+   */
+  child(options: unknown, boundary: Pick<WorkflowBoundary, 'clone' | 'readSchema'>): unknown {
+    const result = boundary.clone(options)
+    const source = boundary.readSchema(options)
+    if (source && result !== null && typeof result === 'object') {
+      const schema = this.values.get(source)
+      if (schema !== undefined) Object.assign(result, { schema })
+      else if ('schema' in result && result.schema !== undefined) this.values.set(source, result.schema)
+    }
+    return result
+  }
+}
+
+/** Convert a host failure to immutable string fields without exposing its prototype. */
+function errorRecord(error: unknown): Error {
+  const source = error as { name?: unknown; message?: unknown; stack?: unknown } | null | undefined
+  let name = 'Error', message = '<non-string error>', stack: string | undefined
+  try { const value = source?.message; message = typeof value === 'string' ? value : typeof error === 'string' ? error : '<non-string error>' }
+  catch (failure: unknown) { void failure; message = '<unprintable thrown value>' }
+  try { const value = source?.name; if (typeof value === 'string') name = value }
+  catch (failure: unknown) { void failure /* A throwing name does not discard the message. */ }
+  try { const value = source?.stack; if (typeof value === 'string') stack = value }
+  catch (failure: unknown) { void failure /* Stack is optional diagnostic data. */ }
+  const toString = () => `${name}: ${message}`
+  Object.setPrototypeOf(toString, null)
+  Object.freeze(toString)
+  return Object.freeze({ __proto__: null, name, message, stack: stack ?? `${name}: ${message}`, toString })
+}
+
+/**
+ * Expose a synchronous host hook with no inherited host methods.
+ * @param callback - Host implementation; thrown values become immutable error records.
+ * @returns A callable with a null prototype.
+ */
+export function wrapWorkflowHostCall(callback: (...args: unknown[]) => unknown): (...args: unknown[]) => unknown {
+  const wrapped = (...args: unknown[]) => {
+    try { return callback(...args) }
+    catch (error: unknown) { throw errorRecord(error) }
+  }
+  Object.setPrototypeOf(wrapped, null)
+  return wrapped
+}
+
+/**
+ * Normalize asynchronous host failures before creating a guest Promise wrapper.
+ * @param callback - Host implementation whose result may be a Promise.
+ * @returns A callable with a null prototype and immutable rejection records.
+ */
+export function wrapWorkflowHostAsync(callback: (...args: unknown[]) => unknown): (...args: unknown[]) => Promise<unknown> {
+  const wrapped = async (...args: unknown[]) => {
+    try { return await callback(...args) }
+    catch (error: unknown) { throw errorRecord(error) }
+  }
+  Object.setPrototypeOf(wrapped, null)
+  return wrapped
+}
