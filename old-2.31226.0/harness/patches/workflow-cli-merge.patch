@@ -0,0 +1,87 @@
+/** Read named Claude MCP declarations without starting transports or mutating settings. */
+import { homedir } from 'node:os'
+import { join, posix } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-fs'
+import { isAgentDirectoryTrusted } from './agent-trust.ts'
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+/** Read local, approved project-ancestor and user declarations in precedence order.
+ * @param ctx - Parent execution-world context.
+ * @param cwd - Original project directory, before worktree isolation.
+ * @param signal - Cancels bounded configuration reads.
+ * @returns A lookup of candidates; connection validation decides which candidate survives.
+ */
+export async function readAgentMcpConfigs(ctx: Context, cwd: string, signal: AbortSignal): Promise<(name: string) => unknown[]> {
+  signal.throwIfAborted()
+  const fs = ctx.get('fs')
+  if (!fs || fs.processPathFromHostPath(cwd) !== cwd) return () => []
+  const read = async (path: string | undefined): Promise<Record<string, unknown>> => {
+    if (path === undefined) return {}
+    try {
+      const target = await fs.resolve(path, { cwd, signal })
+      if ((await fs.stat(target, signal))?.type !== 'file') return {}
+      const parsed: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 2_097_152)))
+      if (!record(parsed)) throw new Error('expected an object')
+      return parsed
+    } catch (_error: unknown) {
+      signal.throwIfAborted()
+      // Parser diagnostics can include file contents and credentials.
+      ctx.logger.warn(`Could not read agent MCP configuration: ${path}`)
+      return {}
+    }
+  }
+  const user = fs.processPathFromHostPath(join(homedir(), '.claude'))
+  const global = await read(fs.processPathFromHostPath(join(homedir(), '.claude.json')))
+  const projectKey = fs.processPath(await fs.resolve(cwd, { signal }))
+  const local = record(global.projects) && record(global.projects[projectKey]) ? global.projects[projectKey] : {}
+  const settings = [
+    await read(user === undefined ? undefined : posix.join(user, 'settings.json')),
+    await read(posix.join(cwd, '.claude/settings.json')),
+    await read(posix.join(cwd, '.claude/settings.local.json')),
+  ]
+  const trusted = await isAgentDirectoryTrusted(ctx, cwd, signal)
+  const matches = (value: unknown, name: string) => Array.isArray(value)
+    && value.some(entry => typeof entry === 'string'
+      && entry.replace(/[^a-zA-Z0-9_-]/g, '_') === name)
+  const approved = (name: string) => !settings.some(value => matches(value.disabledMcpjsonServers, name))
+    && settings.some((value, index) => (index === 0 || trusted)
+      && (value.enableAllProjectMcpServers === true || matches(value.enabledMcpjsonServers, name)))
+  const servers = (value: Record<string, unknown>): Record<string, unknown> => record(value.mcpServers) ? value.mcpServers : {}
+  const project: Record<string, unknown>[] = []
+  for (let directory = cwd; posix.dirname(directory) !== directory; directory = posix.dirname(directory)) {
+    project.push(servers(await read(posix.join(directory, '.mcp.json'))))
+  }
+  signal.throwIfAborted()
+  return name => [servers(local), ...approved(name) ? project : [], servers(global)]
+    .filter(value => Object.hasOwn(value, name)).map(value => value[name])
+}
+
+/** Expand disk-config command, arguments, environment, URL and header strings once.
+ * @param ctx - Diagnostics owner; no expanded value is logged.
+ * @param name - MCP server identity for missing-variable warnings.
+ * @param config - Untrusted connection object; non-string fields remain for schema validation.
+ * @returns A copy with native-style substitutions; missing variables retain their placeholder.
+ */
+export function expandAgentMcpConfig(ctx: Context, name: string, config: Record<string, unknown>): Record<string, unknown> {
+  const missing = new Set<string>()
+  const expand = (value: unknown): unknown => typeof value !== 'string' ? value : value.replace(/\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}/g, (placeholder: string, key: string, fallback: string | undefined) => {
+    if (process.env[key] !== undefined) return process.env[key]
+    if (fallback !== undefined) return fallback
+    missing.add(key)
+    return placeholder
+  })
+  const dictionary = (value: unknown): unknown => record(value)
+    ? Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, expand(entry)])) : value
+  const result = config.type === undefined || config.type === 'stdio'
+    ? {
+      ...config, command: expand(config.command),
+      args: Array.isArray(config.args) ? config.args.map(expand) : config.args, env: dictionary(config.env),
+    }
+    : { ...config, url: expand(config.url), headers: dictionary(config.headers) }
+  if (missing.size) ctx.logger.warn(`Agent MCP server '${name}' has missing environment variables: ${[...missing].join(', ')}`)
+  return result
+}
