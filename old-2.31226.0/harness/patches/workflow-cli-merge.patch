+it('pairs queued identities with publication or failure and counts unpublished invocations', async () => {
+  const ctx = await setup(), run = info()
+  ctx.emit('workflow/start', run)
+  const queued = { seq: 1, label: 'reviewer', state: 'queued' as const, queuedAt: 1, lastProgressAt: 1 }
+  expect(() => { ctx.emit('workflow/agent-admission', run, { ...queued, state: 'failed', error: 'early' }) }).toThrow()
+  ctx.emit('workflow/agent-admission', run, queued)
+  expect(() => { ctx.emit('workflow/agent-admission', run, queued) }).toThrow()
+  expect(() => { ctx.emit('workflow/agent-start', run, agent({ label: 'different' })) }).toThrow()
+  ctx.emit('workflow/agent-start', run, agent())
+  expect(() => { ctx.emit('workflow/agent-admission', run, { ...queued, state: 'failed', error: 'late' }) }).toThrow()
+  ctx.emit('workflow/agent-end', run, agentEnd())
+  expect(() => { ctx.emit('workflow/agent-start', run, agent()) }).toThrow()
+  ctx.emit('workflow/agent-admission', run, { ...queued, seq: 2 })
+  ctx.emit('workflow/agent-admission', run, { ...queued, seq: 2, state: 'failed', error: 'startup failed' })
+  expect(() => { ctx.emit('workflow/agent-start', run, agent({ seq: 2 })) }).toThrow()
+  ctx.emit('workflow/agent-admission', run, { ...queued, seq: 3 })
+  expect(() => { ctx.emit('workflow/end', run, result({ agentsStarted: 2 })) }).toThrow()
+  ctx.emit('workflow/end', run, result({ agentsStarted: 3 }))
+})
