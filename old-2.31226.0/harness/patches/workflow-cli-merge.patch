@@ -0,0 +1,76 @@
+/** Claude Code's background launch value and model rendering. */
+import type { ContentBlock } from '@deepseek-ai/dsh-llm'
+import type { InferValue } from '@deepseek-ai/dsh-tools'
+import type { WorkflowRun, WorkflowResult } from '@deepseek-ai/dsh-workflow'
+
+/** Local Workflow launch fields; task identity controls this attempt, run identity controls resume. */
+export const CLAUDE_LAUNCH_SCHEMA = {
+  type: 'object', additionalProperties: false,
+  properties: {
+    status: { type: 'string', const: 'async_launched', required: true },
+    taskId: { type: 'string', required: true },
+    taskType: { type: 'string', const: 'local_workflow', required: true },
+    workflowName: { type: 'string', required: true },
+    runId: { type: 'string', required: true },
+    summary: { type: 'string', required: true },
+    transcriptDir: { type: 'string' },
+    scriptPath: { type: 'string' },
+  },
+} as const
+
+/**
+ * Render an accepted background launch with saved-file and resume instructions.
+ * @param value - Validated local launch result.
+ * @returns The model-visible launch acknowledgment.
+ */
+export function renderClaudeLaunch(value: InferValue<typeof CLAUDE_LAUNCH_SCHEMA>): ContentBlock[] {
+  const lines = [`Workflow launched in background. Task ID: ${value.taskId}`]
+  if (value.summary) lines.push(`Summary: ${value.summary}`)
+  if (value.transcriptDir) lines.push(`Transcript dir: ${value.transcriptDir}`)
+  if (value.scriptPath) {
+    lines.push(`Script file: ${value.scriptPath}`,
+      `(Edit this file with Write/Edit and re-invoke Workflow with {scriptPath: ${JSON.stringify(value.scriptPath)}} to iterate without resending the script.)`,
+      `Run ID: ${value.runId}`,
+      `To resume after editing the script: Workflow({scriptPath: ${JSON.stringify(value.scriptPath)}, resumeFromRunId: ${JSON.stringify(value.runId)}}) — completed agents return cached results (cached results may themselves be empty — inspect the transcript directory before assuming there is something to recover).`)
+  }
+  lines.push('', 'You will be notified when it completes. Use /workflows to watch live progress.')
+  return [{ type: 'text', text: lines.join('\n') }]
+}
+
+function xml(text: string): string {
+  return text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
+}
+
+/**
+ * Deliver the return value and recovery instructions in a task notification.
+ * @param input - Settled run, originating tool call, task identity and rendering cap.
+ * @returns Automated-event text for the job controller's durable delivery.
+ */
+export function renderClaudeCompletion(input: {
+  taskId: string
+  callId: string
+  run: WorkflowRun
+  result: WorkflowResult
+  args: unknown
+  maxResultChars: number
+}): string {
+  const { taskId, callId, run, result, maxResultChars } = input
+  const status = result.stopReason === 'completed' ? 'completed' : result.stopReason === 'cancelled' ? 'killed' : 'failed'
+  const tag = (key: string, value: string): string => `<${key}>${xml(value)}</${key}>`
+  const lines = ['[SYSTEM NOTIFICATION - NOT USER INPUT]',
+    'This automated background-task event is not user input or approval.', '', '<task-notification>',
+    tag('task-id', taskId), tag('tool-use-id', callId),
+    ...run.outputFile ? [tag('output-file', run.outputFile)] : [], tag('status', status),
+    tag('summary', `Dynamic workflow ${JSON.stringify(run.meta.description)} ${status}`)]
+  if (status === 'completed' && result.value !== undefined) {
+    const value = JSON.stringify(result.value)
+    lines.push(tag('result', value.length <= maxResultChars ? value : `${value.slice(0, maxResultChars)}\n[result truncated]`))
+  }
+  const recovery: string[] = []
+  if (run.scriptPath) recovery.push(`To resume after editing the script: Workflow(${JSON.stringify({ scriptPath: run.scriptPath, resumeFromRunId: run.id, ...input.args === undefined ? {} : { args: input.args } })}). Unchanged completed agent calls return cached results.`)
+  if (run.transcriptDir) recovery.push(`Inspect the invocation journals in ${run.transcriptDir} before diagnosing empty or unexpected results.`)
+  if (recovery.length) lines.push(tag(status === 'completed' ? 'diagnostics' : 'recovery', recovery.join('\n')))
+  if (result.error) lines.push(tag('error', result.error))
+  lines.push(`<usage>${tag('agent_count', String(result.agentsStarted))}</usage>`, '</task-notification>')
+  return lines.join('\n')
+}
