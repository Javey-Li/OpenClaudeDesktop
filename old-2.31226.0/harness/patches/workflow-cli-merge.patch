+/** Opaque provider data stays private, durable, and ordered across request projections. */
+import { expect, it, vi } from 'vitest'
+import { createAssistantMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, Message, StreamChunk } from '@deepseek-ai/dsh-llm'
+import { resolveAdapterOptions } from '../src/config.ts'
+import { readReplay, replayState } from '../src/replay.ts'
+import type { ReplayBlock } from '../src/replay.ts'
+import type { WireBlock } from '../src/wire-types.ts'
+import { serialize } from '../src/serialize.ts'
+import { translateComplete } from '../src/translate.ts'
+import { chunks, MODEL, options, user } from './helpers.ts'
+
+const connection = resolveAdapterOptions({})
+const payload = 'fixture-ciphertext+/=='
+const opaque = { type: 'reasoning', text: '' } as const
+const text = { type: 'text', text: 'answer' } as const
+const thinking = { type: 'reasoning', text: 'visible thought' } as const
+const signed = { type: 'reasoning', signature: 'fixture-signature' } as const
+const hidden = { type: 'reasoning', redactedData: payload } as const
+const assistant = (content: ContentBlock[], blocks: ReplayBlock[]) => createAssistantMessage({
+  content, source: { provider: 'deepseek-official', model: MODEL, replayState: replayState(MODEL, blocks) },
+})
+const body = (messages: Message[], model = MODEL, onDegrade?: (reason: string) => void) => serialize(
+  options({ messages, model }), connection, messages, new Map(), () => undefined, onDegrade,
+)
+
+it.each([payload, ''])('round-trips opaque bytes %j without inventing visible reasoning', (data) => {
+  const original = assistant([opaque, text], [{ type: 'reasoning', redactedData: data }, { type: 'text' }])
+  const saved = JSON.stringify(original)
+  const restored = JSON.parse(saved) as Message
+  expect(body([user(), restored]).messages[1]?.content).toEqual([{ type: 'redacted_thinking', data }, text])
+  expect(restored.content).toEqual([opaque, text])
+  expect(JSON.stringify(restored)).toBe(saved)
+})
+
+it('projects model switches without removing saved thinking, including a switch back', () => {
+  const original = assistant([thinking, opaque, text], [signed, hidden, { type: 'text' }])
+  const messages = [user(), JSON.parse(JSON.stringify(original)) as Message, user()]
+  const saved = JSON.stringify(messages)
+  const native = [{ type: 'thinking', thinking: thinking.text, signature: signed.signature }, { type: 'redacted_thinking', data: payload }, text]
+  const onDegrade = vi.fn()
+  expect(body(messages, MODEL, onDegrade).messages[1]?.content).toEqual(native)
+  expect(body(messages, 'other-model', onDegrade).messages[1]?.content).toEqual([text])
+  expect(body(messages, MODEL, onDegrade).messages[1]?.content).toEqual(native)
+  expect(onDegrade).not.toHaveBeenCalled()
+  expect(JSON.stringify(messages)).toBe(saved)
+})
+
+it.each([
+  { content: [opaque], blocks: [hidden] },
+  { content: [thinking, opaque], blocks: [signed, hidden] },
+])('omits a trailing thinking-only response while retaining its durable data %#', ({ content, blocks }) => {
+  const message = assistant(content, blocks)
+  const history = [user(), message]
+  const saved = JSON.stringify(history)
+  expect(body(history).messages).toHaveLength(1)
+  expect(body([...history, user()]).messages).toHaveLength(3)
+  expect(JSON.stringify(history)).toBe(saved)
+})
+
+it.each([
+  { content: [opaque, text], blocks: [{ type: 'reasoning', redactedData: 42 }, { type: 'text' }] },
+  { content: [opaque, text], blocks: [{ ...hidden, signature: 'invalid' }, { type: 'text' }] },
+  { content: [thinking, text], blocks: [hidden, { type: 'text' }] },
+  { content: [text], blocks: [{ type: 'text', redactedData: payload }] },
+])('rejects corrupt opaque metadata without exposing it %#', ({ content, blocks }) => {
+  const message = createAssistantMessage({ content, source: {
+    provider: 'deepseek-official', model: MODEL,
+    replayState: { response: { kind: 'deepseek-messages', version: 1, model: MODEL }, blocks },
+  } })
+  const onDegrade = vi.fn()
+  expect(readReplay(message, MODEL, onDegrade)).toBeUndefined()
+  expect(onDegrade).toHaveBeenCalledExactlyOnceWith('DeepSeek Messages replay: invalid redacted payload')
+  const request = body([user(), message])
+  expect(request.messages[1]?.content).toEqual(content.flatMap<WireBlock>(block => block.type === 'text' ? [block]
+    : block.text ? [{ type: 'thinking', thinking: block.text }] : []))
+  expect(JSON.stringify(request)).not.toContain(payload)
