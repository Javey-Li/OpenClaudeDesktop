@@ -0,0 +1,40 @@
+/** URL allowlist matching for Claude HTTP hooks.
+ * @module @deepseek-ai/dsh-hooks-claude-code/http-url
+ */
+const STAR = 'hookwildcardplaceholder'
+function glob(text: string, pattern: string, replacement: string): boolean {
+  const escaped = pattern.split('*').map(part => part.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join(replacement)
+  return new RegExp(`^${escaped}$`).test(text)
+}
+function parsed(value: string): URL | undefined {
+  try { return new URL(value) } catch { return undefined }
+}
+
+/** Match URL components, with host/scheme/port wildcards and path/query globbing.
+ * @param url - Destination URL; fragments and embedded credentials do not select a route.
+ * @param pattern - Host policy pattern; a bare origin also admits its paths.
+ * @returns Whether the destination matches the configured pattern.
+ */
+export function matchesHttpHookUrl(url: string, pattern: string): boolean {
+  if (pattern === '*') return true
+  const target = parsed(url)
+  if (!target) return false
+  const substituted = pattern.replaceAll('*', STAR)
+  let template = parsed(substituted)
+  let anyPort = false
+  if (!template) {
+    const withPort = substituted.replace(new RegExp(`:${STAR}(?=[/?#]|$)`), ':0')
+    if (withPort !== substituted) {
+      template = parsed(withPort)
+      anyPort = template !== undefined
+    }
+  }
+  if (!template) return glob(`${target.protocol}//${target.host}${target.pathname}${target.search}`, pattern, '[^/]*')
+  if (template.protocol !== `${STAR}:` && template.protocol !== target.protocol) return false
+  const host = template.hostname.replace(/\.$/, '').toLowerCase().replaceAll(STAR, '*')
+  if (!glob(target.hostname.replace(/\.$/, '').toLowerCase(), host, '[^/]*')) return false
+  anyPort ||= template.port === '' && template.hostname.includes(STAR)
+  if (!anyPort && template.port !== target.port) return false
+  if (template.pathname === '/' && template.search === '' && !substituted.endsWith('/')) return true
+  return glob(target.pathname + target.search, (template.pathname + template.search).replaceAll(STAR, '*'), '.*')
+}
