+/** A rejected request can only retry after its history repair is durably accepted. */
+import { afterEach, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import LlmRuntime, { createUserMessage, LlmError } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { for (const ctx of contexts.splice(0)) await ctx.fiber.dispose() })
+const content: ContentBlock[] = [...Array.from({ length: 4 }, (_, i): ContentBlock => ({ type: 'reasoning', text: String(i) })), { type: 'text', text: 'FIRST' }]
+const first: StreamChunk[] = [...content.flatMap((block, index): StreamChunk[] => [
+  { type: 'block-start', index, blockType: block.type }, { type: 'block-end', index, block },
+]), { type: 'finish', reason: { kind: 'stop' }, replayState: { response: {}, blocks: content.map((_, i) => ({ index: i })) } }]
+const reject = (request: GenerateOptions): never => {
+  const message = request.messages.find(m => m.role === 'assistant')
+  if (!message || message.role !== 'assistant') throw new Error('fixture needs an assistant')
+  const blockIndex = message.content.findLastIndex(b => b.type === 'reasoning')
+  throw new LlmError('rejected', 'REASONING_REPLAY_REJECTED', { status: 400, reasoningRecovery: { from: { messageId: message.id, blockIndex } } })
+}
+async function harness(streamToolCalls: boolean, script: ConstructorParameters<typeof MockAdapter>[0]) {
+  const ctx = new Context(); contexts.push(ctx)
+  for (const plugin of [LlmRuntime, SessionStore, SessionProjectionRegistry, SystemPrompt, ToolRuntime, AgentRegistry]) {
+    await ctx.plugin(plugin)
+  }
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter(script)
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const agent = await ctx.agentLoop.create(SessionId('repair'), { provider: 'mock', model: 'mock', ...streamToolCalls ? { streamToolCalls: true } : {} })
+  const run = async () => {
+    agent.followup(createUserMessage({
+      source: { kind: 'user' }, content: [{ type: 'text', text: 'continue' }],
+    }))
+    await agent.whenIdle()
+  }
+  return { agent, adapter, ctx, run }
+}
+
+it.each([false, true])('repairs at most two suffixes before stripping all, streaming=%s', async (streaming) => {
+  const { agent, adapter, ctx, run } = await harness(streaming, [first, reject, reject, reject, textResponse('SECOND'), textResponse('THIRD')])
+  const fallback = vi.fn()
+  ctx.on('agent/request-error', fallback)
+  await run(); await run(); await run()
+  expect(adapter.requests.map(r => r.messages.filter(m => m.role === 'assistant').flatMap(m => m.content).filter(b => b.type === 'reasoning').map(b => b.text)))
+    .toEqual([[], ['0', '1', '2', '3'], ['0', '1', '2'], ['0', '1'], [], []])
+  const events = agent.session.snapshotEvents()
+  expect(events.filter(e => e.type === 'assistant/reasoning-strip')).toHaveLength(3)
+  expect(events.filter(e => e.type === 'turn/end').map(e => e.data.reason.kind)).toEqual(['completed', 'completed', 'completed'])
+  expect(fallback).not.toHaveBeenCalled()
+  const restored = Session.create(SessionId('restore'), JSON.parse(JSON.stringify(events)) as SessionEvent[])
+  expect(restored.deriveMessages()).toEqual(agent.session.deriveMessages())
+  expect(restored.deriveMessages().flatMap(m => m.content).filter(b => b.type === 'reasoning')).toEqual([])
+  expect(events.filter(e => e.type === 'assistant/message').some(e => e.data.message.content.some(b => b.type === 'reasoning'))).toBe(true)
+})
+
+it.each([false, true])('does not retry after the durable repair fails, streaming=%s', async (streaming) => {
+  const { agent, adapter, run } = await harness(streaming, [first, reject, textResponse('MUST NOT RUN')])
+  await run()
+  const append = agent.session.append.bind(agent.session)
+  vi.spyOn(agent.session, 'append').mockImplementation((...args) => {
+    if (args[0] === 'assistant/reasoning-strip') throw new Error('fixture persistence failure')
+    return Reflect.apply(append, agent.session, args) as ReturnType<typeof append>
+  })
+  await run()
+  expect(adapter.requests).toHaveLength(2)
+  expect(agent.session.snapshotEvents().filter(e => e.type === 'assistant/reasoning-strip')).toEqual([])
+  expect(agent.session.snapshotEvents().findLast(e => e.type === 'turn/end')?.data.reason.kind).toBe('error')
+})
+
+it.each([false, true])('honors cancellation before any reasoning repair, streaming=%s', async (streaming) => {
+  let cancel = () => {}
+  const { agent, adapter, run } = await harness(streaming, [first, (request) => { cancel(); return reject(request) }, textResponse('MUST NOT RUN')])
+  cancel = () => { agent.cancel({ kind: 'user' }) }
+  await run(); await run()
+  expect(adapter.requests).toHaveLength(2)
+  expect(agent.session.snapshotEvents().filter(e => e.type === 'assistant/reasoning-strip')).toEqual([])
+  expect(agent.session.snapshotEvents().findLast(e => e.type === 'turn/end')?.data.reason.kind).toBe('aborted')
+})
