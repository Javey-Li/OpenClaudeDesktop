+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LlmRuntime, { createUserMessage, createSystemMessage, expandAssistantStream, isAgentLoopRequest, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent, AssistantStreamFrame } from '@deepseek-ai/dsh-agent'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import AgentLoop from '../src/index.ts'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose())) })
+
+class StreamingAdapter extends MockAdapter {
+  constructor(private readonly responses: ((request: GenerateOptions) => AsyncIterable<StreamChunk>)[]) { super([]) }
+  override async * stream(request: GenerateOptions): AsyncIterable<StreamChunk> {
+    this.requests.push(request)
+    const next = this.responses.shift()
+    if (next === undefined) throw new Error('unexpected extra model request')
+    yield * next(request)
+  }
+}
+
+function call(index: number, name = 'write'): StreamChunk[] {
+  return [
+    { type: 'block-start', index, blockType: 'tool-call' },
+    { type: 'tool-call-delta', index, id: ToolCallId(`call-${index}`), name, argumentsDelta: '{}' },
+    { type: 'block-end', index, block: { type: 'tool-call', id: ToolCallId(`call-${index}`), name, arguments: '{}' } },
+  ]
+}
+const failure: StreamChunk = { type: 'finish', reason: { kind: 'error', failure: {
+  code: 'STREAM_CLOSED', message: 'stream closed before completion',
+} } }
+
+async function harness(adapter: StreamingAdapter) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt, { personaPrefix: 'stable prefix' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const agent = await ctx.agentLoop.create(SessionId('streaming-tools'), {
+    provider: 'mock', model: 'mock', streamToolCalls: true,
+  })
+  return { ctx, agent }
+}
+
+function start(agent: Agent): Promise<void> {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
+  return agent.whenIdle()
+}
+
+function events(agent: Agent) { return agent.session.snapshotEvents() }
+
+describe('streaming tool request ownership', () => {
+  it.each([false, true])('recovers closed=%s text using only committed blocks and durable instructions', async (closed) => {
+    const adapter = new StreamingAdapter([
+      async function * () {
+        yield { type: 'text-delta', index: 0, text: 'discarded text' }
+        if (closed) yield { type: 'block-end', index: 0, block: { type: 'text', text: 'discarded text' } }
+        yield failure
+      },
+      async function * () { yield * textResponse('recovered') },
+    ])
+    const { ctx, agent } = await harness(adapter)
+    ctx.on('agent/request-error', async () => ({ kind: 'retry' }))
+    await start(agent)
+    expect(adapter.requests).toHaveLength(2)
+    const messages = adapter.requests[1]!.messages
+    const suffix = messages.slice(messages.findIndex(message => message.role === 'assistant'))
+    const instruction = 'Your response above was cut off mid-stream and only your next message is delivered. Write the complete response again from the start — no apology, no mention of the cut-off.'
+    if (closed) {
+      expect(suffix.map(message => ({ role: message.role, content: message.content }))).toEqual([
+        { role: 'assistant', content: [{ type: 'text', text: 'discarded text' }] },
+        { role: 'user', content: [{ type: 'text', text: instruction }] },
+      ])
+    } else expect(messages.map(message => message.role)).toEqual(['system', 'user'])
+    const log = events(agent)
+    expect(log.filter(event => event.type === 'user/message' && event.data.source.kind === 'stream-recovery')).toHaveLength(closed ? 1 : 0)
+    const restored = Session.create(SessionId('restored-text'), log)
+    expect(restored.deriveMessages()).toEqual(agent.session.deriveMessages())
+    const attempt = log.find(event => event.type === 'assistant/attempt')!
+    expect(expandAssistantStream(attempt.data.stream)).toContainEqual(expect.objectContaining({
+      chunk: { type: 'text-delta', index: 0, text: 'discarded text' },
+    }))
+  })
+
+  it('does not request a rewrite when failure terminates without a retry', async () => {
+    const adapter = new StreamingAdapter([async function * () {
