+
+it('omits an opaque placeholder whose replay was lost without creating an empty assistant turn', () => {
+  const message = createAssistantMessage({ content: [opaque], source: { provider: 'deepseek-official', model: MODEL } })
+  expect(body([user(), message, user()]).messages).toHaveLength(1)
+  expect(message.content).toEqual([opaque])
