@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest'
+import { parseClaudeCodeScript } from '../src/claude-script.ts'
+
+describe('Claude meta compatibility without evaluation', () => {
+  it('extracts quoted/unquoted JSON5 literal fields and preserves body line positions', () => {
+    const input = '// saved workflow\nexport const meta = { name: \'review-changes\', description: \'Review\', phases: [{title:\'Read\'}], };\nreturn await agent(\'review\');'
+    const parsed = parseClaudeCodeScript(input)
+    expect(parsed.meta).toMatchObject({ name: 'review-changes', phases: [{ title: 'Read' }] })
+    expect(parsed.script.split('\n')).toHaveLength(input.split('\n').length)
+    expect(parsed.script).not.toContain('export const meta')
+    expect(parsed.script).toContain("return await agent('review')")
+  })
+  it('preserves script semantics instead of imposing module strict mode', () => {
+    const script = 'function choose(a, a) { return a }; return choose(1, 2)'
+    expect(parseClaudeCodeScript(script)).toEqual({ script })
+    expect(parseClaudeCodeScript(`export const meta = { name: 'plain', description: 'Plain' }; ${script}`).script).toContain(script)
+  })
+  it.each(['{name: (() => process.exit())()}', '{...globalThis}', '{get name(){ return "x" }}', '{name: `dynamic`}'])('rejects executable metadata %s', (expression) => {
+    expect(() => parseClaudeCodeScript(`export const meta = ${expression}; return 1`)).toThrow()
+    expect(() => parseClaudeCodeScript(`export const meta = ${expression}; const = ;`, false)).toThrow()
+  })
+  it('discovers literal metadata without parsing or executing the body', () => {
+    const script = '// leading comment\nexport const meta = {name:"broken",description:"A } in a string",phases:[{title:"Read"}]}; const = ; "unterminated'
+    expect(parseClaudeCodeScript(script, false).meta).toEqual({ name: 'broken', description: 'A } in a string', phases: [{ title: 'Read' }] })
+    expect(() => parseClaudeCodeScript(script)).toThrow(SyntaxError)
+    for (const invalid of ['export let meta = {}', 'export const other = {}', 'export const meta = {', 'return 1']) {
+      expect(() => parseClaudeCodeScript(invalid, false)).toThrow()
+    }
+  })
+})
