+    if (claude) {
+      const canonical = workflowScriptPath(fs.processPath(target), cwd)
+      await authorize?.([...new Set([lexical, canonical])])
+    }
+    const bytes = await fs.readBytes(target, signal, config.maxScriptBytes, claude ? { verifyIdentity: true } : undefined)
+    return { ...parse(decode(bytes)), scriptPath: fs.processPath(target) }
+  }
