index 0000000000..c5edde96cf
--- /dev/null
+++ b/packages/subagent/subagent/src/output-schema.ts
@@ -0,0 +1,47 @@
+/** Full object-rooted JSON Schema validation for delegated structured results. */
+import { Ajv, type ValidateFunction } from 'ajv'
+import { JsonSchemaError } from '@deepseek-ai/dsh-tools'
+import { snapshotJsonValue } from '@deepseek-ai/dsh-util-values'
+import { assertUsableOutputSchema } from './output-schema-lint.ts'
+import type { StructuredOutputSchema } from './types.ts'
+
+/** Compile a detached schema without coercing output, fetching references, or enforcing formats.
+ * @param value - untrusted schema at a workflow or subagent boundary.
+ * @returns the compiled synchronous validator; invalid schemas throw JsonSchemaError.
+ */
+export function compileStructuredOutputSchema(value: unknown): ValidateFunction {
+  const detached = snapshotJsonValue(value)
+  if (typeof detached !== 'object' || detached === null || Array.isArray(detached) || !('type' in detached) || detached.type !== 'object') {
+    throw new JsonSchemaError(['structured output requires an object-rooted schema containing lossless JSON data'])
+  }
+  const schema = detached as Record<string, unknown>
+  // Match Claude's schema admission bounds before invoking the compiler.
+  const queue: { value: unknown; depth: number }[] = [{ value: schema, depth: 0 }]
+  let remaining = 100_000
+  for (let node = queue.pop(); node !== undefined; node = queue.pop()) {
+    if (--remaining < 0 || node.depth > 10_000) throw new JsonSchemaError(['schema too large'])
+    if (node.value && typeof node.value === 'object') {
+      for (const child of Object.values(node.value)) queue.push({ value: child, depth: node.depth + 1 })
+    }
+  }
+  if (schema.$async) throw new JsonSchemaError(['$async schemas are not supported'])
+  try {
+    // A compiler belongs to one schema: duplicate $id values in concurrent
+    // children cannot collide, and disposed runs leave no global schema cache.
+    const ajv = new Ajv({ allErrors: true, validateFormats: false, logger: false })
+    const validate = ajv.compile(schema)
+    assertUsableOutputSchema(schema)
+    return validate
+  } catch (error) {
+    if (error instanceof JsonSchemaError) throw error
+    throw new JsonSchemaError([error instanceof Error ? error.message : String(error)])
+  }
+}
+
+/** Assert a full structured-output schema before publishing a child.
+ * @param value - schema received across a caller boundary.
+ * @returns Narrows a usable object-rooted schema; rejects unsupported or contradictory schemas.
+ */
+export function assertStructuredOutputSchema(value: unknown): asserts value is StructuredOutputSchema {
+  compileStructuredOutputSchema(value)
+}
