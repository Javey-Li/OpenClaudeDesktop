@@ -0,0 +1,35 @@
+/** Local protocol fixture with observed process ownership and a changing tool list. */
+import { appendFileSync } from 'node:fs'
+import { createInterface } from 'node:readline'
+const record = (event, extra = {}) => {
+  if (process.env.AGENT_MCP_LOG) appendFileSync(process.env.AGENT_MCP_LOG, `${JSON.stringify({ event, pid: process.pid, ...extra })}\n`)
+}
+const send = value => process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', ...value })}\n`)
+record('start')
+process.once('exit', () => record('exit'))
+process.stdin.once('end', () => process.exit(0))
+let changed = false
+createInterface({ input: process.stdin }).on('line', line => {
+  const request = JSON.parse(line)
+  if (request.id === undefined) return
+  record(request.method, { name: request.params?.name })
+  if (request.method === 'server/discover') {
+    if (process.env.AGENT_MCP_HANG) return
+    send({ id: request.id, error: { code: -32601, message: 'Legacy fixture' } })
+    return
+  }
+  let result
+  if (request.method === 'initialize') result = { protocolVersion: request.params.protocolVersion, capabilities: { tools: { listChanged: true }, resources: {} }, serverInfo: { name: 'agent-fixture', version: '1' }, instructions: 'AGENT_MCP_INSTRUCTIONS' }
+  else if (request.method === 'tools/list') result = { tools: (changed ? ['echo', 'blocked', 'late'] : ['echo', 'blocked']).map(name => ({ name, description: name, inputSchema: { type: 'object', properties: {} } })) }
+  else if (request.method === 'tools/call') {
+    result = { content: [{ type: 'text', text: `MCP_RESULT:${request.params.name}${process.env.AGENT_MCP_STATIC ? '' : `:${process.cwd()}`}` }] }
+    if (!process.env.AGENT_MCP_STATIC) {
+      changed = true
+      send({ method: 'notifications/tools/list_changed' })
+    }
+  } else if (request.method === 'resources/list') result = { resources: [{ uri: 'fixture://guide', name: 'Fixture guide', mimeType: 'text/plain' }] }
+  else if (request.method === 'resources/templates/list') result = { resourceTemplates: [{ uriTemplate: 'fixture://{name}', name: 'Fixture template' }] }
+  else if (request.method === 'resources/read') result = { contents: [{ uri: request.params.uri, mimeType: 'text/plain', text: 'MCP_RESOURCE_CONTENT' }] }
+  else result = {}
+  send({ id: request.id, result })
+})
