diff --git a/packages/core/tools/tests/input-preparation.spec.ts b/packages/core/tools/tests/input-preparation.spec.ts
new file mode 100644
index 0000000000..ed5a3fbb76
--- /dev/null
+++ b/packages/core/tools/tests/input-preparation.spec.ts
@@ -0,0 +1,87 @@
+/** Input preparation keeps execution identity, policy and result context consistent. */
+import { Context } from '@deepseek-ai/cordis'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture, TOOL_RUNTIME_SCHEDULER, type ToolInputPreparation } from '@deepseek-ai/dsh-tools'
+import { describe, expect, it, onTestFinished } from 'vitest'
+import { renderJsonValue } from '../src/json-render.ts'
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+
+async function setup() {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  const calls: string[] = []
+  ctx.tools.register(defineContentToolFixture({
+    name: 'echo', description: 'Echo input', parameters: { text: { type: 'string', required: true } },
+    async execute(args) { calls.push(args.text); return [{ type: 'text', text: args.text }] },
+  }))
+  const controller = new AbortController()
+  const input = { callId: ToolCallId('rewrite'), name: 'echo', arguments: { text: 'original' }, signal: controller.signal }
+  return { ctx, calls, controller, input }
+}
+
+describe('tool input preparation', () => {
+  it('detaches replacements, closes the capability and seals published identity', async () => {
+    const { ctx, calls, input } = await setup()
+    let capability: ToolInputPreparation | undefined
+    const replacement = { text: 'accepted' }
+    ctx.on('tools/prepare-input', async (exec) => { capability = exec; exec.replaceArguments(replacement); replacement.text = 'mutated' })
+    const resolved = await ctx.tools[TOOL_RUNTIME_SCHEDULER].resolve(input)
+    expect(resolved.exec.arguments).toEqual({ text: 'accepted' })
+    expect(resolved.serializedArguments).toBe('{"text":"accepted"}')
+    expect(() => capability?.replaceArguments({ text: 'late' })).toThrow('closed')
+    expect(Reflect.set(resolved.exec, 'arguments', {})).toBe(false)
+    expect(Reflect.set(resolved.exec, 'name', 'other')).toBe(false)
+    const prepared = await ctx.tools[TOOL_RUNTIME_SCHEDULER].prepare(resolved)
+    expect(prepared.kind).toBe('dispatch')
+    const dispatched = await ctx.tools[TOOL_RUNTIME_SCHEDULER].dispatch(resolved.exec)
+    const result = await ctx.tools[TOOL_RUNTIME_SCHEDULER].finalize(resolved.exec, dispatched.result)
+    expect(calls).toEqual(['accepted'])
+    expect(input.arguments).toEqual({ text: 'original' })
+    expect(result.additionalContexts?.[0]?.source).toEqual({ kind: 'tool-input-rewrite' })
+    expect(result.additionalContexts?.[0]?.content).toEqual([{ type: 'text', text: 'Input for tool echo was rewritten before execution.\nOriginal arguments: {"text":"original"}\nAccepted arguments: {"text":"accepted"}' }])
+  })
+
+  it.each(['guard', 'post-block', 'cancel'] as const)('retains the accepted-input correction on %s', async (reason) => {
+    const { ctx, calls, controller, input } = await setup()
+    ctx.on('tools/prepare-input', async (exec) => {
+      exec.replaceArguments({ text: 'restricted' })
+      if (reason === 'cancel') controller.abort()
+    })
+    if (reason === 'guard') ctx.tools.guard(exec => (exec.arguments as { text: string }).text === 'restricted' ? 'denied rewritten input' : undefined)
+    if (reason === 'post-block') ctx.on('tools/post-execute', async () => ({ kind: 'block', feedback: [{ type: 'text', text: 'blocked result' }] }))
+    const result = await ctx.tools.execute(input)
+    expect(result.isError).toBe(true)
+    expect(calls).toEqual(reason === 'post-block' ? ['restricted'] : [])
+    expect(result.additionalContexts?.[0]?.source).toEqual({ kind: 'tool-input-rewrite' })
+  })
+
+  it('contains a failed preparation after an accepted rewrite', async () => {
+    const { ctx, calls, input } = await setup()
+    ctx.on('tools/prepare-input', async (exec) => { exec.replaceArguments({ text: 'accepted' }); throw new Error('preparation failed') })
+    const result = await ctx.tools.execute(input)
+    expect(result.isError).toBe(true)
+    expect(calls).toEqual([])
+    expect(result.additionalContexts?.[0]?.source.kind).toBe('tool-input-rewrite')
+  })
+
+  it('does not add a correction for equivalent JSON or a disposed listener', async () => {
+    const { ctx, input } = await setup()
+    const dispose = ctx.on('tools/prepare-input', async (exec) => { exec.replaceArguments({ text: 'original' }) })
+    expect((await ctx.tools.execute(input)).additionalContexts).toBeUndefined()
+    dispose()
+    expect((await ctx.tools.execute(input)).additionalContexts).toBeUndefined()
+  })
+
+  it('serializes deep rewritten arguments without overflowing the stack', async () => {
+    const { ctx, input } = await setup()
+    let deep: JsonValue = 'leaf'
+    for (let i = 0; i < 20000; i++) deep = { child: deep }
+    ctx.on('tools/prepare-input', async (exec) => { exec.replaceArguments(deep) })
+    const resolved = await ctx.tools[TOOL_RUNTIME_SCHEDULER].resolve(input)
+    expect(resolved.serializedArguments).toBe('{"child":'.repeat(20000) + '"leaf"' + '}'.repeat(20000))
+    expect(renderJsonValue({ a: [null, true, 'x\n', 1] }, true)).toBe(JSON.stringify({ a: [null, true, 'x\n', 1] }))
+  })
+})
