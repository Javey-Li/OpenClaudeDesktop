+import { mkdir, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { setupMerge } from '../../workflow-ptc/tests/merge-setup.ts'
+import { resolveWorkflowSource } from '../src/source.ts'
+
+const config = { inputMode: 'claude-code' as const, maxScriptBytes: 524288, workflowDirectories: [] }
+const signal = new AbortController().signal
+
+it('resolves the built-in without a filesystem and retains it behind a broken project override', async () => {
+  const builtin = await resolveWorkflowSource(undefined, { name: 'deep-research' }, config, signal)
+  expect(builtin.meta?.phases?.map(phase => phase.title)).toEqual(['Scope', 'Search', 'Fetch', 'Verify', 'Synthesize'])
+  const t = await setupMerge()
+  const cwd = t.ctx.sandboxPolicy.workspaceRoot
+  const directory = join(cwd, '.claude/workflows')
+  await mkdir(directory, { recursive: true })
+  const override = 'export const meta={name:"deep-research",description:"Override"}; '
+  await writeFile(join(directory, 'override.js'), override + 'const = ;')
+  expect((await resolveWorkflowSource(t.ctx.fs, { name: 'deep-research' }, config, signal, cwd)).script).toBe(builtin.script)
+  await writeFile(join(directory, 'override.js'), override + 'return "custom"')
+  expect((await resolveWorkflowSource(t.ctx.fs, { name: 'deep-research' }, config, signal, cwd)).script).toBe('return "custom"')
+  await expect(resolveWorkflowSource(t.ctx.fs, { name: 'absent' }, config, signal, cwd)).rejects.toThrow('Available: deep-research')
+})
+
+it('returns the missing-question diagnostic from the confined built-in without launching children', async () => {
+  const t = await setupMerge()
+  const source = await resolveWorkflowSource(undefined, { name: 'deep-research' }, config, signal)
+  const run = t.start(source.script, { meta: source.meta! })
+  const result = await run.result
+  expect(result).toMatchObject({ stopReason: 'completed', agentsStarted: 0 })
+  expect(JSON.stringify(result.value)).toContain('No research question provided')
+  await run.dispose()
+})
+
+it('runs search, deduplication, three-vote verification and synthesis through the real engine', async () => {
+  const t = await setupMerge({ cap: 20, concurrency: 3 })
+  let calls = 0
+  const schemas: string[][] = []
+  t.ctx.subagents.registerProvider({
+    name: 'research-fixture', inheritsParentContext: false,
+    capabilities: { agentOptions: true, outputSchema: true, depthLimit: false, persona: false, toolFilter: true },
+    async start(request) {
+      const id = ++calls
+      const keys = Object.keys(request.outputSchema?.properties ?? {})
+      schemas.push(keys)
+      const structured = keys.includes('angles') ? { angles: ['primary', 'recent', 'skeptical'].map(label => ({ label, query: label })) }
+        : keys.includes('results') ? { results: [{ url: 'https://example.com/source', title: 'Source', relevance: 'high' }] }
+          : keys.includes('claims') ? { sourceQuality: 'primary', claims: [{ claim: 'A supported claim', quote: 'Source evidence', importance: 'central' }] }
+            : keys.includes('refuted') ? { refuted: false, evidence: 'Independent verification', confidence: 'high' }
+              : { summary: 'Research answer', findings: [{ claim: 'A supported claim', confidence: 'high', sources: ['https://example.com/source'], evidence: 'Source evidence' }], caveats: 'One source' }
+      return { id: SessionId(`research-${id}`), localAgent: undefined, result: Promise.resolve({ output: [], structured, outputTokens: 2, stopReason: 'completed' as const }), dispose: async () => {} }
+    },
+  })
+  const source = await resolveWorkflowSource(undefined, { name: 'deep-research' }, config, signal)
+  const phases: string[] = []
+  t.ctx.on('workflow/phase', (_run, title) => { phases.push(title) })
+  const run = t.start(source.script, { meta: source.meta!, args: 'Research a question', subagentProvider: 'research-fixture', budgetTotal: 1000 })
+  expect(await run.result).toMatchObject({ stopReason: 'completed', agentsStarted: 9, value: {
+    question: 'Research a question', summary: 'Research answer', refuted: [], unverified: [],
+    stats: { sourcesFetched: 1, claimsVerified: 1, confirmed: 1, urlDupes: 2, agentCalls: 9 },
+  } })
+  expect(schemas.filter(keys => keys.includes('refuted'))).toHaveLength(3)
+  expect(phases).toEqual(['Scope', 'Search', 'Fetch', 'Verify', 'Synthesize'])
+  await run.dispose()
+})
