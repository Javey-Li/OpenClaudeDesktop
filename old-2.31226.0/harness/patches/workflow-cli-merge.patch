+    if (error instanceof FsError) throw error
+    if (isENOENT(error) || isENOTDIR(error)) throw new FsError(`cannot read "${target.displayPath}": not found`, 'FS_NOT_FOUND', { cause: error })
+    if (isPermissionError(error)) throw new FsError(`cannot read "${target.displayPath}": permission denied`, 'FS_PERMISSION_DENIED', { cause: error })
+    throw new FsError(`cannot read "${target.displayPath}": file identity could not be verified`, 'FS_IO_ERROR', { cause: error })
