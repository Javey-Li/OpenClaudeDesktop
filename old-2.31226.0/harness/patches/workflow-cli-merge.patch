+/** Git isolation owned by one published subagent and its disposal. */
+import { randomUUID } from 'node:crypto'
+import { posix } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-subprocess'
+
+/** Create an execution-world worktree and retain any edits or commits on cleanup.
+ * @param ctx - Parent context supplying the subprocess service.
+ * @param cwd - Working directory inside the Git repository.
+ * @param signal - Cancels Git discovery and worktree creation.
+ * @returns Detached worktree directory and cleanup that removes only an unchanged tree.
+ */
+export async function createAgentWorktree(
+  ctx: Context,
+  cwd: string,
+  signal: AbortSignal,
+): Promise<{ cwd: string; cleanup(): Promise<void> }> {
+  const subprocess = ctx.get('subprocess')
+  if (!subprocess) throw new Error('worktree isolation requires the subprocess service')
+  const git = async (directory: string, args: string[], abort?: AbortSignal): Promise<string> => {
+    const child = subprocess.spawn({ argv: ['git', ...args], cwd: directory, stdio: { stdin: 'ignore', stdout: { maxBytes: 1_048_576 }, stderr: { maxBytes: 16_384 } }, graceMs: 1000, ...abort === undefined ? {} : { signal: abort } })
+    try {
+      const result = await child.done
+      if (result.exitCode !== 0) throw new Error(`worktree git ${args[0]} failed: ${child.collected.stderr?.readFrom(0).text ?? result.exitCode}`)
+      // oxlint-disable-next-line typescript/no-non-null-assertion -- spawn explicitly requests a stdout collector above.
+      return child.collected.stdout!.readFrom(0).text.trim()
+    } finally { child.terminate(); await child.waitForExit() }
+  }
+  const root = await git(cwd, ['rev-parse', '--show-toplevel'], signal)
+  const original = await git(root, ['rev-parse', 'HEAD'], signal)
+  const directory = posix.join(root, '.claude', 'worktrees', `workflow-${randomUUID()}`)
+  const cleanup = async (): Promise<void> => {
+    // Read failure preserves the worktree: lack of evidence is not permission to remove it.
+    const [status, head] = await Promise.all([git(directory, ['status', '--porcelain', '--untracked-files=all']), git(directory, ['rev-parse', 'HEAD'])])
+    if (status || head !== original) {
+      ctx.logger.info(`workflow worktree retained: ${directory}`)
+      return
+    }
+    await git(root, ['worktree', 'remove', directory])
+  }
+  await git(root, ['worktree', 'add', '--detach', directory, original], signal)
+  if (signal.aborted) { await cleanup(); signal.throwIfAborted() }
+  return { cwd: directory, cleanup }
+}
