@@ -0,0 +1,51 @@
+/** Bind explicit script reads to the calling Agent's visible tools and application permissions. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { claudeReadAllowed, harnessToolName } from '@deepseek-ai/dsh-claude-code-config'
+import { scopeTarget } from '@deepseek-ai/dsh-scope'
+
+/** Application-owned Read availability and outside-directory grants. Explicit settings rules still apply. */
+export interface WorkflowReadPolicy {
+  readAvailable: boolean
+  bypassPermissions: boolean
+  additionalDirectories: readonly string[]
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    /**
+     * Resolve application Read policy before an explicit Workflow source read.
+     * @mode waterfall
+     * @param agent - Agent requesting scriptPath, including nested Workflow resolution.
+     * @param next - Delegates to earlier listeners; the default grants only ordinary working-directory reads.
+     */
+    'tool-workflow/read-policy'(agent: Agent, next: () => Promise<WorkflowReadPolicy>): Promise<WorkflowReadPolicy>
+  }
+}
+
+/** Create a Read admission callback that rereads permissions for each path check.
+ * @param ctx - Tool registration context with tools and workflowEngine injected.
+ * @param parent - Agent that owns this Workflow invocation.
+ * @param scriptPath - Original model path for a recoverable admission error.
+ * @param signal - Cancels configuration and canonical-directory reads.
+ * @returns A callback that rejects before any script content is read.
+ */
+export function workflowReadAdmission(
+  ctx: Context, parent: Agent, scriptPath: string, signal: AbortSignal,
+): (paths: readonly string[]) => Promise<void> {
+  return async (paths) => {
+    const fs = ctx.get('fs')
+    if (!fs) throw new Error('workflow scriptPath requires the fs service')
+    const policy = await ctx.waterfall(scopeTarget(ctx, parent), 'tool-workflow/read-policy', parent,
+      () => Promise.resolve({ readAvailable: true, bypassPermissions: false, additionalDirectories: [] }))
+    const available = ctx.tools.schemas(parent).some(tool => harnessToolName(tool.name) === 'read')
+    const privateDirectories = ctx.workflowEngine.sourceDirectories(parent).flatMap((directory) => {
+      const mapped = fs.processPathFromHostPath(directory)
+      return mapped === undefined ? [] : [mapped]
+    })
+    if (!available || !policy.readAvailable || !await claudeReadAllowed(fs, paths, {
+      cwd: parent.session.header.cwd ?? fs.processPath(await fs.resolve('.', { signal })), signal, privateDirectories,
+      additionalDirectories: policy.additionalDirectories, bypassPermissions: policy.bypassPermissions,
+    })) throw new Error(`scriptPath must be a script path this tool returned, or a file you can already read (the working directory or a directory you have added): ${scriptPath}`)
+  }
+}
