@@ -0,0 +1,73 @@
+/** Browser-safe, durable omission of rejected reasoning from model history. */
+import type { Message } from '@deepseek-ai/dsh-llm'
+import { readReasoningPrefix } from '@deepseek-ai/dsh-llm/message'
+import type { SessionSeq } from './types.ts'
+import type { SessionMessageProjection } from './surface.ts'
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function index(value: unknown): value is SessionSeq {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 && !Object.is(value, -0)
+}
+
+/** Validate a complete decision before projecting any changed messages. */
+export const reasoningStripProjection: SessionMessageProjection<'assistant/reasoning-strip'> = {
+  type: 'assistant/reasoning-strip',
+  project(event, context) {
+    const data: unknown = event.data
+    if (!record(data) || Object.keys(data).length !== 1 || !Array.isArray(data.targets) || data.targets.length === 0) {
+      throw new Error('assistant/reasoning-strip: expected nonempty targets')
+    }
+    const updates = new Map<SessionSeq, Message>()
+    const current = new Map<string, { seq: SessionSeq; message: Message }>()
+    const duplicates = new Set<string>()
+    for (const seq of context.nodes) {
+      const source = context.events[seq - context.baseSeq]
+      if (source?.type !== 'assistant/message') continue
+      const message = context.messages.get(seq) ?? source.data.message
+      if (current.has(message.id)) duplicates.add(message.id)
+      current.set(message.id, { seq, message })
+    }
+    for (const target of data.targets as unknown[]) {
+      if (!record(target) || Object.keys(target).length !== 2 || typeof target.messageId !== 'string' || target.messageId.length === 0
+        || !Array.isArray(target.blockIndexes) || target.blockIndexes.length === 0) {
+        throw new Error('assistant/reasoning-strip: invalid target')
+      }
+      const selectedMessage = current.get(target.messageId)
+      if (!selectedMessage || duplicates.has(target.messageId) || updates.has(selectedMessage.seq)) {
+        throw new Error('assistant/reasoning-strip: repeated, ambiguous or non-current assistant message')
+      }
+      const { message, seq } = selectedMessage
+      if (message.role !== 'assistant') throw new Error('assistant/reasoning-strip: target has no assistant projection')
+      const selected = new Set<number>()
+      let previous = -1
+      for (const position of target.blockIndexes as unknown[]) {
+        if (!index(position) || position <= previous || message.content[position]?.type !== 'reasoning') {
+          throw new Error('assistant/reasoning-strip: indexes must select ordered reasoning blocks')
+        }
+        selected.add(position)
+        previous = position
+      }
+      const content = message.content.filter((_, position) => !selected.has(position))
+      let preceding = 0
+      const prefix = readReasoningPrefix(message) ?? message.content.map((block) => {
+        const count = preceding
+        if (block.type === 'reasoning') preceding++
+        return count
+      })
+      const reasoningPrefix = prefix.filter((_, position) => !selected.has(position))
+      const { replayState, ...originalSource } = message.source
+      const replay = !record(replayState) || !('response' in replayState) ? undefined
+        : replayState.blocks === undefined ? replayState
+          : Array.isArray(replayState.blocks) && replayState.blocks.length === message.content.length
+            ? { ...replayState, blocks: replayState.blocks.filter((_, position) => !selected.has(position)) }
+            : undefined
+      updates.set(seq, {
+        ...message, content, source: { ...originalSource, reasoningPrefix, ...replay === undefined ? {} : { replayState: replay } },
+      })
+    }
+    return updates
+  },
+}
