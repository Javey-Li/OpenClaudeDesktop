+import { mkdir, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { homedir } from 'node:os'
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { mountPtcRuntime } from '../../../workflow/workflow-ptc/tests/setup.ts'
+import { agentSelectors, loadAgentType } from '../src/agent-type.ts'
+
+const signal = new AbortController().signal
+const markdown = (name: string, fields = '') => `---\nname: ${name}\ndescription: A test agent\n${fields}---\nAgent instructions.`
+
+describe('Claude agent definition lookup', () => {
+  it('uses frontmatter names across nested project directories and rereads edits', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/agents/nested'), { recursive: true })
+    const path = join(cwd, '.claude/agents/nested/unrelated.md')
+    await writeFile(path, markdown('reviewer', 'tools: Read, Write\nmodel: Inherit\n'))
+    expect(await loadAgentType(ctx, 'reviewer', cwd, signal)).toMatchObject({ persona: 'Agent instructions.', tools: ['Read', 'Write'] })
+    expect((await loadAgentType(ctx, 'reviewer', cwd, signal)).model).toBeUndefined()
+    await writeFile(path, markdown('reviewer', 'tools: ["*"]\nisolation: worktree\n'))
+    expect(await loadAgentType(ctx, 'reviewer', cwd, signal)).toMatchObject({ isolation: 'worktree' })
+    expect((await loadAgentType(ctx, 'reviewer', cwd, signal)).tools).toBeUndefined()
+    await expect(loadAgentType(ctx, 'unrelated', cwd, signal)).rejects.toThrow('not found')
+  })
+
+  it('namespaces nested plugin agents, supports custom files, and ignores plugin-only forbidden controls', async () => {
+    const ctx = new Context()
+    const { cwd, root } = await mountPtcRuntime(ctx)
+    const user = join(root, 'user'), plugin = join(root, 'plugin')
+    await mkdir(join(user, 'plugins'), { recursive: true })
+    await mkdir(join(plugin, '.claude-plugin'), { recursive: true })
+    await mkdir(join(plugin, 'agents/security'), { recursive: true })
+    await mkdir(join(cwd, '.claude'), { recursive: true })
+    await writeFile(join(user, 'settings.json'), JSON.stringify({ enabledPlugins: { 'kit@fixtures': true } }))
+    await writeFile(join(user, 'plugins/installed_plugins.json'), JSON.stringify({ plugins: { 'kit@fixtures': [{ scope: 'user', installPath: plugin }] } }))
+    await writeFile(join(plugin, '.claude-plugin/plugin.json'), JSON.stringify({ name: 'kit', agents: ['./custom.md'] }))
+    await writeFile(join(plugin, 'custom.md'), markdown('custom'))
+    await writeFile(join(plugin, 'agents/security/scan.md'), '---\ntools: [Read]\npermissionMode: plan\nhooks: {}\nmcpServers: [example]\n---\nRead ${CLAUDE_PLUGIN_ROOT}/rules.')
+    const home = join(homedir(), '.claude')
+    const mapping = vi.spyOn(ctx.fs, 'processPathFromHostPath').mockImplementation(path => path.startsWith(home) ? user + path.slice(home.length) : undefined)
+    const warnings = vi.spyOn(ctx.logger, 'warn')
+    try {
+      expect(await loadAgentType(ctx, 'kit:security:scan', cwd, signal)).toMatchObject({ persona: `Read ${plugin}/rules.`, tools: ['Read'], pluginRoot: plugin })
+      expect((await loadAgentType(ctx, 'kit:security:scan', cwd, signal)).permissionMode).toBeUndefined()
+      expect(warnings.mock.calls.flat().join('\n')).toContain('ignored for plugin agents')
+      expect((await loadAgentType(ctx, 'kit:custom', cwd, signal)).persona).toBe('Agent instructions.')
+      await writeFile(join(cwd, '.claude/settings.local.json'), JSON.stringify({ enabledPlugins: { 'kit@fixtures': false } }))
+      await expect(loadAgentType(ctx, 'kit:custom', cwd, signal)).rejects.toThrow('not found')
+    } finally { mapping.mockRestore(); warnings.mockRestore() }
+  })
+
+  it('rejects missing metadata and reserved local namespaces, and honors cancellation', async () => {
+    const ctx = new Context()
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+    await writeFile(join(cwd, '.claude/agents/no-description.md'), '---\nname: no-description\n---\nBody')
+    await writeFile(join(cwd, '.claude/agents/namespace.md'), markdown('kit:review'))
+    await expect(loadAgentType(ctx, 'no-description', cwd, signal)).rejects.toThrow('not found')
+    await expect(loadAgentType(ctx, 'kit:review', cwd, signal)).rejects.toThrow('not found')
+    await expect(loadAgentType(ctx, 'Explore', cwd, AbortSignal.abort(new Error('cancelled')))).rejects.toThrow('cancelled')
+  })
+
+  it.each([
+    ['Read, Agent(Explore, Plan), Bash', ['Read', 'Agent(Explore, Plan)', 'Bash']],
+    [['Read, Write', 42, 'Bash'], ['Read', 'Write', 'Bash']],
+    [null, []],
+    ['', []],
+  ])('parses selector field %j', (input, expected) => { expect(agentSelectors(input)).toEqual(expected) })
+})
diff --git a/packages/subagent/subagent-spawn-in-process/tests/bash-clamp.spec.ts b/packages/subagent/subagent-spawn-in-process/tests/bash-clamp.spec.ts
