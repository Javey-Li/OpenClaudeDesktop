@@ -0,0 +1,42 @@
+import { describe, expect, it } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+
+describe('run output-token admission budget', () => {
+  it('exposes unlimited remaining allowance without a budget', async () => {
+    const t = await setupMerge()
+    const run = t.start('return { total: budget.total, unlimited: budget.remaining() === Infinity, spent: budget.spent() }')
+    expect(await run.result).toMatchObject({ stopReason: 'completed', value: { total: null, unlimited: true, spent: 0 } })
+    await run.dispose()
+  })
+  it('refuses an exhausted batch before invoking its items and lets zero disable admission', async () => {
+    const t = await setupMerge({ tokens: 6 })
+    const run = t.start('await agent("first"); return await parallel([() => agent("second")])', { budgetTotal: 6 })
+    const result = await run.result
+    expect(result).toMatchObject({ value: null, stopReason: 'error' })
+    expect(result.error).toContain('output token budget exhausted')
+    expect(t.requests).toHaveLength(1)
+    const checked = t.start('await agent("zero limit"); return budget.total', { budgetTotal: 0 })
+    expect(await checked.result).toMatchObject({ value: 0, stopReason: 'completed' })
+    await Promise.all([run.dispose(), checked.dispose()])
+  })
+  it('returns empty combinators despite exhausted output allowance and invalid unused stages', async () => {
+    const t = await setupMerge({ tokens: 6 })
+    const run = t.start('await agent("first"); return [await parallel([]), await pipeline([],1)]', { budgetTotal: 6 })
+    expect(await run.result).toMatchObject({ value: [[], []], stopReason: 'completed' })
+    expect(t.requests).toHaveLength(1)
+    await run.dispose()
+  })
+  it('converges loops against host-reported usage', async () => {
+    const t = await setupMerge({ tokens: 5 })
+    const run = t.start('while (budget.remaining() > 0) await agent("step"); return budget.spent()', { budgetTotal: 10 })
+    expect(await run.result).toMatchObject({ value: 10, stopReason: 'completed', agentsStarted: 2 })
+    await run.dispose()
+  })
+  it('rechecks queued children after another child exhausts the pool', async () => {
+    const t = await setupMerge({ tokens: 10, concurrency: 1 })
+    const run = t.start('return await parallel([() => agent("first"), () => agent("second")])', { budgetTotal: 10 })
+    expect(await run.result).toMatchObject({ value: ['reply-1', null], stopReason: 'completed' })
+    expect(t.requests).toHaveLength(1)
+    await run.dispose()
+  })
+})
