index 0000000000..f7a283c12a
--- /dev/null
+++ b/packages/settings/claude-code-config/src/read-permission.ts
@@ -0,0 +1,132 @@
+/** Read-path admission from declarative user and current-project Claude settings. */
+import { homedir } from 'node:os'
+import { join, posix, win32 } from 'node:path'
+import type FileSystem from '@deepseek-ai/dsh-fs'
+import ignore from 'ignore'
+import { parseClaudeToolSelector } from './tool-selector.ts'
+
+type RuleSource = { base: string; permissions: Record<string, unknown> }
+
+/** Apply Read deny/ask rules before directory, explicit rule, or bypass grants.
+ * @param fs - Calling execution world's filesystem; host paths are mapped before use.
+ * @param paths - Absolute lexical and resolved spellings of the same target; every spelling must pass.
+ * @param options - Caller-owned directories, permission mode, cwd, and cancellation signal.
+ * @returns Whether the file is readable without another permission prompt. Bare Read allow does not grant outside-directory access.
+ */
+export async function claudeReadAllowed(fs: FileSystem, paths: readonly string[], options: {
+  cwd: string
+  signal: AbortSignal
+  additionalDirectories: readonly string[]
+  privateDirectories: readonly string[]
+  bypassPermissions: boolean
+}): Promise<boolean> {
+  const { cwd, signal } = options
+  signal.throwIfAborted()
+  const path = /^[a-z]:[\\/]/iu.test(cwd) ? win32 : posix
+  paths = paths.map(candidate => path.resolve(cwd, candidate))
+  const home = fs.processPathFromHostPath(homedir())
+  const user = fs.processPathFromHostPath(process.env.CLAUDE_CONFIG_DIR || join(homedir(), '.claude'))
+  const sources: RuleSource[] = []
+  const files: [string, string][] = [
+    ...user === undefined ? [] : [[path.join(user, 'settings.json'), user] as [string, string]],
+    [path.join(cwd, '.claude/settings.json'), cwd],
+    [path.join(cwd, '.claude/settings.local.json'), cwd],
+  ]
+  for (const [file, base] of files) {
+    const target = await fs.resolve(file, { signal, cwd })
+    if ((await fs.stat(target, signal))?.type !== 'file') continue
+    const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 2_097_152)))
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`invalid Claude settings: ${file}`)
+    const permissions: unknown = Reflect.get(value, 'permissions')
+    if (permissions === undefined) continue
+    if (!permissions || typeof permissions !== 'object' || Array.isArray(permissions)) throw new Error(`invalid Claude permissions: ${file}`)
+    sources.push({ base, permissions: permissions as Record<string, unknown> })
+  }
+  const rules = (source: RuleSource, behavior: string): string[] => {
+    const value = source.permissions[behavior]
+    if (value === undefined) return []
+    if (!Array.isArray(value) || value.some(rule => typeof rule !== 'string')) throw new Error(`invalid Claude permissions.${behavior}`)
+    return value as string[]
+  }
+  const contains = (root: string, candidate: string): boolean => {
+    const relative = path.relative(root, candidate)
+    return relative === '' || relative !== '..' && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative)
+  }
+  const match = async (source: RuleSource, behavior: 'allow' | 'deny' | 'ask', tool: string, candidate: string): Promise<boolean> => {
+    const groups = new Map<string, string[]>()
+    for (const rule of rules(source, behavior)) {
+      const parsed = parseClaudeToolSelector(rule)
+      if (parsed.toolName !== tool) continue
+      if (parsed.ruleContent === undefined) {
+        if (behavior !== 'allow') return true
+        continue
+      }
+      let pattern = parsed.ruleContent
+      const negative = pattern.startsWith('!') ? '!' : ''
+      pattern = pattern.slice(negative.length)
+      let root = cwd
+      if (pattern.startsWith('//')) { root = path.parse(cwd).root; pattern = pattern.slice(1) }
+      else if (pattern.startsWith('~/')) { if (!home) continue; root = home; pattern = pattern.slice(1) }
+      else if (pattern.startsWith('/')) root = source.base
+      else if (pattern.startsWith('./')) pattern = pattern.slice(2)
+      if (pattern.endsWith('/**')) {
+        pattern = pattern.slice(0, -3)
+        if (!pattern) pattern = '/**'
+        else if (behavior === 'allow' && !pattern.includes('/') && !/^[!#]/u.test(pattern)) pattern = `/${pattern}`
+      }
+      const roots = new Set([root, fs.processPath(await fs.resolve(root, { signal, cwd }))])
+      const variants = [negative + pattern]
+      const macPrefix = root === '/' && /^\/(?:private\/)?(var|tmp)(?=\/|$)/u.exec(pattern)
+      if (macPrefix) {
+        const alias = `/${macPrefix[1]}`
+        const physical = fs.processPath(await fs.resolve(alias, { signal, cwd }))
+        if (physical === `/private${alias}`) {
+          const rest = pattern.slice(macPrefix[0].length)
+          variants.push(negative + alias + rest, negative + physical + rest)
+        }
+      }
+      for (const spelling of roots) {
+        const patterns = groups.get(spelling) ?? []
+        patterns.push(...variants)
+        groups.set(spelling, patterns)
+      }
+    }
+    for (const [root, patterns] of groups) {
+      const relative = path.relative(root, candidate).split(path.sep).join('/')
+      if (relative && ignore.isPathValid(relative) && ignore({ ignorecase: false }).add(patterns).ignores(relative)) return true
+    }
+    return false
+  }
+  for (const source of sources) for (const candidate of paths) {
+    if (await match(source, 'deny', 'Read', candidate) || await match(source, 'ask', 'Read', candidate)) return false
+  }
+  const directories = [cwd, ...options.additionalDirectories]
+  for (const source of sources) {
+    const extra = source.permissions.additionalDirectories
+    if (extra !== undefined) {
+      if (!Array.isArray(extra) || extra.some(value => typeof value !== 'string')) throw new Error('invalid Claude permissions.additionalDirectories')
+      directories.push(...extra.map(value => path.resolve(cwd, String(value))))
+    }
+  }
+  const expand = async (roots: readonly string[]): Promise<string[]> => {
+    const resolved = []
+    for (const root of roots) resolved.push(path.resolve(cwd, root), fs.processPath(await fs.resolve(root, { signal, cwd })))
+    return resolved
+  }
+  const allowedRoots = await expand(directories)
+  const within = paths.every(candidate => allowedRoots.some(root => contains(root, candidate)))
+  if (sources.some(source => source.permissions.blockReadsOutsideWorkingDirectories === true) && !within) return false
+  if (within) return true
+  const privateRoots = await expand(options.privateDirectories)
+  if (paths.every(candidate => privateRoots.some(root => contains(root, candidate)))) return true
+  // An explicit Edit allow grants the corresponding read, unless Edit itself needs permission.
+  for (const candidate of paths) {
+    let allowed = false
+    let editBlocked = false
+    for (const source of sources) editBlocked ||= await match(source, 'deny', 'Edit', candidate) || await match(source, 'ask', 'Edit', candidate)
+    for (const source of sources) allowed ||= await match(source, 'allow', 'Read', candidate) || !editBlocked && await match(source, 'allow', 'Edit', candidate)
+    if (!allowed && !options.bypassPermissions) return false
+  }
+  signal.throwIfAborted()
+  return true
+}
