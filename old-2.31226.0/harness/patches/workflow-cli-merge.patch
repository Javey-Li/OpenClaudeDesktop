index 0000000000..7e0a600b40
--- /dev/null
+++ b/packages/hooks/hooks-claude-code/src/http-network.ts
@@ -0,0 +1,82 @@
+/** HTTP hook address validation at connection lookup, with the installed proxy route.
+ * @module @deepseek-ai/dsh-hooks-claude-code/http-network
+ */
+import { lookup } from 'node:dns/promises'
+import type { LookupAddress, LookupOptions } from 'node:dns'
+import { isIP } from 'node:net'
+import ipaddr from 'ipaddr.js'
+import { proxyRouteFor } from '@deepseek-ai/dsh-http-proxy'
+
+/** Test the CLI's private/link-local ranges; loopback remains usable for local hooks.
+ * @param address - A numeric IPv4 or IPv6 address.
+ * @returns Whether a direct HTTP hook connection must be refused.
+ */
+export function blockedHttpHookAddress(address: string): boolean {
+  const family = isIP(address)
+  if (!family) return false
+  if (family === 6) {
+    const lower = address.toLowerCase()
+    if (lower === '::') return true
+    const parsed = ipaddr.parse(address)
+    if (parsed instanceof ipaddr.IPv6 && parsed.isIPv4MappedAddress()) return blockedHttpHookAddress(parsed.toIPv4Address().toString())
+    if (lower.startsWith('fc') || lower.startsWith('fd')) return true
+    const prefix = lower.split(':')[0] ?? ''
+    return prefix.length === 4 && prefix >= 'fe80' && prefix <= 'febf'
+  }
+  const [a, b] = address.split('.').map(Number)
+  if (a === undefined || b === undefined) return false
+  return a === 0 || a === 10 || a === 169 && b === 254 || a === 172 && b >= 16 && b <= 31
+    || a === 100 && b >= 64 && b <= 127 || a === 192 && b === 168
+}
+
+function blocked(hostname: string, address: string): Error {
+  return Object.assign(new Error(`HTTP hook blocked: ${hostname} resolves to ${address} (private/link-local address). Loopback (127.0.0.1, ::1) is allowed for local dev.`), {
+    code: 'ERR_HTTP_HOOK_BLOCKED_ADDRESS', hostname, address,
+  })
+}
+
+type LookupCallback = (error: NodeJS.ErrnoException | null, address: string | LookupAddress[], family?: number) => void
+
+/** Validate every DNS answer and use that same result for the connection.
+ * @param hostname - Hostname being connected to.
+ * @param options - Node connector options, including its all-addresses mode.
+ * @param callback - Receives the validated addresses or a lookup error.
+ */
+export function lookupHttpHook(hostname: string, options: LookupOptions, callback: LookupCallback): void {
+  void lookup(hostname, { all: true }).then((addresses) => {
+    const refused = addresses.find(entry => blockedHttpHookAddress(entry.address))
+    if (refused) { callback(blocked(hostname, refused.address), ''); return }
+    const first = addresses[0]
+    if (!first) { callback(Object.assign(new Error(`ENOTFOUND ${hostname}`), { code: 'ENOTFOUND', hostname }), ''); return }
+    if (options.all) callback(null, addresses)
+    else callback(null, first.address, first.family)
+  }, (error: unknown) => { callback(error instanceof Error ? error : new Error(String(error)), '') })
+}
+
+/** Post one hook payload without redirects and read its body before releasing the connection.
+ * @param url - Hook URL; only HTTP and HTTPS are accepted.
+ * @param headers - Prepared request headers.
+ * @param body - Serialized hook event input.
+ * @param signal - Cancels connection and response-body reading.
+ * @returns HTTP status and the complete response text.
+ */
+export async function postHttpHook(
+  url: URL, headers: Record<string, string>, body: string, signal: AbortSignal,
+): Promise<{ status: number; body: string }> {
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new Error('HTTP hooks require an http: or https: URL')
+  const route = proxyRouteFor(url)
+  const hostname = url.hostname.replace(/^\[|\]$/g, '')
+  if (!route.proxied && blockedHttpHookAddress(hostname)) throw blocked(hostname, hostname)
+  const { Agent, fetch } = await import('undici')
+  // proxy-exempt: direct destinations need a per-request validating DNS lookup;
+  // proxied destinations use the installed policy's dispatcher without owning it.
+  const dispatcher = route.proxied ? route.dispatcher : new Agent({ connect: { lookup: lookupHttpHook } })
+  try {
+    // proxy-exempt: the dispatcher above follows proxyRouteFor for this URL.
+    const response = await fetch(url, { method: 'POST', headers, body, redirect: 'manual', signal, dispatcher })
+    return { status: response.status, body: await response.text() }
+  } finally {
+    // Destroying the private pool also settles a partially read/cancelled body.
+    if (!route.proxied) await dispatcher.destroy()
+  }
+}
