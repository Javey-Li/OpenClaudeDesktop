@@ -0,0 +1,122 @@
+/** Request-owned streaming tool dispatch and durable response settlement. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { createAssistantMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+import { assembleStreamedAssistant } from '@deepseek-ai/dsh-session'
+import type { Session, SessionSeq, StreamedAssistantBlock, UserMessage } from '@deepseek-ai/dsh-session'
+import type { AssistantStreamAttempt } from './assistant-stream.ts'
+import { ToolCallBatch } from './tool-call-batch.ts'
+import { executeToolCalls } from './tool-calls.ts'
+
+/** One request owns the input queue, its cancellation, and the scheduler drain. */
+export class StreamingTools {
+  private readonly batch = new ToolCallBatch()
+  private readonly abort = new AbortController()
+  private readonly advertised = new Map<number, SessionSeq>()
+  private readonly order = new Set<number>()
+  private readonly closed = new Set<number>()
+  private hasText = false
+  private readonly startSeq: SessionSeq
+  private readonly result: Promise<{ kind: 'done'; concluded: boolean } | { kind: 'error'; error: unknown }>
+  readonly signal: AbortSignal
+
+  constructor(
+    context: Context,
+    private readonly session: Session,
+    private readonly live: AssistantStreamAttempt,
+    private readonly request: GenerateOptions,
+    signal: AbortSignal,
+    onContext: (message: UserMessage) => void,
+    transport?: 'non-streaming',
+  ) {
+    this.signal = AbortSignal.any([signal, this.abort.signal])
+    this.startSeq = session.append('assistant/stream-start', {
+      turn: live.turn, step: live.step, provider: request.provider, model: request.model,
+      incompleteBlocks: 'discard',
+      ...transport === undefined ? {} : { transport },
+    }).seq
+    this.result = executeToolCalls(context, live.turn, live.step, this.batch, this.signal, onContext).then(
+      result => ({ kind: 'done', ...result }),
+      (error: unknown) => {
+        this.abort.abort(error)
+        return { kind: 'error', error }
+      },
+    )
+  }
+
+  get count(): number { return this.batch.length }
+
+  /** Dispatch only the completed prefix, preserving model order across barriers. */
+  push(chunk: StreamChunk): void {
+    if ('index' in chunk) this.order.add(chunk.index)
+    if (chunk.type !== 'block-end') return
+    this.closed.add(chunk.index)
+    const completePrefix = new Set<number>()
+    for (const index of this.order) {
+      if (!this.closed.has(index)) break
+      completePrefix.add(index)
+    }
+    for (const fragment of assembleStreamedAssistant(this.live.stream).blocks) {
+      if (completePrefix.has(fragment.index)) this.advertise(fragment)
+    }
+  }
+
+  private advertise(fragment: StreamedAssistantBlock): void {
+    if (this.advertised.has(fragment.index)) return
+    const checkpoint = this.session.append('assistant/message', {
+      turn: this.live.turn, step: this.live.step,
+      message: createAssistantMessage({
+        content: [fragment.block], source: { provider: this.request.provider, model: this.request.model },
+      }),
+      stream: fragment.stream,
+    }, { surfaceOp: 'append' })
+    this.advertised.set(fragment.index, checkpoint.seq)
+    if (fragment.block.type === 'text' && fragment.block.text.length > 0) this.hasText = true
+    if (fragment.block.type === 'tool-call' && !this.signal.aborted) this.batch.add(fragment.block)
+  }
+
+  /** Stop the request and its started tools after a thrown provider/middleware failure. */
+  fail(error: unknown): void { this.abort.abort(error) }
+
+  /** Record the text-only recovery instruction after the driver commits to retrying. */
+  recordRetry(): void {
+    if (this.count > 0 || !this.hasText) return
+    this.session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'Your response above was cut off mid-stream and only your next message is delivered. Write the complete response again from the start — no apology, no mention of the cut-off.' }],
+      source: { kind: 'stream-recovery', form: 'instructions' },
+    }), { surfaceOp: 'append' })
+  }
+
+  /** Drain every started call, then commit the full stream and its history reconstruction. */
+  async settle(): Promise<{ concluded: boolean; generationBeforeMerge: number; generationAfterMerge: number }> {
+    let failure: { error: unknown } | undefined
+    try {
+      for (const fragment of assembleStreamedAssistant(this.live.stream, 'discard').blocks) this.advertise(fragment)
+    } catch (error: unknown) {
+      failure = { error }
+      this.abort.abort(error)
+    } finally {
+      this.batch.close()
+    }
+    const result = await this.result
+    if (failure !== undefined) throw failure.error
+    let generationBeforeMerge = 0
+    let generationAfterMerge = 0
+    this.live.settle('assistant/attempt', () => {
+      const attempt = this.session.append('assistant/attempt', {
+        turn: this.live.turn, step: this.live.step, stream: this.live.stream,
+      })
+      generationBeforeMerge = this.session.surface.contentGeneration
+      generationAfterMerge = generationBeforeMerge + (this.advertised.size > 0 ? 1 : 0)
+      this.session.append('assistant/stream-merge', {
+        turn: this.live.turn, step: this.live.step, startSeq: this.startSeq, attemptSeq: attempt.seq,
+        messageSeqs: [...this.advertised.values()],
+        incompleteBlocks: 'discard',
+      })
+      return attempt.seq
+    })
+    if (result.kind === 'error') throw result.error
+    return { concluded: result.concluded, generationBeforeMerge, generationAfterMerge }
+  }
+}
diff --git a/packages/core/agent-loop/src/tool-call-batch.ts b/packages/core/agent-loop/src/tool-call-batch.ts
new file mode 100644
index 0000000000..3346741d52
--- /dev/null
+++ b/packages/core/agent-loop/src/tool-call-batch.ts
@@ -0,0 +1,50 @@
+/** Complete, durably advertised calls arriving during one assistant response. */
+
+import type { ToolCallBlock } from '@deepseek-ai/dsh-llm'
+
+/** One producer feeds calls; the scheduler drains them after closure or cancellation. */
+export class ToolCallBatch {
+  private readonly calls: ToolCallBlock[] = []
+  private ended = false
+  private change = Promise.withResolvers<void>()
+
+  /** Number of complete calls received so far. */
+  get length(): number { return this.calls.length }
+
+  /** Whether no more calls may arrive. */
+  get closed(): boolean { return this.ended }
+
+  /** Resolves on the next addition or closure; read before inspecting current state. */
+  get changed(): Promise<void> { return this.change.promise }
+
+  /**
+   * Snapshot a complete call after its assistant message has committed.
+   * @param block - the model-authored call, without input preparation rewrites.
+   * @throws if the response has closed, including scheduler cancellation.
+   */
+  add(block: ToolCallBlock): void {
+    if (this.ended) throw new Error('Cannot add a tool call after its response closed')
+    this.calls.push(structuredClone(block))
+    this.notify()
+  }
+
+  /** Stop accepting calls and wake a scheduler waiting for input. Idempotent. */
+  close(): void {
+    if (this.ended) return
+    this.ended = true
+    this.notify()
+  }
+
+  /**
+   * Read a received call by its model-order position.
+   * @param index - zero-based position.
+   * @returns the call, or undefined when it has not arrived.
+   */
+  at(index: number): ToolCallBlock | undefined { return this.calls[index] }
+
+  private notify(): void {
+    const previous = this.change
+    this.change = Promise.withResolvers<void>()
+    previous.resolve()
+  }
+}
