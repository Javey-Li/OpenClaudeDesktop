diff --git a/packages/subagent/subagent/src/output-schema-lint.ts b/packages/subagent/subagent/src/output-schema-lint.ts
new file mode 100644
index 0000000000..3dbf2f89ca
--- /dev/null
+++ b/packages/subagent/subagent/src/output-schema-lint.ts
@@ -0,0 +1,70 @@
+/** Reject the statically impossible property/item schemas checked by workflow admission. */
+import { JsonSchemaError } from '@deepseek-ai/dsh-tools'
+
+function record(value: unknown): Record<string, unknown> | undefined {
+  return value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : undefined
+}
+
+function matchesType(value: unknown, type: string): boolean {
+  switch (type) {
+    case 'null': return value === null
+    case 'object': return record(value) !== undefined
+    case 'array': return Array.isArray(value)
+    case 'integer': return typeof value === 'number' && Number.isInteger(value)
+    default: return typeof value === type
+  }
+}
+
+/** Check local contradictions after Ajv accepts the schema's syntax.
+ * References and combinator branches are deliberately left to Ajv, matching
+ * the CLI's bounded property/item lint rather than attempting general SAT.
+ * @param root - a detached, syntactically valid JSON Schema object.
+ */
+export function assertUsableOutputSchema(root: Record<string, unknown>): void {
+  const stack = [{ schema: root, path: 'root', depth: 0 }]
+  let remaining = 100_000
+  for (let node = stack.pop(); node !== undefined; node = stack.pop()) {
+    const { schema, path, depth } = node
+    if (depth >= 32 || --remaining < 0 || Object.hasOwn(schema, '$ref')) continue
+    const types = typeof schema.type === 'string' ? [schema.type]
+      : Array.isArray(schema.type) ? schema.type.filter((value): value is string => typeof value === 'string') : undefined
+    if (schema.nullable === true && types && !types.includes('null')) types.push('null')
+    const only = (type: string): boolean => types?.length === 1 && types[0] === type
+    const required = Array.isArray(schema.required) ? schema.required.filter((value): value is string => typeof value === 'string' && !(value in Object.prototype)) : []
+    const properties = record(schema.properties)
+    const fail = (reason: string): never => { throw new JsonSchemaError([`${path}: unusable schema — ${reason}`]) }
+    if (only('object')) {
+      if (schema.additionalProperties === false && schema.patternProperties === undefined
+        && required.some(key => !properties || !Object.hasOwn(properties, key))) {
+        fail('a required property is forbidden by additionalProperties')
+      }
+      if (typeof schema.maxProperties === 'number' && required.length > schema.maxProperties) fail('required properties exceed maxProperties')
+    }
+    const choices = Array.isArray(schema.enum) ? schema.enum : undefined
+    if (types && choices?.length && !choices.some(value => types.some(type => matchesType(value, type)))) fail('no enum value matches the declared type')
+    if (Object.hasOwn(schema, 'const')) {
+      if (types && !types.some(type => matchesType(schema.const, type))) fail('const does not match the declared type')
+      if (choices?.length && (schema.const === null || typeof schema.const !== 'object') && !choices.includes(schema.const)) fail('const is absent from enum')
+    }
+    const bounds: [string, string, string][] = [['string', 'minLength', 'maxLength'], ['array', 'minItems', 'maxItems'], ['object', 'minProperties', 'maxProperties']]
+    for (const [type, low, high] of bounds) {
+      if (only(type) && typeof schema[low] === 'number' && typeof schema[high] === 'number' && schema[low] > schema[high]) fail(`${low} exceeds ${high}`)
+    }
+    if (types?.length && types.every(type => type === 'number' || type === 'integer')) {
+      const min = typeof schema.minimum === 'number' ? schema.minimum : -Infinity
+      const max = typeof schema.maximum === 'number' ? schema.maximum : Infinity
+      const exclusiveMin = typeof schema.exclusiveMinimum === 'number' ? schema.exclusiveMinimum : -Infinity
+      const exclusiveMax = typeof schema.exclusiveMaximum === 'number' ? schema.exclusiveMaximum : Infinity
+      const low = Math.max(min, exclusiveMin), high = Math.min(max, exclusiveMax)
+      if (low > high || (low === high && (exclusiveMin === low || exclusiveMax === high))) fail('numeric bounds admit no value')
+    }
+    if ((!types || types.includes('object')) && properties) {
+      for (const [key, value] of Object.entries(properties)) {
+        const child = record(value)
+        if (child && key !== '__proto__') stack.push({ schema: child, path: `${path}/properties/${key.replaceAll('~', '~0').replaceAll('/', '~1')}`, depth: depth + 1 })
+      }
+    }
+    const items = record(schema.items)
+    if ((!types || types.includes('array')) && items) stack.push({ schema: items, path: `${path}/items`, depth: depth + 1 })
+  }
+}
