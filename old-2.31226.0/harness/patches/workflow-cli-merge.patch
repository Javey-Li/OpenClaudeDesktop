+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+import { workflowPreview } from '../src/output.ts'
+
+// Recorded with the published Claude 2.1.286 executable and a local Messages fixture.
+const native = JSON.parse(await readFile(new URL('./fixtures/output-native.json', import.meta.url), 'utf8')) as { name: string; fileText: string }[]
+const scripts: Record<string, string> = {
+  object: 'log("first");phase("Inspect");return {answer:42}',
+  undefined: 'log("no return")',
+  null: 'return null',
+  failure: 'phase("Inspect");log("before failure");throw {name:"Failure",message:"fixture",stack:"  at fixture"}',
+  phases: 'phase("First");phase("Second");phase("First");return 1',
+}
+
+it.each(native)('writes the native $name artifact through the real PTC process', async ({ name, fileText }) => {
+  const t = await setupMerge()
+  const run = t.start(scripts[name]!, { meta: { name: 'output', description: 'Workflow result and logs' } })
+  expect((await run.result).stopReason).toBe(name === 'failure' ? 'error' : 'completed')
+  expect(await readFile(run.outputFile!, 'utf8')).toBe(fileText)
+  await run.dispose()
+})
+
+it('retains reserved child indices, complete values and cache observations without fabricating provider metrics', async () => {
+  const t = await setupMerge()
+  const script = 'await workflow("empty");phase("Parent");log("kept");return await workflow("child")'
+  const extra = { meta: { name: 'output', description: 'Output fixture', phases: [{ title: 'Declared' }] },
+    resolveWorkflow: async ({ name }: { name?: string }) => ({ meta: { name: name!, description: 'Child' }, script: name === 'empty' ? 'return 1' : 'return await agent("  inspect  ",{label:"Inspect"})' }),
+  }
+  const run = t.start(script, extra)
+  expect((await run.result).value).toBe('reply-1')
+  const output = JSON.parse(await readFile(run.outputFile!, 'utf8')) as { workflowProgress: Record<string, unknown>[] }
+  expect(output.workflowProgress.filter(row => row.type === 'workflow_phase')).toEqual([
+    { type: 'workflow_phase', index: 1, title: 'Declared' },
+    { type: 'workflow_phase', index: 3, title: 'Parent' },
+    { type: 'workflow_phase', index: 4, title: '▸ child', kind: 'child' },
+  ])
+  expect(output.workflowProgress.at(-1)).toMatchObject({ type: 'workflow_agent', index: 1, label: 'Inspect', phaseIndex: 4,
+    state: 'done', agentId: 'merge-child-1', promptPreview: 'inspect', promptFramed: true, resultPreview: 'reply-1', attempt: 1,
+  })
+  expect(output).not.toHaveProperty('totalTokens')
+  expect(output).not.toHaveProperty('totalToolCalls')
+  await run.dispose()
+  const resumed = t.start(script, { ...extra, resumeFromRunId: run.id })
+  expect((await resumed.result).value).toBe('reply-1')
+  const cached = JSON.parse(await readFile(resumed.outputFile!, 'utf8')) as { workflowProgress: Record<string, unknown>[]; totalTokens: number; totalToolCalls: number }
+  expect(cached.workflowProgress.at(-1)).toMatchObject({ cached: true, state: 'done', resultPreview: 'reply-1' })
+  for (const field of ['tokens', 'toolCalls', 'durationMs', 'queuedAt', 'attempt', 'promptFramed']) expect(cached.workflowProgress.at(-1)).not.toHaveProperty(field)
+  expect(cached.totalTokens).toBe(0)
+  expect(cached.totalToolCalls).toBe(0)
+  expect(t.requests).toHaveLength(1)
+  await resumed.dispose()
+})
+
+it('keeps cancelled output empty after pending work is disposed', async () => {
+  const t = await setupMerge()
+  const run = t.start('await new Promise(()=>{})')
+  run.cancel('fixture stop')
+  expect((await run.result).stopReason).toBe('cancelled')
+  expect(await readFile(run.outputFile!, 'utf8')).toBe('')
+  await run.dispose()
+})
+
+it('bounds previews without trimming the complete returned value or splitting surrogate pairs', () => {
+  expect(workflowPreview('  ')).toBeUndefined()
+  expect(workflowPreview(null)).toBeUndefined()
+  expect(workflowPreview({ answer: 42 })).toBe('{"answer":42}')
+  expect(workflowPreview('x'.repeat(399) + '😀tail')).toBe('x'.repeat(399) + '…')
+  expect(workflowPreview('x'.repeat(398) + '😀tail')).toBe('x'.repeat(398) + '😀…')
+})
