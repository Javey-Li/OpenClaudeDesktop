+    // Native inline inputs have a character cap; disk reads enforce the byte cap before decoding.
+    if (!claude && Buffer.byteLength(source, 'utf8') > config.maxScriptBytes) {
+      throw new Error(`workflow script exceeds maxScriptBytes (${config.maxScriptBytes})`)
+    }
+    const parsed = claude ? parseClaudeWorkflowScript(source, validateBody) : parseClaudeCodeScript(source, validateBody)
