@@ -0,0 +1,18 @@
+/** Shared validation for provider-owned history-repair coordinates. */
+import type { LlmFailure } from './types.ts'
+
+/**
+ * Validate a whole-history or positioned reasoning omission without reading provider payloads.
+ * @param value - untrusted recovery metadata.
+ * @returns whether the metadata is a canonical recovery decision.
+ */
+export function isReasoningRecovery(value: unknown): value is NonNullable<LlmFailure['reasoningRecovery']> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)
+    || Object.keys(value).some(key => key !== 'from')) return false
+  if (!('from' in value) || value.from === undefined) return true
+  const from = value.from
+  return typeof from === 'object' && from !== null && !Array.isArray(from)
+    && Object.keys(from).length === 2 && 'messageId' in from && typeof from.messageId === 'string' && from.messageId.length > 0
+    && 'blockIndex' in from && typeof from.blockIndex === 'number'
+    && Number.isSafeInteger(from.blockIndex) && from.blockIndex >= 0 && !Object.is(from.blockIndex, -0)
+}
