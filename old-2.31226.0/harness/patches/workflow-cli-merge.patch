+import { parseClaudeCodeScript } from './claude-script.ts'
+import { parseClaudeWorkflowScript } from './claude-metadata.ts'
+import { workflowScriptPath } from './script-path.ts'
+import { deepResearchScript } from './builtin-research.ts'
+
+/** Sources accepted at the tool boundary; an explicit path takes precedence. */
+export interface WorkflowSourceInput {
+  script?: string
+  scriptPath?: string
+  name?: string
+}
+
+/** Filesystem lookup limits and directories, supplied by the tool configuration. */
+export interface WorkflowSourceConfig {
+  maxScriptBytes: number
+  workflowDirectories: string[]
