+export function expandHttpHookHeader(
+  text: string, allowed: ReadonlySet<string>, approvedCredentials: ReadonlySet<string>, env: NodeJS.ProcessEnv,
+): string {
+  return text.replace(/\$\{([A-Z_][A-Z0-9_]*)\}|\$([A-Z_][A-Z0-9_]*)/g, (_match, braced: string | undefined, bare: string | undefined) => {
