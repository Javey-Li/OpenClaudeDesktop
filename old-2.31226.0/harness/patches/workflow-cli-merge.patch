+  /** Restore missing private files from the latest retained same-Session execution.
+   * @param root - Configured host journal directory.
+   * @param sessionId - Owner whose projection supplied the backup.
+   * @param runId - Validated run identity.
+   * @param provider - Required child-provider route.
+   * @param snapshot - Latest retained attempt, absent when mirroring was unavailable.
+   * @param requestedFileName - Matching private source requested by the caller, never an arbitrary target path.
+   * @param warn - Receives nonfatal script restoration failures.
+   */
+  static restore(root: string, sessionId: string, runId: string, provider: string, snapshot: WorkflowMirrorSnapshot | undefined,
+    requestedFileName: string | undefined, warn: (error: unknown) => void): void {
+    assertRunId(runId)
+    if (!snapshot) return
+    try {
+      const directory = join(root, digest(sessionId), runId)
+      const raw = contents(directory)
+      const source = snapshot.source
+      const usableSource = source && /^[A-Za-z0-9_.-]{1,120}\.js$/.test(source.fileName)
+        && source.script.length <= 524288 && !/[\x00-\x08\x0b-\x1f\x7f-\x9f]/u.test(source.script) ? source : undefined
+      const scriptMissing = usableSource && requestedFileName === usableSource.fileName
+        && !existsSync(join(directory, usableSource.fileName))
+      if (raw !== undefined && !scriptMissing) return
+      if (snapshot.provider !== provider) throw new Error('backup belongs to another provider')
+      mkdirSync(directory, { recursive: true, mode: 0o700 })
+      if (realpathSync(directory) !== join(realpathSync(root), digest(sessionId), runId)) throw new Error('private journal directory resolves outside its owner')
+      if (usableSource) {
+        try { writeFileSync(join(directory, usableSource.fileName), usableSource.script, { flag: 'wx', mode: 0o600, flush: true }) }
+        catch (error) { if (!(error instanceof Error && 'code' in error && error.code === 'EEXIST')) warn(error) }
+      }
+      if (raw !== undefined) return
+      const attemptId = randomUUID()
+      const restored = [JSON.stringify({ version: 2, sessionId, runId, provider }), ...snapshot.entries.map(entry => JSON.stringify(entry))].join('\n') + '\n'
+      writeFileSync(join(directory, `${attemptId}.jsonl`), restored, { flag: 'wx', mode: 0o600, flush: true })
+      const pointer = join(directory, `${attemptId}.json.tmp`)
+      writeFileSync(pointer, JSON.stringify({ attemptId }) + '\n', { flag: 'wx', mode: 0o600, flush: true })
+      renameSync(pointer, join(directory, 'current.json'))
+    } catch (cause) {
+      throw new WorkflowError(`Could not restore the journal for workflow run ${runId}`, 'RESUME_UNAVAILABLE', { cause })
+    }
+  }
+}
