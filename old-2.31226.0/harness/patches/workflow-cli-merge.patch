+
+async function setup(script: ConstructorParameters<typeof MockAdapter>[0]) {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  const { cwd, root } = await mountPtcRuntime(ctx)
+  const user = join(root, 'user')
+  await mkdir(join(user, '.claude/agents'), { recursive: true })
+  await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+  vi.spyOn(ctx.fs, 'processPathFromHostPath').mockImplementation(path => path.startsWith(join(homedir(), '.claude')) ? user + path.slice(homedir().length) : undefined)
+  await ctx.plugin(LocalBashExecutor, { timeoutMs: 10_000 })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(SubagentRuntime)
+  await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+  let executions = 0
+  ctx.tools.register(defineContentToolFixture({ name: 'bash', description: 'fixture tool', parameters: { command: { type: 'string', required: true } }, execute: async () => { executions++; return [{ type: 'text', text: 'executed' }] } }))
+  const adapter = new MockAdapter(script)
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const parent = await ctx.agents.create({ sessionId: SessionId('hook-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+  return { ctx, cwd, root, user, adapter, parent, executions: () => executions }
+}
+
+describe('local agent frontmatter hooks', () => {
+  it.each(['PreToolUse', 'PostToolUse', 'PostToolUseFailure', 'Stop'])('honors continue:false at %s without halting the parent or losing completed output', async (point) => {
+    const first = point === 'Stop' ? textResponse('HOOK_FINAL_OUTPUT')
+      : toolCallResponse('hooked', point === 'PostToolUseFailure' ? 'explode' : 'bash', { command: 'allowed' }, 'HOOK_PARTIAL_OUTPUT')
+    const h = await setup([first, textResponse('PARENT_RESULT')])
+    if (point === 'PostToolUseFailure') h.ctx.tools.register(defineContentToolFixture({ name: 'explode', description: 'failure fixture', parameters: {}, execute: async () => { throw new Error('tool exploded') } }))
+    await writeFile(join(h.user, '.claude/agents/checked.md'), definition({ [point]: [{ hooks: [command('halt.cjs')] }] }).replace('tools: [Bash]', 'tools: [Bash, explode]'))
+    await writeFile(join(h.cwd, 'halt.cjs'), 'console.log(JSON.stringify({continue:false,stopReason:\'HOOK_HALT_REASON\',decision:\'block\',reason:\'This must not force continuation.\'}))')
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Run the requested work.' }] })
+    const result = await run.result
+    expect(result.stopReason).toBe('hook-stopped')
+    expect(result.output).toContainEqual({ type: 'text', text: point === 'Stop' ? 'HOOK_FINAL_OUTPUT' : 'HOOK_PARTIAL_OUTPUT' })
+    expect(h.adapter.requests).toHaveLength(1)
+    expect(h.executions()).toBe(point === 'PostToolUse' ? 1 : 0)
+    const events = run.localAgent!.session.snapshotEvents()
+    expect(events.findLast(event => event.type === 'turn/end')?.data).toMatchObject({ reason: { kind: 'aborted', reason: { kind: 'hook', reason: 'HOOK_HALT_REASON' } } })
+    const toolResult = events.find(event => event.type === 'tool/result')
+    if (point === 'PostToolUse') expect(toolResult?.type === 'tool/result' && toolResult.data.message).toMatchObject({ isError: false, content: [{ type: 'text', text: 'executed' }] })
+    if (point === 'PostToolUseFailure') expect(toolResult?.type === 'tool/result' && toolResult.data.message).toMatchObject({ isError: true, content: [{ type: 'text', text: 'Error: tool exploded' }] })
+    await run.dispose()
+    h.parent.agent.followup(createUserMessage({ content: [{ type: 'text', text: 'Continue the parent task.' }], source: { kind: 'user' } }))
+    await h.parent.agent.whenIdle()
+    expect(h.adapter.requests).toHaveLength(2)
+    expect(h.parent.agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data).toMatchObject({ reason: { kind: 'completed' } })
+    await h.parent.dispose()
+  })
+
+  it('blocks only the selected child, logs pre/post context, converts Stop and tears down its handlers', async () => {
+    const h = await setup([toolCallResponse('deny', 'bash', { command: 'blocked' }), toolCallResponse('allow', 'bash', { command: 'allowed' }), textResponse('first answer'), textResponse('corrected answer'), toolCallResponse('parent', 'bash', { command: 'blocked' }), textResponse('parent answer')])
+    await writeFile(join(h.user, '.claude/agents/checked.md'), definition({ PreToolUse: [{ matcher: 'Bash', hooks: [command('pre.cjs')] }], PostToolUse: [{ matcher: 'Bash', hooks: [command('post.cjs')] }], Stop: [{ hooks: [command('stop.cjs')] }] }))
+    await writeFile(join(h.cwd, 'pre.cjs'), 'let s=\'\'; process.stdin.on(\'data\',x=>s+=x).on(\'end\',()=>{const p=JSON.parse(s);require(\'fs\').appendFileSync(\'hook-input.jsonl\',JSON.stringify(p)+\'\\n\');if(p.tool_input.command===\'blocked\'){process.stderr.write(\'blocked by declared agent hook\');process.exitCode=2}else console.log(JSON.stringify({hookSpecificOutput:{hookEventName:\'PreToolUse\',additionalContext:\'PRE_HOOK_CONTEXT\'}}))})')
+    await writeFile(join(h.cwd, 'post.cjs'), 'console.log(JSON.stringify({hookSpecificOutput:{hookEventName:\'PostToolUse\',additionalContext:\'POST_HOOK_CONTEXT\'}}))')
+    await writeFile(join(h.cwd, 'stop.cjs'), 'let s=\'\'; process.stdin.on(\'data\',x=>s+=x).on(\'end\',()=>{const p=JSON.parse(s);require(\'fs\').appendFileSync(\'stop-input.jsonl\',JSON.stringify(p)+\'\\n\');console.log(JSON.stringify(p.stop_hook_active?{}:{decision:\'block\',reason:\'Make one correction.\'}))})')
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Try blocked, then allowed; finish.' }] })
+    expect((await run.result).stopReason).toBe('completed')
+    expect(h.executions()).toBe(1)
+    expect(run.localAgent!.session.snapshotEvents().filter(event => event.type === 'hook/invoked' && event.data.point === 'PostToolUse')).toHaveLength(1)
+    const events = run.localAgent!.session.snapshotEvents()
+    expect(events.filter(event => event.type === 'hook/invoked' && event.data.point === 'SubagentStop')).toHaveLength(2)
+    expect(events.some(event => event.type === 'hook/invoked' && event.data.point === 'Stop')).toBe(false)
+    expect(JSON.stringify(events)).toContain('blocked by declared agent hook')
+    expect(JSON.stringify(h.adapter.requests[2]!.messages)).toContain('PRE_HOOK_CONTEXT')
+    expect(JSON.stringify(h.adapter.requests[2]!.messages)).toContain('POST_HOOK_CONTEXT')
+    const payloads = (await readFile(join(h.cwd, 'stop-input.jsonl'), 'utf8')).trim().split('\n').map((line): unknown => JSON.parse(line))
+    expect(payloads).toMatchObject([{ stop_hook_active: false }, { stop_hook_active: true }])
+    expect(payloads[0]).toMatchObject({ hook_event_name: 'SubagentStop', agent_type: 'checked', cwd: h.cwd, last_assistant_message: 'first answer' })
+    expect(JSON.parse((await readFile(join(h.cwd, 'hook-input.jsonl'), 'utf8')).split('\n')[0]!)).toMatchObject({ tool_name: 'Bash' })
+    await run.dispose()
+    h.parent.agent.followup(createUserMessage({ content: [{ type: 'text', text: 'Parent task' }], source: { kind: 'user' } }))
+    await h.parent.agent.whenIdle()
+    expect(h.executions()).toBe(2)
+    expect(h.parent.agent.session.snapshotEvents().some(event => event.type === 'hook/invoked')).toBe(false)
+    await h.parent.dispose()
+  })
+
+  it('routes failed tool bodies to PostToolUseFailure without running success hooks', async () => {
+    const h = await setup([toolCallResponse('failure', 'explode', {}), textResponse('failed')])
+    h.ctx.tools.register(defineContentToolFixture({ name: 'explode', description: 'failure fixture', parameters: {}, execute: async () => { throw new Error('tool exploded') } }))
+    await writeFile(join(h.user, '.claude/agents/checked.md'), definition({ PostToolUse: [{ hooks: [{ type: 'command', command: 'printf bad > success-marker' }] }], PostToolUseFailure: [{ hooks: [{ type: 'command', command: 'cat > failure-input.json' }] }] }).replace('tools: [Bash]', 'tools: [explode]'))
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Run failing tool.' }] })
+    await run.result
+    expect(JSON.parse(await readFile(join(h.cwd, 'failure-input.json'), 'utf8'))).toMatchObject({ hook_event_name: 'PostToolUseFailure', tool_name: 'explode', is_interrupt: false })
+    await expect(readFile(join(h.cwd, 'success-marker'))).rejects.toMatchObject({ code: 'ENOENT' })
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it('cancels and drains an active hook process before disposal resolves', async () => {
+    const h = await setup([toolCallResponse('wait', 'bash', { command: 'allowed' })])
+    await writeFile(join(h.user, '.claude/agents/checked.md'), definition({ PreToolUse: [{ hooks: [command('wait.cjs')] }] }))
+    await writeFile(join(h.cwd, 'wait.cjs'), 'require(\'fs\').writeFileSync(\'hook.pid\',String(process.pid)); setInterval(()=>{},1000)')
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Use Bash.' }] })
+    let pid = 0
+    await vi.waitFor(async () => { pid = Number(await readFile(join(h.cwd, 'hook.pid'), 'utf8')); expect(pid).toBeGreaterThan(0) })
+    await run.dispose()
+    expect((await run.result).stopReason).toBe('aborted')
+    expect(() => process.kill(pid, 0)).toThrow()
+    expect(h.executions()).toBe(0)
+    await h.parent.dispose()
+  })
+
+  it.each([false, true])('uses only the exact project trust grant: trusted=%s', async (trusted) => {
+    const h = await setup([textResponse('done')])
+    await writeFile(join(h.cwd, '.claude/agents/checked.md'), definition({ Stop: [{ hooks: [{ type: 'command', command: 'printf hook > hook-marker' }] }] }))
+    await writeFile(join(h.user, '.claude.json'), JSON.stringify({ projects: { [trusted ? h.cwd : h.root]: { hasTrustDialogAccepted: true } } }))
+    const loaded = await loadAgentType(h.ctx, 'checked', h.cwd, signal)
+    expect(loaded.hooks !== undefined).toBe(trusted)
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Finish.' }] })
+    expect((await run.result).stopReason).toBe('completed')
+    expect(run.localAgent!.session.snapshotEvents().some(event => event.type === 'hook/invoked')).toBe(trusted)
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it.each([
+    { PreToolUse: { hooks: [command('guard.cjs')] } },
+    [{ matcher: 'Bash', hooks: [command('guard.cjs')] }],
+    { PreToolUse: [{ matcher: '[', hooks: [command('guard.cjs')] }] },
+    { PreToolUse: [{ hooks: [{ type: 'command', command: '' }] }] },
+  ])('rejects malformed guards before a model request: %j', async (hooks) => {
+    const h = await setup([])
+    await writeFile(join(h.user, '.claude/agents/checked.md'), definition(hooks))
+    await expect(h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'checked', prompt: [{ type: 'text', text: 'Do work.' }] })).rejects.toThrow()
+    expect(h.adapter.requests).toHaveLength(0)
+    await h.parent.dispose()
