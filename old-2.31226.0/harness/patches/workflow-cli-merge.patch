@@ -0,0 +1,34 @@
+/** Commit provider-requested reasoning omission before admitting a replacement request. */
+import type { LlmFailure, MessageId, RequestMessage } from '@deepseek-ai/dsh-llm'
+import type { Session } from '@deepseek-ai/dsh-session'
+
+/**
+ * Apply a whole-history repair, or at most two targeted repairs per failed request chain.
+ * @param session - authoritative session whose current messages formed the request.
+ * @param messages - rejected request history, in model-visible order.
+ * @param failure - provider-classified recovery coordinates.
+ * @param attempts - reasoning repairs already made for this step and route.
+ * @returns whether an omission was committed and retry can make progress.
+ */
+export function recoverReasoning(session: Session, messages: readonly RequestMessage[], failure: LlmFailure, attempts: number): boolean {
+  if (failure.code !== 'REASONING_REPLAY_REJECTED' || failure.reasoningRecovery === undefined) return false
+  const from = attempts < 2 ? failure.reasoningRecovery.from : undefined
+  let found = from === undefined
+  const targets: { messageId: MessageId; blockIndexes: number[] }[] = []
+  for (const message of messages) {
+    if (message.role !== 'assistant') continue
+    if (message.id === from?.messageId) {
+      if (message.content[from.blockIndex]?.type !== 'reasoning') throw new Error('Reasoning recovery selected a non-reasoning block')
+      found = true
+    }
+    if (!found) continue
+    const blockIndexes = message.content.flatMap((block, index) => block.type === 'reasoning'
+      && (message.id !== from?.messageId || index >= from.blockIndex) ? [index] : [])
+    if (blockIndexes.length === 0) continue
+    targets.push({ messageId: message.id, blockIndexes })
+  }
+  if (!found) throw new Error('Reasoning recovery selected a message outside the rejected request')
+  if (targets.length === 0) return false
+  session.append('assistant/reasoning-strip', { targets })
+  return true
+}
