@@ -0,0 +1,24 @@
+/** Parse the tool spelling and optional argument text in a Claude tool selector. */
+
+/** Read Tool(argument) syntax without interpreting arguments as execution permissions.
+ * @param selector - One selector after frontmatter list splitting.
+ * @returns The tool spelling and decoded content; malformed calls retain their complete spelling.
+ */
+export function parseClaudeToolSelector(selector: string): { toolName: string; ruleContent?: string } {
+  let opening = -1
+  let closing = -1
+  let escaped = false
+  for (let index = 0; index < selector.length; index++) {
+    const character = selector[index]
+    if (!escaped) {
+      if (character === '(' && opening < 0) opening = index
+      if (character === ')') closing = index
+    }
+    escaped = character === '\\' && !escaped
+  }
+  const name = selector.slice(0, opening)
+  if (opening <= 0 || closing <= opening || closing !== selector.length - 1 || /[()]/.test(name)) return { toolName: selector }
+  const raw = selector.slice(opening + 1, closing)
+  if (!raw || raw === '*') return { toolName: name }
+  return { toolName: name, ruleContent: raw.replace(/\\([()])/g, '$1').replaceAll('\\\\', '\\') }
+}
