+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import type { WorkflowMeta } from '@deepseek-ai/dsh-workflow'
+import { setupMerge } from './merge-setup.ts'
+
+interface PhaseFixture {
+  name: string
+  script: string
+  child: string
+  meta: Partial<WorkflowMeta>
+  progress: Record<string, unknown>[]
+}
+const native = JSON.parse(await readFile(new URL('./fixtures/phases-native.json', import.meta.url), 'utf8')) as PhaseFixture[]
+const project = (rows: Record<string, unknown>[]) => rows.map(row => Object.fromEntries(
+  ['type', 'index', 'title', 'kind', 'label', 'phaseIndex', 'phaseTitle'].filter(key => row[key] !== undefined).map(key => [key, row[key]]),
+))
+
+it.each(native)('preserves native $name phase identities in real PTC events and output', async (fixture) => {
+  const t = await setupMerge({ structured: { items: [1, 2] } })
+  const events: Record<string, unknown>[] = [], starts: Record<string, unknown>[] = []
+  t.ctx.on('workflow/phase', (_run, title, phase) => { events.push({ type: 'workflow_phase', title, ...phase }) })
+  t.ctx.on('workflow/agent-admission', (_run, agent) => { if (agent.state === 'queued') events.push({ type: 'workflow_agent', index: agent.seq, label: agent.label, phaseIndex: agent.phaseIndex, phaseTitle: agent.phase }) })
+  t.ctx.on('workflow/agent-start', (_run, agent) => { starts.push({ type: 'workflow_agent', index: agent.seq, label: agent.label, phaseIndex: agent.phaseIndex, phaseTitle: agent.phase }) })
+  const run = t.start(fixture.script, {
+    meta: { name: 'phases', description: 'Workflow phases', ...fixture.meta },
+    resolveWorkflow: async () => ({ meta: { name: 'child', description: 'Child' }, script: fixture.child }),
+  })
+  expect((await run.result).stopReason).toBe('completed')
+  const output = JSON.parse(await readFile(run.outputFile!, 'utf8')) as { workflowProgress: Record<string, unknown>[] }
+  expect(project(events)).toEqual(fixture.progress)
+  expect(project(output.workflowProgress)).toEqual(fixture.progress)
+  expect(project(starts).sort((a, b) => Number(a.index) - Number(b.index))).toEqual(fixture.progress.filter(row => row.type === 'workflow_agent'))
+  await run.dispose()
+})
