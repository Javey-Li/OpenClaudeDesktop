@@ -0,0 +1,55 @@
+import { describe, expect, it, vi } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+
+const child = { meta: { name: 'child-review', description: 'nested review' }, script: 'return await agent(args.prompt)' }
+describe('nested workflow ownership', () => {
+  it('reuses the agent prefix when unused child arguments and source change', async () => {
+    const t = await setupMerge()
+    const script = 'return await workflow("child", args)'
+    const secondChild = { ...child, script: 'const unused = 2; return await agent("stable")' }
+    // The prompt and execution options own reuse; a child-source namespace would miss it.
+    const baseline = { ...child, script: 'return await agent("stable")' }
+    const original = t.start(script, { args: { unused: 1 }, workflows: { child: baseline } })
+    expect(await original.result).toMatchObject({ stopReason: 'completed' })
+    const requests = t.requests.length
+    const resumed = t.start(script, { args: { unused: 2 }, workflows: { child: secondChild }, resumeFromRunId: original.id })
+    try {
+      expect(await resumed.result).toMatchObject({ stopReason: 'completed', agentsStarted: 1 })
+      expect(t.requests).toHaveLength(requests)
+    } finally { await Promise.all([original.dispose(), resumed.dispose()]) }
+  })
+  it('shares root agent counts, journal prefix, phase groups and budget', async () => {
+    const t = await setupMerge()
+    const phases: string[] = []
+    t.ctx.on('workflow/agent-start', (_run, info) => phases.push(info.phase ?? ''))
+    const script = 'await workflow("child", {prompt: "nested"}); await agent("root"); return budget.spent()'
+    const a = t.start(script, { workflows: { child }, budgetTotal: 12 })
+    expect(await a.result).toMatchObject({ value: 12, agentsStarted: 2, stopReason: 'completed' })
+    expect(phases).toEqual(['▸ child-review', ''])
+    const b = t.start(script, { workflows: { child }, resumeFromRunId: a.id, budgetTotal: 12 })
+    expect(await b.result).toMatchObject({ value: 0, agentsStarted: 2, stopReason: 'completed' })
+    expect(t.requests).toHaveLength(2)
+    await Promise.all([a.dispose(), b.dispose()])
+  })
+  it('rejects a second nesting level and counts child agents against the root cap', async () => {
+    const t = await setupMerge({ cap: 1 })
+    const run = t.start('await workflow("child", {prompt: "nested"}); return await agent("root")', { workflows: { child } })
+    expect(await run.result).toMatchObject({ value: null, stopReason: 'error', agentsStarted: 1 })
+    const deep = t.start('return await workflow("child")', { workflows: { child: { ...child, script: 'return await workflow("child")' } } })
+    expect((await deep.result).error).toContain('nesting is limited to one level')
+    await Promise.all([run.dispose(), deep.dispose()])
+  })
+  it('cancels nested and queued agents and awaits their disposal', async () => {
+    const t = await setupMerge({ hold: true, concurrency: 1 })
+    const run = t.start('return await parallel([() => workflow("child", {prompt:"nested"}), () => agent("queued")])', { workflows: { child } })
+    try {
+      // A source-runtime child can take longer than Vitest's default one-second poll window.
+      await vi.waitFor(() => { expect(t.requests).toHaveLength(1) }, { timeout: 10_000 })
+      run.cancel('user stop')
+      expect(await run.result).toMatchObject({ value: null, stopReason: 'cancelled' })
+      await run.dispose()
+      expect(t.disposed).toEqual([1])
+      expect(t.requests[0]!.signal.aborted).toBe(true)
+    } finally { await run.dispose() }
+  })
+})
