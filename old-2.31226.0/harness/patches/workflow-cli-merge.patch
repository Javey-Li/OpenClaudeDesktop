+++ b/packages/core/session/src/streaming-assistant.ts
@@ -0,0 +1,191 @@
+/** Browser-safe reconstruction of durably advertised streaming tool batches. */
+
+import { AssistantStreamAccumulator, assembleAssistantStream, expandAssistantStream, lastAssistantStreamChunk } from '@deepseek-ai/dsh-llm/assistant-stream'
+import type { AssistantStreamRecord, ContentBlock, Message, ReplayEnvelope, TimedStreamChunk } from '@deepseek-ai/dsh-llm'
+import { deepEqualJson, deepFreeze } from '@deepseek-ai/dsh-util-values'
+import type { SessionEvent, SessionSeq } from './types.ts'
+import type { SessionMessageProjection, SessionMessageProjectionContext } from './surface.ts'
+
+/** One block and its exact, independently replayable stream segment. */
+export interface StreamedAssistantBlock {
+  readonly index: number
+  readonly block: ContentBlock
+  readonly closed: boolean
+  readonly stream: AssistantStreamRecord[]
+}
+
+/**
+ * Retain completed tools even after a failed or truncated response. Incomplete
+ * calls become eligible only at a successful terminal finish. Replay entries
+ * follow the same keep/drop positions, including opaque provider signatures.
+ * @param stream - the exact accumulated response chunks.
+ * @param incompleteBlocks - the recorded policy for unclosed blocks on unsuccessful settlement.
+ * @returns safe blocks in first-seen model order and aligned replay metadata.
+ */
+export function assembleStreamedAssistant(
+  stream: readonly AssistantStreamRecord[],
+  incompleteBlocks?: 'discard',
+): {
+  blocks: StreamedAssistantBlock[]
+  replayState?: ReplayEnvelope
+} {
+  const fragments = new Map<number, {
+    chunks: TimedStreamChunk[]
+    closed: boolean
+    assembler: ReturnType<typeof assembleAssistantStream>
+  }>()
+  for (const timed of expandAssistantStream(stream)) {
+    if (!('index' in timed.chunk)) continue
+    let fragment = fragments.get(timed.chunk.index)
+    if (fragment === undefined) {
+      fragment = { chunks: [], closed: false, assembler: assembleAssistantStream([]) }
+      fragments.set(timed.chunk.index, fragment)
+    }
+    // The first close is authoritative; stragglers belong to the full attempt only.
+    if (fragment.closed) continue
+    fragment.chunks.push(timed)
+    fragment.assembler.push(timed.chunk)
+    if (timed.chunk.type === 'block-end') fragment.closed = true
+  }
+  const finish = lastAssistantStreamChunk(stream, 'finish')
+  const complete = finish?.reason.kind === 'stop' || finish?.reason.kind === 'tool-calls'
+  const kept: number[] = []
+  const blocks: StreamedAssistantBlock[] = []
+  for (const [position, [index, fragment]] of [...fragments].entries()) {
+    if (incompleteBlocks === 'discard' && !fragment.closed && !complete) continue
+    const block = (fragment.closed || complete
+      ? fragment.assembler.blocks()
+      : fragment.assembler.interruptedBlocks())[0]
+    if (block === undefined) continue
+    const accumulator = new AssistantStreamAccumulator()
+    for (const timed of fragment.chunks) accumulator.push(timed)
+    kept.push(position)
+    blocks.push({ index, block, closed: fragment.closed, stream: [...accumulator.snapshot()] })
+  }
+  const keptPositions = new Set(kept)
+  const replay = finish?.replayState
+  const replayState = replay?.blocks === undefined ? replay
+    : replay.blocks.length !== fragments.size ? undefined
+      : { ...replay, blocks: replay.blocks.filter((_, position) => keptPositions.has(position)) }
+  return { blocks, ...replayState === undefined ? {} : { replayState } }
+}
+
+function position(event: SessionEvent): { turn: number; step: number } {
+  if (event.ignorable === true) throw new Error(`${event.type}: stream markers must be required on read`)
+  const data: unknown = event.data
+  if (typeof data !== 'object' || data === null
+    || !('turn' in data) || !('step' in data)
+    || typeof data.turn !== 'number' || !Number.isSafeInteger(data.turn) || data.turn < 0
+    || typeof data.step !== 'number' || !Number.isSafeInteger(data.step) || data.step < 0) {
+    throw new Error(`${event.type}: invalid turn/step`)
+  }
+  return { turn: data.turn, step: data.step }
+}
+
+function preceding(event: SessionEvent, context: SessionMessageProjectionContext): readonly SessionEvent[] {
+  return context.events.slice(0, event.seq - context.baseSeq)
+}
+
+const startProjection: SessionMessageProjection<'assistant/stream-start'> = {
+  type: 'assistant/stream-start',
+  project(event, context) {
+    const { turn, step } = position(event)
+    if (typeof event.data.provider !== 'string' || !event.data.provider
+      || typeof event.data.model !== 'string' || !event.data.model) {
+      throw new Error('assistant/stream-start: missing provider/model')
+    }
+    const transport: unknown = event.data.transport
+    if (transport !== undefined && transport !== 'non-streaming') {
+      throw new Error('assistant/stream-start: invalid transport')
+    }
+    const incompleteBlocks: unknown = event.data.incompleteBlocks
+    if (incompleteBlocks !== undefined && incompleteBlocks !== 'discard') {
+      throw new Error('assistant/stream-start: invalid incompleteBlocks')
+    }
+    const history = preceding(event, context)
+    const boundary = history.findLast(item => item.type === 'step/start' || item.type === 'step/end')
+    if (boundary?.type !== 'step/start' || boundary.data.turn !== turn || boundary.data.step !== step) {
+      throw new Error('assistant/stream-start: no matching open step')
+    }
+    const previous = history.findLast(item => item.type === 'assistant/stream-start' || item.type === 'assistant/stream-merge' || item.type === 'step/start')
+    if (previous?.type === 'assistant/stream-start') throw new Error('assistant/stream-start: previous stream is still open')
+    return new Map()
+  },
+}
+
+const mergeProjection: SessionMessageProjection<'assistant/stream-merge'> = {
+  type: 'assistant/stream-merge',
+  project(event, context) {
+    const { turn, step } = position(event)
+    const { startSeq, attemptSeq } = event.data
+    if (!Number.isSafeInteger(startSeq) || !Number.isSafeInteger(attemptSeq)
+      || startSeq < context.baseSeq || startSeq >= attemptSeq || attemptSeq >= event.seq) {
+      throw new Error('assistant/stream-merge: invalid earlier stream references')
+    }
+    const start = context.events[startSeq - context.baseSeq]
+    const attempt = context.events[attemptSeq - context.baseSeq]
+    if (start?.type !== 'assistant/stream-start' || attempt?.type !== 'assistant/attempt'
+      || start.data.turn !== turn || start.data.step !== step
+      || attempt.data.turn !== turn || attempt.data.step !== step) {
+      throw new Error('assistant/stream-merge: mismatched stream references')
+    }
+    if (event.data.incompleteBlocks !== start.data.incompleteBlocks) {
+      throw new Error('assistant/stream-merge: mismatched incompleteBlocks')
+    }
+    const range = context.events.slice(startSeq - context.baseSeq + 1, event.seq - context.baseSeq)
+    if (range.some(item => item.type === 'step/start' || item.type === 'step/end'
+      || item.type === 'assistant/stream-start' || item.type === 'assistant/stream-merge'
+      || item.type === 'assistant/attempt' && item !== attempt)) {
+      throw new Error('assistant/stream-merge: crossed or reused stream boundary')
+    }
+    const checkpoints = range.filter(item => item.type === 'assistant/message')
+    if (!deepEqualJson(event.data.messageSeqs, checkpoints.map(item => item.seq))) {
+      throw new Error('assistant/stream-merge: incomplete or reordered message references')
+    }
+    const response = assembleStreamedAssistant(attempt.data.stream, start.data.incompleteBlocks)
+    const advertised = new Set<number>()
+    const nodes = new Set(context.nodes)
+    for (const checkpoint of checkpoints) {
+      if (checkpoint.seq >= attemptSeq || !nodes.has(checkpoint.seq) || context.messages.has(checkpoint.seq)
+        || checkpoint.surfaceOp !== 'append' || checkpoint.data.turn !== turn || checkpoint.data.step !== step
+        || checkpoint.data.usage !== undefined || checkpoint.data.interrupted !== undefined
+        || checkpoint.data.message.source.provider !== start.data.provider
+        || checkpoint.data.message.source.model !== start.data.model
+        || checkpoint.data.message.source.replayState !== undefined) {
+        throw new Error('assistant/stream-merge: invalid advertised message')
+      }
+      // A delta-only protocol can advertise its last blocks after a successful finish.
+      const authored = expandAssistantStream(checkpoint.data.stream)
+      const indices = new Set(authored.flatMap(({ chunk }) => 'index' in chunk ? [chunk.index] : []))
+      const selected = response.blocks.filter(block => indices.has(block.index))
+      if (selected.length !== indices.size || selected.length === 0
+        || !deepEqualJson(checkpoint.data.message.content, selected.map(item => item.block))
+        || !deepEqualJson(authored, selected.flatMap(item => expandAssistantStream(item.stream)))) {
+        throw new Error('assistant/stream-merge: advertised content is not an exact response segment')
+      }
+      for (const selectedBlock of selected) {
+        if (advertised.has(selectedBlock.index)) throw new Error('assistant/stream-merge: repeated advertised block')
+        advertised.add(selectedBlock.index)
+      }
+    }
+    if (response.blocks.some(item => !advertised.has(item.index))) {
+      throw new Error('assistant/stream-merge: response has unadvertised blocks')
+    }
+    const messages = new Map<SessionSeq, Message>()
+    for (const [index, checkpoint] of checkpoints.entries()) {
+      const message = checkpoint.data.message
+      messages.set(checkpoint.seq, deepFreeze({
+        ...message,
+        content: index === 0 ? response.blocks.map(item => item.block) : [],
+        source: {
+          ...message.source,
+          ...index === 0 && response.replayState !== undefined ? { replayState: response.replayState } : {},
+        },
+      }))
+    }
+    return messages
+  },
+}
+
+/** Built-in definitions shared by live, detached, restored, and browser folds. */
+export const assistantStreamProjections: readonly SessionMessageProjection[] = [startProjection, mergeProjection]
