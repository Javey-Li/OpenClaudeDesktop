+/**
+ * Workflow result conversion, console formatting and script failure text.
+ * @module @deepseek-ai/dsh-workflow-ptc/result
+ */
+import type { WorkflowBoundary, WorkflowErrorInfo } from './boundary.ts'
+
+/**
+ * Copy a completed root result and validate its JSON rendering without invoking source toJSON methods.
+ * @param value - Settled script value.
+ * @param boundary - Helpers belonging to the script VM.
+ * @returns Host data; undefined, nonfinite numbers and undefined properties survive until JSON transport.
+ */
+export function workflowResultValue(value: unknown, boundary: WorkflowBoundary): unknown {
+  if (typeof value === 'function') throw new Error('workflow result cannot be a function')
+  const clean = value !== null && typeof value === 'object' ? boundary.clone(value) : value
+  let copied: unknown
+  try { copied = structuredClone(clean) }
+  catch (error: unknown) {
+    if (clean === null || typeof clean !== 'object') {
+      if (typeof clean === 'symbol') throw new DOMException('The object can not be cloned.', 'DataCloneError')
+      throw error
+    }
+    copied = JSON.parse(stringifyResult(clean) ?? 'null')
+  }
+  stringifyResult(copied)
+  return copied
+}
+
+/** Standard JSON conversion after guest getters and methods have been removed. */
+function stringifyResult(value: unknown): string | undefined {
+  try { return JSON.stringify(value) }
+  catch (error: unknown) {
+    if (error instanceof TypeError) {
+      if (error.message.includes('BigInt')) throw new TypeError('JSON.stringify cannot serialize BigInt.')
+      if (error.message.includes('circular')) throw new TypeError('JSON.stringify cannot serialize cyclic structures.')
+    }
+    throw error
+  }
+}
+
+/**
+ * Format console arguments with guest-owned property reads and conversion hooks.
+ * @param values - Values passed to one console method.
+ * @param boundary - Helpers belonging to the script VM.
+ * @returns Space-separated text, including empty fields for undefined and symbols.
+ */
+export function workflowConsoleText(values: unknown[], boundary: WorkflowBoundary): string {
+  return values.map((value) => {
+    if (typeof value === 'string') return value
+    if (value === null || typeof value !== 'object' && typeof value !== 'function') {
+      try { return JSON.stringify(value) }
+      catch (error: unknown) { void error; return `[${typeof value}]` }
+    }
+    let fallback: string
+    try {
+      const json = stringifyResult(boundary.clone(value))
+      if (json !== undefined && json !== '{}') return json
+      fallback = json ?? `[${typeof value}]`
+    } catch (error: unknown) {
+      const message = boundary.errorInfo(error).message
+      return message.includes('exceeds the maximum') ? `[${typeof value}: array exceeds the 4096-element logging cap]` : `[${typeof value}]`
+    }
+    const text = boundary.toString(value)
+    return text === '[object Object]' || text === '<unprintable>' ? fallback : text
+  }).join(' ')
+}
+
+/** Preserve whole UTF-16 pairs at a truncated prefix or suffix. */
+function edge(text: string, size: number, tail = false): string {
+  let part = tail ? text.slice(-size) : text.slice(0, size)
+  const unit = part.charCodeAt(tail ? 0 : part.length - 1)
+  if (tail ? unit >= 0xdc00 && unit <= 0xdfff : unit >= 0xd800 && unit <= 0xdbff) part = tail ? part.slice(1) : part.slice(0, -1)
+  return part.toWellFormed()
+}
+
+/**
+ * Collapse long diagnostics while retaining counts from prior truncation markers.
+ * @param text - Diagnostic field or rendered failure.
+ * @returns Text retaining both ends and complete UTF-16 pairs.
+ */
+export function truncateWorkflowDiagnostic(text: string): string {
+  if (text.length <= 11024) return text
+  const first = edge(text, 5000), last = edge(text, 5000, true)
+  let removed = text.length - first.length - last.length
+  for (const match of text.slice(5000, -5000).matchAll(/\n\n\.\.\. \[(\d+) characters truncated\] \.\.\.\n\n/g)) {
+    const digits = match[1] ?? ''
+    const count = digits.length <= 15 ? Number(digits) : NaN
+    if (Number.isSafeInteger(count) && count >= match[0].length) removed += count - match[0].length
+  }
+  return `${first}\n\n... [${removed} characters truncated] ...\n\n${last}`
+}
+
+/**
+ * Render a script failure's string fields, retaining at most five bounded stack frames.
+ * @param info - Fields read inside the script VM without calling arbitrary toString methods.
+ * @returns A diagnostic whose header and total text are each capped with retained ends.
+ */
+export function workflowErrorText(info: WorkflowErrorInfo): string {
+  const header = info.message ? `${info.name}: ${info.message}` : info.name
+  const frames = info.stack.split('\n').filter(line => /^\s*at /.test(line)).slice(0, 5)
+    .map(line => line.length > 500 ? `${edge(line, 500)}…` : line)
+  return truncateWorkflowDiagnostic([truncateWorkflowDiagnostic(header), ...frames].join('\n'))
+}
