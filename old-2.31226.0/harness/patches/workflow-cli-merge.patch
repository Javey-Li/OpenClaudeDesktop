@@ -0,0 +1,35 @@
+import { readFile } from 'node:fs/promises'
+import { expect, it } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+
+interface Schema { type: 'object'; properties: { value: { enum: string[] } }; required: string[] }
+interface Fixture { name: string; script: string; child?: string; value: unknown; schemas: Schema[] }
+const fixtures = JSON.parse(await readFile(new URL('./fixtures/schema-memo-native.json', import.meta.url), 'utf8')) as Fixture[]
+
+it.each(fixtures)('retains native schema reference decisions for $name through PTC', async (fixture) => {
+  const t = await setupMerge({ structuredResult: (request) => {
+    const schema = request.outputSchema as Schema
+    const result = { value: schema.properties.value.enum[0] }
+    if (schema.required.some(key => !Object.hasOwn(result, key))) throw new Error('Fixture provider rejected its invalid structured reply')
+    return result
+  } })
+  const run = t.start(fixture.script, { workflows: { child: { meta: { name: 'child', description: 'Schema reference fixture' }, script: fixture.child ?? '' } } })
+  try {
+    expect(await run.result).toMatchObject({ stopReason: 'completed', value: fixture.value })
+    // The native invalid-schema case makes provider retries. The fixture checks
+    // the first schema supplied to each call; provider retry policy is separate.
+    const expected = fixture.name === 'invalid-then-repaired' ? [fixture.schemas[0], fixture.schemas[0]] : fixture.schemas
+    expect(t.requests.map(request => request.outputSchema)).toEqual(expected)
+  } finally { await run.dispose() }
+})
+
+it('uses a fresh schema memo for each root execution', async () => {
+  const t = await setupMerge({ structured: { value: 'fixture' } })
+  const script = 'const schema={type:"object",properties:{value:{type:"string",enum:[args]}}};return await agent("schema",{schema})'
+  for (const args of ['first', 'second']) {
+    const run = t.start(script, { args })
+    try { expect(await run.result).toMatchObject({ stopReason: 'completed' }) }
+    finally { await run.dispose() }
+  }
+  expect(t.requests.map(request => (request.outputSchema as Schema).properties.value.enum)).toEqual([['first'], ['second']])
+})
