+import { describe, expect, it, vi } from 'vitest'
+import { setupMerge } from './merge-setup.ts'
+import { fakeParent } from './setup.ts'
+
+describe('holder-owned workflow member controls', () => {
+  it('shares parent-turn output with sibling workflows and resets at the next turn', { timeout: 20_000 }, async () => {
+    const t = await setupMerge()
+    t.parent.session.append('turn/start', { turn: 1 })
+    t.parent.session.append('step/start', { turn: 1, step: 1 })
+    t.parent.session.append('assistant/attempt', { turn: 1, step: 1, stream: [{ type: 'chunk', time: 0, chunk: { type: 'usage', usage: { inputTokens: 0, outputTokens: 8 } } }] })
+    const first = t.start('await agent("first"); return budget.spent()', { budgetTotal: 10 })
+    expect(await first.result).toMatchObject({ stopReason: 'completed', value: 14 })
+    await first.dispose()
+    const sibling = t.start('return await parallel([()=>agent("over budget")])', { budgetTotal: 10 })
+    const siblingResult = await sibling.result
+    expect(siblingResult).toMatchObject({ stopReason: 'error', value: null, agentsStarted: 0 })
+    expect(siblingResult.error).toContain('output token budget exhausted')
+    await sibling.dispose()
+    t.parent.session.append('turn/start', { turn: 2 })
+    const next = t.start('await agent("new turn"); return budget.spent()', { budgetTotal: 10 })
+    expect(await next.result).toMatchObject({ stopReason: 'completed', value: 6 })
+    expect(t.requests).toHaveLength(2)
+    await next.dispose()
+  })
+
+  it('retries a member after disposing its previous child, preserving one invocation and cumulative usage', async () => {
+    const t = await setupMerge({ holdCalls: [1] })
+    const starts: number[] = [], ends: number[] = []
+    t.ctx.on('workflow/agent-start', (_run, info) => starts.push(info.seq))
+    t.ctx.on('workflow/agent-end', (_run, info) => ends.push(info.seq))
+    const run = t.start('const value = await agent("retry me"); return {value, spent: budget.spent()}')
+    try {
+      await vi.waitFor(() => { expect(starts).toEqual([1]) }, { timeout: 10_000 })
+      expect(t.ctx.workflowEngine.controlMember(fakeParent(t.ctx), run.id, 1, 'retry')).toBe(false)
+      expect(t.ctx.workflowEngine.controlMember(t.parent, run.id, 1, 'retry')).toBe(true)
+      expect(await run.result).toMatchObject({ stopReason: 'completed', agentsStarted: 1, value: { value: 'reply-2', spent: 12 } })
+      expect(t.requests[0]!.signal.aborted).toBe(true)
+      expect(new Set(t.disposed)).toEqual(new Set([1, 2]))
+      expect(starts).toEqual([1])
+      expect(ends).toEqual([1])
+      expect(run.controlMember?.(1, 'skip')).toBe(false)
+    } finally { await run.dispose() }
+  })
+
+  it('skips only the selected member while its sibling completes', async () => {
+    const t = await setupMerge({ holdCalls: [1] })
+    const run = t.start('return await parallel([() => agent("skip"), () => agent("keep")])')
+    try {
+      await vi.waitFor(() => { expect(t.requests).toHaveLength(2) }, { timeout: 10_000 })
+      expect(run.controlMember?.(1, 'skip')).toBe(true)
+      expect(await run.result).toMatchObject({ stopReason: 'completed', value: [null, 'reply-2'] })
+    } finally { await run.dispose() }
+  })
+
+  it('loads nested scripts through the host and owns timers and console narration', async () => {
+    const t = await setupMerge()
+    const selected: unknown[] = [], phases: string[] = []
+    t.ctx.on('workflow/phase', (_run, title) => phases.push(title))
+    const run = t.start('return await workflow({scriptPath:"child.js"}, ["value"])', {
+      resolveWorkflow: async (source) => {
+        selected.push(source)
+        return { meta: { name: 'child', description: 'nested source' }, script: 'phase("inner"); console.log("working"); await new Promise(r=>setTimeout(r,5)); return await agent(args[0])' }
+      },
+    })
+    expect(await run.result).toMatchObject({ stopReason: 'completed', value: 'reply-1' })
+    expect(selected).toEqual([{ scriptPath: 'child.js' }])
+    expect(phases).toEqual(['▸ child'])
+    await run.dispose()
+  })
+
+  it('reuses completed siblings beyond an interrupted call', async () => {
+    const t = await setupMerge({ holdCalls: [2] })
+    const script = 'return await parallel([() => agent("one"), () => agent("two"), () => agent("three")])'
+    const first = t.start(script)
+    const completed: number[] = []
+    t.ctx.on('workflow/agent-end', (info, agent) => { if (info.id === first.id && agent.outcome === 'completed') completed.push(agent.seq) })
+    await vi.waitFor(() => { expect(completed.sort()).toEqual([1, 3]) }, { timeout: 10_000 })
+    first.cancel('interrupted')
+    await first.dispose()
+    const resumed = t.start(script, { resumeFromRunId: first.id })
+    expect(await resumed.result).toMatchObject({ stopReason: 'completed', value: ['reply-1', 'reply-4', 'reply-3'] })
+    expect(t.requests).toHaveLength(4)
+    await resumed.dispose()
+  })
+})
