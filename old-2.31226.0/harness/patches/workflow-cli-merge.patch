+/** Repair only recognized HTTP rejections, mapping wire positions by unique native identity. */
+import { expect, it } from 'vitest'
+import { createAssistantMessage, createToolResultMessage, LlmError, MessageId, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, LlmFailure } from '@deepseek-ai/dsh-llm'
