@@ -0,0 +1,66 @@
+/** Claude Code's model inputs, adapted to the Harness tool's execution interface. */
+import { ToolArgsError, valueSchemaSpecToJsonSchema } from '@deepseek-ai/dsh-tools'
+import type { ToolDefinition, InferValue } from '@deepseek-ai/dsh-tools'
+import { CLAUDE_LAUNCH_SCHEMA, renderClaudeLaunch } from './claude-output.ts'
+
+const properties = {
+  script: { type: 'string', maxLength: 524288, description: 'Self-contained JavaScript. Begin with a literal export const meta = { name, description, phases }, then the workflow body.' },
+  name: { type: 'string', description: 'Registered workflow name. Takes precedence over inline script; scriptPath takes precedence over both.' },
+  description: { type: 'string', description: 'Ignored. Set the description in the script metadata.' },
+  title: { type: 'string', description: 'Ignored. Set the title in the script metadata.' },
+  args: { description: 'Input exposed verbatim as args. Pass arrays and objects as JSON values, not JSON-encoded strings.' },
+  scriptPath: { type: 'string', description: 'Read a complete saved workflow script. Relative paths use the session directory. Takes precedence over name and script.' },
+  resumeFromRunId: { type: 'string', pattern: '^wf_[a-z0-9-]{6,}$', description: 'Resume a stopped run in this session. Unchanged completed agent calls use cached results. Also provide script, name or scriptPath.' },
+}
+
+/**
+ * Enforce the published CLI's seven input fields and always start an owned job.
+ * @param tool - Harness tool with its lifecycle and output projections.
+ * @returns Tool exposing the CLI input schema while retaining Harness job ownership.
+ */
+export function withClaudeInputs(tool: ToolDefinition): ToolDefinition {
+  return {
+    ...tool,
+    aliases: tool.name === 'RunWorkflow' ? [] : ['RunWorkflow'],
+    description: 'Starts a background workflow and returns a task ID immediately. Its completion notification includes the return value. Use TaskStop({task_id}) to cancel.\n\n' + tool.description,
+    output: {
+      schema: valueSchemaSpecToJsonSchema(CLAUDE_LAUNCH_SCHEMA),
+      render: (_args, value) => renderClaudeLaunch(value as InferValue<typeof CLAUDE_LAUNCH_SCHEMA>),
+    },
+    parameters: { type: 'object', properties, additionalProperties: false },
+    async execute(input, exec) {
+      if (!input || typeof input !== 'object' || Array.isArray(input)) throw new ToolArgsError(['expected an object'])
+      for (const [key, value] of Object.entries(input)) {
+        if (!Object.hasOwn(properties, key)) throw new ToolArgsError([`unexpected parameter ${key}`])
+        if (key !== 'args' && typeof value !== 'string') throw new ToolArgsError([`${key} must be a string`])
+      }
+      // Field types were checked at the model JSON boundary above.
+      const fields = input as { script?: string; name?: string; scriptPath?: string; resumeFromRunId?: string }
+      if (fields.script !== undefined) {
+        if (fields.script.length > 524288) throw new ToolArgsError(['script exceeds 524288 characters'])
+        if (/[\x00-\x08\x0b-\x1f\x7f-\x9f]/u.test(fields.script)) throw new ToolArgsError(['script contains control characters'])
+      }
+      for (const key of ['name', 'scriptPath'] as const) {
+        const value = fields[key]
+        if (value !== undefined && /[\p{Cc}\p{Cf}\p{Cs}\p{Default_Ignorable_Code_Point}\u2028\u2029]/u.test(value)) throw new ToolArgsError([`${key} contains control or invisible format characters`])
+      }
+      if (fields.resumeFromRunId !== undefined && !/^wf_[a-z0-9-]{6,}$/u.test(fields.resumeFromRunId)) throw new ToolArgsError(['resumeFromRunId must match ^wf_[a-z0-9-]{6,}$'])
+      if (!fields.script && !fields.name && !fields.scriptPath) throw new ToolArgsError(['must provide script, name or scriptPath'])
+      // The owned consumer always returns its background branch with resolved metadata in this mode.
+      const launched = await tool.execute({ ...input, run_in_background: true }, exec) as {
+        jobId: string
+        name: string
+        runId: string
+        summary: string
+        transcriptDir?: string
+        scriptPath?: string
+      }
+      return {
+        status: 'async_launched', taskType: 'local_workflow',
+        taskId: launched.jobId, workflowName: launched.name, runId: launched.runId, summary: launched.summary,
+        ...launched.transcriptDir === undefined ? {} : { transcriptDir: launched.transcriptDir },
+        ...launched.scriptPath === undefined ? {} : { scriptPath: launched.scriptPath },
+      }
+    },
+  }
+}
diff --git a/packages/workflow/tool-workflow/src/claude-metadata.ts b/packages/workflow/tool-workflow/src/claude-metadata.ts
new file mode 100644
index 0000000000..471383f390
--- /dev/null
+++ b/packages/workflow/tool-workflow/src/claude-metadata.ts
@@ -0,0 +1,133 @@
+/** Claude input-mode metadata: decode static syntax as data and normalize optional annotations. */
+import { parse } from 'acorn'
+import type { AnyNode, ObjectExpression } from 'acorn'
+import type { WorkflowMeta, WorkflowPhase } from '@deepseek-ai/dsh-workflow'
+import { metadataEnd } from './claude-script.ts'
+
+const reserved = new Set(['__proto__', 'constructor', 'prototype'])
+const trivia = /(?:\s+|\/\/[^\r\n\u2028\u2029]*(?:[\r\n\u2028\u2029]|$)|\/\*[\s\S]*?\*\/)*/y
+const header = new RegExp(`^${trivia.source}export\\s+const\\s+meta\\s*=\\s*(?=\\{)`)
+
+function literal(node: AnyNode): unknown {
+  switch (node.type) {
+    case 'Literal': return node.value
+    case 'TemplateLiteral':
+      if (node.expressions.length) throw new Error('template interpolation not allowed in meta')
+      return node.quasis.map(part => part.value.cooked ?? '').join('')
+    case 'UnaryExpression':
+      if (node.operator === '-' && node.argument.type === 'Literal' && typeof node.argument.value === 'number') return -node.argument.value
+      throw new Error('only negative-number unary allowed in meta')
+    case 'ArrayExpression': return node.elements.map((element) => {
+      if (element === null) throw new Error('sparse arrays not allowed')
+      if (element.type === 'SpreadElement') throw new Error('spread not allowed in meta')
+      return literal(element)
+    })
+    case 'ObjectExpression': {
+      const value = Object.create(null) as Record<string, unknown>
+      for (const property of node.properties) {
+        if (property.type !== 'Property') throw new Error('only plain properties allowed in meta')
+        if (property.computed) throw new Error('computed keys not allowed in meta')
+        if (property.method || property.kind !== 'init') throw new Error('methods/accessors not allowed in meta')
+        const key = property.key.type === 'Identifier' ? property.key.name : property.key.type === 'Literal' ? String(property.key.value) : undefined
+        if (key === undefined) throw new Error(`unsupported key type in meta: ${property.key.type}`)
+        if (reserved.has(key)) throw new Error(`reserved key name not allowed in meta: ${key}`)
+        value[key] = literal(property.value)
+      }
+      return value
+    }
+    default: throw new Error(`non-literal node type in meta: ${node.type}`)
+  }
+}
+
+function normalize(meta: Record<string, unknown>): WorkflowMeta {
+  if (typeof meta.name !== 'string' || !meta.name.length) throw new Error('meta.name must be a non-empty string')
+  if (typeof meta.description !== 'string' || !meta.description.length) throw new Error('meta.description must be a non-empty string')
+  const phases: WorkflowPhase[] = []
+  const entries: unknown[] = Array.isArray(meta.phases) ? meta.phases : []
+  for (const phase of entries) {
+    if (!phase || typeof phase !== 'object' || !('title' in phase) || typeof phase.title !== 'string') continue
+    phases.push({ title: phase.title,
+      ...'detail' in phase && typeof phase.detail === 'string' ? { detail: phase.detail } : {},
+      ...'model' in phase && typeof phase.model === 'string' ? { model: phase.model } : {},
+    })
+  }
+  return { name: meta.name, description: meta.description,
+    ...typeof meta.title === 'string' && meta.title.length ? { title: meta.title } : {},
+    ...typeof meta.whenToUse === 'string' ? { whenToUse: meta.whenToUse } : {},
+    ...phases.length ? { phases } : {},
+  }
+}
+
+/** Syntax handled by native header-only discovery; other literals require the complete script parser. */
+function headerLiteral(node: AnyNode, source: string): boolean {
+  switch (node.type) {
+    case 'Literal': return node.value === null || typeof node.value === 'boolean' || typeof node.value === 'string'
+      || typeof node.value === 'number' && /^(?:(?:0|[1-9][0-9]*)(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$/u.test(source.slice(node.start, node.end))
+    case 'TemplateLiteral': return !node.expressions.length
+    case 'UnaryExpression': return node.operator === '-' && node.argument.type === 'Literal' && typeof node.argument.value === 'number' && headerLiteral(node.argument, source)
+    case 'ArrayExpression': return node.elements.every(element => element !== null && headerLiteral(element, source))
+    case 'ObjectExpression': return node.properties.every(property => property.type === 'Property' && !property.computed && !property.method && property.kind === 'init'
+      && (property.key.type === 'Identifier' && /^[A-Za-z_$][\w$]*$/u.test(source.slice(property.key.start, property.key.end))
+        || property.key.type === 'Literal' && typeof property.key.value === 'string') && headerLiteral(property.value, source))
+    default: return false
+  }
+}
+
+function declaration(source: string, preserveParens = false): { object: ObjectExpression; end: number } {
+  let program: ReturnType<typeof parse>
+  try {
+    program = parse(source, { ecmaVersion: 'latest', sourceType: 'module', allowAwaitOutsideFunction: true, allowReturnOutsideFunction: true, preserveParens })
+  } catch (error) {
+    const hint = 'Workflow scripts must be plain JavaScript — common causes are TypeScript syntax (type annotations, interfaces, generics) and broken string quoting or escaping.'
+    const message = error instanceof Error ? error.message : String(error)
+    const loc: unknown = error && typeof error === 'object' && 'loc' in error ? error.loc : undefined
+    if (loc && typeof loc === 'object' && 'line' in loc && typeof loc.line === 'number' && 'column' in loc && typeof loc.column === 'number') {
+      const line = source.split('\n')[loc.line - 1]
+      if (line !== undefined) {
+        const column = Math.max(0, Math.min(loc.column, line.length))
+        const start = Math.max(0, Math.min(column - 40, line.length - 80))
+        throw new SyntaxError(`Script parse error: ${message}\n\n${line.slice(start, start + 80)}\n${' '.repeat(column - start)}^\n\n${hint}`, { cause: error })
+      }
+    }
+    throw new SyntaxError(`Script parse error: ${message}. ${hint}`, { cause: error })
+  }
+  const first = program.body[0]
+  const variable = first?.type === 'ExportNamedDeclaration' ? first.declaration : undefined
+  const item = variable?.type === 'VariableDeclaration' && variable.kind === 'const' && variable.declarations.length === 1 ? variable.declarations[0] : undefined
+  if (!first || !item || item.id.type !== 'Identifier' || item.id.name !== 'meta' || item.init?.type !== 'ObjectExpression') {
+    throw new Error('`export const meta = { name, description, phases }` must be the FIRST statement in the script')
+  }
+  return { object: item.init, end: first.end }
+}
+
+function parsed(source: string, object: ObjectExpression, end: number): { script: string; meta: WorkflowMeta } {
+  let value: Record<string, unknown>
+  try { value = literal(object) as Record<string, unknown> }
+  catch (error) { throw new Error(`meta must be a pure literal: ${error instanceof Error ? error.message : String(error)}`, { cause: error }) }
+  return { meta: normalize(value), script: source.slice(end).replace(/^[;\s]*\n/u, '').trimStart() }
+}
+
+/** Decode a CLI metadata header without evaluating expressions or script code.
+ * @param source - Complete script with its required first metadata export.
+ * @param validateBody - False allows header-only discovery for the native static-literal subset.
+ * @returns Normalized annotations and the body following the declaration.
+ */
+export function parseClaudeWorkflowScript(source: string, validateBody = true): { script: string; meta: WorkflowMeta } {
+  if (source.length > 524288) throw new Error('Script exceeds 524288 bytes')
+  if (!validateBody && header.test(source)) {
+    try {
+      const end = metadataEnd(source)
+      const { object } = declaration(source.slice(0, end), true)
+      trivia.lastIndex = end
+      const next = trivia.exec(source) ? trivia.lastIndex : end
+      const word = /^[A-Za-z_$][\w$]*(?![\w$\\]|[^\x00-\x7f])/u.exec(source.slice(next))?.[0]
+      const terminated = source[next] === ';' || next === source.length || /[\r\n\u2028\u2029]/u.test(source.slice(end, next)) && word !== undefined && word !== 'in' && word !== 'instanceof'
+      if (terminated && headerLiteral(object, source)) return parsed(source, object, source[next] === ';' ? next + 1 : end)
+    } catch (error) {
+      // The complete parser owns diagnostics when header-only discovery cannot accept a definition.
+      void error
+    }
+  }
+  const { object, end } = declaration(source)
+  return parsed(source, object, end)
+}
diff --git a/packages/workflow/tool-workflow/src/claude-output.ts b/packages/workflow/tool-workflow/src/claude-output.ts
