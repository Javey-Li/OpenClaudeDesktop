+/** Scoped tool narrowing applied before a workflow child can execute tools. */
+import { harnessToolName } from '@deepseek-ai/dsh-claude-code-config'
+import { scopeOf } from '@deepseek-ai/dsh-scope'
+import { MCP_RESOURCE_TOOL_NAMES, type McpResourceToolName } from '@deepseek-ai/dsh-mcp-resources'
+import type { Context } from '@deepseek-ai/cordis'
+import type { ToolRestriction } from '@deepseek-ai/dsh-tools'
+import type { AgentTypeDefinition } from './agent-type.ts'
+import type { BashClamp } from './bash-clamp.ts'
+import { parseToolSelector } from './tool-selector.ts'
+
+/** Match a Claude tool alias, exact name, or MCP server/prefix selector, ignoring argument text for tool admission.
+ * @param rule - One selector from an agent definition or caller restriction.
+ * @param name - Public Harness tool name.
+ * @returns Whether the selector names this tool.
+ */
+export function matchesAgentTool(rule: string, name: string): boolean {
+  const tool = parseToolSelector(rule).toolName
+  return rule === '*' || harnessToolName(tool) === harnessToolName(name) || (tool.startsWith('mcp__') && (tool.endsWith('*') ? name.startsWith(tool.slice(0, -1)) : !tool.slice(5).includes('__') && name.startsWith(`${tool}__`)))
+}
+
+/** Admit a declared MCP tool under caller restrictions and definition denials.
+ * @param name - Public MCP tool name.
+ * @param filter - Caller allow/deny selectors, independent of definition tools.
+ * @param definition - Agent definition whose disallowedTools still apply.
+ * @returns Whether the MCP client may register this tool.
+ */
+export function acceptsAgentMcpTool(name: string, filter?: ToolRestriction, definition?: AgentTypeDefinition): boolean {
+  const match = (rule: string): boolean => matchesAgentTool(rule, name)
+  return !filter?.exclude?.includes(name) && !filter?.deny?.some(match)
+    && (!filter?.allow || filter.allow.some(match)) && !definition?.disallowedTools?.some(match)
+}
+
+/** Resolve shared resource operations under ordinary definition and caller selectors.
+ * @param filter - Caller allow/deny selectors.
+ * @param definition - Agent tools and disallowedTools declarations.
+ * @returns Canonical resource names allowed before any child-owned server is registered.
+ */
+export function agentMcpResourceTools(filter?: ToolRestriction, definition?: AgentTypeDefinition): McpResourceToolName[] {
+  return MCP_RESOURCE_TOOL_NAMES.filter(name => acceptsAgentMcpTool(name, filter, definition)
+    && (!definition?.tools || definition.tools.some(rule => matchesAgentTool(rule, name))))
+}
+
+// An Agent subtype allowlist needs delegation-time enforcement. Until it exists,
+// preserve the unavailable-selector behavior instead of granting an unrestricted Agent tool.
+function unsupportedAgentSelection(rule: string): boolean {
+  const selector = parseToolSelector(rule)
+  return harnessToolName(selector.toolName) === 'subagent' && selector.ruleContent !== undefined
+}
+
+function allowsAgentTool(rule: string, name: string): boolean {
+  return !unsupportedAgentSelection(rule) && matchesAgentTool(rule, name)
+}
+
+/** Install child-scoped name restrictions and a final command guard.
+ * @param ctx - Unpublished child's tool registration scope.
+ * @param filter - Allowed and denied global tool names, including Claude aliases.
+ * @param clamp - Prepared Bash command guard, or no additional Bash restriction.
+ * @param readOnly - Whether the agent definition limits the child to reading.
+ * @param definition - Optional Claude agent selectors, resolved independently before intersection.
+ * @param mcpServers - Declared namespaces added after ordinary definition tool selection.
+ */
+export function installWorkflowToolPolicy(
+  ctx: Context, filter: ToolRestriction | undefined, clamp: BashClamp | undefined,
+  readOnly: boolean, definition?: AgentTypeDefinition, mcpServers: readonly string[] = [],
+): void {
+  const available = new Set(ctx.root.tools.schemas().map(tool => tool.name))
+  const scoped = new Set(ctx.tools.schemas(scopeOf(ctx)).map(tool => tool.name).filter(name => !available.has(name)))
+  const matches = matchesAgentTool
+  const declaredMcp = (name: string): boolean => mcpServers.some(server => name.startsWith(`mcp__${server}__`))
+  const translate = (values: readonly string[], strict = true, selection = true): string[] => values.flatMap((value) => {
+    if (selection && unsupportedAgentSelection(value)) {
+      if (strict) throw new Error(`Agent subtype selector '${value}' is not supported`)
+      ctx.logger.warn(`Agent subtype selector '${value}' is unavailable`)
+      return []
+    }
+    const toolName = parseToolSelector(value).toolName
+    if (value === '*') return [...available]
+    if (toolName.startsWith('mcp__')) return [...available].filter(name => matches(value, name))
+    const name = [...available].find(candidate => matches(value, candidate)) ?? harnessToolName(toolName)
+    if (!available.has(name)) {
+      if (mcpServers.length > 0 && MCP_RESOURCE_TOOL_NAMES.some(tool => tool === name)) return []
+      if (strict) throw new Error(`unknown global tool "${value}"`)
+      ctx.logger.warn(`Agent tool selector '${value}' is unavailable`)
+      return []
+    }
+    return [name]
+  })
+  const selected = definition?.tools === undefined ? undefined
+    : [...translate(definition.tools, false), ...[...available].filter(declaredMcp)]
+  const requested = filter?.allow && translate(filter.allow)
+  const allow = selected === undefined ? requested : requested === undefined ? selected : selected.filter(name => requested.includes(name))
+  const deny = [
+    ...filter?.deny ? translate(filter.deny, true, false) : [],
+    ...definition?.disallowedTools ? translate(definition.disallowedTools, false, false) : [],
+  ]
+  const exclude = filter?.exclude
+  deny.push(...[...available].filter(name => exclude?.includes(name)))
+  if (selected !== undefined && available.size > 0 && !allow?.some(name => !deny.includes(name)) && mcpServers.length === 0) throw new Error('agent tools list resolved to zero available tools')
+  if (clamp) {
+    if (!available.has('bash') || deny.includes('bash') || (allow && !allow.includes('bash'))) throw new Error('bashCommandClamp requires an available Bash tool')
+    deny.push(...[...available].filter(name => name.startsWith('mcp__') || MCP_RESOURCE_TOOL_NAMES.some(tool => tool === name) || /^(subagent|workflow|terminal_|pwsh|exec_)/.test(harnessToolName(name))))
+  }
+  if (readOnly) deny.push(...[...available].filter(name =>
+    /^(write|edit|bash|pwsh|terminal_|subagent|workflow|mcp__)/.test(harnessToolName(name))))
+  if (allow !== undefined || deny.length || exclude !== undefined) ctx.tools.restrict({
+    ...allow === undefined ? {} : { allow },
+    ...deny.length ? { deny: [...new Set(deny)] } : {},
+    ...exclude === undefined ? {} : { exclude },
+  })
+  ctx.tools.guard((exec) => {
+    // A scoped guard also covers tools registered after this child was created.
+    const match = (rule: string): boolean => matches(rule, exec.name)
+    if (declaredMcp(exec.name) && !acceptsAgentMcpTool(exec.name, filter, definition)) return 'This tool is outside the workflow agent’s allowed tools.'
+    if (!available.has(exec.name) && !scoped.has(exec.name) && (filter?.deny?.some(match) || (filter?.allow && !filter.allow.some(rule => allowsAgentTool(rule, exec.name))) || definition?.disallowedTools?.some(match) || (!declaredMcp(exec.name) && definition?.tools && !definition.tools.some(rule => allowsAgentTool(rule, exec.name))))) return 'This tool is outside the workflow agent’s allowed tools.'
+    if (clamp && (exec.name.startsWith('mcp__') || MCP_RESOURCE_TOOL_NAMES.some(tool => tool === exec.name) || /^(subagent|workflow|terminal_|pwsh|exec_)/.test(harnessToolName(exec.name)))) return 'This tool is unavailable while a Bash clamp is active.'
+    if (readOnly && /^(write|edit|bash|pwsh|terminal_|subagent|workflow|mcp__)/.test(harnessToolName(exec.name))) return 'This agent definition permits reading only.'
+    if (readOnly && exec.name === 'str_replace_editor') {
+      const args = exec.arguments
+      if (!args || typeof args !== 'object' || !('command' in args) || args.command !== 'view') return 'This agent definition permits reading only.'
+    }
+    if (!clamp || exec.name !== 'bash') return
+    const args = exec.arguments
+    const command = args && typeof args === 'object' && 'command' in args && typeof args.command === 'string' ? args.command : ''
+    return clamp(command)
+  })
+}
