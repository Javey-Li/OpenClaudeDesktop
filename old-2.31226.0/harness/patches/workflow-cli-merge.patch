diff --git a/snapshots/session/workflow-text-recovery/cordis.snapshot.yml b/snapshots/session/workflow-text-recovery/cordis.snapshot.yml
new file mode 100644
index 0000000000..7125462c59
--- /dev/null
+++ b/snapshots/session/workflow-text-recovery/cordis.snapshot.yml
@@ -0,0 +1,40 @@
+# Replay the authored model turns through the shipped OS sandbox.
+- id: llm-deepseek
+  name: '@deepseek-ai/dsh-llm-deepseek-api-key'
+  disabled: true
+
+- id: plugin-package-inventory-deepseek
+  disabled: true
+
+- id: session-title-llm
+  disabled: true
+
+- id: session-persistence-jsonl
+  name: '@deepseek-ai/dsh-session-persistence-jsonl'
+  config:
+    root: !!js dshHomePath('sessions')
+    compression: none
+
+- insert:
+    - id: llm-replay
+      name: '@deepseek-ai/dsh-llm-replay'
+      config:
+        providers:
+          - id: deepseek-official
+            name: DeepSeek
+            retryPolicy:
+              mode: normal
+              maxRetries: 3
+              retryableCodes: [STREAM_CLOSED]
+              backoff:
+                initialDelayMs: 1
+                maxDelayMs: 1
+                jitterRatio: 0
+            models:
+              - id: deepseek-v4-flash
+              - id: deepseek-v4-pro
+
+# Tool execution timing is covered separately; retain deterministic progress endpoints.
+- id: workflow-ptc
+  config:
+    progressIntervalMs: 60000
diff --git a/snapshots/session/workflow-text-recovery/cordis.yml b/snapshots/session/workflow-text-recovery/cordis.yml
new file mode 100644
index 0000000000..5ac4fd6358
--- /dev/null
+++ b/snapshots/session/workflow-text-recovery/cordis.yml
@@ -0,0 +1,5 @@
+# Uses the shipped headless workflow and Bash providers.
+# Pin throttling so this protocol snapshot keeps initial and terminal progress only.
+- id: workflow-ptc
+  config:
+    progressIntervalMs: 60000
