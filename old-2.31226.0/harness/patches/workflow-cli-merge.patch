@@ -0,0 +1,45 @@
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import Subagents from '@deepseek-ai/dsh-subagent'
+import type { SubagentCapabilities, SubagentStartRequest } from '@deepseek-ai/dsh-subagent'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { WorkflowStartRequest } from '@deepseek-ai/dsh-workflow'
+import Engine from '../src/index.ts'
+import { fakeParent, mountPtcRuntime } from './setup.ts'
+
+export async function setupMerge(options: {
+  tokens?: number
+  structured?: unknown
+  structuredResult?: (request: SubagentStartRequest) => unknown
+  capabilities?: Partial<SubagentCapabilities>
+  hold?: boolean
+  concurrency?: number
+  cap?: number
+  startFailedCalls?: number[]
+  failedCalls?: number[]
+  holdCalls?: number[]
+  mirror?: boolean
+} = {}) {
+  const ctx = new Context()
+  const { root } = await mountPtcRuntime(ctx)
+  await ctx.plugin(Subagents)
+  const requests: SubagentStartRequest[] = []
+  const disposed: number[] = []
+  ctx.subagents.registerProvider({
+    name: 'merge-test', inheritsParentContext: false,
+    capabilities: { agentOptions: true, outputSchema: true, depthLimit: false, persona: false, toolFilter: true, ...options.capabilities },
+    async start(request) {
+      const id = requests.push(request)
+      if (options.startFailedCalls?.includes(id)) throw new Error('provider startup rejected')
+      const structured = options.structuredResult ? options.structuredResult(request) : options.structured
+      const completed = { ...structured === undefined ? {} : { structured }, output: [{ type: 'text' as const, text: `reply-${id}` }], stopReason: options.failedCalls?.includes(id) ? 'error' as const : 'completed' as const, outputTokens: options.tokens ?? 6 }
+      const pending = Promise.withResolvers<typeof completed>()
+      if (!options.hold && !options.holdCalls?.includes(id)) pending.resolve(completed)
+      return { id: SessionId(`merge-child-${id}`), localAgent: undefined, result: pending.promise, dispose: async () => { disposed.push(id); pending.resolve(completed) } }
+    },
+  })
+  await ctx.plugin(Engine, { provider: 'merge-test', warmupWaitMs: 0, journalDirectory: join(root, 'workflows'), sessionMirror: options.mirror ?? false, maxConcurrentAgents: options.concurrency ?? 2, maxTotalAgents: options.cap ?? 8 })
+  const parent = fakeParent(ctx)
+  const start = (script: string, extra: Partial<WorkflowStartRequest> = {}) => ctx.workflowEngine.start({ script, meta: { name: 'merge-test', description: 'workflow integration test' }, parent, ...extra })
+  return { ctx, root, parent, requests, disposed, start }
+}
