@@ -0,0 +1,65 @@
+import { mkdtemp, readFile, writeFile, mkdir, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { afterEach, describe, expect, it } from 'vitest'
+import { Journal } from '../src/journal.ts'
+import { WorkflowOutput } from '../src/output.ts'
+import { digest } from '../src/call-key.ts'
+
+const roots: string[] = []
+afterEach(async () => { await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true }))) })
+const entry = { seq: 1, promptHash: 'prompt', optsHash: 'options', childId: 'child', outcome: 'completed' as const, value: 'cached' }
+const meta = { name: 'script', description: 'Journal fixture' }
+async function root() { const directory = await mkdtemp(join(tmpdir(), 'workflow-attempt-')); roots.push(directory); return directory }
+
+describe('workflow journal attempts', () => {
+  it('keeps valueless completion distinct from an explicit null in output files', async () => {
+    const directory = await root()
+    for (const value of [undefined, null]) {
+      const journal = new Journal(directory, 'owner', 'wf_no-value', 'return args', meta, 'spawn')
+      journal.finish(new WorkflowOutput(meta.description).render({ value, stopReason: 'completed', agentsStarted: 0 }))
+      if (!journal.outputFile) throw new Error('missing output')
+      const output = JSON.parse(await readFile(journal.outputFile, 'utf8')) as { result?: unknown }
+      expect(Object.hasOwn(output, 'result')).toBe(value !== undefined)
+      expect(output.result).toBe(value)
+    }
+  })
+  it('publishes complete output independently for each attempt and advertises no failed write', async () => {
+    const directory = await root()
+    const first = new Journal(directory, 'owner', 'wf_output', 'return args', meta, 'spawn')
+    const second = new Journal(directory, 'owner', 'wf_output', 'return 2', meta, 'spawn')
+    expect(first.outputFile).toBeUndefined()
+    first.finish(new WorkflowOutput(meta.description).render({ value: { text: 'x'.repeat(120000) }, stopReason: 'completed', agentsStarted: 0 }))
+    second.finish('')
+    expect(first.outputFile).not.toBe(second.outputFile)
+    if (!first.outputFile || !second.outputFile) throw new Error('missing published output')
+    expect((JSON.parse(await readFile(first.outputFile, 'utf8')) as { result: unknown }).result).toEqual({ text: 'x'.repeat(120000) })
+    expect(await readFile(second.outputFile, 'utf8')).toBe('')
+    const broken = new Journal(directory, 'owner', 'wf_broken', 'return 1', meta, 'spawn')
+    await rm(broken.directory, { recursive: true })
+    expect(() => { broken.finish('1') }).toThrow()
+    expect(broken.outputFile).toBeUndefined()
+  })
+
+  it('retains earlier journals and isolates their late writes from the current attempt', async () => {
+    const directory = await root()
+    const first = new Journal(directory, 'owner', 'wf_same-run', 'return 1', meta, 'spawn')
+    first.append(entry)
+    expect(Journal.resume(directory, 'owner', 'wf_same-run', 'spawn')).toEqual([entry])
+    const second = new Journal(directory, 'owner', 'wf_same-run', 'return 2', meta, 'spawn')
+    expect(second.attemptId).not.toBe(first.attemptId)
+    first.append({ ...entry, seq: 2 })
+    second.append({ ...entry, value: 'current' })
+    expect(Journal.resume(directory, 'owner', 'wf_same-run', 'spawn')).toEqual([{ ...entry, value: 'current' }])
+    expect(await readFile(join(directory, digest('owner'), 'wf_same-run', `${first.attemptId}.jsonl`), 'utf8')).toContain('"seq":2')
+    expect(() => Journal.resume(directory, 'owner', 'wf_same-run', 'other')).toThrow('unavailable')
+  })
+  it('loads a legacy journal and ignores only an unterminated crash tail', async () => {
+    const directory = await root(), run = join(directory, digest('owner'), 'wf_legacy-run')
+    await mkdir(run, { recursive: true })
+    await writeFile(join(run, 'journal.jsonl'), JSON.stringify({ version: 2, sessionId: 'owner', runId: 'wf_legacy-run', provider: 'spawn' }) + '\n' + JSON.stringify(entry) + '\n{"seq":2')
+    expect(Journal.resume(directory, 'owner', 'wf_legacy-run', 'spawn')).toEqual([entry])
+    await writeFile(join(run, 'current.json'), JSON.stringify({ attemptId: '../../outside' }))
+    expect(() => Journal.resume(directory, 'owner', 'wf_legacy-run', 'spawn')).toThrow('unavailable')
+  })
+})
