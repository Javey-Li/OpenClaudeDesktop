diff --git a/packages/subagent/subagent-spawn-in-process/tests/tool-selector.spec.ts b/packages/subagent/subagent-spawn-in-process/tests/tool-selector.spec.ts
new file mode 100644
index 0000000000..b864fdf986
--- /dev/null
+++ b/packages/subagent/subagent-spawn-in-process/tests/tool-selector.spec.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest'
+import { parseToolSelector } from '../src/tool-selector.ts'
+import { matchesAgentTool, acceptsAgentMcpTool, agentMcpResourceTools } from '../src/tool-policy.ts'
+import { agentSelectors } from '../src/agent-type.ts'
+import { prepareBashClamp } from '../src/bash-clamp.ts'
+
+describe('Claude tool selector syntax and admission', () => {
+  it.each([
+    ['Bash', { toolName: 'Bash' }],
+    ['Bash(*)', { toolName: 'Bash' }],
+    ['Bash()', { toolName: 'Bash' }],
+    ['Bash(echo hi)', { toolName: 'Bash', ruleContent: 'echo hi' }],
+    ['Bash(echo \\(hi\\))', { toolName: 'Bash', ruleContent: 'echo (hi)' }],
+    ['Bash(echo \\\\path)', { toolName: 'Bash', ruleContent: 'echo \\path' }],
+    ['Bash(echo hi)tail', { toolName: 'Bash(echo hi)tail' }],
+    ['Bash(echo hi', { toolName: 'Bash(echo hi' }],
+    ['(Bash)', { toolName: '(Bash)' }],
+    ['Bash\\(echo hi)', { toolName: 'Bash\\(echo hi)' }],
+    ['Bash(echo\\)', { toolName: 'Bash(echo\\)' }],
+    ['Bash(echo \\))', { toolName: 'Bash', ruleContent: 'echo )' }],
+  ])('parses %s', (value, expected) =>{  expect(parseToolSelector(value)).toEqual(expected) })
+
+  it.each([
+    ['Read Bash(echo hi), Agent(Explore, Plan)', ['Read', 'Bash(echo hi)', 'Agent(Explore, Plan)']],
+    [['Read Bash(echo hi)', 5, 'Write'], ['Read', 'Bash(echo hi)', 'Write']],
+    ['Read * Bash(echo hi)', ['*']],
+    ['Read\tWrite', ['Read\tWrite']],
+    ['Bash(echo hi Read', ['Bash(echo hi Read']],
+  ])('splits frontmatter %j', (value, expected) =>{  expect(agentSelectors(value)).toEqual(expected) })
+
+  it.each([
+    ['Bash(echo:*)', 'bash', true], ['Read(src/*)', 'read', true],
+    ['Task(Explore)', 'subagent', true], ['mcp__demo__*(payload)', 'mcp__demo__ping', true],
+    ['Bash(echo)tail', 'bash', false], ['Bash\\(echo)', 'bash', false],
+    ['Bash(echo:*)', 'write', false], ['*(anything)', 'bash', false],
+  ])('matches %s to %s = %s', (rule, name, matched) =>{  expect(matchesAgentTool(rule, name)).toBe(matched) })
+
+  it('applies argument-bearing MCP denials to whole tools and resource helpers', () => {
+    expect(acceptsAgentMcpTool('mcp__demo__ping', { deny: ['mcp__demo__ping(payload)'] })).toBe(false)
+    expect(acceptsAgentMcpTool('mcp__demo__ping', undefined, { persona: '', disallowedTools: ['mcp__demo(payload)'] })).toBe(false)
+    expect(agentMcpResourceTools(undefined, { persona: '', tools: ['ListMcpResources(*)'], disallowedTools: ['ReadMcpResource(private)'] })).toEqual(['list_mcp_resources'])
+  })
+
+  it('decodes escaped delimiters for a real Bash command clamp', async () => {
+    const clamp = await prepareBashClamp([String.raw`Bash(printf '\(ok\)')`], new AbortController().signal)
+    expect(clamp?.("printf '(ok)' > result.txt")).toBeUndefined()
+    expect(clamp?.("printf '(no)' > result.txt")).toContain('outside')
+  })
+})
diff --git a/packages/subagent/subagent-spawn-in-process/tests/workflow-options.spec.ts b/packages/subagent/subagent-spawn-in-process/tests/workflow-options.spec.ts
new file mode 100644
index 0000000000..3c6463f053
--- /dev/null
+++ b/packages/subagent/subagent-spawn-in-process/tests/workflow-options.spec.ts
@@ -0,0 +1,171 @@
+import { execFile } from 'node:child_process'
+import { promisify } from 'node:util'
+import { mkdir, writeFile, stat } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import SubagentRuntime from '@deepseek-ai/dsh-subagent'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { mountPtcRuntime } from '../../../workflow/workflow-ptc/tests/setup.ts'
+import * as spawn from '../src/index.ts'
+import { createAgentWorktree } from '../src/worktree.ts'
+
+const exec = promisify(execFile)
+const signal = new AbortController().signal
+
+describe('workflow spawn options on the real provider', () => {
+  it('loads an agent definition into the child prompt/model/tool scope', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+    await writeFile(join(cwd, '.claude/agents/reviewer.md'), '---\nname: reviewer\ndescription: Review a change\nmodel: review-model\ntools: [Read]\ndisallowedTools: [Write]\n---\nLook for incorrect state transitions.\n')
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(SubagentRuntime)
+    await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+    for (const name of ['read', 'write']) ctx.tools.register(defineContentToolFixture({ name, description: name, parameters: {}, execute: async () => [] }))
+    const adapter = new MockAdapter([textResponse('reviewed')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const parent = await ctx.agents.create({ sessionId: SessionId('review-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+    const run = await ctx.subagents.start('spawn', { parent: parent.agent, signal, agentType: 'reviewer', toolFilter: { allow: ['read', 'write'] }, prompt: [{ type: 'text', text: 'Review this change.' }] })
+    try {
+      expect((await run.result).stopReason).toBe('completed')
+      expect(adapter.requests[0]!.model).toBe('review-model')
+      expect(JSON.stringify(adapter.requests[0]!.messages[0])).toContain('Look for incorrect state transitions')
+      expect(adapter.requests[0]!.tools?.map(tool => tool.name)).toEqual(['read'])
+      expect(parent.agent.ctx.tools.schemas().map(tool => tool.name)).toContain('write')
+    } finally { await run.dispose(); await parent.dispose() }
+  })
+
+  it('resolves argument-bearing tool names and enforces caller and definition denials in real children', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+    await writeFile(join(cwd, '.claude/agents/selectors.md'), '---\nname: selectors\ndescription: Selector fixture\ntools: Bash(echo:*) Read(src/*) Write(*) Agent(Explore)\ndisallowedTools: Read(private/*)\n---\nRun selected tools.')
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(SubagentRuntime)
+    await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+    const executed: string[] = []
+    for (const name of ['bash', 'read', 'write', 'subagent']) ctx.tools.register(defineContentToolFixture({ name, description: name, parameters: {}, execute: async () => { executed.push(name); return [] } }))
+    const adapter = new MockAdapter([
+      toolCallResponse('read-denied', 'read', {}), toolCallResponse('write-denied', 'write', {}),
+      toolCallResponse('agent-unavailable', 'subagent', {}), toolCallResponse('bash-allowed', 'bash', {}), textResponse('selected'),
+    ])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const parent = await ctx.agents.create({ sessionId: SessionId('selector-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+    const run = await ctx.subagents.start('spawn', { parent: parent.agent, signal, agentType: 'selectors', toolFilter: { deny: ['Write(other/*)'] }, prompt: [{ type: 'text', text: 'Run the selected tools.' }] })
+    try {
+      expect((await run.result).stopReason).toBe('completed')
+      expect(adapter.requests[0]?.tools?.map(tool => tool.name)).toEqual(['bash'])
+      expect(executed).toEqual(['bash'])
+      const results = run.localAgent?.session.snapshotEvents().filter(event => event.type === 'tool/result')
+      expect(results?.map(event => event.data.message.isError === true)).toEqual([true, true, true, false])
+      expect(parent.agent.ctx.tools.schemas().map(tool => tool.name).sort()).toEqual(['bash', 'read', 'subagent', 'write'])
+    } finally { await run.dispose(); await parent.dispose() }
+  })
+
+  it('preloads agent skills into the child request and durable log without exposing them to the parent', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    const { cwd } = await mountPtcRuntime(ctx)
+    await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+    await mkdir(join(cwd, '.claude/skills/review'), { recursive: true })
+    await mkdir(join(cwd, '.claude/skills/disabled'), { recursive: true })
+    await writeFile(join(cwd, '.claude/agents/reviewer.md'), '---\nname: reviewer\ndescription: Review code\nskills: [review, review, missing, disabled]\ntools: [Read, NotInstalled]\n---\nReview carefully.')
+    await writeFile(join(cwd, '.claude/skills/review/SKILL.md'), '---\nname: review\ndescription: Review lifecycle behavior\n---\nCheck cancellation and disposal using references.md.')
+    await writeFile(join(cwd, '.claude/skills/disabled/SKILL.md'), '---\nname: disabled\ndisable-model-invocation: true\n---\nDo not preload this skill.')
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(SubagentRuntime)
+    await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+    ctx.tools.register(defineContentToolFixture({ name: 'read', description: 'read', parameters: {}, execute: async () => [] }))
+    const adapter = new MockAdapter([textResponse('reviewed')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const parent = await ctx.agents.create({ sessionId: SessionId('skill-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+    const run = await ctx.subagents.start('spawn', { parent: parent.agent, signal, agentType: 'reviewer', prompt: [{ type: 'text', text: 'Review the task.' }] })
+    try {
+      expect((await run.result).stopReason).toBe('completed')
+      const request = JSON.stringify(adapter.requests[0]!.messages)
+      expect(request).toContain('Check cancellation and disposal')
+      expect(request).toContain(join(cwd, '.claude/skills/review'))
+      expect(request).not.toContain('Do not preload this skill')
+      const events = run.localAgent!.session.snapshotEvents()
+      const preloads = events.filter(event => event.type === 'user/message' && event.data.source.kind === 'subagent-skill-preload')
+      expect(preloads).toHaveLength(1)
+      expect(JSON.stringify(parent.agent.session.snapshotEvents())).not.toContain('Check cancellation and disposal')
+    } finally { await run.dispose(); await parent.dispose() }
+  })
+
+  it('enforces Bash clamps on actual child tool calls without affecting the parent', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    const { cwd } = await mountPtcRuntime(ctx)
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(SubagentRuntime)
+    await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+    let executions = 0
+    ctx.tools.register(defineContentToolFixture({ name: 'bash', description: 'fixture', parameters: { command: { type: 'string', required: true } }, execute: async () => { executions++; return [] } }))
+    ctx.tools.register(defineContentToolFixture({ name: 'mcp__example__run', description: 'alternate execution fixture', parameters: {}, execute: async () => [] }))
+    const adapter = new MockAdapter([toolCallResponse('allowed', 'bash', { command: 'echo good | echo good && echo good > output' }), textResponse('allowed'), toolCallResponse('rejected', 'bash', { command: 'echo good; echo bypass' }), textResponse('rejected')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const parent = await ctx.agents.create({ sessionId: SessionId('clamp-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+    try {
+      for (const prompt of ['allowed', 'rejected']) {
+        const run = await ctx.subagents.start('spawn', { parent: parent.agent, signal, bashCommandClamp: ['Bash(echo good)'], prompt: [{ type: 'text', text: prompt }] })
+        await run.result
+        const results = run.localAgent!.session.snapshotEvents().filter(event => event.type === 'tool/result')
+        expect(results).toHaveLength(1)
+        expect(results[0]!.data.message.isError).toBe(prompt === 'rejected')
+        await run.dispose()
+      }
+      expect(executions).toBe(1)
+      expect(adapter.requests.every(request => !request.tools?.some(tool => tool.name === 'mcp__example__run'))).toBe(true)
+      expect(parent.agent.ctx.tools.schemas().some(tool => tool.name === 'mcp__example__run')).toBe(true)
+    } finally { await parent.dispose() }
+  })
+
+  it('removes an unchanged worktree and retains both edits and new commits', async () => {
+    const ctx = new Context()
+    await mountAgentLoopTestDependencies(ctx)
+    const { cwd } = await mountPtcRuntime(ctx)
+    const git = (directory: string, ...args: string[]) => exec('git', args, { cwd: directory })
+    await git(cwd, 'init')
+    await git(cwd, 'config', 'user.email', 'fixture@example.test')
+    await git(cwd, 'config', 'user.name', 'Workflow Fixture')
+    await writeFile(join(cwd, 'tracked.txt'), 'initial')
+    await git(cwd, 'add', 'tracked.txt')
+    await git(cwd, 'commit', '-m', 'fixture')
+    await ctx.plugin(AgentLoop, { agents: [] })
+    await ctx.plugin(SubagentRuntime)
+    await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+    const adapter = new MockAdapter([textResponse('isolated')])
+    ctx.llm.registerAdapter(['mock'], adapter)
+    const parent = await ctx.agents.create({ sessionId: SessionId('worktree-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock' } })
+    const run = await ctx.subagents.start('spawn', { parent: parent.agent, signal, isolation: 'worktree', prompt: [{ type: 'text', text: 'Check this tree.' }] })
+    const childCwd = run.localAgent!.session.header.cwd!
+    expect(childCwd).not.toBe(cwd)
+    expect(childCwd).toContain('.claude/worktrees/')
+    expect((await run.result).stopReason).toBe('completed')
+    await run.dispose()
+    await expect(stat(childCwd)).rejects.toMatchObject({ code: 'ENOENT' })
+    await parent.dispose()
+    const clean = await createAgentWorktree(ctx, cwd, signal)
+    await clean.cleanup()
+    await expect(stat(clean.cwd)).rejects.toMatchObject({ code: 'ENOENT' })
+    const edited = await createAgentWorktree(ctx, cwd, signal)
+    await writeFile(join(edited.cwd, 'new.txt'), 'keep this')
+    await edited.cleanup()
+    expect((await stat(edited.cwd)).isDirectory()).toBe(true)
+    const committed = await createAgentWorktree(ctx, cwd, signal)
+    await writeFile(join(committed.cwd, 'tracked.txt'), 'committed work')
+    await git(committed.cwd, 'add', 'tracked.txt')
+    await git(committed.cwd, 'commit', '-m', 'keep commit')
+    await committed.cleanup()
+    expect((await stat(committed.cwd)).isDirectory()).toBe(true)
+    expect((await git(committed.cwd, 'status', '--porcelain')).stdout.trim()).toBe('')
+  })
+})
