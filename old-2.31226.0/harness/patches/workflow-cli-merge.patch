+import { describe, expect, it } from 'vitest'
+import { parseClaudeWorkflowScript as parse } from '../src/claude-metadata.ts'
+
+const header = (extra = '') => `export const meta = { name: 'audit', description: 'Inspect', ${extra} };`
+
+describe('CLI metadata data decoding', () => {
+  it('accepts static templates and preserves display titles independently of names', () => {
+    expect(parse('export const meta={name:`audit`,description:`Inspect`,title:`  Display  `}; return 1')).toEqual({
+      meta: { name: 'audit', description: 'Inspect', title: '  Display  ' }, script: 'return 1',
+    })
+  })
+  it('ignores invalid optional annotations while retaining empty phase titles and duplicates', () => {
+    expect(parse(header('title:3,whenToUse:"",unknown:/a/i,phases:[null,{},3,{title:4},{title:""},{title:"Scan",detail:9,model:"small",provider:"ignored"},{title:"Scan"}]')).meta).toEqual({
+      name: 'audit', description: 'Inspect', whenToUse: '', phases: [{ title: '' }, { title: 'Scan', model: 'small' }, { title: 'Scan' }],
+    })
+    expect(parse(header('title:"",phases:{title:"ignored"},unknown:1n')).meta).toEqual({ name: 'audit', description: 'Inspect' })
+  })
+  it.each(['name:undefined', 'ignored:+1', 'ignored:[1,,2]', 'ignored:{["x"]:1}', 'ignored:{constructor:1}', 'ignored:{prototype:1}', 'ignored:{"__proto__":1}', 'ignored:`${1}`', 'ignored:globalThis.mutate()'])('rejects executable or reserved metadata: %s', (extra) => {
+    expect(() => parse(header(extra))).toThrow('meta must be a pure literal')
+  })
+  it('requires the first statement to be the single metadata declaration and validates strict bodies', () => {
+    expect(() => parse('return 1')).toThrow('FIRST statement')
+    expect(() => parse('export let meta={name:"x",description:"x"}')).toThrow('FIRST statement')
+    expect(() => parse(header() + 'function f(a,a){}')).toThrow('Script parse error')
+    expect(() => parse(header() + 'const x: number = 1')).toThrow('plain JavaScript')
+  })
+  it('discovers ordinary headers without parsing bodies and falls back for extended syntax', () => {
+    expect(parse(header() + 'const = ;', false).meta.name).toBe('audit')
+    expect(parse(header('unknown:`static`') + 'const = ;', false).meta.name).toBe('audit')
+    for (const extra of ['unknown:0x20', 'unknown:({x:1})', 'unknown:1n', 'unknown:{名:1}']) {
+      expect(() => parse(header(extra) + 'const = ;', false)).toThrow('Script parse error')
+      expect(parse(header(extra) + 'return 1', false).meta.name).toBe('audit')
+    }
+    expect(() => parse(header().replace('export const', 'export /*comment*/ const') + 'const = ;', false)).toThrow('Script parse error')
+  })
+  it('uses the CLI character ceiling for inline source', () => {
+    const source = header() + '// ' + '字'.repeat(524288 - header().length - 3)
+    expect(parse(source).meta.name).toBe('audit')
+    expect(() => parse(source + '字')).toThrow('Script exceeds 524288 bytes')
+  })
+})
