new file mode 100644
index 0000000000..0e00b48486
--- /dev/null
+++ b/packages/hooks/hooks-claude-code/tests/http-fixture.ts
@@ -0,0 +1,37 @@
+/** Local HTTP hook endpoint shared with the keyless profile snapshot. */
+import { createServer } from 'node:http'
+
+/** Start a JSON-only hook endpoint and retain an independent request oracle. */
+export async function startHttpHookFixture(): Promise<{
+  url: string
+  events: string[]
+  close(): Promise<void>
+}> {
+  const events: string[] = []
+  const server = createServer((request, response) => {
+    let body = ''
+    request.on('data', (chunk) => { body += String(chunk) })
+    request.on('end', () => {
+      const payload: unknown = JSON.parse(body)
+      if (request.method !== 'POST' || typeof payload !== 'object' || payload === null
+        || !('hook_event_name' in payload) || typeof payload.hook_event_name !== 'string') {
+        response.writeHead(400).end()
+        return
+      }
+      events.push(payload.hook_event_name)
+      response.writeHead(200, { 'Content-Type': 'application/json' }).end(JSON.stringify({
+        hookSpecificOutput: { hookEventName: payload.hook_event_name, additionalContext: `HTTP_${payload.hook_event_name}_CONTEXT` },
+      }))
+    })
+  })
+  await new Promise<void>((resolve) => { server.listen(0, '127.0.0.1', resolve) })
+  const address = server.address()
+  if (!address || typeof address === 'string') throw new Error('HTTP hook fixture has no TCP address')
+  return {
+    url: `http://127.0.0.1:${address.port}/hook`, events,
+    async close() {
+      server.closeAllConnections()
+      await new Promise<void>((resolve, reject) => { server.close((error) => { if (error) reject(error); else resolve() }) })
+    },
+  }
+}
