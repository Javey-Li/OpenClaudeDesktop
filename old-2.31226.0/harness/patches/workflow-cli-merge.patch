index 0000000000..76806e1c18
--- /dev/null
+++ b/packages/workflow/workflow-ptc/src/compiler.ts
@@ -0,0 +1,97 @@
+/** Parse workflow bodies and normalize asynchronous values inside the script realm. */
+
+import { parse } from 'acorn'
+import type { AnyNode, Node } from 'acorn'
+import { ancestor, full } from 'acorn-walk'
+
+const reservedPrefix = '__wRg$'
+const resolveName = `${reservedPrefix}resolve`
+
+/** Capture the guest Promise resolver before script code can replace global bindings. */
+export const WORKFLOW_ASYNC_INIT_SOURCE = `Object.defineProperty(globalThis, '${resolveName}', {
+  value: Promise.resolve.bind(Promise), writable: false, enumerable: false, configurable: false,
+})`
+
+// Iterator methods are captured once; both the step and its value are resolved,
+// including values returned during completion and early loop exit.
+const iteratorAdapter = `function __wRg$a(source) {
+  return { [Symbol.asyncIterator]() {
+    const method = source[Symbol.asyncIterator];
+    if (method != null && typeof method !== 'function') throw new TypeError('@@asyncIterator is not a function');
+    const iterator = method != null ? method.call(source) : source[Symbol.iterator]();
+    const object = value => value !== null && (typeof value === 'object' || typeof value === 'function');
+    if (!object(iterator)) throw new TypeError('Iterator is not an object');
+    const next = iterator.next;
+    if (typeof next !== 'function') throw new TypeError('Iterator.next is not a function');
+    const finish = iterator.return;
+    const fail = iterator.throw;
+    const settle = step => __wRg$(step).then(result => {
+      if (!object(result)) throw new TypeError('Iterator result is not an object');
+      const done = result.done;
+      return __wRg$(result.value).then(value => ({ value, done }));
+    });
+    return {
+      next(value) { return settle(next.call(iterator, value)); },
+      return(value) { return settle(typeof finish === 'function' ? finish.call(iterator, value) : { value, done: true }); },
+      throw(error) {
+        if (typeof fail === 'function') return settle(fail.call(iterator, error));
+        return __wRg$(typeof finish === 'function' ? finish.call(iterator) : undefined).then(() => {
+          throw new TypeError('The iterator does not provide a throw method');
+        });
+      },
+    };
+  } };
+}`
+
+function enclosingFunction(nodes: Node[]): Extract<AnyNode, { type: 'FunctionDeclaration' | 'FunctionExpression' | 'ArrowFunctionExpression' }> | undefined {
+  for (let index = nodes.length - 2; index >= 0; index--) {
+    const node = nodes[index] as AnyNode
+    if (node.type === 'FunctionDeclaration' || node.type === 'FunctionExpression' || node.type === 'ArrowFunctionExpression') return node
+  }
+  return undefined
+}
+
+/**
+ * Compile a body into a strict async expression with guest-local value resolution.
+ * @param body - JavaScript following the separately decoded metadata declaration.
+ * @returns JavaScript to compile with node:vm after installing WORKFLOW_ASYNC_INIT_SOURCE.
+ * @throws SyntaxError for invalid JavaScript, reserved identifiers, imports or await-using declarations.
+ */
+export function compileWorkflowBody(body: string): string {
+  const prefix = "(async () => {'use strict';\n"
+  const suffix = '\n})()'
+  const source = prefix + body + suffix
+  const tree = parse(source, { ecmaVersion: 'latest', sourceType: 'script', allowHashBang: true })
+  full(tree, (node) => {
+    if ('name' in node && typeof node.name === 'string' && node.name.startsWith(reservedPrefix)) {
+      throw new SyntaxError(`Identifier '${node.name}' is reserved.`)
+    }
+    if (node.type === 'ImportExpression') throw new SyntaxError('import() is not available in workflow scripts.')
+    if (node.type === 'WithStatement') throw new SyntaxError("'with' statements are not supported in workflow scripts.")
+  })
+  const insertions: [number, string][] = []
+  const wrap = (node: Node | null | undefined, helper = '__wRg$'): void => {
+    if (node) insertions.push([node.start, ` ${helper}((`], [node.end, '))'])
+  }
+  ancestor(tree, {
+    VariableDeclaration(node) {
+      if (node.kind === 'await using') throw new SyntaxError("'await using' declarations are not supported in workflow scripts.")
+    },
