+      || key.startsWith('CLAUDE_CODE_ARTIFACT') && key.endsWith('_BASE_URL')
+    if (secret && !approvedCredentials.has(name)) return ''
+    return env[name] ?? ''
+  }).replace(/[\r\n\x00]/g, '')
