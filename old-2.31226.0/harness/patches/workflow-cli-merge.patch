+import { describe, expect, it } from 'vitest'
+import { createAssistantMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { AssistantStreamRecord, ContentBlock } from '@deepseek-ai/dsh-llm'
+import { Session, SessionId, SessionSeq, buildForkSeed, foldSurface } from '../src/index.ts'
+
+function fixture() {
+  const session = Session.create(SessionId('stream-fixture'))
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  const start = session.append('assistant/stream-start', { turn: 1, step: 1, provider: 'mock', model: 'mock' })
+  const blocks: ContentBlock[] = [
+    { type: 'tool-call', id: ToolCallId('one'), name: 'write', arguments: '{}' },
+    { type: 'tool-call', id: ToolCallId('two'), name: 'read', arguments: '{}' },
+  ]
+  const segments: AssistantStreamRecord[][] = blocks.map((block, index) => [
+    { type: 'chunk', time: index + 1, chunk: { type: 'block-end', index, block } },
+  ])
+  const messages = blocks.map((block, index) => {
+    const checkpoint = session.append('assistant/message', {
+      turn: 1, step: 1, stream: segments[index]!,
+      message: createAssistantMessage({ content: [block], source: { provider: 'mock', model: 'mock' } }),
+    }, { surfaceOp: 'append' })
+    if (block.type !== 'tool-call') throw new Error('invalid test block')
+    session.append('tool/call', { turn: 1, step: 1, callId: block.id, name: block.name, arguments: block.arguments })
+    session.append('tool/result', {
+      turn: 1, step: 1,
+      message: createToolResultMessage({ callId: block.id, isError: false, content: [{ type: 'text', text: block.name }] }),
+    }, { surfaceOp: 'append' })
+    return checkpoint
+  })
+  const attempt = session.append('assistant/attempt', {
+    turn: 1, step: 1, stream: [...segments.flat(), { type: 'chunk', time: 3, chunk: {
+      type: 'finish', reason: { kind: 'tool-calls' }, replayState: {
+        response: { signature: 'signed-response' }, blocks: [{ id: 'signed-write' }, { id: 'signed-read' }],
+      },
+    } }],
+  })
+  const merge = { turn: 1, step: 1, startSeq: start.seq, attemptSeq: attempt.seq, messageSeqs: messages.map(item => item.seq) }
+  return { session, start, messages, attempt, merge }
+}
+
+describe('streamed assistant history reconstruction', () => {
+  it.each([undefined, 'discard'] as const)('restores historical partial text according to the recorded %s policy', (incompleteBlocks) => {
+    const session = Session.create(SessionId('text-policy'))
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    const policy = incompleteBlocks === undefined ? {} : { incompleteBlocks }
+    const start = session.append('assistant/stream-start', { turn: 1, step: 1, provider: 'mock', model: 'mock', ...policy })
+    const partial: AssistantStreamRecord[] = [{ type: 'text-chunks', time0: 1, index: 0, dt: [], texts: ['partial text'] }]
+    const checkpoint = incompleteBlocks === undefined ? session.append('assistant/message', {
+      turn: 1, step: 1, stream: partial,
+      message: createAssistantMessage({ content: [{ type: 'text', text: 'partial text' }], source: { provider: 'mock', model: 'mock' } }),
+    }, { surfaceOp: 'append' }) : undefined
+    const attempt = session.append('assistant/attempt', { turn: 1, step: 1, stream: [...partial, {
+      type: 'chunk', time: 2, chunk: { type: 'finish', reason: { kind: 'error', failure: { code: 'STREAM_CLOSED', message: 'stream closed' } } },
+    }] })
+    session.append('assistant/stream-merge', {
+      turn: 1, step: 1, startSeq: start.seq, attemptSeq: attempt.seq,
+      messageSeqs: checkpoint === undefined ? [] : [checkpoint.seq], ...policy,
+    })
+    const restored = Session.create(SessionId('text-restored'), session.snapshotEvents())
+    expect(restored.deriveMessages()).toEqual(session.deriveMessages())
+    expect(restored.deriveMessages().flatMap(message => message.content)).toEqual(incompleteBlocks === undefined
+      ? [{ type: 'text', text: 'partial text' }] : [])
+    expect(restored.snapshotEvents().find(event => event.type === 'assistant/attempt')?.data.stream).toEqual(attempt.data.stream)
+  })
+
+  it('keeps original records and identities while folding a complete batch before results', () => {
+    const { session, messages, merge } = fixture()
+    const before = structuredClone(session.snapshotEvents())
+    session.append('assistant/stream-merge', merge)
+    const history = session.deriveMessages()
+    expect(history.map(message => message.role)).toEqual(['assistant', 'tool', 'tool'])
+    expect(history[0]!.id).toBe(messages[0]!.data.message.id)
+    expect(history[0]!.content.map(block => block.type === 'tool-call' ? block.id : block.type)).toEqual(['one', 'two'])
+    expect(history[0]!.source).toMatchObject({ replayState: {
+      response: { signature: 'signed-response' }, blocks: [{ id: 'signed-write' }, { id: 'signed-read' }],
+    } })
+    expect(Object.isFrozen(history[0]!.content)).toBe(true)
+    expect(session.snapshotEvents().slice(0, before.length)).toEqual(before)
+    expect(session.surface.replaceGeneration).toBe(0)
+    expect(session.surface.contentGeneration).toBe(1)
+    expect(foldSurface(session.snapshotEvents()).projectedMessages.size).toBe(2)
+    const seed = buildForkSeed(session.snapshotEvents(), SessionSeq(session.seq - 1))
+    expect(Session.create(SessionId('fork'), seed).deriveMessages()).toEqual(history)
+  })
+
+  it.each(['arguments', 'timestamp', 'provider', 'omitted', 'duplicate'] as const)('rejects %s tampering before publishing a fold', (tamper) => {
+    const { session, messages, attempt, merge } = fixture()
+    const seed = structuredClone(session.snapshotEvents())
+    const checkpoint = seed[messages[0]!.seq]!
+    if (checkpoint.type !== 'assistant/message') throw new Error('wrong fixture')
+    if (tamper === 'arguments') checkpoint.data.message = {
+      ...checkpoint.data.message,
+      content: [{ type: 'tool-call', id: ToolCallId('one'), name: 'write', arguments: '{"forged":true}' }],
+    }
+    if (tamper === 'timestamp') checkpoint.data.stream = [{ type: 'chunk', time: 99, chunk: { type: 'block-end', index: 0, block: checkpoint.data.message.content[0]! } }]
+    if (tamper === 'provider') checkpoint.data.message.source.provider = 'different'
+    if (tamper === 'duplicate') {
+      const second = seed[messages[1]!.seq]!
+      if (second.type !== 'assistant/message') throw new Error('wrong fixture')
+      second.data.stream = structuredClone(checkpoint.data.stream)
+      second.data.message = { ...second.data.message, content: structuredClone(checkpoint.data.message.content) }
+    }
+    if (tamper === 'omitted') {
+      const final = seed[attempt.seq]!
+      if (final.type !== 'assistant/attempt') throw new Error('wrong fixture')
+      final.data.stream.unshift({ type: 'chunk', time: 0, chunk: { type: 'block-end', index: 2, block: { type: 'text', text: 'unadvertised' } } })
+    }
+    const restored = Session.create(SessionId(`tampered-${tamper}`), seed)
+    const seq = restored.seq
+    const before = restored.deriveMessages()
+    expect(() => restored.append('assistant/stream-merge', merge)).toThrow(/assistant\/stream-merge/)
+    expect(restored.seq).toBe(seq)
+    expect(restored.deriveMessages()).toEqual(before)
+  })
+
+  it('refuses reused, cross-step, and forward references', () => {
+    const { session, merge } = fixture()
+    expect(() => foldSurface([...session.snapshotEvents(), {
+      type: 'assistant/stream-merge', seq: SessionSeq(session.seq), time: 0, data: merge, ignorable: true,
+    }])).toThrow(/required on read/)
+    expect(() => session.append('assistant/stream-merge', { ...merge, messageSeqs: [...merge.messageSeqs].reverse() })).toThrow(/message references/)
+    expect(() => session.append('assistant/stream-merge', { ...merge, attemptSeq: SessionSeq(session.seq + 1) })).toThrow(/earlier/)
+    expect(() => session.append('assistant/stream-merge', { ...merge, step: 2 })).toThrow(/mismatched/)
+    session.append('assistant/stream-merge', merge)
+    expect(() => session.append('assistant/stream-merge', merge)).toThrow(/reused/)
+  })
+
+  it('refuses a nested start but can restore an unfinished stream without replaying effects', () => {
+    const { session, start, messages } = fixture()
+    expect(() => session.append('assistant/stream-start', start.data)).toThrow(/still open/)
+    const partial = session.snapshotEvents().slice(0, messages[1]!.seq + 1)
+    const fork = Session.create(SessionId('partial'), buildForkSeed(partial, SessionSeq(partial.length - 1)))
+    const log = fork.snapshotEvents()
+    expect(log.filter(event => event.type === 'tool/call')).toHaveLength(1)
+    const result = log.findLast(event => event.type === 'tool/result')!
+    expect(result.data.message.toolCallId).toBe('two')
+    expect(result.data.error?.code).toBe('TOOL_NOT_STARTED')
+  })
+})
