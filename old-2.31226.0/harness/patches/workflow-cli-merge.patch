@@ -0,0 +1,29 @@
+import { expect, it } from 'vitest'
+import { PrefixWarmup } from '../src/warmup.ts'
+
+it('releases same-prefix followers on response and never gates a different prefix', async () => {
+  const gate = new PrefixWarmup(1000, 270_000)
+  const signal = new AbortController().signal
+  const leader = await gate.enter('same', signal)
+  let entered = false
+  const follower = gate.enter('same', signal).then(() => { entered = true })
+  const other = await gate.enter('other', signal)
+  expect(entered).toBe(false)
+  leader(true)
+  await follower
+  expect(entered).toBe(true)
+  await gate.enter('same', signal)
+  other(false)
+})
+
+it('cancels waiting followers without invalidating their leader', async () => {
+  const gate = new PrefixWarmup(1000, 270_000)
+  const leader = await gate.enter('same', new AbortController().signal)
+  const controller = new AbortController()
+  const follower = gate.enter('same', controller.signal)
+  controller.abort()
+  await expect(follower).rejects.toBeDefined()
+  leader(false)
+  const replacement = await gate.enter('same', new AbortController().signal)
+  replacement(true)
+})
