+import { dirname, basename } from 'node:path'
+import { readFile, writeFile } from 'node:fs/promises'
+import { describe, expect, it } from 'vitest'
+import { WorkflowRunId } from '@deepseek-ai/dsh-workflow'
+import { fakeParent } from './setup.ts'
+import { setupMerge } from './merge-setup.ts'
+
+describe('durable workflow resume', () => {
+  it('keeps a display name containing path syntax inside the owning run directory', async () => {
+    const t = await setupMerge()
