+import { describe, expect, it } from 'vitest'
+import { claudeToolName, harnessToolName, parseClaudeMarkdown } from '../src/index.ts'
+
+describe('Claude tool aliases', () => {
+  it.each(['workflow', 'Workflow', 'RunWorkflow'])('normalizes %s for selectors and hook matching', (name) => {
+    expect(harnessToolName(name)).toBe('workflow')
+    expect(claudeToolName(name)).toBe('Workflow')
+  })
+  it('retains ordinary aliases and leaves unrelated names unchanged', () => {
+    expect(claudeToolName('Task')).toBe('Agent')
+    expect(claudeToolName('bash')).toBe('Bash')
+    expect(harnessToolName('Bash')).toBe('bash')
+    expect(harnessToolName('__proto__')).toBe('__proto__')
+    expect(claudeToolName('custom')).toBe('custom')
+  })
+  it('keeps absent and literal frontmatter distinct from invalid YAML values', () => {
+    expect(parseClaudeMarkdown('body')).toEqual({ metadata: {}, content: 'body' })
+    expect(parseClaudeMarkdown('---\nname: worker\n---\nBody')).toEqual({ metadata: { name: 'worker' }, content: 'Body' })
+    expect(() => parseClaudeMarkdown('---\n[]\n---\nBody')).toThrow('object')
+  })
+})
