@@ -0,0 +1,31 @@
+/** Resolve the definition folder's explicit Claude workspace trust before running its hooks. */
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-fs'
+
+/** Check the exact definition folder; neither ancestors nor noninteractive mode grant trust.
+ * @param ctx - Parent context with the execution-world filesystem.
+ * @param directory - Project folder containing the selected .claude/agents directory.
+ * @param signal - Cancels trust-file reads before child publication.
+ * @returns Whether Claude's projects entry explicitly trusts this folder.
+ */
+export async function isAgentDirectoryTrusted(ctx: Context, directory: string, signal: AbortSignal): Promise<boolean> {
+  const fs = ctx.get('fs')
+  if (!fs) return false
+  const config = fs.processPathFromHostPath(join(homedir(), '.claude.json'))
+  if (!config) return false
+  const target = await fs.resolve(config, { signal })
+  if ((await fs.stat(target, signal))?.type !== 'file') return false
+  try {
+    const raw: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 1_048_576)))
+    if (!raw || typeof raw !== 'object' || !('projects' in raw) || !raw.projects || typeof raw.projects !== 'object' || Array.isArray(raw.projects)) return false
+    const key = fs.processPath(await fs.resolve(directory, { signal }))
+    const record: unknown = Reflect.get(raw.projects, key)
+    return record !== null && typeof record === 'object' && 'hasTrustDialogAccepted' in record && record.hasTrustDialogAccepted === true
+  } catch (error: unknown) {
+    signal.throwIfAborted()
+    ctx.logger.warn(`Could not read agent directory trust: ${String(error)}`)
+    return false
+  }
+}
diff --git a/packages/subagent/subagent-spawn-in-process/src/agent-type.ts b/packages/subagent/subagent-spawn-in-process/src/agent-type.ts
new file mode 100644
index 0000000000..9119a4f2c4
--- /dev/null
+++ b/packages/subagent/subagent-spawn-in-process/src/agent-type.ts
@@ -0,0 +1,149 @@
+/** Resolve Claude-format agent definitions through the execution-world filesystem. */
+import { homedir } from 'node:os'
+import { inspect } from 'node:util'
+import { validateClaudeAgentHooks } from '@deepseek-ai/dsh-hooks-claude-code'
+import { agentEffort, agentMaxTurns } from './agent-metadata.ts'
+import { isAgentDirectoryTrusted } from './agent-trust.ts'
+import { posix } from 'node:path'
+import type { Context } from '@deepseek-ai/cordis'
+import { claudeDirectories, claudePluginSources, parseClaudeMarkdown } from '@deepseek-ai/dsh-claude-code-config'
+import type {} from '@deepseek-ai/dsh-fs'
+
+/** Resolved instructions and supported start options from one Markdown definition. */
+export interface AgentTypeDefinition {
+  persona: string
+  model?: string
+  effort?: string
+  maxTurns?: number
+  tools?: string[]
+  disallowedTools?: string[]
+  permissionMode?: string
+  skills?: string[]
+  isolation?: 'worktree'
+  pluginRoot?: string
+  hooks?: unknown
+  mcpServers?: unknown[]
+}
+
+/** Split comma/space-separated selectors, retaining separators inside parentheses; a wildcard selects the complete list.
+ * @param value - YAML array or comma/space-separated field value.
+ * @returns Nonempty selectors, or an empty list for an invalid field.
+ */
+export function agentSelectors(value: unknown): string[] {
+  const values = typeof value === 'string' ? [value] : Array.isArray(value) ? value : []
+  const selectors: string[] = []
+  for (const entry of values) {
+    if (typeof entry !== 'string') continue
+    let text = ''
+    let inside = false
+    const append = (): void => { if (text.trim()) selectors.push(text.trim()); text = '' }
+    for (const character of entry) {
+      if (character === '(') inside = true
+      else if (character === ')') inside = false
+      if (!inside && (character === ' ' || character === ',')) append()
+      else text += character
+    }
+    append()
+  }
+  return selectors.includes('*') ? ['*'] : selectors
+}
+
+/** Read project ancestors before user and enabled plugin definitions.
+ * @param ctx - Parent context supplying the execution-world filesystem.
+ * @param name - Declared agent name, namespaced plugin name, or supported built-in name.
+ * @param cwd - Parent working directory from which ancestor lookup begins.
+ * @param signal - Cancels definition reads before child publication.
+ * @returns Persona and supported routing and tool restrictions; rejects missing definitions.
+ */
+export async function loadAgentType(ctx: Context, name: string, cwd: string, signal: AbortSignal): Promise<AgentTypeDefinition> {
+  signal.throwIfAborted()
+  if (!name || name.startsWith('-') || /[\0\r\n/\\]/.test(name)) throw new Error(`invalid agentType: ${name}`)
+  const fs = ctx.get('fs')
+  if (!fs) throw new Error('agentType requires the fs service')
+  const sources = claudeDirectories(fs, 'agents', cwd).map(path => ({ path, namespace: '', root: '' }))
+  if (name.includes(':')) sources.push(...await claudePluginSources(fs, 'agents', cwd, signal))
+  for (const source of sources) {
+    if (source.namespace && !name.startsWith(`${source.namespace}:`)) continue
+    const visited = new Set<string>()
+    const walk = async (path: string, namespaces: string[], depth: number): Promise<AgentTypeDefinition | undefined> => {
+      if (depth > 32 || visited.size >= 4096) throw new Error('agent definition directory exceeds lookup limits')
+      const target = await fs.resolve(path, { cwd, signal })
+      const resolved = fs.processPath(target)
+      if (visited.has(resolved)) return
+      visited.add(resolved)
+      const stat = await fs.stat(target, signal)
+      if (stat?.type === 'directory') {
+        for (const entry of (await fs.listDir(target, signal)).sort((a, b) => a.name.localeCompare(b.name))) {
+          const found = await walk(posix.join(resolved, entry.name), entry.type === 'directory' ? [...namespaces, entry.name] : namespaces, depth + 1)
+          if (found) return found
+        }
+        return
+      }
+      if (stat?.type !== 'file' || !path.endsWith('.md')) return
+      let parsed: ReturnType<typeof parseClaudeMarkdown>
+      try { parsed = parseClaudeMarkdown(new TextDecoder('utf-8', { fatal: true }).decode(await fs.readBytes(target, signal, 1_048_576))) }
+      catch (error: unknown) {
+        signal.throwIfAborted()
+        ctx.logger.warn(`Could not load agent definition ${path}: ${String(error)}`)
+        return
+      }
+      const meta = parsed.metadata
+      const localName = typeof meta.name === 'string' && meta.name ? meta.name : source.namespace ? posix.basename(path, '.md') : undefined
+      if (!localName || localName.startsWith('-') || (!source.namespace && localName.normalize('NFKC').includes(':'))) return
+      const fullName = source.namespace ? [source.namespace, ...namespaces, localName].join(':') : localName
+      if (fullName !== name) return
+      if (!source.namespace && (typeof meta.description !== 'string' || !meta.description)) {
+        ctx.logger.warn(`Agent file ${path} is missing required description in frontmatter`)
+        return
+      }
+      const tools = meta.tools === undefined ? undefined : agentSelectors(meta.tools)
+      const disallowedTools = meta.disallowedTools === undefined ? undefined : agentSelectors(meta.disallowedTools)
+      const model = typeof meta.model === 'string' ? meta.model.trim() : ''
+      const effort = agentEffort(meta.effort)
+      const maxTurns = agentMaxTurns(meta.maxTurns)
+      if (meta.effort !== undefined && effort === undefined) ctx.logger.warn(`Agent file ${path} has invalid effort '${typeof meta.effort === 'string' ? meta.effort : inspect(meta.effort)}'; expected low, medium, high, xhigh, max or an integer`)
+      if (meta.maxTurns !== undefined && maxTurns === undefined) ctx.logger.warn(`Agent file ${path} has invalid maxTurns '${typeof meta.maxTurns === 'string' ? meta.maxTurns : inspect(meta.maxTurns)}'; expected a positive integer`)
+      if (source.namespace) for (const field of ['permissionMode', 'hooks', 'mcpServers']) {
+        if (meta[field] !== undefined) ctx.logger.warn(`Plugin agent ${name} sets ${field}, which is ignored for plugin agents. Use .claude/agents/ for this level of control.`)
+      }
+      let hooks: unknown
+      let mcpServers: unknown[] | undefined
+      if (!source.namespace) {
+        if (meta.PreToolUse !== undefined || meta.PermissionRequest !== undefined) throw new Error(`Agent ${name}: guard events must be nested inside hooks`)
+        if (meta.hooks) {
+          validateClaudeAgentHooks(meta.hooks)
+          const userRoot = fs.processPathFromHostPath(posix.join(homedir(), '.claude', 'agents'))
+          const project = posix.dirname(posix.dirname(source.path))
+          if (source.path === userRoot || await isAgentDirectoryTrusted(ctx, project, signal)) hooks = meta.hooks
+          else ctx.logger.warn(`Skipping frontmatter hooks for agent '${name}': definition folder ${project} is not explicitly trusted in .claude.json`)
+        }
+        if (Array.isArray(meta.mcpServers)) {
+          const userRoot = fs.processPathFromHostPath(posix.join(homedir(), '.claude', 'agents'))
+          const project = posix.dirname(posix.dirname(source.path))
+          const trusted = source.path === userRoot || await isAgentDirectoryTrusted(ctx, project, signal)
+          mcpServers = meta.mcpServers.filter(entry => trusted || typeof entry === 'string')
+          if (mcpServers.length < meta.mcpServers.length) ctx.logger.warn(`Skipping inline MCP servers for agent '${name}': definition folder ${project} is not explicitly trusted in .claude.json`)
+        }
+      }
+      return {
+        ...hooks === undefined ? {} : { hooks },
+        ...mcpServers === undefined ? {} : { mcpServers },
+        ...effort === undefined ? {} : { effort },
+        ...maxTurns === undefined ? {} : { maxTurns },
+        persona: source.root ? parsed.content.replaceAll('${CLAUDE_PLUGIN_ROOT}', source.root) : parsed.content,
+        ...!model || model.toLowerCase() === 'inherit' ? {} : { model },
+        ...tools === undefined || tools.includes('*') ? {} : { tools },
+        ...disallowedTools === undefined || disallowedTools.includes('*') ? {} : { disallowedTools },
+        ...!source.namespace && typeof meta.permissionMode === 'string' ? { permissionMode: meta.permissionMode } : {},
+        skills: agentSelectors(meta.skills),
+        ...meta.isolation === 'worktree' ? { isolation: 'worktree' } : {},
+        ...source.root ? { pluginRoot: source.root } : {},
+      }
+    }
+    const definition = await walk(source.path, [], 0)
+    if (definition) return definition
+  }
+  if (name === 'general-purpose') return { persona: 'Complete the delegated task using the available tools.' }
+  if (name === 'Explore' || name === 'Plan') return { persona: name === 'Explore' ? 'Explore the codebase and return precise findings with file references. Do not modify files.' : 'Investigate the task and return an implementation plan. Do not modify files.', permissionMode: 'plan' }
+  throw new Error(`agentType not found: ${name}`)
+}
diff --git a/packages/subagent/subagent-spawn-in-process/src/bash-clamp.ts b/packages/subagent/subagent-spawn-in-process/src/bash-clamp.ts
new file mode 100644
index 0000000000..cc86df3955
--- /dev/null
+++ b/packages/subagent/subagent-spawn-in-process/src/bash-clamp.ts
@@ -0,0 +1,349 @@
+/** Parse and match each executable span of a workflow child's Bash call. */
+import { parseToolSelector } from './tool-selector.ts'
+import { homedir } from 'node:os'
+import { fileURLToPath } from 'node:url'
+import { Language, Parser, type Node } from 'web-tree-sitter'
+
+// CLI admission limit; this bounds synchronous parsing inside the final tool guard.
+const MAX_COMMAND_LENGTH = 10_000
+const DENIED = 'Command is outside this workflow agent’s Bash clamp.'
+const DYNAMIC = '__TRACKED_VAR__'
+const runtimeVariables = new Set(['PWD', 'OLDPWD', 'USER', 'LOGNAME', 'SHELL', 'PATH', 'HOSTNAME', 'UID', 'EUID', 'PPID', 'RANDOM', 'SECONDS', 'LINENO', 'TMPDIR', 'BASH_VERSION', 'BASHPID', 'SHLVL', 'HISTFILE', 'IFS'])
+const removableEnvironment = new Set(['GOEXPERIMENT', 'GOOS', 'GOARCH', 'CGO_ENABLED', 'GO111MODULE', 'RUST_BACKTRACE', 'RUST_LOG', 'NODE_ENV', 'PYTHONUNBUFFERED', 'PYTHONDONTWRITEBYTECODE', 'PYTEST_DISABLE_PLUGIN_AUTOLOAD', 'PYTEST_DEBUG', 'ANTHROPIC_API_KEY', 'LANG', 'LANGUAGE', 'LC_ALL', 'LC_CTYPE', 'LC_TIME', 'CHARSET', 'TERM', 'COLORTERM', 'NO_COLOR', 'FORCE_COLOR', 'TZ', 'LS_COLORS', 'LSCOLORS', 'GREP_COLOR', 'GREP_COLORS', 'GCC_COLORS', 'TIME_STYLE', 'BLOCK_SIZE', 'BLOCKSIZE', 'COLUMNS', 'LINES', 'CLICOLOR', 'CLICOLOR_FORCE', 'CI', 'DEBIAN_FRONTEND', 'GIT_TERMINAL_PROMPT'])
+const lookupVariables = new Set('path home dirstack tmpprefix bash_env env cdpath globignore shell fpath bash_loadables_path module_path manpath mailpath readnullcmd nullcmd histfile zdotdir functions commands aliases galiases saliases bash_cmds bash_aliases execignore bash_source_path lang language lc_all lc_ctype lc_collate lc_messages lc_numeric lc_time histchars textdomain textdomaindir'.split(' '))
+const integerVariables = new Set('RANDOM SECONDS LINENO OPTIND MAILCHECK HISTCMD SRANDOM EPOCHSECONDS EPOCHREALTIME BASH_MONOSECONDS BASH_TRAPSIG COLUMNS LINES SHLVL ERRNO TMOUT HISTSIZE SAVEHIST TRY_BLOCK_ERROR TRY_BLOCK_INTERRUPT KEYTIMEOUT LISTMAX LOGCHECK PERIOD FUNCNEST UID EUID GID EGID REPORTTIME REPORTMEMORY DIRSTACKSIZE BAUD ZLE_RPROMPT_INDENT MBEGIN MEND PPID ARGC ZSH_SUBSHELL TTYIDLE status'.split(' '))
+const wrappers = [
+  new RegExp(String.raw`^timeout[ \t]+(?:(?:--(?:foreground|preserve-status|verbose)|--(?:kill-after|signal)(?:=|[ \t]+)[\w.+-]+|-v|-[ks][ \t]*[\w.+-]+)[ \t]+)*(?:--[ \t]+)?\d+(?:\.\d+)?[smhd]?[ \t]+`),
+  /^time[ \t]+(?:--[ \t]+)?/,
+  /^nice(?:[ \t]+-n[ \t]+-?\d+|[ \t]+-\d+)?[ \t]+(?:--[ \t]+)?/,
+  /^stdbuf(?:[ \t]+-[ioe][LN0-9]+)+[ \t]+(?:--[ \t]+)?/,
+  /^nohup[ \t]+(?:--[ \t]+)?/,
+  /^command(?:[ \t]+-p+)*(?:[ \t]+--)?[ \t]+(?!-)/,
+  /^builtin(?:[ \t]+--)?[ \t]+(?!-)/,
+  /^noglob[ \t]+(?!-)/,
+]
+
+let language: Promise<Language> | undefined
+function loadLanguage(): Promise<Language> {
+  return language ??= (async () => {
+    await Parser.init()
+    return Language.load(fileURLToPath(import.meta.resolve('tree-sitter-bash/tree-sitter-bash.wasm')))
+  })()
+}
+
+/** One prepared clamp; the caller installs it in a child-scoped final guard. */
+export type BashClamp = (command: string) => string | undefined
+
+/** Validate rules and load the grammar before publishing the child. No shell is executed.
+ * @param rules - case-sensitive Bash(command) permission rules, or no clamp.
+ * @param signal - the child creation signal.
+ * @returns a synchronous final guard, or undefined for an absent/empty clamp.
+ */
+export async function prepareBashClamp(rules: readonly string[] | undefined, signal: AbortSignal): Promise<BashClamp | undefined> {
+  if (!rules?.length) return undefined
+  const matches = rules.map((rule) => {
+    const { toolName, ruleContent } = parseToolSelector(rule)
+    if (toolName !== 'Bash' || !ruleContent || ruleContent !== ruleContent.trim()) throw new Error(`invalid bashCommandClamp rule: ${rule}`)
+    return compileRule(ruleContent)
+  })
+  signal.throwIfAborted()
+  const grammar = await loadLanguage()
+  signal.throwIfAborted()
+  return (command) => {
+    if (!command.trim() || command.length > MAX_COMMAND_LENGTH || unverifiableText(command)) return DENIED
+    const parser = new Parser()
+    try {
+      parser.setLanguage(grammar)
+      const tree = parser.parse(command)
+      if (!tree) return DENIED
+      try {
+        if (tree.rootNode.hasError) return DENIED
+        const spans: CommandSpan[] = []
+        if (!collectSpans(tree.rootNode, new Map(), spans)) return DENIED
+        return spans.length && spans.every((span) => {
+          const stripped = [span.stripped, normalizeCommand(span.stripped, parser)]
+          const exact = [...stripped, span.raw, normalizeCommand(span.raw, parser)]
+          return matches.some(rule => (rule.exact ? exact : stripped).some(rule.match))
+        }) ? undefined : DENIED
+      } finally { tree.delete() }
+    } finally { parser.delete() }
+  }
+}
+
+function unverifiableText(command: string): boolean {
+  return /[\x00-\x08\x0b-\x1f\x7f\u00a0\u1680\u2000-\u200b\u2028\u2029\u202f\u205f\u3000\ufeff]/.test(command)
+    || /[\ud800-\udbff](?![\udc00-\udfff])|(?<![\ud800-\udbff])[\udc00-\udfff]/.test(command)
+    || /\\[ \t]|(?:^|[^ \t\\])(?:\\\\)*\\\n|[ \t](?:\\\\)+\\\n/.test(command)
+    || /~\[|(?:^|[\s;&|])=[a-zA-Z_]|<\d*-\d*>/.test(command)
+}
+
+interface CommandSpan { raw: string; stripped: string }
+interface CommandRule { exact: boolean; match: (command: string) => boolean }
+
+/** Exact rules retain raw redirections; prefixes/globs inspect stripped commands. */
+function compileRule(rule: string): CommandRule {
+  if (rule.startsWith('certified: ')) return { exact: false, match: () => false }
+  if (rule.endsWith(':*')) {
+    const prefix = rule.slice(0, -2).replace(/[ \t]+/g, ' ')
+    return { exact: false, match: command => [command, command.startsWith('xargs ') ? command.slice(6) : command].some((value) => {
+      const normalized = value.replace(/[ \t]+/g, ' ')
+      return normalized === prefix || normalized.startsWith(prefix + ' ')
+    }) }
+  }
+  let pattern = '', stars = 0
+  const normalized = rule.replace(/[ \t]+/g, ' ')
+  for (let i = 0; i < normalized.length; i++) {
+    const char = normalized.charAt(i)
+    if (char === '\\' && (normalized[i + 1] === '*' || normalized[i + 1] === '\\')) {
+      pattern += escapePattern(normalized.charAt(++i))
+    } else if (char === '*') {
+      stars++
+      if (normalized.slice(i - 1, i + 3) === '/**/') {
+        pattern = pattern.slice(0, -1) + '/(?:.*/)?'
+        stars++; i += 2
+        while (normalized.slice(i + 1, i + 4) === '**/') { stars += 2; i += 3 }
+      }
+      else pattern += '.*'
+    } else pattern += escapePattern(char)
+  }
+  if (stars === 0) return { exact: true, match: command => command === rule }
+  if (stars === 1 && pattern.endsWith(' .*')) pattern = pattern.slice(0, -3) + '( .*)?'
+  const expression = new RegExp(`^${pattern}$`, 'su')
+  const trailingStar = /(?<!\\)(?:\\\\)*\*$/.test(rule)
+  return { exact: false, match: (command) => {
+    const value = command.replace(/[ \t]+/g, ' ')
+    return expression.test(value) || (trailingStar && value.startsWith('xargs ') && expression.test(value.slice(6)))
+  } }
+}
+
+function escapePattern(text: string): string { return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') }
+
+/** Remove only CLI-recognized inert wrappers and environment prefixes. */
+function normalizeCommand(command: string, parser: Parser): string {
+  let value = command.trim(), prior: string
+  do {
+    prior = value
+    const assignment = /^([A-Za-z_][A-Za-z0-9_]*)=([A-Za-z0-9_./:-]+)[ \t]+/.exec(value)
+    if (assignment?.[1] && removableEnvironment.has(assignment[1])) value = value.slice(assignment[0].length)
+  } while (value !== prior)
+  do {
+    prior = value
+    const head = /^([^\s]+)([\s\S]*)$/.exec(value)
+    if (head?.[1] !== undefined && head[2] !== undefined) {
+      const tree = parser.parse(head[1])
+      try {
+        const commandNode = tree?.rootNode.namedChildren[0]
+        const name = commandNode?.type === 'command' && commandNode.childForFieldName('name')
+        const decoded = name && word(name, new Map())
+        if (decoded && !decoded.changed) value = decoded.value + head[2]
+      } finally { tree?.delete() }
+    }
+    for (const wrapper of wrappers) value = value.replace(wrapper, '')
+  } while (value !== prior)
+  return value.trim()
+}
+
+type Bindings = Map<string, string | undefined>
+interface Word { value: string; changed: boolean }
+
+function word(node: Node, bindings: Bindings, quoted = false): Word | undefined {
+  if (node.type === 'raw_string') return { value: node.text.slice(1, -1), changed: false }
+  if (node.type === 'number' || node.type === 'string_content') return { value: node.text.replace(/\\([\\"$`])/g, '$1'), changed: false }
+  if (node.type === 'word') {
+    if (/\{[^\s]*(?:,|\.\.)[^\s]*\}/.test(node.text)) return undefined
+    return { value: node.text.replace(/\\([^\n])/g, '$1'), changed: false }
+  }
+  if (node.type === 'simple_expansion') {
+    const name = node.text.slice(1)
+    if (bindings.has(name) && ['RANDOM', 'SECONDS', 'LINENO', 'BASHPID'].includes(name)) return quoted && name !== 'BASHPID' ? { value: DYNAMIC, changed: true } : undefined
+    const value = bindings.has(name) ? bindings.get(name) ?? (quoted ? DYNAMIC : undefined) : name === 'HOME' ? homedir() : quoted && (runtimeVariables.has(name) || /^[0?$!#-]$/.test(name)) ? DYNAMIC : undefined
+    if (value === undefined || (!quoted && (!value || value.includes(DYNAMIC) || /[ \t\n*?[]/.test(value)))) return undefined
+    return { value, changed: true }
+  }
+  if (node.type === 'arithmetic_expansion') {
+    const expression = node.text.slice(3, -2).replace(/(?:0[xX][0-9a-fA-F]+|[0-9]+#[0-9a-zA-Z]+|[0-9]+)/g, '0')
+    return /^[0\s()+*/%^&|~!<>=?:,.-]+$/.test(expression) ? { value: DYNAMIC, changed: false } : undefined
+  }
+  if (node.type === 'command_name' || node.type === 'concatenation' || node.type === 'string') {
+    if (node.type === 'concatenation' && /\{[^}]*[,]|\{[^}]*\.\./.test(node.text)) return undefined
+    const parts: Word[] = []
+    for (const child of node.namedChildren) {
+      const part = word(child, bindings, quoted || node.type === 'string')
+      if (!part) return undefined
+      parts.push(part)
+    }
+    const value = parts.map(part => part.value).join('')
+    if (node.type === 'string' && value.includes(DYNAMIC) && value.replaceAll(DYNAMIC, '').length <= 1) return undefined
+    return { value, changed: parts.some(part => part.changed) }
+  }
+  return undefined
+}
+
+function assignment(node: Node, bindings: Bindings, afterCommand: boolean, bare: boolean): boolean {
+  const name = node.childForFieldName('name')?.text
+  if (!name || !/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) return false
+  const valueNode = node.childForFieldName('value')
+  const value = valueNode ? word(valueNode, bindings, true) : { value: '', changed: false }
+  if (!value || name === 'IFS' || value.value.includes('~')) return false
+  if (bare && (lookupVariables.has(name.toLowerCase()) || /^(ld_|dyld_|bash_func_)/i.test(name))) return false
+  if (integerVariables.has(name) && !/^(0|[1-9][0-9]{0,17})$/.test(value.value)) return false
+  if ((name === 'PS4' || name === 'PROMPT4') && (node.children.some(child => child.type === '+=') || !/^[A-Za-z0-9 _+:./=[\]-]*$/.test(value.value.replace(/\$\{[A-Za-z_][A-Za-z0-9_]*\}/g, '')))) return false
+  const prior = bindings.get(name)
+  const append = node.children.some(child => child.type === '+=')
+  if (append && prior === undefined) return true
+  const next = append && prior !== undefined ? prior + value.value : value.value
+  bindings.set(name, afterCommand || (bindings.has(name) && prior !== value.value && !append) ? undefined : next)
+  return true
+}
+
+function redirect(node: Node, bindings: Bindings): boolean {
+  if (node.type === 'heredoc_redirect') {
+    const delimiter = node.namedChildren.find(child => child.type === 'heredoc_start')?.text ?? ''
+    const quoted = /^(['"]).*\1$/.test(delimiter)
+    if (!(quoted || /^\\\w+$/.test(delimiter)) || (quoted && delimiter.slice(1, -1).includes('\\'))) return false
+    const body = node.namedChildren.find(child => child.type === 'heredoc_body')
+    const end = quoted ? delimiter.slice(1, -1) : delimiter.slice(1)
+    return !!body && !body.text.split('\n').some(line => line.replace(/^\t+/, '').startsWith(end) && /[)`}]/.test(line.slice(end.length)))
+  }
+  if (node.type !== 'file_redirect' && node.type !== 'herestring_redirect') return false
+  if (node.children.some(child => ['>&-', '<&-'].includes(child.type))) return false
+  const targets = node.namedChildren.filter(child => child.type !== 'file_descriptor')
+  const [target] = targets
+  if (!target || targets.length !== 1) return false
+  if (node.type === 'herestring_redirect') {
+    const parsed = word(target, bindings)
+    return parsed !== undefined && !/\n\s*#/.test(parsed.value)
+  }
+  if (target.type === 'concatenation' && /[$`]/.test(target.text)) return false
+  if (!['word', 'number', 'raw_string', 'string', 'concatenation'].includes(target.type)) return false
+  const parsed = word(target, bindings)
+  if (!parsed || parsed.value.includes(DYNAMIC) || /[\n]/.test(parsed.value) || /^[!=]/.test(parsed.value)) return false
+  if (node.children.some(child => ['>&', '<&'].includes(child.type)) && parsed.value.startsWith('-')) return false
+  return !node.children.some(child => child.type === '>&') || /^[A-Za-z0-9./_-]+$/.test(parsed.value)
+}
+
+/** Collect both raw and resolved command spans; every span must match independently. */
+function collectSpans(node: Node, bindings: Bindings, spans: CommandSpan[], state = { commands: 0 }): boolean {
+  if (node.type === 'comment') return true
+  if (node.type === 'program' || node.type === 'list' || node.type === 'pipeline') {
+    const initial = new Map(bindings)
+    let active = node.type === 'pipeline' ? new Map(bindings) : bindings
+    let uncertain: Set<string> | undefined
+    for (const child of node.children) {
+      if (!child.isNamed) {
+        if (child.type === '|' || child.type === '|&' || child.type === '&') active = new Map(initial)
+        if (child.type === '||') {
+          uncertain ??= new Set(bindings.keys())
+          active = new Map(initial)
+          for (const [key, value] of bindings) if (initial.get(key) !== value) active.set(key, undefined)
+        } else if (!['|', '|&', '&'].includes(child.type) && uncertain) {
+          for (const key of uncertain) bindings.set(key, undefined)
+          uncertain = undefined
+          active = bindings
+        }
+        continue
+      }
+      if (!collectSpans(child, active, spans, state)) return false
+    }
+    if (uncertain) for (const key of uncertain) bindings.set(key, undefined)
+    if (node.type === 'pipeline' || active !== bindings) {
+      for (const [key, value] of active) if (bindings.get(key) !== value) bindings.set(key, undefined)
+    }
+    return true
+  }
+  if (node.type === 'negated_command') return node.namedChildren.every(child => collectSpans(child, bindings, spans, state))
+  if (node.type === 'redirected_statement') return node.namedChildren.every(child => child.type.endsWith('_redirect') ? redirect(child, bindings) : collectSpans(child, bindings, spans, state))
+  if (node.type === 'variable_assignment') {
+    spans.push({ raw: node.text, stripped: node.text })
+    return assignment(node, bindings, state.commands > 0, true)
+  }
+  if (node.type !== 'command') return false
+  const words: Word[] = [], prefixes = new Set<string>()
+  let stripped = node.text, hasRedirect = false, expandedRedirect = false
+  for (const child of [...node.namedChildren].reverse()) {
+    if (child.type.endsWith('_redirect')) {
+      if (!redirect(child, bindings)) return false
+      const start = child.startIndex - node.startIndex, end = child.endIndex - node.startIndex
+      stripped = stripped.slice(0, start) + stripped.slice(end)
+      hasRedirect = true
+      expandedRedirect ||= child.namedChildren.some(target => word(target, bindings)?.changed)
+    }
+  }
+  for (const child of node.namedChildren) {
+    if (child.type.endsWith('_redirect')) continue
+    if (child.type === 'variable_assignment') {
+      const referencesPrefix = (part: Node): boolean => part.type === 'simple_expansion' && prefixes.has(part.text.slice(1)) || part.namedChildren.some(referencesPrefix)
+      if (referencesPrefix(child) || !assignment(child, new Map(bindings), state.commands > 0, false)) return false
+      const name = child.childForFieldName('name')
+      if (!name) return false
+      prefixes.add(name.text)
+      continue
+    }
+    // Prefix assignments do not affect expansion of this command's arguments.
+    const parsed = word(child, bindings)
+    if (!parsed) return false
+    words.push(parsed)
+  }
+  if (!words.length) return false
+  stripped = stripped.trim()
+  // Inline here-strings remain part of the CLI matcher span.
+  spans.push({ raw: node.text.trim(), stripped: node.text.trim() })
+  if (expandedRedirect || words.some(part => part.changed)) {
+    const resolved = words.map(part => part.value).join(' ')
+    spans.push({ raw: resolved, stripped: resolved })
+  } else if (node.text.includes('\\\n')) {
+    const continued = (hasRedirect ? stripped : node.text).replace(/\\\n/g, '').trim()
+    spans.push({ raw: continued, stripped: continued })
+  }
+  if (!invalidateWrites(words.map(part => part.value), bindings, prefixes)) return false
+  state.commands++
+  return true
+}
+
+/** Shell builtins can invalidate a literal before a later command expands it. */
+function invalidateWrites(argv: string[], bindings: Bindings, prefixes: Set<string>): boolean {
+  let command = argv
+  while (['command', 'builtin', 'time', 'noglob', 'nocorrect'].includes(command[0] ?? '')) {
+    if (command[0] === 'command' && /^-[pvV]*[vV]/.test(command[1] ?? '')) return true
+    command = command.slice(1)
+    while (/^-[-p]*$/.test(command[0] ?? '')) command = command.slice(1)
+  }
+  const head = command[0], args = command.slice(1), targets: string[] = []
+  if (head === 'read') {
+    for (let i = 0; i < args.length; i++) {
+      const arg = args[i]
+      if (arg === undefined) break
+      if (arg === '--') { targets.push(...args.slice(i + 1)); break }
+      if (/^-[pdnNtui]$/.test(arg)) { i++; continue }
+      const array = /^-[rse]*[aA](.*)$/.exec(arg)
+      if (array) { targets.push(array[1] || args[++i] || ''); continue }
+      if (!arg.startsWith('-')) targets.push(arg)
+    }
+    if (!targets.length) targets.push('REPLY')
+  } else if (['printf', 'print', 'wait'].includes(head ?? '')) {
+    const option = head === 'wait' ? '-p' : '-v'
+    for (let i = 0; i < args.length; i++) {
+      const arg = args[i]
+      if (arg === undefined) break
+      if (arg === '--' || !arg.startsWith('-')) break
+      if (arg === option) targets.push(args[++i] ?? '')
+      else if (arg.startsWith(option)) targets.push(arg.slice(2))
+    }
+  } else if (head === 'getopts') {
+    targets.push(args[args[0] === '--' ? 2 : 1] ?? '', 'OPTARG')
+    bindings.set('OPTIND', undefined)
+  } else if (['cd', 'chdir', 'pushd', 'popd'].includes(head ?? '')) {
+    bindings.set('PWD', undefined); bindings.set('OLDPWD', undefined)
+  } else if (['declare', 'typeset', 'local', 'export', 'readonly'].includes(head ?? '')) {
+    if (args.some(arg => /^[+-].*m/.test(arg))) return false
+    targets.push(...args.filter(arg => !arg.startsWith('-') && arg.includes('=')))
+  }
+  if ([':', 'break', 'continue', 'return', 'exit', 'shift', 'times', 'set', 'export', 'readonly', 'unset'].includes(head ?? '')) targets.push(...prefixes)
+  for (const target of targets) {
+    const name = /^[A-Za-z_][A-Za-z0-9_]*/.exec(target)?.[0]
+    if (!name) continue
+    if (lookupVariables.has(name.toLowerCase()) || /^(ld_|dyld_|bash_func_)/i.test(name) || integerVariables.has(name) || ['IFS', 'PS4', 'PROMPT4'].includes(name)) return false
+    bindings.set(name, undefined)
+  }
+  return true
+}
