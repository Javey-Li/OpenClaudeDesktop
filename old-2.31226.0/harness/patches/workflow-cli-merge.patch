--- /dev/null
+++ b/snapshots/session/workflow-agent-hooks/workspace/stop.cjs
@@ -0,0 +1,9 @@
+let input = '';
+process.stdin.on('data', value => { input += value }).on('end', () => {
+  const payload = JSON.parse(input);
+  const output = payload.last_assistant_message === 'AGENT_HOOK_DONE'
+    ? {continue:false,stopReason:'AGENT_HOOK_HALT',decision:'block',reason:'This must not force continuation'}
+    : payload.last_assistant_message === 'AGENT_HOOK_FIRST' && !payload.stop_hook_active
+      ? {decision:'block',reason:'AGENT_HOOK_CONTINUE'} : {};
+  console.log(JSON.stringify(output));
+});
