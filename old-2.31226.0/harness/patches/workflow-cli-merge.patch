+
+const assistant = createAssistantMessage({
+  content: [{ type: 'reasoning', text: 'first' }, { type: 'text', text: 'text' }, { type: 'reasoning', text: '' }],
+  source: { provider: 'deepseek-official', model: MODEL, replayState: replayState(MODEL, [{ type: 'reasoning', signature: 'first' }, { type: 'text' }, { type: 'reasoning', redactedData: 'hidden+/==' }]) },
+})
+const history = [user(), assistant, user()]
+const body = serialize(options({ messages: history }), resolveAdapterOptions({}), history, new Map(), () => undefined)
+const failure = (message: string, status = 400): LlmFailure => ({ message, status, code: 'INVALID_REQUEST' })
+const prefix = failure('Thinking was bound to a different conversation')
+const header = (block: string) => new Headers({ 'anthropic-thinking-prefix-mismatch': block })
+
+it.each([false, true])('keeps the original tool position after reasoning omission, partial=%s', (partial) => {
+  const callId = ToolCallId('read')
+  const content: ContentBlock[] = [
+    { type: 'reasoning', text: 'first' }, { type: 'tool-call', id: callId, name: 'read', arguments: '{}' },
+    { type: 'reasoning', text: 'last' }, { type: 'text', text: 'FIRST' },
+  ]
+  const replay = replayState(MODEL, [{ type: 'reasoning', signature: 'first' }, { type: 'tool-call' }, { type: 'reasoning', signature: 'last' }, { type: 'text' }])
+  const keep = (_: unknown, index: number) => index !== 2 && (partial || index !== 0)
+  const message = createAssistantMessage({ content: content.filter(keep), source: {
+    provider: 'deepseek-official', model: MODEL, replayState: { ...replay, blocks: replay.blocks!.filter(keep) },
+  } })
+  const messages = [user(), message, createToolResultMessage({ callId, content: [{ type: 'text', text: 'READ' }], isError: false })]
+  const wire = serialize(options({ messages }), resolveAdapterOptions({}), messages, new Map(), () => undefined)
+  expect(wire.messages[1]?.content.map(b => b.type)).toEqual(partial ? ['thinking', 'tool_use', 'text'] : ['tool_use', 'text'])
+  expect(JSON.stringify(wire)).not.toContain('thinkingPrefix')
+})
+
+it.each([false, true])('uses Session ordering for legacy replay without private counters, partial=%s', (partial) => {
+  const callId = ToolCallId('read')
+  const content: ContentBlock[] = [
+    { type: 'reasoning', text: 'first' }, { type: 'tool-call', id: callId, name: 'read', arguments: '{}' },
+    { type: 'reasoning', text: 'last' }, { type: 'text', text: 'FIRST' },
+  ]
+  const keep = (_: unknown, index: number) => index !== 2 && (partial || index !== 0)
+  const message = createAssistantMessage({ content: content.filter(keep), source: {
+    provider: 'deepseek-official', model: MODEL, reasoningPrefix: [0, 1, 1, 2].filter(keep),
+    replayState: { response: { kind: 'deepseek-messages', version: 1, model: MODEL }, blocks: [
+      { type: 'reasoning', signature: 'first' }, { type: 'tool-call' }, { type: 'reasoning', signature: 'last' }, { type: 'text' },
+    ].filter(keep) },
+  } })
+  const messages = [user(), message, createToolResultMessage({ callId, content: [{ type: 'text', text: 'READ' }], isError: false })]
+  const wire = serialize(options({ messages }), resolveAdapterOptions({}), messages, new Map(), () => undefined)
+  expect(wire.messages[1]?.content.map(b => b.type)).toEqual(partial ? ['thinking', 'tool_use', 'text'] : ['tool_use', 'text'])
+  expect(JSON.stringify(wire)).not.toContain('Prefix')
+})
+
+it.each([
+  'Invalid signature in thinking block', 'invalid data in redacted_thinking block',
+  '`thinking.signature`: Field required', 'Thinking block cannot be modified',
+  'redacted_thinking contains an invalid signature', 'capability_rejected: thinking_signature',
+])('classifies whole-history repair for %s', (message) => {
+  expect(reasoningRecovery(failure(message), new Headers(), body, history)).toEqual({})
+})
+
+it.each([
+  failure('unrelated error'), failure('invalid tool signature'),
+  failure('capability_rejected: thinking_signature_extra'), failure('Thinking block invalid signature', 401),
+  failure('Thinking block invalid signature', 500),
+])('does not strip for unrelated or non-400 errors %#', (error) => {
+  expect(reasoningRecovery(error, new Headers(), body, history)).toBeUndefined()
+})
+
+it('maps native opaque positions to durable indexes without exposing their contents in failure metadata', () => {
+  const value = reasoningRecovery(prefix, header('kind=signature;block=messages.1.content.2'), body, history)
+  expect(value).toEqual({ from: { messageId: assistant.id, blockIndex: 2 } })
+  expect(JSON.stringify(value)).not.toContain('hidden')
+})
+
+it.each([
+  '', 'block=messages.99.content.0', 'block=messages.1.content.1',
+  'block=messages.-1.content.0', 'block=messages.1.content.9999999', 'x'.repeat(2049),
+])('falls back to all when the prefix position is unusable %#', (value) => {
+  expect(reasoningRecovery(prefix, header(value), body, history)).toEqual({})
+})
+
+it('uses the first duplicate header key and rejects ambiguous native identities', () => {
+  expect(reasoningRecovery(prefix, header('block=messages.1.content.0;block=messages.1.content.2'), body, history))
+    .toEqual({ from: { messageId: assistant.id, blockIndex: 0 } })
+  const repeated = createAssistantMessage({ content: assistant.content, source: { provider: 'deepseek-official', model: MODEL, replayState: assistant.source.replayState } })
+  expect(reasoningRecovery(prefix, header('block=messages.1.content.0'), body, [...history, repeated])).toEqual({})
+})
+
+it('does not retry if the rejected wire request contains no thinking', () => {
+  const without = { ...body, messages: body.messages.map(m => ({ ...m, content: m.content.filter(b => b.type === 'text') })) }
+  expect(reasoningRecovery(prefix, new Headers(), without, history)).toBeUndefined()
+})
+
+it('owns immutable validated failure coordinates through serialization', () => {
+  const decision = { from: { messageId: MessageId('original'), blockIndex: 2 } }
+  const error = new LlmError('rejected', 'REASONING_REPLAY_REJECTED', { reasoningRecovery: decision })
+  decision.from.blockIndex = 0
+  expect(error.failure.reasoningRecovery?.from?.blockIndex).toBe(2)
+  expect(Object.isFrozen(error.failure.reasoningRecovery?.from)).toBe(true)
+  expect((JSON.parse(JSON.stringify(error.failure)) as LlmFailure).reasoningRecovery?.from?.blockIndex).toBe(2)
+  expect(() => new LlmError('auth', 'AUTH', { reasoningRecovery: {} })).toThrow(/reasoningRecovery/)
+})
+
+it.each([null, [], { unknown: true }, { from: null }, { from: {} }, { from: { messageId: '', blockIndex: 0 } }, { from: { messageId: 'm', blockIndex: -1 } }, { from: { messageId: 'm', blockIndex: -0 } }, { from: { messageId: 'm', blockIndex: 0.1 } }])('refuses malformed recovery coordinates %#', (decision) => {
+  expect(() => new LlmError('rejected', 'REASONING_REPLAY_REJECTED', { reasoningRecovery: decision as never })).toThrow(/reasoningRecovery/)
+})
