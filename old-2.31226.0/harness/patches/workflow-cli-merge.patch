diff --git a/packages/subagent/subagent-spawn-in-process/tests/agent-metadata.spec.ts b/packages/subagent/subagent-spawn-in-process/tests/agent-metadata.spec.ts
new file mode 100644
index 0000000000..7a6a70ade1
--- /dev/null
+++ b/packages/subagent/subagent-spawn-in-process/tests/agent-metadata.spec.ts
@@ -0,0 +1,113 @@
+import { mkdir, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { ReasoningEffortId, createUserMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import SubagentRuntime from '@deepseek-ai/dsh-subagent'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse, toolCallResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { mountPtcRuntime } from '../../../workflow/workflow-ptc/tests/setup.ts'
+import { loadAgentType } from '../src/agent-type.ts'
+import * as spawn from '../src/index.ts'
+
+const signal = new AbortController().signal
+
+async function setup(metadata: string, script: ConstructorParameters<typeof MockAdapter>[0]) {
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  const { cwd } = await mountPtcRuntime(ctx)
+  await mkdir(join(cwd, '.claude/agents'), { recursive: true })
+  await writeFile(join(cwd, '.claude/agents/bounded.md'), `---\nname: bounded\ndescription: Bounded reviewer\ntools: [Bash]\n${metadata}\n---\nReview the task.`)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(SubagentRuntime)
+  await ctx.plugin(spawn, { providerName: 'spawn', maxStructuredOutputRetries: 5 })
+  let executed = 0
+  ctx.tools.register(defineContentToolFixture({ name: 'bash', description: 'tool fixture', parameters: {}, execute: async () => { executed++; return [{ type: 'text', text: 'tool done' }] } }))
+  const adapter = new MockAdapter(script, { efforts: ['low', 'medium', 'high', 'xhigh', 'max', '1000'].map(id => ({ id: ReasoningEffortId(id), name: id })) })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const parent = await ctx.agents.create({ sessionId: SessionId('metadata-parent'), meta: { cwd }, agentOptions: { provider: 'mock', model: 'mock', reasoningEffort: ReasoningEffortId('low') } })
+  return { ctx, cwd, adapter, parent, executed: () => executed }
+}
+
+describe('agent definition iteration and effort metadata', () => {
+  it.each([
+    ['"MED"', 'medium'], ['high', 'high'], ['"1000tokens"', '1000'], ['invalid', 'low'],
+  ])('resolves effort %s before the first child request', async (value, expected) => {
+    const h = await setup(`effort: ${value}`, [textResponse('done')])
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', prompt: [{ type: 'text', text: 'Review.' }] })
+    expect((await run.result).stopReason).toBe('completed')
+    expect(h.adapter.requests[0]!.reasoningEffort).toBe(expected)
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it('lets the caller override definition effort without changing the parent', async () => {
+    const h = await setup('effort: max', [textResponse('done'), textResponse('parent')])
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', agentOptions: { reasoningEffort: ReasoningEffortId('medium') }, prompt: [{ type: 'text', text: 'Review.' }] })
+    await run.result
+    expect(h.adapter.requests[0]!.reasoningEffort).toBe('medium')
+    await run.dispose()
+    h.parent.agent.followup(createUserMessage({ content: [{ type: 'text', text: 'Parent task' }], source: { kind: 'user' } }))
+    await h.parent.agent.whenIdle()
+    expect(h.adapter.requests[1]!.reasoningEffort).toBe('low')
+    await h.parent.dispose()
+  })
+
+  it.each([
+    ['1', 1], ['"2 requests"', 2], ['"2e1"', 20], ['"1_000"', 1000], ['0', undefined], ['1.5', undefined], ['"1e-2"', undefined],
+  ])('reads maxTurns %s with Claude numeric-string semantics', async (value, expected) => {
+    const h = await setup(`maxTurns: ${value}`, [])
+    expect((await loadAgentType(h.ctx, 'bounded', h.cwd, signal)).maxTurns).toBe(expected)
+    await h.parent.dispose()
+  })
+
+  it('finishes the admitted tool, retains partial output and blocks the next model iteration', async () => {
+    const h = await setup('maxTurns: 1', [toolCallResponse('bounded-tool', 'bash', {}, 'Partial findings'), textResponse('must not run')])
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', prompt: [{ type: 'text', text: 'Keep checking.' }] })
+    const result = await run.result
+    expect(result.stopReason).toBe('max-turns')
+    expect(result.output).toContainEqual({ type: 'text', text: 'Partial findings' })
+    expect(result.diagnostic).toContain('maxTurns (1)')
+    expect(h.adapter.requests).toHaveLength(1)
+    expect(h.executed()).toBe(1)
+    expect(run.localAgent!.session.snapshotEvents().filter(event => event.type === 'step/start')).toHaveLength(1)
+    expect(run.localAgent!.session.snapshotEvents().at(-1)).toMatchObject({ type: 'turn/end', data: { reason: { kind: 'error', error: { code: 'SUBAGENT_MAX_TURNS' } } } })
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it('caps Stop-triggered continuation without discarding the last answer', async () => {
+    const h = await setup('maxTurns: 1', [textResponse('last permitted answer')])
+    h.ctx.on('agent/turn-stopping', ({ agent }) => {
+      if (agent !== h.parent.agent) agent.steer(createUserMessage({ content: [{ type: 'text', text: 'Continue checking.' }], source: { kind: 'user' } }))
+    })
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', prompt: [{ type: 'text', text: 'Finish.' }] })
+    expect(await run.result).toMatchObject({ stopReason: 'max-turns', output: [{ type: 'text', text: 'last permitted answer' }] })
+    expect(h.adapter.requests).toHaveLength(1)
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it('retains the limit outcome when no structured value was captured', async () => {
+    const h = await setup('maxTurns: 1', [toolCallResponse('limit', 'bash', {})])
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', outputSchema: { type: 'object', properties: { ok: { type: 'boolean' } }, required: ['ok'] }, prompt: [{ type: 'text', text: 'Finish.' }] })
+    const result = await run.result
+    expect(result.stopReason).toBe('max-turns')
+    expect(result.structured).toBeUndefined()
+    expect(h.adapter.requests).toHaveLength(1)
+    await run.dispose()
+    await h.parent.dispose()
+  })
+
+  it('allows normal completion on the final permitted iteration', async () => {
+    const h = await setup('maxTurns: 2', [toolCallResponse('bounded-tool', 'bash', {}), textResponse('finished')])
+    const run = await h.ctx.subagents.start('spawn', { parent: h.parent.agent, signal, agentType: 'bounded', prompt: [{ type: 'text', text: 'Finish.' }] })
+    expect((await run.result).stopReason).toBe('completed')
+    expect(h.adapter.requests).toHaveLength(2)
+    await run.dispose()
+    await h.parent.dispose()
+  })
+})
