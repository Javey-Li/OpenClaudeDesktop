+/** Resolve reusable scripts through the active execution world's filesystem. */
+import { posix } from 'node:path'
+import { claudeDirectories, claudePluginSources } from '@deepseek-ai/dsh-claude-code-config'
+import { FsError } from '@deepseek-ai/dsh-fs'
+import type FileSystem from '@deepseek-ai/dsh-fs'
