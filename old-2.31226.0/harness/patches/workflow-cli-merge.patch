+    // Publish only a complete journal header. Earlier attempts remain available for inspection.
+    const temporaryPointer = join(directory, `${this.attemptId}.json.tmp`)
+    writeFileSync(temporaryPointer, JSON.stringify({ attemptId: this.attemptId }) + '\n', { flag: 'wx', mode: 0o600, flush: true })
