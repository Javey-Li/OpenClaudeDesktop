+
+it.each([
+  { input: ['opaque', 'tool', 'text'], expected: ['opaque', 'text', 'tool'] },
+  { input: ['tool', 'opaque', 'tool', 'text'], expected: ['opaque', 'text', 'tool', 'tool'] },
+  { input: ['think', 'tool', 'opaque', 'tool', 'think', 'text'], expected: ['think', 'tool', 'opaque', 'tool', 'think', 'text'] },
+])('orders opaque blocks around tools in full and fragmented history: $input', ({ input, expected }) => {
+  const content: ContentBlock[] = input.map((kind, index) => kind === 'opaque' ? opaque : kind === 'think' ? thinking : kind === 'text' ? text
+    : { type: 'tool-call', id: ToolCallId(`call-${index}`), name: 'read', arguments: '{}' })
+  const blocks: ReplayBlock[] = input.map(kind => kind === 'opaque' ? hidden : kind === 'think' ? signed : { type: kind === 'tool' ? 'tool-call' : 'text' })
+  for (const responses of [[assistant(content, blocks)], content.map((block, index) => assistant([block], [blocks[index]!]))]) {
+    const messages = [user(), ...responses, ...content.filter(block => block.type === 'tool-call').map(block => createToolResultMessage({ callId: block.id, content: [text], isError: false }))]
+    const saved = JSON.stringify(messages)
+    const wire = body(messages).messages[1]!.content
+    expect(wire.map(block => block.type === 'redacted_thinking' ? 'opaque' : block.type === 'thinking' ? 'think' : block.type === 'tool_use' ? 'tool' : block.type)).toEqual(expected)
+    expect(wire.filter(block => block.type === 'redacted_thinking')).toEqual([{ type: 'redacted_thinking', data: payload }])
+    expect(JSON.stringify(messages)).toBe(saved)
