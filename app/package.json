{
  "name": "code-desktop-local",
  "version": "0.2.130",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:ui && vite build",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "package": "npm run build && electron-packager . 'Code Desktop' --platform=darwin --arch=arm64 --app-bundle-id=local.code-desktop --icon=build/icon.icns --out=../releases --overwrite --prune=false --ignore='^/(src|tests|scripts|public|node_modules|build|vite.config.js|index.html|package-lock.json)' --asar && node scripts/sign-local.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "katex": "0.16.47",
    "micromark": "4.0.2",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-util-decode-string": "2.0.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "vite": "8.3.0"
  }
}
